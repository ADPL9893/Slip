@{
    ViewBag.Title = "Add Reports Jumbo";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}


<div ng-controller="Diamond" class="addreports-jumbo-page">
    <!-- Top Header Card (SaaS Ice-Blue Theme) -->
    <div class="reports-header-card">
        <div class="reports-header-left">
            <div class="reports-header-icon">
                <i class="fa fa-cubes"></i>
            </div>
            <div>
                <div class="reports-breadcrumb">
                    <a href="@Url.Action("Index", "Home")"><i class="fa fa-home"></i> Home</a> / 
                    <span>Slip</span> / 
                    <span>Jumbo Loss Report Management</span>
                </div>
                <h4 class="reports-header-title">Jumbo Loss Report Management</h4>
            </div>
        </div>
        <div>
            <span class="reports-header-badge">
                <i class="fa fa-cloud-upload"></i> 4 Upload Modules
            </span>
        </div>
    </div>

    <!-- 4 Jumbo Report Uploader Cards in Responsive Grid View -->
    <div class="row">
        <!-- 1. DATE WISE LOSS JUMBO REPORT -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
            <div class="report-uploader-card">
                <div class="report-card-header">
                    <div class="report-card-title-group">
                        <div class="report-card-icon-badge">
                            <i class="fa fa-calendar-check-o"></i>
                        </div>
                        <h4 class="report-card-title">Date Wise Loss Jumbo Report</h4>
                    </div>
                    <span class="badge-format-tag"><i class="fa fa-file-excel-o"></i> .xlsx</span>
                </div>
                <div class="report-card-body">
                    <div class="report-card-desc">
                        Upload and process date-wise jumbo loss summary records from Excel.
                    </div>
                    <div class="report-card-controls">
                        <div class="report-file-input-wrapper">
                            <input id="filename" type="file" accept=".xlsx" file-model="Planning.filename" ng-model="Diamond.filename" class="report-file-input" />
                        </div>
                        <button class="btn-report-upload" type="button" ng-click="Upload()">
                            <i class="fa fa-cloud-upload"></i> Upload
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. CLEAVING REPORT -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
            <div class="report-uploader-card">
                <div class="report-card-header">
                    <div class="report-card-title-group">
                        <div class="report-card-icon-badge">
                            <i class="fa fa-scissors"></i>
                        </div>
                        <h4 class="report-card-title">Cleaving Report</h4>
                    </div>
                    <span class="badge-format-tag"><i class="fa fa-file-excel-o"></i> .xlsx</span>
                </div>
                <div class="report-card-body">
                    <div class="report-card-desc">
                        Import kapan-wise cleaving report and diamond processing loss data.
                    </div>
                    <div class="report-card-controls">
                        <div class="report-file-input-wrapper">
                            <input id="filename2" type="file" accept=".xlsx" file-model="Planning.filename2" ng-model="Diamond.filename2" class="report-file-input" />
                        </div>
                        <button class="btn-report-upload" type="button" ng-click="Upload2()">
                            <i class="fa fa-cloud-upload"></i> Upload
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. DST REPORT -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
            <div class="report-uploader-card">
                <div class="report-card-header">
                    <div class="report-card-title-group">
                        <div class="report-card-icon-badge">
                            <i class="fa fa-cogs"></i>
                        </div>
                        <h4 class="report-card-title">DST Report</h4>
                    </div>
                    <span class="badge-format-tag"><i class="fa fa-file-excel-o"></i> .xlsx</span>
                </div>
                <div class="report-card-body">
                    <div class="report-card-desc">
                        Upload kapan-wise diamond DST stage processing metrics.
                    </div>
                    <div class="report-card-controls">
                        <div class="report-file-input-wrapper">
                            <input id="filename3" type="file" accept=".xlsx" file-model="Planning.filename3" ng-model="Diamond.filename3" class="report-file-input" />
                        </div>
                        <button class="btn-report-upload" type="button" ng-click="Upload3()">
                            <i class="fa fa-cloud-upload"></i> Upload
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- 4. MFG REPORT -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
            <div class="report-uploader-card">
                <div class="report-card-header">
                    <div class="report-card-title-group">
                        <div class="report-card-icon-badge">
                            <i class="fa fa-industry"></i>
                        </div>
                        <h4 class="report-card-title">MFG Report</h4>
                    </div>
                    <span class="badge-format-tag"><i class="fa fa-file-excel-o"></i> .xlsx</span>
                </div>
                <div class="report-card-body">
                    <div class="report-card-desc">
                        Import kapan-wise manufacturing (MFG) summary and yield reports.
                    </div>
                    <div class="report-card-controls">
                        <div class="report-file-input-wrapper">
                            <input id="filename4" type="file" accept=".xlsx" file-model="Planning.filename4" ng-model="Diamond.filename4" class="report-file-input" />
                        </div>
                        <button class="btn-report-upload" type="button" ng-click="Upload4()">
                            <i class="fa fa-cloud-upload"></i> Upload
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    var Paramdata = [{}];
    var ReturnLogID = 0;
    let IssueList = [];
    var module;
    try {
        module = angular.module('app');
    } catch (e) {
        module = angular.module('app', ['ngAnimate', 'ngTouch', 'ui.grid', 'ui.grid.edit', 'ui.grid.rowEdit', 'ui.grid.cellNav', 'ui.grid.selection', 'ui.grid.pagination', 'ui.grid.moveColumns', 'ui.grid.exporter', 'ui.grid.pinning', 'ui.grid.resizeColumns', 'angularjs-dropdown-multiselect']);
    }

    module.directive('chosen', function () {
        var linker = function (scope, element, attrs) {
            var list = attrs['chosen'];

            scope.$watch(list, function () {
                element.trigger('chosen:updated');
            });

            scope.$watch(attrs['ngModel'], function () {
                element.trigger('chosen:updated');
            });

            element.chosen();
        };

        return {
            restrict: 'A',
            link: linker
        };
    });

    module.controller("Diamond", ['$scope', '$filter', '$http', '$q', '$log', '$timeout', '$interval', 'uiGridConstants', function ($scope, $filter, $http, $q, $log, $timeout, $interval, uiGridConstants, $window) {
        $scope.Diamond = {};
        $scope.Planning = {};

        $scope.Upload = function () {
            var formData = new FormData();
            var file = document.getElementById('filename').files;

            if (file.length > 0) {
                for (var i = 0; i < file.length; i++) {
                    formData.append("excelFile", file[i]);
                }
                show_loader();

                $http({
                    method: 'POST',
                    url: '@Url.Action("Jumbo_Date_Wise_Loss_Summary_Insert_Using_Excel", "Slip")',
                    headers: { 'Content-Type': undefined },
                    data: formData,
                    contentType: false,
                    processData: false,
                }).then(function (ret) {
                    hide_loader();
                    if (ret.data && ret.data.Message == "Record Is Inserted") {
                        Noty("success", ret.data.Message);
                        document.getElementById('filename').value = "";
                    } else {
                        Noty("error", (ret.data && ret.data.Message) ? ret.data.Message : "Failed to upload file.");
                    }
                }, function () {
                    hide_loader();
                    Noty("error", "Error connecting to server.");
                });
            } else {
                Noty("error", "Please select an Excel file to upload.");
            }
        };

        $scope.Upload2 = function () {
            var formData = new FormData();
            var file = document.getElementById('filename2').files;

            if (file.length > 0) {
                for (var i = 0; i < file.length; i++) {
                    formData.append("excelFile", file[i]);
                }
                show_loader();

                $http({
                    method: 'POST',
                    url: '@Url.Action("Kapan_Wise_Cleaving_Report_Insert_Using_Excel", "Slip")',
                    headers: { 'Content-Type': undefined },
                    data: formData,
                    contentType: false,
                    processData: false,
                }).then(function (ret) {
                    hide_loader();
                    if (ret.data && ret.data.Message == "Record Is Inserted") {
                        Noty("success", ret.data.Message);
                        document.getElementById('filename2').value = "";
                    } else {
                        Noty("error", (ret.data && ret.data.Message) ? ret.data.Message : "Failed to upload file.");
                    }
                }, function () {
                    hide_loader();
                    Noty("error", "Error connecting to server.");
                });
            } else {
                Noty("error", "Please select an Excel file to upload.");
            }
        };

        $scope.Upload3 = function () {
            var formData = new FormData();
            var file = document.getElementById('filename3').files;

            if (file.length > 0) {
                for (var i = 0; i < file.length; i++) {
                    formData.append("excelFile", file[i]);
                }
                show_loader();

                $http({
                    method: 'POST',
                    url: '@Url.Action("Kapan_Wise_DST_Report_Insert_Using_Excel", "Slip")',
                    headers: { 'Content-Type': undefined },
                    data: formData,
                    contentType: false,
                    processData: false,
                }).then(function (ret) {
                    hide_loader();
                    if (ret.data && ret.data.Message == "Record Is Inserted") {
                        Noty("success", ret.data.Message);
                        document.getElementById('filename3').value = "";
                    } else {
                        Noty("error", (ret.data && ret.data.Message) ? ret.data.Message : "Failed to upload file.");
                    }
                }, function () {
                    hide_loader();
                    Noty("error", "Error connecting to server.");
                });
            } else {
                Noty("error", "Please select an Excel file to upload.");
            }
        };

        $scope.Upload4 = function () {
            var formData = new FormData();
            var file = document.getElementById('filename4').files;

            if (file.length > 0) {
                for (var i = 0; i < file.length; i++) {
                    formData.append("excelFile", file[i]);
                }
                show_loader();

                $http({
                    method: 'POST',
                    url: '@Url.Action("Kapan_Wise_MFG_Report_Insert_Using_Excel", "Slip")',
                    headers: { 'Content-Type': undefined },
                    data: formData,
                    contentType: false,
                    processData: false,
                }).then(function (ret) {
                    hide_loader();
                    if (ret.data && ret.data.Message == "Record Is Inserted") {
                        Noty("success", ret.data.Message);
                        document.getElementById('filename4').value = "";
                    } else {
                        Noty("error", (ret.data && ret.data.Message) ? ret.data.Message : "Failed to upload file.");
                    }
                }, function () {
                    hide_loader();
                    Noty("error", "Error connecting to server.");
                });
            } else {
                Noty("error", "Please select an Excel file to upload.");
            }
        };
    }]);
</script>