@{
    ViewBag.Title = "Vipulbhai";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}


<div ng-controller="Diamond" class="vipulbhai-page">
    <!-- Top Header Card (SaaS Ice-Blue Theme) -->
    <div class="vipul-header-card">
        <div class="vipul-header-left">
            <div class="vipul-header-icon">
                <i class="fa fa-diamond"></i>
            </div>
            <div>
                <div class="vipul-breadcrumb">
                    <a href="@Url.Action("Index", "Home")"><i class="fa fa-home"></i> Home</a> / 
                    <span>Slip</span> / 
                    <span>Vipulbhai</span>
                </div>
                <h4 class="vipul-header-title">Vipulbhai</h4>
            </div>
        </div>
        <div>
            <!-- Add New Record Button -->
            <button class="btn-vipul-add" type="button" ng-click="OpenPopUpMenu()">
                <i class="fa fa-plus"></i> NEW ENTRY
            </button>
        </div>
    </div>

    <!-- DevExtreme DataGrid Card -->
    <div class="vipul-grid-card">
        <div class="vipul-card-header">
            <div class="vipul-card-title-left">
                <i class="fa fa-table"></i>
                <h3>Vipulbhai Records</h3>
            </div>
        </div>

        <div class="vipul-grid-body">
            <div class="uigrid">
                <div id="gIDContainer" style="width: 100%;"></div>
            </div>
        </div>
    </div>

    <!-- Modal Popup for Add / Edit (Clean SaaS Dialog Style) -->
    <div class="modal fade" id="FetchFilterPopUp" role="dialog" aria-labelledby="exampleModalCenterTitle" data-backdrop="static">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <!-- Sleek Header (Strict Left Title & Right X Button) -->
                <div class="modal-header">
                    <div class="modal-header-flex">
                        <div class="modal-header-title-left">
                            <i class="fa fa-diamond" style="color: #38bdf8; font-size: 16px;"></i>
                            <h4 class="modal-title">Vipulbhai Entry</h4>
                        </div>
                        <button type="button" ng-click="ClosePopupFilterDetails();" class="btn-close-header" data-dismiss="modal">&times;</button>
                    </div>
                </div>

                <div class="modal-body">
                    <!-- Form Controls Section -->
                    <div class="vipul-modal-section">
                        <div class="row">
                            <!-- Date -->
                            <div class="col-md-3 col-sm-6 col-xs-12" style="margin-bottom: 12px;">
                                <label class="vipul-form-label" for="Date">Date <span class="req">*</span></label>
                                <input id="Date" type="text" tabindex="1" class="vipul-input" placeholder="dd-M-yyyy" autocomplete="off" ng-model="Diamond.Date" readonly />
                            </div>

                            <!-- SizeCode -->
                            <div class="col-md-2 col-sm-6 col-xs-12" style="margin-bottom: 12px;">
                                <label class="vipul-form-label" for="SizeCode">SizeCode <span class="req">*</span></label>
                                <select id="SizeCode" chosen="SizeCode" tabindex="2" class="vipul-input" ng-model="Diamond.SizeCode">
                                    <option value="">Select SizeCode</option>
                                    <option value="JW">JW</option>
                                    <option value="JC">JC</option>
                                    <option value="SW">SW</option>
                                    <option value="SC">SC</option>
                                </select>
                            </div>

                            <!-- Status -->
                            <div class="col-md-3 col-sm-6 col-xs-12" style="margin-bottom: 12px;">
                                <label class="vipul-form-label" for="Status">Status <span class="req">*</span></label>
                                <select id="Status" chosen="Status" tabindex="3" class="vipul-input" ng-model="Diamond.Status">
                                    <option value="">Select Status</option>
                                    <option value="TODAY">TODAY</option>
                                    <option value="TOTAL">TOTAL</option>
                                    <option value="AVAILABLE">AVAILABLE</option>
                                </select>
                            </div>

                            <!-- VipulBhai -->
                            <div class="col-md-2 col-sm-6 col-xs-12" style="margin-bottom: 12px;">
                                <label class="vipul-form-label" for="VipulBhai">VipulBhai <span class="req">*</span></label>
                                <input type="number" id="VipulBhai" ng-model="Diamond.VipulBhai" placeholder="Enter VipulBhai" tabindex="4" class="vipul-input" />
                            </div>

                            <!-- Add Button -->
                            <div class="col-md-2 col-sm-6 col-xs-12" style="margin-top: 26px; display: flex; align-items: flex-end;">
                                <button class="btn-vipul-add-row" tabindex="5" type="button" ng-click="AddRowData()" style="width: 100%; justify-content: center;">
                                    <i class="fa fa-plus"></i> Add
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Inner DataGrid Section -->
                    <div class="vipul-modal-grid-wrap">
                        <div class="uigrid3">
                            <div id="gridContainer"></div>
                        </div>
                    </div>
                </div>

                <!-- Clean Actions Footer -->
                <div class="modal-footer">
                    <button class="btn-vipul-reset" tabindex="7" ng-click="Clear()" type="button">
                        <i class="fa fa-refresh"></i> Reset
                    </button>
                    <button class="btn-vipul-save" tabindex="6" type="button" ng-click="DataSave()">
                        <i class="fa fa-check"></i> {{BtnName}}
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    var Action = "INSERT";
    var List = [];
    var DataField = [];
    var DataSummary = [];
    var IssueList = [];

    var module;
    try {
        module = angular.module('app');
    } catch (e) {
        module = angular.module('app', ['ngTouch']);
    }

    module.directive('chosen', function () {
        var linker = function (scope, element, attrs) {
            scope.$watch(attrs['ngModel'], function () {
                element.trigger('chosen:updated');
            });

            element.chosen();
        };

        return {
            restrict: 'A',
            link: linker
        };
    });

    module.controller("Diamond", ['$scope', '$filter', '$http', '$q', '$interval', function ($scope, $filter, $http, $q, $interval) {
        $scope.Diamond = {
            Date: "",
            SizeCode: "",
            Status: "",
            VipulBhai: "",
            DeleteButton: false
        };

        $scope.BtnName = "SAVE";

        $scope.ClosePopupFilterDetails = function () {
            $("#FetchFilterPopUp").modal("hide");
        }

        window.onkeyup = function (event) {
            if (event.keyCode == 27) {
                $("#FetchFilterPopUp").modal("hide");
                $("#FetchDeleteFilterPopUp").modal("hide");
            }
        }

        $scope.OpenPopUpMenu = function () {
            $scope.Clear();
            $("#FetchFilterPopUp").modal("show");
            setTimeout(function () {
                if (typeof initModalDatePicker === 'function') {
                    initModalDatePicker();
                }
            }, 120);
        };

        $scope.FetchData = function () {
            show_loader();
            $http.post('@Url.Action("Daily_RP_Rough_Polish_GetData", "Slip")', JSON.stringify({ Type : 'ROUGH' }))
                .then(function (response) {
                    hide_loader();

                    if (!response.data) {
                        console.error('No data received from server');
                        Noty("error", "No data received from server");
                        return;
                    }

                    List = response.data.List || [];
                    DataSummary = response.data.DataSummary || [];
                    DataField = response.data.DataField || [];

                    GIDData();
                })
                .catch(function (error) {
                    hide_loader();
                    console.error('Error fetching data:', error);
                    Noty("error", "Error loading data. Please try again.");
                });
        };

        $scope.FetchData();

        const GIDData = () => {
            $("#gIDContainer").dxDataGrid({
                dataSource: new DevExpress.data.CustomStore({
                    load: function () {
                        return List;
                    },
                    remove: function (key) {
                        return $scope.deleteEntry(key);
                    },
                }),
                columns: DataField,
                editing: {
                    allowUpdating: false,
                    allowDeleting: true,
                    useIcons: true,
                },
                keyExpr: 'ID',
                columnAutoWidth: true,
                allowColumnResizing: true,
                columnResizingMode: 'widget',
                allowColumnReordering: true,
                showColumnLines: true,
                showRowLines: true,
                showBorders: true,
                height: 'calc(100vh - 210px)',
                paging: { enabled: false },
                sorting: { mode: "multiple" },
                scrolling: {
                    mode: 'virtual',
                },
                filterRow: {
                    visible: true,
                    applyFilter: 'auto',
                },
                filterPanel: { visible: true },
                searchPanel: {
                    visible: true,
                    width: 240,
                    placeholder: 'Search...',
                },
                loadPanel: {
                    enabled: true,
                    showPane: false,
                    indicatorSrc: '/Content/icons/Loader.gif',
                },
                headerFilter: {
                    visible: true,
                },
                pager: {
                    visible: false,
                },
                selection: {
                    mode: 'single',
                },
                keyboardNavigation: {
                    enterKeyAction: 'moveFocus',
                    enterKeyDirection: 'column',
                    editOnKeyPress: true,
                },
                summary: {
                    totalItems: DataSummary
                },
                export: {
                    enabled: true,
                    formats: ['xlsx'],
                    allowExportSelectedData: false,
                },
                onExporting(e) {
                    if (e.format == 'xlsx') {
                        const workbook = new ExcelJS.Workbook();
                        const worksheet = workbook.addWorksheet('Vipulbhai');

                        DevExpress.excelExporter.exportDataGrid({
                            component: e.component,
                            worksheet,
                            autoFilterEnabled: true,
                        }).then(() => {
                            workbook.xlsx.writeBuffer().then((buffer) => {
                                saveAs(new Blob([buffer], { type: 'application/octet-stream' }), 'Vipulbhai.xlsx');
                            });
                        });
                    }
                },
            });
        }

        $scope.AddRowData = function () {
            if ($scope.Diamond.Date === "" || $scope.Diamond.Date === null || $scope.Diamond.Date === undefined) {
                Noty("error", "Please Select Date!");
                return false;
            }
            if ($scope.Diamond.SizeCode === "" || $scope.Diamond.SizeCode === null || $scope.Diamond.SizeCode === undefined) {
                Noty("error", "Please Enter Valid SizeCode!");
                return false;
            }
            if ($scope.Diamond.Status === "" || $scope.Diamond.Status === null || $scope.Diamond.Status === undefined) {
                Noty("error", "Please Enter Valid Status!");
                return false;
            }
            if ($scope.Diamond.VipulBhai === "" || $scope.Diamond.VipulBhai === null || $scope.Diamond.VipulBhai === undefined) {
                Noty("error", "Please Enter VipulBhai!");
                return false;
            }

            var StatusCheck = IssueList.filter(x => x.Status == $scope.Diamond.Status && x.SizeCode == $scope.Diamond.SizeCode).length;
            if (StatusCheck > 0) {
                Noty("error", "SizeCode & Status Data Already Exists!");
                return false;
            }

            IssueList.push({
                'Key': Math.random(),
                'ReportDate': $scope.Diamond.Date,
                'SizeCode': $scope.Diamond.SizeCode,
                'Status': $scope.Diamond.Status,
                'RoughWeight': 0,
                'VipulBhai': $scope.Diamond.VipulBhai,
            });

            document.getElementById('Date').disabled = true;

            GridData();

            $scope.Diamond.Status = "";
            $scope.Diamond.VipulBhai = "";

            document.getElementById('Status').focus();
        }

        const GridData = () => {
            $("#gridContainer").dxDataGrid({
                dataSource: new DevExpress.data.CustomStore({
                    load: function () {
                        return IssueList;
                    },
                    remove: function (key) {
                        return $scope.deleteData(key);
                    },
                }),
                columns: [{
                    type: "buttons",
                    buttons: [{
                        name: "delete",
                    }]
                }, 'ReportDate', 'SizeCode', 'Status', 'VipulBhai'],
                editing: {
                    allowDeleting: true,
                    useIcons: true,
                },
                columnAutoWidth: true,
                columnResizingMode: 'widget',
                allowColumnResizing: true,
                showColumnLines: true,
                showRowLines: true,
                rowAlternationEnabled: true,
                showBorders: true,
                height: "100%",
                paging: { enabled: false },
                sorting: { mode: "multiple" },
                scrolling: {
                    mode: 'virtual',
                },
                loadPanel: {
                    enabled: true,
                    showPane: false,
                    indicatorSrc: '/Content/icons/Loader.gif',
                },
                headerFilter: {
                    visible: true,
                },
                pager: {
                    visible: false,
                },
                selection: {
                    mode: 'single',
                },
                keyboardNavigation: {
                    enterKeyAction: 'moveFocus',
                    enterKeyDirection: 'column',
                    editOnKeyPress: true,
                },
                summary: {
                    totalItems: [
                        { column: 'Status', summaryType: 'count' },
                        { column: 'VipulBhai', summaryType: 'sum' }
                    ]
                },
            });
        }

        GridData();

        $scope.deleteData = function (key) {
            IssueList = IssueList.filter(item => item.Key !== key.Key);

            if (IssueList.length == 0) {
                $scope.Diamond.Date = "";
                document.getElementById('Date').disabled = false;
            }
        }

        $scope.DataSave = function () {
            try {
                if (IssueList.length == 0) {
                    Noty("error", "Please Enter Some Entry!");
                    return false;
                }

                show_loader();

                $http({
                    method: "post",
                    url: '@Url.Action("Daily_RP_Rough_Polish_Insert_Update_Delete", "Slip")',
                    data: { IssueList: IssueList, Action: Action, Type: "ROUGH" },
                    headers: { 'Content-Type': 'application/json' }
                }).then(function (ret) {
                    hide_loader();
                    if (ret.data.Message == "Record Is Inserted" || ret.data.Message == "Record Is Updated") {
                        Noty("success", "Data Saved Successfully!");

                        $scope.FetchData();

                        setTimeout(() => {
                            $scope.Clear();
                            $("#FetchFilterPopUp").modal("hide");
                        }, 100);
                    }
                    else {
                        Noty("error", ret.data.Message);
                    }
                })
                .catch(function (error) {
                    hide_loader();
                    console.error('Error saving data:', error);
                    Noty("error", "Error saving data. Please try again.");
                });
            } catch (ex) {
                hide_loader();
                console.error('Exception in DataSave:', ex);
                Noty("error", "An error occurred. Please try again.");
                return false;
            }
        }

        $scope.deleteEntry = function (key) {
            try {
                show_loader();

                let deleteList = [];
                deleteList.push(key);

                $http({
                    method: "post",
                    url: '@Url.Action("Daily_RP_Rough_Polish_Insert_Update_Delete", "Slip")',
                    data: { IssueList: deleteList, Action: 'DELETE', Type: "ROUGH" },
                    headers: { 'Content-Type': 'application/json' }
                }).then(function (ret) {
                    hide_loader();
                    if (ret.data.Message == "Record Is Deleted") {
                        Noty("success", "Data Deleted Successfully!");
                        $scope.FetchData();
                    }
                    else {
                        Noty("error", ret.data.Message);
                    }
                })
                .catch(function (error) {
                    hide_loader();
                    console.error('Error deleting data:', error);
                    Noty("error", "Error saving data. Please try again.");
                });
            } catch (ex) {
                hide_loader();
                console.error('Exception in DataSave:', ex);
                Noty("error", "An error occurred. Please try again.");
                return false;
            }
        }

        $scope.Clear = function () {
            $scope.BtnName = "SAVE";
            Action = "INSERT";

            IssueList = [];
            GridData();

            $scope.Diamond = {
                Date: "",
                SizeCode: "",
                Status: "",
                VipulBhai: "",
            };
            document.getElementById('Date').disabled = false;

            setTimeout(() => {
                $("#SizeCode").val("").trigger("chosen:updated");
                $("#Status").val("").trigger("chosen:updated");
            }, 50);
        };
    }]);
</script>
<script>
    function initModalDatePicker() {
        try {
            $('#Date').datepicker('destroy');
        } catch (e) { }

        $('#Date').datepicker({
            format: "dd-M-yyyy",
            autoclose: true,
            todayHighlight: true,
            container: 'body',
            orientation: "bottom auto"
        }).on('changeDate', function (e) {
            var val = $(this).val();
            var scope = angular.element(document.querySelector('[ng-controller="Diamond"]')).scope();
            if (scope && scope.Diamond) {
                scope.$apply(function () {
                    scope.Diamond.Date = val;
                });
            }
        });
    }

    $(document).ready(function () {
        initModalDatePicker();

        $('#FetchFilterPopUp').on('shown.bs.modal', function () {
            initModalDatePicker();
        });

        $('#FetchFilterPopUp').on('hidden.bs.modal', function () {
            try {
                $('#Date').datepicker('hide');
            } catch (e) { }
        });

        // Ensure clicking or tapping immediately opens the datepicker
        $(document).on('click focus touchstart', '#Date', function (e) {
            if (!$(this).prop('disabled')) {
                $(this).datepicker('show');
            }
        });
    });
</script>