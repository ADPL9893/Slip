@{
    ViewBag.Title = "Add Reports";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* ==========================================================================
       Add Reports / Loss Report Management - SaaS Card View & Ice Blue Theming
       ========================================================================== */
    @@keyframes fadeInUpSmooth {
        from {
            opacity: 0;
            transform: translateY(10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .addreports-page {
        padding: 0 0 20px 0;
        margin-top: -10px;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    }

    /* Staggered Entrance Animation */
    .reports-header-card { animation: fadeInUpSmooth 0.35s cubic-bezier(0.16, 1, 0.3, 1) 0.05s both; }
    .report-uploader-card { animation: fadeInUpSmooth 0.35s cubic-bezier(0.16, 1, 0.3, 1) 0.12s both; }

    /* Page Header Card */
    .reports-header-card {
        background: #ffffff !important;
        border-radius: 12px !important;
        padding: 14px 20px !important;
        margin-bottom: 18px !important;
        box-shadow: 0 2px 10px rgba(15, 23, 42, 0.04) !important;
        border: 1.5px solid #cbd5e1 !important;
        border-left: 5px solid #0284c7 !important;
        display: flex !important;
        justify-content: space-between !important;
        align-items: center !important;
        flex-wrap: wrap !important;
        gap: 12px !important;
        transition: all 0.25s ease !important;
    }
    .reports-header-card:hover {
        box-shadow: 0 6px 18px rgba(15, 23, 42, 0.08) !important;
        border-color: #94a3b8 !important;
        border-left-color: #0369a1 !important;
    }

    .reports-header-left {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .reports-header-icon {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        box-shadow: 0 4px 12px rgba(2, 132, 199, 0.28);
        transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
        flex-shrink: 0;
    }
    .reports-header-card:hover .reports-header-icon {
        transform: scale(1.08) rotate(4deg);
    }

    .reports-header-title {
        font-size: 18px !important;
        font-weight: 700 !important;
        color: #0f172a !important;
        margin: 0 !important;
        line-height: 1.2 !important;
        letter-spacing: -0.2px;
    }

    .reports-breadcrumb {
        font-size: 11.5px;
        color: #64748b;
        margin-bottom: 3px;
        font-weight: 500;
    }
    .reports-breadcrumb a {
        color: #0284c7;
        text-decoration: none;
        transition: color 0.15s ease;
        font-weight: 500;
    }
    .reports-breadcrumb a:hover {
        color: #0369a1;
        text-decoration: underline;
    }

    .reports-header-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 14px;
        background: #f0f9ff;
        color: #0369a1;
        border: 1.5px solid #bae6fd;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
    }

    /* Individual Report Uploader Card */
    .report-uploader-card {
        background: #ffffff !important;
        border-radius: 12px !important;
        border: 1.5px solid #cbd5e1 !important;
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04) !important;
        transition: all 0.25s ease !important;
        margin-bottom: 20px !important;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        overflow: hidden;
    }
    .report-uploader-card:hover {
        border-color: #0284c7 !important;
        box-shadow: 0 8px 22px rgba(2, 132, 199, 0.12) !important;
        transform: translateY(-2px);
    }

    .report-card-header {
        padding: 14px 18px !important;
        background: #f8fafc !important;
        border-bottom: 1.5px solid #e2e8f0 !important;
        display: flex !important;
        align-items: center !important;
        justify-content: space-between !important;
        gap: 10px !important;
    }

    .report-card-title-group {
        display: flex;
        align-items: center;
        gap: 11px;
    }

    .report-card-icon-badge {
        width: 36px;
        height: 36px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        flex-shrink: 0;
        background: #e0f2fe;
        color: #0284c7;
        border: 1px solid #bae6fd;
    }
    .report-uploader-card:hover .report-card-icon-badge {
        background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
        color: #ffffff;
        border-color: transparent;
    }

    .report-card-title {
        margin: 0 !important;
        font-size: 14.5px !important;
        font-weight: 700 !important;
        color: #0f172a !important;
        letter-spacing: -0.1px;
    }

    .badge-format-tag {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 3px 9px;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 700;
        background: #ecfdf5;
        color: #047857;
        border: 1px solid #a7f3d0;
        text-transform: uppercase;
        letter-spacing: 0.3px;
    }

    .report-card-body {
        padding: 16px 18px 18px 18px !important;
        background: #ffffff !important;
    }

    .report-card-desc {
        font-size: 12px;
        color: #64748b;
        margin-bottom: 14px;
        line-height: 1.4;
    }

    .report-card-controls {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .report-file-input-wrapper {
        flex: 1;
        min-width: 200px;
    }

    .report-file-input {
        width: 100%;
        height: 38px;
        padding: 6px 10px;
        font-size: 12px;
        color: #334155;
        background: #f8fafc;
        border: 1.5px solid #cbd5e1;
        border-radius: 8px;
        outline: none;
        transition: all 0.2s ease;
        display: flex;
        align-items: center;
    }
    .report-file-input:focus,
    .report-file-input:hover {
        border-color: #0284c7;
        background: #ffffff;
    }

    .btn-report-upload {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%) !important;
        color: #ffffff !important;
        border: none !important;
        border-radius: 8px !important;
        padding: 9px 20px !important;
        font-size: 12.5px !important;
        font-weight: 700 !important;
        display: inline-flex !important;
        align-items: center !important;
        gap: 7px !important;
        box-shadow: 0 3px 10px rgba(16, 185, 129, 0.3) !important;
        transition: all 0.2s cubic-bezier(0.34, 1.56, 0.64, 1) !important;
        cursor: pointer !important;
        white-space: nowrap;
        text-decoration: none !important;
        height: 38px;
    }
    .btn-report-upload:hover {
        background: linear-gradient(135deg, #059669 0%, #047857 100%) !important;
        transform: translateY(-1px) !important;
        box-shadow: 0 6px 16px rgba(16, 185, 129, 0.4) !important;
        color: #ffffff !important;
    }
    .btn-report-upload:active {
        transform: translateY(0) !important;
    }

    /* Responsive Design */
    @@media (max-width: 768px) {
        .reports-header-card {
            flex-direction: column !important;
            align-items: stretch !important;
            padding: 12px 14px !important;
            gap: 12px !important;
        }

        .reports-header-left {
            width: 100%;
        }

        .reports-header-badge {
            align-self: flex-start;
        }

        .report-card-controls {
            flex-direction: column;
            align-items: stretch;
        }

        .report-file-input-wrapper {
            width: 100%;
            min-width: 100%;
        }

        .btn-report-upload {
            width: 100% !important;
            justify-content: center !important;
        }
    }
</style>

<div ng-controller="Diamond" class="addreports-page">
