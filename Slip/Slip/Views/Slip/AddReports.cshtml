<script>
    var Paramdata = [{}];
    var ReturnLogID = 0;
    let IssueList = [];
    var module;
    try {
        module = angular.module('app');
    } catch (e) {
        module = angular.module('app', ['ngAnimate', 'ngTouch', 'ui.grid', 'ui.grid.edit', 'ui.grid.rowEdit', 'ui.grid.cellNav', 'ui.grid.selection', 'ui.grid.pagination', 'ui.grid.moveColumns', 'ui.grid.exporter', 'ui.grid.pinning', 'ui.grid.resizeColumns', 'angularjs-dropdown-multiselect']);
    }

    module.directive('chosen', function () {
        var linker = function (scope, element, attrs) {
            var list = attrs['chosen'];

            scope.$watch(list, function () {
                element.trigger('chosen:updated');
            });

            scope.$watch(attrs['ngModel'], function () {
                element.trigger('chosen:updated');
            });

            element.chosen();
        };

        return {
            restrict: 'A',
            link: linker
        };
    });

    module.controller("Diamond", ['$scope', '$filter', '$http', '$q', '$log', '$timeout', '$interval', 'uiGridConstants', function ($scope, $filter, $http, $q, $log, $timeout, $interval, uiGridConstants, $window) {
        $scope.Diamond = {};
        $scope.Planning = {};

        $scope.DailyUpload = function () {
            var formData = new FormData();
            var file = document.getElementById('field').files;

            if (file.length > 0) {
                for (var i = 0; i < file.length; i++) {
                    formData.append("excelFile", file[i]);
                }
                show_loader();

                $http({
                    method: 'POST',
                    url: '@Url.Action("Daily_Report_Insert_Using_Excel", "Slip")',
                    headers: { 'Content-Type': undefined },
                    data: formData,
                    contentType: false,
                    processData: false,
                }).then(function (ret) {
                    hide_loader();
                    if (ret.data && ret.data.Message == "Record Is Inserted") {
                        Noty("success", ret.data.Message);
                        document.getElementById('field').value = "";
                    } else {
                        Noty("error", (ret.data && ret.data.Message) ? ret.data.Message : "Failed to upload daily report.");
                    }
                }, function () {
                    hide_loader();
                    Noty("error", "Error connecting to server.");
                });
            } else {
                Noty("error", "Please select an Excel file to upload.");
            }
        };

        $scope.Upload = function () {
            var formData = new FormData();
            var file = document.getElementById('filename').files;

            if (file.length > 0) {
                for (var i = 0; i < file.length; i++) {
                    formData.append("excelFile", file[i]);
                }
                show_loader();

                $http({
                    method: 'POST',
                    url: '@Url.Action("RoughTo4POk_Loss_Insert_Using_Excel", "Slip")',
                    headers: { 'Content-Type': undefined },
                    data: formData,
                    contentType: false,
                    processData: false,
                }).then(function (ret) {
                    hide_loader();
                    if (ret.data && ret.data.Message == "Record Is Inserted") {
                        Noty("success", ret.data.Message);
                        document.getElementById('filename').value = "";
                    } else {
                        Noty("error", (ret.data && ret.data.Message) ? ret.data.Message : "Failed to upload file.");
                    }
                }, function () {
                    hide_loader();
                    Noty("error", "Error connecting to server.");
                });
            } else {
                Noty("error", "Please select an Excel file to upload.");
            }
        };

        $scope.Upload2 = function () {
            var formData = new FormData();
            var file = document.getElementById('filename2').files;

            if (file.length > 0) {
                for (var i = 0; i < file.length; i++) {
                    formData.append("excelFile", file[i]);
                }
                show_loader();

                $http({
                    method: 'POST',
                    url: '@Url.Action("After4POk_Loss_Insert_Using_Excel", "Slip")',
                    headers: { 'Content-Type': undefined },
                    data: formData,
                    contentType: false,
                    processData: false,
                }).then(function (ret) {
                    hide_loader();
                    if (ret.data && ret.data.Message == "Record Is Inserted") {
                        Noty("success", ret.data.Message);
                        document.getElementById('filename2').value = "";
                    } else {
                        Noty("error", (ret.data && ret.data.Message) ? ret.data.Message : "Failed to upload file.");
                    }
                }, function () {
                    hide_loader();
                    Noty("error", "Error connecting to server.");
                });
            } else {
                Noty("error", "Please select an Excel file to upload.");
            }
        };

        $scope.Upload3 = function () {
            var formData = new FormData();
            var file = document.getElementById('filename3').files;

            if (file.length > 0) {
                for (var i = 0; i < file.length; i++) {
                    formData.append("excelFile", file[i]);
                }
                show_loader();

                $http({
                    method: 'POST',
                    url: '@Url.Action("Process_Wise_Timing_Insert_Using_Excel", "Slip")',
                    headers: { 'Content-Type': undefined },
                    data: formData,
                    contentType: false,
                    processData: false,
                }).then(function (ret) {
                    hide_loader();
                    if (ret.data && ret.data.Message == "Record Is Inserted") {
                        Noty("success", ret.data.Message);
                        document.getElementById('filename3').value = "";
                    } else {
                        Noty("error", (ret.data && ret.data.Message) ? ret.data.Message : "Failed to upload file.");
                    }
                }, function () {
                    hide_loader();
                    Noty("error", "Error connecting to server.");
                });
            } else {
                Noty("error", "Please select an Excel file to upload.");
