                    <span>Loss Report Management</span>
                </div>
                <h4 class="reports-header-title">Loss Report Management</h4>
            </div>
        </div>
        <div>
            <span class="reports-header-badge">
                <i class="fa fa-cloud-upload"></i> 8 Upload Modules
