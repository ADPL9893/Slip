
@{
    ViewBag.Title = "DSTReport";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}
<div ng-controller="Diamond">
    <div class="page-title">
        <div class="col-lg-12">
            <div class="col-lg-2">
                <h5><a href="@Url.Action("Index", "Home")"><i class="fa fa-home fa-lg"></i>&nbsp;Home</a></h5>
            </div>
            <div class="col-lg-10">
                <div class="col-lg-2 col-lg-offset-1" style="margin-top: 3px;">
                    <input id="reportDate" type="text" class="form-control input-sm" placeholder="dd-MMM-yyyy" autocomplete="off" ng-model="Diamond.reportDate" readonly />
                </div>
                <div class="col-lg-1">
                    <button class="btn btn-primary" ng-click="FetchData('RUNNING')">Fetch</button>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="well bs-component">
                    <legend class="font-green-sharp">
                        <b style="position:absolute">DST Summary</b>
                        <div align="right">
                            &nbsp;@*<a class="btn btn-primary" ng-click="ExcelExport()">Excel</a>*@
                        </div>
                    </legend>
                    <div class="card-body">
                        <div style="padding:0 !important">
                            <div class="tabs">
                                <div class="tab active" data-tab="RUNNING">1.RUNNING</div>
                                <div class="tab" data-tab="COMPLETE">2.COMPLETE</div>
                            </div>
                        </div>
                        <div class="uigrid">
                            <div id="gridContainer"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    var List = "";
    var DataField = "";
    module = angular.module('app', ['ngTouch', 'ui.grid', 'ui.grid.edit', 'ui.grid.rowEdit', 'ui.grid.cellNav', 'ui.grid.pagination', 'ui.grid.moveColumns', 'ui.grid.exporter', 'ui.grid.pinning', 'ui.grid.resizeColumns', 'angularjs-dropdown-multiselect']);
    module.directive('chosen', function () {
        var linker = function (scope, element, attrs) {
            var list = attrs['chosen'];

            scope.$watch(list, function () {
                element.trigger('chosen:updated');
            });

            scope.$watch(attrs['ngModel'], function () {
                element.trigger('chosen:updated');
            });

            element.chosen();
        };

        return {
            restrict: 'A',
            link: linker
        };
    });
    module.controller("Diamond", ['$scope', '$filter', '$http', '$q', '$interval', 'uiGridConstants', function ($scope, $filter, $http, $q, $interval, uiGridConstants, $window) {
        $scope.Diamond = {};
        $scope.MainRCodemodel = [];
        $scope.MainRCodeSettings = { enableSearch: true, externalIdProp: '' };

        debugger
        $('#reportDate').datepicker({
            format: "dd-M-yyyy",
            autoclose: true,
            todayHighlight: true,
            endDate: '1d'
        });

        $('#reportDate').datepicker('setDate', '-1d');

        $scope.Diamond.reportDate = $('#reportDate').val();

        $('#reportDate').on('changeDate', function (e) {
            debugger
            $scope.$apply(function () {
                $scope.Diamond.reportDate = $('#reportDate').val();
            });
        });

        var columnsData = [];
        var SummaryData = [];

        let tabType = "RUNNING";
        let currentView = "RUNNING";

        $('.tab').on('click', async function () {
            var tabType = $(this).data('tab');

            // Update active tab
            $('.tab').removeClass('active');
            $(this).addClass('active');


            // Switch grid view
            if (tabType === 'RUNNING') {
                currentView = 'RUNNING';
                //$(".hide1").show();
                //$(".hide2").hide();
                //dataSelect = false;
                await $scope.setColumn();
                await $scope.FetchData("RUNNING");
            } else if (tabType === 'COMPLETE') {
                currentView = 'COMPLETE';
                //$(".hide2").show();
                //$(".hide1").hide();
                //dataSelectDetails = false;
                await $scope.setColumn();
                await $scope.FetchData("COMPLETE")
            }
        });

        $scope.setColumn = function () {
            if (currentView == 'RUNNING') {

                columnsData = [{
                    caption: $('#reportDate').val(),
                    alignment: "center",
                    columns:
                        [
                            {
                                caption: "Main Rough",
                                alignment: "center",
                                fixed: true,
                                columns:
                                    [
                                        { dataField: "MainRDate", caption: "Date", dataType: "date", format: "dd/MM/yyyy", visible: false },
                                        {
                                            dataField: "MainRCode",
                                            caption: "MainRCode",
                                            groupIndex: 0, // Enable grouping by this column
                                            groupCellTemplate: function (element, options) {
                                                // Extracting data from the first item in the group
                                                debugger
                                                const data = options.data.items ? options.data.items[0] : (options.data.collapsedItems ? options.data.collapsedItems[0] : {});
                                                const dateStr = data.MainRDate ? new Date(data.MainRDate).toLocaleDateString('en-GB') : '';

                                                const template = $(`
                                                    <div style="color: #1e3c72; font-weight: bold; font-size: 14px; display: flex; gap: 20px;">
                                                        <span>📅 ${dateStr}</span>
                                                        <span>| 📦 CODE: ${options.value}</span>
                                                        <span>| 🍳 RECIPE: ${data.MainReceipe || '-'}</span>
                                                        <span style="margin-left: auto; color: #d9534f;">💎 MAIN PCS: ${parseInt(data.MainPcs || 0)}</span>
                                                        <span style="color: #d9534f; margin-right: 20px;">⚖️ MAIN CARAT: ${parseFloat(data.MainCarat || 0).toFixed(3)}</span>
                                                    </div>
                                                `);
                                                element.append(template);
                                            }
                                        },
                                        { dataField: "MainReceipe", caption: "Receipe", dataType: "string", visible: false },
                                        { dataField: "MainPcs", caption: "Pcs", dataType: "number", visible: false },
                                        { dataField: "MainCarat", caption: "Carat", dataType: "number", visible: false },
                                    ]
                            },
                            {
                                caption: "Kapan",
                                alignment: "center",
                                columns: [
                                    { dataField: "RDate", caption: "Date", dataType: "date", format: "dd/MM/yyyy" },
                                    { dataField: "Kapan", caption: "Kapan", dataType: "string" },
                                    { dataField: "TableNo", caption: "Table", dataType: "string" },
                                    { dataField: "HeightName", caption: "Height", dataType: "string" },
                                    { dataField: "GradNo", caption: "GradNo", dataType: "string" },
                                    { dataField: "RoughPcs", caption: "Pcs", dataType: "number" },
                                    { dataField: "RoughCarat", caption: "Carat", dataType: "number" },
                                    { dataField: "AWeight", caption: "AWeight", dataType: "number", visible: false },
                                    { dataField: "BagID", caption: "BagID", dataType: "number", visible: false },
                                ]
                            },
                            {
                                caption: "DST HOLD",
                                alignment: "center",
                                columns: [
                                    {
                                        caption: "1CT Up", alignment: "center",
                                        columns: [
                                            { dataField: "ClvCTUPPcs", caption: "Pcs", dataType: "number" },
                                            { dataField: "ClvCTUPPolishWeight", caption: "Polish WT", dataType: "number" },
                                            { dataField: "ClvCTUPPer", caption: "%", dataType: "number" },
                                        ]
                                    },
                                    {
                                        caption: "1CT Down", alignment: "center",
                                        columns: [
                                            { dataField: "ClvCTDNPcs", caption: "Pcs", dataType: "number" },
                                            { dataField: "ClvCTDNPolishWeight", caption: "Polish WT", dataType: "number" },
                                            { dataField: "ClvCTDNPer", caption: "%", dataType: "number" },
                                        ]
                                    },
                                    {
                                        caption: "Total", alignment: "center",
                                        columns: [
                                            { dataField: "ClvPcs", caption: "Pcs", dataType: "number" },
                                            { dataField: "ClvPolishWeight", caption: "Polish WT", dataType: "number" },
                                            { dataField: "ClvPer", caption: "%", dataType: "number" },
                                            { dataField: "ClvDays", caption: "Days", dataType: "number" },
                                        ]
                                    },
                                ]
                            }
                        ]
                }];

                // 2. Summary Configuration (Used for both Group and Grand Total)
                SummaryData = [
                    { column: 'Kapan', summaryType: "count", valueFormat: "#0", displayFormat: "{0}" },
                    { column: 'RoughPcs', summaryType: "sum", valueFormat: "#0", displayFormat: "{0}" },
                    { column: 'RoughCarat', summaryType: "sum", valueFormat: "#0.000", displayFormat: "{0}" },
                    { column: 'ClvCTUPPcs', summaryType: "sum", valueFormat: "#0", displayFormat: "{0}" },
                    { column: 'ClvCTUPPolishWeight', summaryType: "sum", valueFormat: "#0.000", displayFormat: "{0}" },
                    { name: "ClvCTUPPer", summaryType: "custom", showInColumn: "ClvCTUPPer", valueFormat: "#0.00", displayFormat: "{0}" },
                    { column: 'ClvCTDNPcs', summaryType: "sum", valueFormat: "#0", displayFormat: "{0}" },
                    { column: 'ClvCTDNPolishWeight', summaryType: "sum", valueFormat: "#0.000", displayFormat: "{0}" },
                    { name: "ClvCTDNPer", summaryType: "custom", showInColumn: "ClvCTDNPer", valueFormat: "#0.00", displayFormat: "{0}" },
                    { column: 'ClvPcs', summaryType: "sum", valueFormat: "#0", displayFormat: "{0}" },
                    { column: 'ClvPolishWeight', summaryType: "sum", valueFormat: "#0.000", displayFormat: "{0}" },
                    { name: "ClvPer", summaryType: "custom", showInColumn: "ClvPer", valueFormat: "#0.00", displayFormat: "{0}" },
                ];
            }
            else if (currentView == 'COMPLETE') {
                columnsData = [{
                    caption: $('#reportDate').val(),
                    alignment: "center",
                    columns:
                        [
                            {
                                caption: "Main Rough",
                                alignment: "center",
                                fixed: true,
                                columns:
                                    [
                                        { dataField: "MainRDate", caption: "Date", dataType: "date", format: "dd/MM/yyyy", visible: false },
                                        {
                                            dataField: "MainRCode",
                                            caption: "MainRCode",
                                            groupIndex: 0, // Enable grouping by this column
                                            groupCellTemplate: function (element, options) {
                                                // Extracting data from the first item in the group
                                                debugger
                                                const data = options.data.items ? options.data.items[0] : (options.data.collapsedItems ? options.data.collapsedItems[0] : {});
                                                const dateStr = data.MainRDate ? new Date(data.MainRDate).toLocaleDateString('en-GB') : '';

                                                const template = $(`
                                                    <div style="color: #1e3c72; font-weight: bold; font-size: 14px; display: flex; gap: 20px;">
                                                        <span>📅 ${dateStr}</span>
                                                        <span>| 📦 CODE: ${options.value}</span>
                                                        <span>| 🍳 RECIPE: ${data.MainReceipe || '-'}</span>
                                                        <span style="margin-left: auto; color: #d9534f;">💎 MAIN PCS: ${parseInt(data.MainPcs || 0)}</span>
                                                        <span style="color: #d9534f; margin-right: 20px;">⚖️ MAIN CARAT: ${parseFloat(data.MainCarat || 0).toFixed(3)}</span>
                                                    </div>
                                                `);
                                                element.append(template);
                                            }
                                        },
                                        { dataField: "MainReceipe", caption: "Receipe", dataType: "string", visible: false },
                                        { dataField: "MainPcs", caption: "Pcs", dataType: "number", visible: false },
                                        { dataField: "MainCarat", caption: "Carat", dataType: "number", visible: false },
                                    ]
                            },
                            {
                                caption: "Kapan",
                                alignment: "center",
                                columns: [
                                    { dataField: "RDate", caption: "Date", dataType: "date", format: "dd/MM/yyyy" },
                                    { dataField: "Kapan", caption: "Kapan", dataType: "string" },
                                    { dataField: "TableNo", caption: "Table", dataType: "string" },
                                    { dataField: "HeightName", caption: "Height", dataType: "string" },
                                    { dataField: "GradNo", caption: "GradNo", dataType: "string" },
                                    { dataField: "RoughPcs", caption: "Pcs", dataType: "number" },
                                    { dataField: "RoughCarat", caption: "Carat", dataType: "number" },
                                    { dataField: "AWeight", caption: "AWeight", dataType: "number", visible: false },
                                    { dataField: "BagID", caption: "BagID", dataType: "number", visible: false },
                                ]
                            },
                            {
                                caption: "DST HOLD",
                                alignment: "center",
                                columns: [
                                    {
                                        caption: "1CT Up", alignment: "center",
                                        columns: [
                                            { dataField: "ClvCTUPPcs", caption: "Pcs", dataType: "number" },
                                            { dataField: "ClvCTUPPolishWeight", caption: "Polish WT", dataType: "number" },
                                            { dataField: "ClvCTUPPer", caption: "%", dataType: "number" },
                                        ]
                                    },
                                    {
                                        caption: "1CT Down", alignment: "center",
                                        columns: [
                                            { dataField: "ClvCTDNPcs", caption: "Pcs", dataType: "number" },
                                            { dataField: "ClvCTDNPolishWeight", caption: "Polish WT", dataType: "number" },
                                            { dataField: "ClvCTDNPer", caption: "%", dataType: "number" },
                                        ]
                                    },
                                    {
                                        caption: "Total", alignment: "center",
                                        columns: [
                                            { dataField: "ClvPcs", caption: "Pcs", dataType: "number" },
                                            { dataField: "ClvPolishWeight", caption: "Polish WT", dataType: "number" },
                                            { dataField: "ClvPer", caption: "%", dataType: "number" },
                                            { dataField: "ClvDays", caption: "Days", dataType: "number" },
                                        ]
                                    },
                                ]
                            },
                            {
                                caption: "DST",
                                alignment: "center",
                                columns: [
                                    {
                                        caption: "1CT Up", alignment: "center",
                                        columns: [
                                            { dataField: "DSTCTUPPcs", caption: "Pcs", dataType: "number" },
                                            { dataField: "DSTCTUPPolishWeight", caption: "Polish WT", dataType: "number" },
                                            { dataField: "DSTCTUPPer", caption: "%", dataType: "number" },
                                        ]
                                    },
                                    {
                                        caption: "1CT Down", alignment: "center",
                                        columns: [
                                            { dataField: "DSTCTDNPcs", caption: "Pcs", dataType: "number" },
                                            { dataField: "DSTCTDNPolishWeight", caption: "Polish WT", dataType: "number" },
                                            { dataField: "DSTCTDNPer", caption: "%", dataType: "number" },
                                        ]
                                    },
                                    {
                                        caption: "Total", alignment: "center",
                                        columns: [
                                            { dataField: "DSTPcs", caption: "Pcs", dataType: "number" },
                                            { dataField: "DSTPolishWeight", caption: "Polish WT", dataType: "number" },
                                            { dataField: "DSTPer", caption: "%", dataType: "number" },
                                            { dataField: "ComplateDate", caption: "Date", dataType: "date", format: "dd/MM/yyyy" },
                                            { dataField: "DSTDays", caption: "Days", dataType: "number" },
                                        ]
                                    },
                                ]
                            },
                        ]
                }];

                // 2. Summary Configuration (Used for both Group and Grand Total)
                SummaryData = [
                    { column: 'Kapan', summaryType: "count", valueFormat: "#0", displayFormat: "{0}" },
                    { column: 'RoughPcs', summaryType: "sum", valueFormat: "#0", displayFormat: "{0}" },
                    { column: 'RoughCarat', summaryType: "sum", valueFormat: "#0.000", displayFormat: "{0}" },
                    { column: 'ClvCTUPPcs', summaryType: "sum", valueFormat: "#0", displayFormat: "{0}" },
                    { column: 'ClvCTUPPolishWeight', summaryType: "sum", valueFormat: "#0.000", displayFormat: "{0}" },
                    { name: "ClvCTUPPer", summaryType: "custom", showInColumn: "ClvCTUPPer", valueFormat: "#0.00", displayFormat: "{0}" },
                    { column: 'ClvCTDNPcs', summaryType: "sum", valueFormat: "#0", displayFormat: "{0}" },
                    { column: 'ClvCTDNPolishWeight', summaryType: "sum", valueFormat: "#0.000", displayFormat: "{0}" },
                    { name: "ClvCTDNPer", summaryType: "custom", showInColumn: "ClvCTDNPer", valueFormat: "#0.00", displayFormat: "{0}" },
                    { column: 'ClvPcs', summaryType: "sum", valueFormat: "#0", displayFormat: "{0}" },
                    { column: 'ClvPolishWeight', summaryType: "sum", valueFormat: "#0.000", displayFormat: "{0}" },
                    { name: "ClvPer", summaryType: "custom", showInColumn: "ClvPer", valueFormat: "#0.00", displayFormat: "{0}" },
                    { column: 'DSTCTUPPcs', summaryType: "sum", valueFormat: "#0", displayFormat: "{0}" },
                    { column: 'DSTCTUPPolishWeight', summaryType: "sum", valueFormat: "#0.000", displayFormat: "{0}" },
                    { name: "DSTCTUPPer", summaryType: "custom", showInColumn: "DSTCTUPPer", valueFormat: "#0.00", displayFormat: "{0}" },
                    { column: 'DSTCTDNPcs', summaryType: "sum", valueFormat: "#0", displayFormat: "{0}" },
                    { column: 'DSTCTDNPolishWeight', summaryType: "sum", valueFormat: "#0.000", displayFormat: "{0}" },
                    { name: "DSTCTDNPer", summaryType: "custom", showInColumn: "DSTCTDNPer", valueFormat: "#0.00", displayFormat: "{0}" },
                    { column: 'DSTPcs', summaryType: "sum", valueFormat: "#0", displayFormat: "{0}" },
                    { column: 'DSTPolishWeight', summaryType: "sum", valueFormat: "#0.000", displayFormat: "{0}" },
                    { name: "DSTPer", summaryType: "custom", showInColumn: "DSTPer", valueFormat: "#0.00", displayFormat: "{0}" },
                ];
            }
        }

        $scope.setColumn();

        let List = [];

        $scope.FetchData = function (item) {
          debugger
            var date = $('#reportDate').val();
            if (!date) {
                Noty('error', 'Please select a date');
                return;
            }

            show_loader();
            var response = $http({
                method: "post",
                async: true,
                url: '@Url.Action("RP_Getdata_DST_Report_Summary", "Report")',
                data: { reportDate: date, Action: item, Status: "View" },
                dataType: "json"
            }).then(function (response) {
                console.log("Raw Response:", response.data);
                hide_loader();
                $scope.SummaryList = response.data.SummaryList;
                List = response.data.List;
                GridData();
            })
                .catch(function (error) {
                    console.error('Error loading data:', error);
                    hide_loader();
                    alert('Error loading data. Please try again.');
                });
        };

        $scope.FetchData("RUNNING");

        const GridData = () => {
            $("#gridContainer").dxDataGrid({
                dataSource: List,
                columns: columnsData,
                grouping: { autoExpandAll: true },
                groupPanel: { visible: false },
                summary: {
                    totalItems: SummaryData,
                    groupItems: SummaryData.map(item => ({ ...item, alignByColumn: true, showInGroupFooter: true })),
                    calculateCustomSummary: function (options) {
                        const percFields = ["DSTCTUPPer", "DSTCTDNPer", "DSTPer", "ClvCTUPPer", "ClvCTDNPer", "ClvPer"];
                        const wtMap = {
                            "ClvCTUPPer": "ClvCTUPPolishWeight",
                            "ClvCTDNPer": "ClvCTDNPolishWeight",
                            "ClvPer": "ClvPolishWeight",
                            "DSTCTUPPer": "DSTCTUPPolishWeight",
                            "DSTCTDNPer": "DSTCTDNPolishWeight",
                            "DSTPer": "DSTPolishWeight",
                        };
                        if (percFields.includes(options.name)) {
                            if (options.summaryProcess === "start") {
                                options.totalValue = { polishWt: 0, AWeight: 0 };
                            }
                            if (options.summaryProcess === "calculate") {
                                options.totalValue.polishWt += parseFloat(options.value[wtMap[options.name]] || 0);
                                options.totalValue.AWeight += parseFloat(options.value.AWeight || 0);
                            }
                            if (options.summaryProcess === "finalize") {
                                options.totalValue = options.totalValue.AWeight > 0
                                    ? ((options.totalValue.polishWt / options.totalValue.AWeight) * 100).toFixed(2)
                                    : 0;
                            }
                        }
                    }
                },
                height: '100%',
                columnAutoWidth: true,
                hoverStateEnabled: true,
                allowColumnResizing: true,
                columnResizingMode: 'widget',
                showColumnLines: true,
                showRowLines: true,
                //rowAlternationEnabled: true,
                showBorders: true,
                height: '100%',
                paging: { enabled: false },
                sorting: { mode: "multiple" },
                scrolling: {
                    mode: 'virtual',
                },
                filterRow: {
                    visible: true,
                    applyFilter: 'auto',
                },
                filterPanel: { visible: true },
                searchPanel: {
                    visible: true,
                    width: 240,
                    placeholder: 'Search...',
                },
                loadPanel: {
                    enabled: true,
                    showPane: false,
                    indicatorSrc: '/Content/icons/Loader.gif',
                },
                headerFilter: {
                    visible: true,
                    search: {
                        enabled: true,
                    },
                },
                pager: {
                    visible: false,
                },
                selection: {
                    mode: 'single',
                    //mode: 'multiple',
                    //mode: 'none',
                },
                keyboardNavigation: {
                    enterKeyAction: 'moveFocus',
                    enterKeyDirection: 'column',
                    editOnKeyPress: true,
                },
                onRowPrepared: function (e) {
                    // 1. Group Header (Main Row) Color
                    if (e.rowType === "group") {
                        e.rowElement.css("background-color", "#f0f7ff"); // Light Blue-ish
                        e.rowElement.css("color", "#1e3c72");
                        e.rowElement.css("font-weight", "bold");
                    }
                    // 2. Subtotal Row (Group Footer) Color
                    if (e.rowType === "groupFooter") {
                        e.rowElement.addClass("SubTotal"); // Soft Yellow
                    }

                },
                onCellPrepared: function (e) {
                    const dataField = e.column.dataField;
                    //if (dataField === "MainRDate" || dataField === "MainRCode" || dataField === "MainReceipe" || dataField === "MainGradNo" || dataField === "MainPcs" || dataField === "MainCarat") {
                    //    $(e.cellElement).addClass("Silver");
                    //}
                    if (dataField === "Kapan" || dataField === "RDate" || dataField === "TableNo" || dataField === "HeightName" || dataField === "GradNo" || dataField === "RoughPcs" || dataField === "RoughCarat") {
                        $(e.cellElement).addClass("AshGreen");
                    }
                    else if (dataField === "ClvCTUPPcs" || dataField === "ClvCTUPPolishWeight" || dataField === "ClvCTUPPer") {
                        $(e.cellElement).addClass("Snow");
                    }
                    else if (dataField === "ClvCTDNPcs" || dataField === "ClvCTDNPolishWeight" || dataField === "ClvCTDNPer") {
                        $(e.cellElement).addClass("LightBlue");
                    }
                    else if (dataField === "ClvPcs" || dataField === "ClvPolishWeight" || dataField === "ClvDays") {
                        $(e.cellElement).addClass("Dun");
                    }
                    else if (dataField === "ClvPer") {
                        $(e.cellElement).addClass("yellow");
                    }
                    else if (dataField === "DSTCTUPPcs" || dataField === "DSTCTUPPolishWeight" || dataField === "DSTCTUPPer") {
                        $(e.cellElement).addClass("SoftBlush");
                    }
                    else if (dataField === "DSTCTDNPcs" || dataField === "DSTCTDNPolishWeight" || dataField === "DSTCTDNPer") {
                        $(e.cellElement).addClass("TangerineDream");
                    }
                    else if (dataField === "DSTPcs" || dataField === "DSTPolishWeight" || dataField === "DSTPer" || dataField === "ComplateDate" || dataField === "DSTDays") {
                        $(e.cellElement).addClass("GoldenSand");
                    }
                },
                export: {
                    enabled: true,
                    //formats: ['pdf', 'xlxs'],
                    formats: ['xlxs'],
                    allowExportSelectedData: false,
                },
                onExporting(e) {
                    const grid = e.component;
                    const workbook = new ExcelJS.Workbook();
                    const worksheet = workbook.addWorksheet('Main Rough Summary');

                    // Specify columns to skip in Excel
                    const columnsToHide = []//["MainRDate", "MainPcs", "MainCarat", "MainReceipe"];

                    grid.beginUpdate();
                    columnsToHide.forEach(field => grid.columnOption(field, "visible", false));
                    grid.endUpdate();

                    DevExpress.excelExporter.exportDataGrid({
                        component: grid,
                        worksheet: worksheet,
                        autoFilterEnabled: true,
                        customizeCell: function ({ gridCell, excelCell }) {

                            // 1. STYLE HEADERS
                            if (gridCell.rowType === "header") {
                                excelCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FF1E3C72' } };
                                excelCell.font = { color: { argb: 'FFFFFFFF' }, bold: true };
                            }

                            // 2. STYLE GROUP HEADERS (The "Main Row" in Excel)
                            if (gridCell.rowType === "group") {
                                excelCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFF0F7FF' } };
                                excelCell.font = { color: { argb: 'FF1E3C72' }, bold: true };

                                // Get the data record for this group to build the summary string
                                let firstItem = null;
                                if (gridCell.data) {
                                    firstItem = (gridCell.data.items && gridCell.data.items[0]) ||
                                        (gridCell.data.collapsedItems && gridCell.data.collapsedItems[0]);
                                }

                                // If we found the data, build the full string: Date | Code | Recipe | Pcs | Carat
                                if (firstItem && gridCell.column.dataField === "MainRCode") {
                                    const dateStr = firstItem.MainRDate ? new Date(firstItem.MainRDate).toLocaleDateString('en-GB') : '';
                                    const recipe = firstItem.MainReceipe || '-';
                                    const pcs = firstItem.MainPcs || 0;
                                    const carat = (firstItem.MainCarat || 0).toFixed(3);

                                    excelCell.value = `${dateStr} | CODE: ${gridCell.value} | RECIPE: ${recipe} | PCS: ${pcs} | CARAT: ${carat}`;
                                }
                            }

                            // 3. STYLE SUBTOTALS (Group Footers)
                            if (gridCell.rowType === "groupFooter") {
                                excelCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFFFF8E1' } };
                                excelCell.font = { italic: true, bold: true };
                            }

                            // 4. STYLE FINAL TOTALS
                            if (gridCell.rowType === "totalFooter") {
                                excelCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFDEEDF5' } };
                                excelCell.font = { bold: true };
                            }

                            // Cell Borders
                            excelCell.border = {
                                top: { style: 'thin' }, left: { style: 'thin' },
                                right: { style: 'thin' }, bottom: { style: 'thin' }
                            };
                        }
                    }).then(() => {
                        workbook.xlsx.writeBuffer().then((buffer) => {
                            saveAs(new Blob([buffer], { type: 'application/octet-stream' }), 'DST Summary.xlsx');
                        });

                        // Restore columns in web view (if you need them visible again)
                        // grid.beginUpdate();
                        // columnsToHide.forEach(field => grid.columnOption(field, "visible", true));
                        // grid.endUpdate();
                    });
                },
                toolbar: {
                    items: [
                        {
                            location: "center",
                            template: function () {
                                return $("<div>")
                                    .text("🢡 Kapan Wise DST Report")
                                    .css({
                                        "font-size": "18px",
                                        "font-weight": "600",
                                        "color": "#449bca"
                                    });
                            }
                        },
                        { location: "after", name: "exportButton" },
                        { location: "after", name: "searchPanel" },
                    ]
                },
            });
        }

        $scope.ExcelExport = function () {
            show_loader();
            var response = $http({
                method: "post",
                async: true,
                url: '@Url.Action("RP_Getdata_Main_Rough_Summary_Export", "Report")',
                data: { ToDayDate},
                dataType: "json"
            }).then(function (response) {
                hide_loader();
                debugger
                $scope.DownloadExcel(response.data.Data);
            });
        };

        $scope.DownloadExcel = function (path) {
            var url = '@Url.Action("DownloadExcel", "Lot")/?filepath=' + path;
            var hiddenIFrameID = 'hiddenDownloaderReportResult';
            var iframe = document.getElementById(hiddenIFrameID);
            if (iframe === null) {
                iframe = document.createElement('iframe');
                iframe.id = hiddenIFrameID;
                iframe.style.display = 'none';
                document.body.appendChild(iframe);
            }
            iframe.src = url;
        };
    }]);
</script>