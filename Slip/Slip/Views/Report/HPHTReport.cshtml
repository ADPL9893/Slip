@{
    ViewBag.Title = "HPHT Report";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}


<div ng-controller="Diamond" class="hpht-page">
    <!-- Top Header Card (SaaS Ice-Blue Theme with Action Toolbar) -->
    <div class="hpht-header-card">
        <div class="hpht-header-left">
            <div class="hpht-header-icon">
                <i class="fa fa-flask"></i>
            </div>
            <div>
                <div class="hpht-breadcrumb">
                    <a href="@Url.Action("Index", "Home")"><i class="fa fa-home"></i> Home</a> / 
                    <span>Report</span> / 
                    <span>HPHT Report</span>
                </div>
                <h4 class="hpht-header-title">HPHT Report</h4>
            </div>
        </div>

        <!-- Header Actions Toolbar (RCode Select, From Date, To Date, Fetch, Print) -->
        <div class="hpht-header-actions">
            <!-- RCode Dropdown -->
            <div class="hpht-select-wrap">
                <select id="RCode" chosen="GetRCodeList" class="form-control input-sm" ng-options="item.id as item.value for item in GetRCodeList" ng-model="Diamond.RCode">
                    <option value="">Select RCode</option>
                </select>
            </div>

            <!-- From Date -->
            <span class="hpht-filter-label">From:</span>
            <div class="hpht-date-wrap">
                <input id="FromDate" type="text" class="hpht-date-input" placeholder="dd-M-yyyy" autocomplete="off" ng-model="Diamond.FromDate" readonly />
            </div>

            <!-- To Date -->
            <span class="hpht-filter-label">To:</span>
            <div class="hpht-date-wrap">
                <input id="ToDate" type="text" class="hpht-date-input" placeholder="dd-M-yyyy" autocomplete="off" ng-model="Diamond.ToDate" readonly />
            </div>

            <!-- Action Buttons -->
            <button class="btn-hpht-fetch" type="button" ng-click="FatchData()">
                <i class="fa fa-search"></i> Fetch
            </button>
            <button class="btn-hpht-print" type="button" ng-click="Print()">
                <i class="fa fa-print"></i> Print
            </button>
        </div>
    </div>

    <!-- DevExtreme DataGrid Card -->
    <div class="hpht-grid-card">
        <div class="hpht-card-header">
            <div class="hpht-card-title-left">
                <i class="fa fa-table"></i>
                <h3>HPHT Details</h3>
            </div>
        </div>

        <div class="hpht-grid-body">
            <div class="uigrid">
                <div id="gridContainer" style="width: 100%;"></div>
            </div>
        </div>
    </div>
</div>

<script>
    let IssueList = [];
    let List = [];
    let DataField = [];
    let DataFieldSummary = [];

    var module;
    try {
        module = angular.module('app');
    } catch (e) {
        module = angular.module('app', ['frapontillo.bootstrap-duallistbox', 'ngTouch', 'angularjs-dropdown-multiselect']);
    }

    module.directive('chosen', ['$timeout', function ($timeout) {
        var linker = function (scope, element, attrs) {
            var list = attrs['chosen'];

            if (list) {
                scope.$watchCollection(list, function () {
                    $timeout(function () {
                        element.trigger('chosen:updated');
                    }, 50);
                });
            }

            if (attrs['ngModel']) {
                scope.$watch(attrs['ngModel'], function () {
                    $timeout(function () {
                        element.trigger('chosen:updated');
                    }, 50);
                });
            }

            element.chosen({ width: '100%', search_contains: true, allow_single_deselect: true });
        };

        return {
            restrict: 'A',
            link: linker
        };
    }]);

    module.controller("Diamond", function ($scope, $http, $timeout) {

        $scope.Diamond = {};

        var loopPromises = [];
        var promise = $http.get('@Url.Action("Getdata_For_DropDown", "Master")').then(function (response) {
            var RCodeList = [];
            for (var i = 0; i < response.data.RCodeList.length; i++) {
                var obj = { id: response.data.RCodeList[i]["RCode"], value: response.data.RCodeList[i]["RCode"] };
                RCodeList.push(obj);
            }
            $scope.GetRCodeList = RCodeList;
            $timeout(function () {
                $('#RCode').trigger('chosen:updated');
            }, 60);
        });
        loopPromises.push(promise);

        $scope.FatchData = function () {
            const FromDate = $('#FromDate').val();
            const ToDate = $('#ToDate').val();
            const RCode = $scope.Diamond.RCode;
            const TableNo = "";

            if (!RCode && !FromDate && !ToDate) {
                Noty("error", "Please Select RCode.");
                return;
            }

            if (RCode) {
                if (FromDate || ToDate) {
                    Noty("error", "You Can Only Select RCode OR Date");
                    return;
                }
            }

            if (FromDate || ToDate) {
                if (FromDate && !ToDate) {
                    Noty("error", "Please Select ToDate.");
                    return;
                }
                if (!FromDate && ToDate) {
                    Noty("error", "Please Select FromDate.");
                    return;
                }
                if (FromDate != "" && ToDate != "") {
                    if (new Date(FromDate) > new Date(ToDate)) {
                        Noty("error", "Please Select Valid ToDate!");
                        return;
                    }
                }
                if (RCode) {
                    Noty("error", "You Can Only Select RCode OR Date");
                    return;
                }
            }

            show_loader();
            $http({
                method: "POST",
                url: '@Url.Action("RP_Slip_Report_Getdata", "Report")',
                data: { Process: "HPHTReport", FromDate, ToDate, RCode, TableNo }
            }).then(function (response) {
                hide_loader();
                List = response.data.List || [];
                DataField = response.data.DataField || [];
                DataFieldSummary = response.data.DataFieldSummary || [];

                GridData();
            }).catch(function (error) {
                hide_loader();
                Noty("error", "Error loading HPHT report data.");
            });
        };

        GridData();

        function GridData() {
            $("#gridContainer").dxDataGrid({
                dataSource: List,
                columns: DataField,
                keyExpr: 'ID',
                columnWidth: 'auto',
                columnAutoWidth: true,
                allowColumnResizing: true,
                columnResizingMode: 'widget',
                showColumnLines: true,
                showRowLines: true,
                showBorders: true,
                height: 'calc(100vh - 210px)',
                paging: { enabled: false },
                sorting: { mode: "multiple" },
                filterRow: { visible: true, applyFilter: 'auto' },
                filterPanel: { visible: true },
                searchPanel: { visible: true, width: 240, placeholder: 'Search...' },
                headerFilter: { visible: true },
                loadPanel: {
                    enabled: true,
                    showPane: false,
                    indicatorSrc: '/Content/icons/Loader.gif',
                },
                selection: {
                    mode: 'multiple'
                },
                summary: {
                    totalItems: DataFieldSummary
                },
                onSelectionChanged: function (e) {
                    const grid = e.component;
                    e.currentSelectedRowKeys.forEach(function (key, index) {
                        const row = e.selectedRowsData.find(item => item.ID === key);
                        if (row) {
                            IssueList.push(row);
                        }
                    });

                    // ❌ Remove deselected rows
                    e.currentDeselectedRowKeys.forEach(function (key) {
                        IssueList = IssueList.filter(row => row.ID !== key);
                    });
                },
                export: {
                    enabled: true,
                    formats: ['xlxs'],
                    allowExportSelectedData: false
                },
                onExporting(e) {
                    const workbook = new ExcelJS.Workbook();
                    const worksheet = workbook.addWorksheet('Report');

                    DevExpress.excelExporter.exportDataGrid({
                        component: e.component,
                        worksheet
                    }).then(() => {
                        workbook.xlsx.writeBuffer().then(buffer => {
                            saveAs(new Blob([buffer], { type: 'application/octet-stream' }), 'HPHT Report.xlsx');
                        });
                    });
                }
            });
        }

        $scope.Print = function () {
            const RCode = $scope.Diamond.RCode;
            const FromDate = $('#FromDate').val();
            const ToDate = $('#ToDate').val();

            let Title;
            if (!RCode && !FromDate && !ToDate) {
                Noty("error", "Please Select RCode.");
                return;
            }

            if (RCode) {
                if (FromDate || ToDate) {
                    Noty("error", "You Can Only Select RCode OR Date");
                    return;
                }

                Title = RCode;
            }

            if (FromDate || ToDate) {
                if (FromDate && !ToDate) {
                    Noty("error", "Please Select ToDate.");
                    return;
                }
                if (!FromDate && ToDate) {
                    Noty("error", "Please Select FromDate.");
                    return;
                }
                if (FromDate != "" && ToDate != "") {
                    if (new Date(FromDate) > new Date(ToDate)) {
                        Noty("error", "Please Select Valid ToDate!");
                        return;
                    }
                }
                if (RCode) {
                    Noty("error", "You Can Only Select RCode OR Date");
                    return;
                }
            }

            if (RCode) {
                Title = RCode;
            }
            else {
                if (FromDate == ToDate) {
                    Title = FromDate;
                }
                if (FromDate != ToDate) {
                    Title = FromDate + ' To ' + ToDate;
                }
            }

            // Determine endpoint
            var form = document.createElement("form");
            form.method = "POST";
            form.action = "/Print/HPHT_Summary_SlipPrint";
            form.target = "_blank"; // Open in new window

            // Hidden input helper
            const addHidden = (name, value) => {
                const input = document.createElement("input");
                input.type = "hidden";
                input.name = name;
                input.value = JSON.stringify(value);
                form.appendChild(input);
            };

            addHidden("RCode", RCode == undefined ? "" : RCode);
            addHidden("FromDate", FromDate);
            addHidden("ToDate", ToDate);
            addHidden("Title", Title);

            document.body.appendChild(form);
            form.submit();
            document.body.removeChild(form);
        }

    });
</script>
<script>
    $(document).ready(function () {
        $('#FromDate, #ToDate').datepicker({
            format: "dd-M-yyyy",
            autoclose: true,
            todayHighlight: true
        });

        // Ensure clicking or tapping on mobile immediately opens the datepicker
        $(document).on('click focus touchstart', '#FromDate, #ToDate', function (e) {
            if (!$(this).prop('disabled')) {
                $(this).datepicker('show');
            }
        });
    });
</script>
