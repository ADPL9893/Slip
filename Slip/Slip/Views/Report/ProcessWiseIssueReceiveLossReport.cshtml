
@{
    ViewBag.Title = "ProcessWiseIssueReceiveLossReport";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}
<div ng-controller="Diamond">
    <div class="page-title">
        <div class="col-lg-12">
            @*<div class="col-lg-1">
                    <h5>
                        <a href="@Url.Action("Index", "Home")">
                            <i class="fa fa-home fa-lg"></i>&nbsp;Home
                        </a>
                    </h5>
                </div>*@
            <label class="col-md-1 control-label">Date</label>
            <div class="col-lg-1">
                <input id="Date" type="text" class="form-control input-sm" placeholder="dd/mm/yyyy" autocomplete="off" ng-model="Diamond.Date" readonly />
            </div>
            <div class="col-lg-6">
                <button class="btn btn-primary" ng-click="FatchData()">Fatch</button>
                <button class="btn btn-primary" ng-click="Print()">Print</button>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="well bs-component">
                    <legend class="font-green-sharp">
                        <b style="position:absolute">Process Wise IssueReceive Loss Report</b>
                        <div align="right">
                            &nbsp; @*<button class="btn btn-primary" ng-click="Print()" type="button">Print</button>*@
                        </div>
                    </legend>
                    <div class="card-body">
                        <div class="uigrid">
                            <div id="gridContainer" style="width:100%;"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    module = angular.module('app', ['frapontillo.bootstrap-duallistbox', 'ngTouch', 'angularjs-dropdown-multiselect']);

    module.directive('chosen', function () {
        var linker = function (scope, element, attrs) {
            var list = attrs['chosen'];

            scope.$watch(list, function () {
                element.trigger('chosen:updated');
            });

            scope.$watch(attrs['ngModel'], function () {
                element.trigger('chosen:updated');
            });

            element.chosen();
        };

        return {
            restrict: 'A',
            link: linker
        };
    });

    module.controller("Diamond", function ($scope, $http) {

        $scope.Diamond = {};

        $scope.FatchData = function () {
            const Date = $('#Date').val();

            debugger
            show_loader();
            $http({
                method: "POST",
                url: '@Url.Action("GetData_For_Process_Wise_Issue_Receive_Loss_Report", "Report")',
                data: { Date }
            }).then(function (response) {
                hide_loader();
                List = response.data.List;

                GridData();
            });
        };

        function GridData() {
            $("#gridContainer").dxDataGrid({
                dataSource: List,
                columns: [
                    {
                        caption: $('#Date').val(), alignment: "center",
                        columns: [
                            { dataField: "Process", caption: "Process", dataType: "string", fixed: true },
                            { dataField: "IdealCount", caption: "IdealCount", dataType: "string", fixed: true },
                            {
                                caption: "ISSUE", alignment: "center",
                                columns: [
                                    { dataField: "IssuePcs", caption: "Pcs", dataType: "number", },
                                    { dataField: "IssueRPartWeight", caption: "RPartWeight", dataType: "number", },
                                    { dataField: "IssuePolishWeight", caption: "PolishWeight", dataType: "number" },
                                ]
                            },
                            {
                                caption: "RECEIVE", alignment: "center",
                                columns: [
                                    { dataField: "ReceivePcs", caption: "Pcs", dataType: "number", },
                                    { dataField: "ReceiveRPartWeight", caption: "RPartWeight", dataType: "number", },
                                    { dataField: "ReceivePolishWeight", caption: "PolishWeight", dataType: "number" },
                                ]
                            },
                            {
                                caption: "LOSS", alignment: "center",
                                columns: [
                                    { dataField: "LossRPartWeight", caption: "RPartWeight", dataType: "number", },
                                    { dataField: "LossRPartWeightPer", caption: "%", dataType: "number", },
                                    { dataField: "LossPolishWeight", caption: "PolishWeight", dataType: "number" },
                                    { dataField: "LossPolishWeightPer", caption: "%", dataType: "number" },
                                ]
                            }
                        ],
                    },
                ],
                keyExpr: 'Process',
                columnWidth: 'auto',
                columnAutoWidth: true,
                allowColumnResizing: true,
                columnResizingMode: 'widget',
                showColumnLines: true,
                showRowLines: true,
                showBorders: true,
                height: '100%',
                paging: { enabled: false },
                sorting: { mode: "multiple" },
                filterRow: { visible: true, applyFilter: 'auto' },
                filterPanel: { visible: true },
                searchPanel: { visible: true, placeholder: 'Search...' },
                headerFilter: { visible: true },
                loadPanel: {
                    enabled: true,
                    showPane: false,
                    indicatorSrc: '/Content/icons/Loader.gif',
                },
                selection: {
                    mode: 'single'
                    //mode: 'multiple'
                },
                summary: {
                    totalItems: [
                        { column: "IssuePcs", valueFormat: "#0", summaryType: "sum", displayFormat:"{0}"},
                        { column: "IssueRPartWeight", valueFormat: "#0.000", summaryType: "sum", displayFormat:"{0}"},
                        { column: "IssuePolishWeight", valueFormat: "#0.000", summaryType: "sum", displayFormat:"{0}"},
                        { column: "ReceivePcs", valueFormat: "#0", summaryType: "sum", displayFormat:"{0}"},
                        { column: "ReceiveRPartWeight", valueFormat: "#0.000", summaryType: "sum", displayFormat:"{0}"},
                        { column: "ReceivePolishWeight", valueFormat: "#0.000", summaryType: "sum", displayFormat:"{0}"},
                        { column: "LossRPartWeight", valueFormat: "#0.000", summaryType: "sum", displayFormat:"{0}"},
                        { column: "LossRPartWeightPer", valueFormat: "#0.000", summaryType: "sum", displayFormat:"{0}"},
                        { column: "LossPolishWeight", valueFormat: "#0.000", summaryType: "sum", displayFormat:"{0}"},
                        { column: "LossPolishWeightPer", valueFormat: "#0.000", summaryType: "sum", displayFormat:"{0}"},
                    ]
                },
                export: {
                    enabled: true,
                    formats: ['xlxs'],
                    allowExportSelectedData: false
                },
                onExporting(e) {
                    const workbook = new ExcelJS.Workbook();
                    const worksheet = workbook.addWorksheet('Report');

                    DevExpress.excelExporter.exportDataGrid({
                        component: e.component,
                        worksheet
                    }).then(() => {
                        workbook.xlsx.writeBuffer().then(buffer => {
                            saveAs(new Blob([buffer], { type: 'application/octet-stream' }),  'Process Wise IssueReceive Loss Report.xlsx');
                        });
                    });
                }
            });
        }

        $scope.Print = function () {
            debugger

            const RCode = $scope.Diamond.RCode;
            const Date = $('#Date').val();
            const ToDate = $('#ToDate').val();

            debugger
            let Title;
            if (!RCode && !Date && !ToDate) {
                Noty("error", "Please Select RCode.");
                return;
            }

            if (RCode) {
                if (Date || ToDate) {
                    Noty("error", "You Can Only Select RCode OR Date");
                    return;
                }

                Title = RCode;
            }

            if (Date || ToDate) {
                if (Date && !ToDate) {
                    Noty("error", "Please Select ToDate.");
                    return;
                }
                if (!Date && ToDate) {
                    Noty("error", "Please Select Date.");
                    return;
                }
                if (Date != "" && ToDate != "") {
                    if (new Date(Date) > new Date(ToDate)) {
                        Noty("error", "Please Select Valid ToDate!");
                        return;
                    }
                }
                if (RCode) {
                    Noty("error", "You Can Only Select RCode OR Date");
                    return;
                }
            }

            if (RCode) {
                Title = RCode;
            }
            else {
                if (Date == ToDate) {
                    Title = Date;
                }
                if (Date != ToDate) {
                    Title = Date + ' To ' + ToDate;
                }
            }

            // Determine endpoint

            var form = document.createElement("form");
            form.method = "POST";
            form.action = "/Print/HPHT_Summary_SlipPrint";
            form.target = "_blank"; // Open in new window

            // Hidden input helper
            const addHidden = (name, value) => {
                const input = document.createElement("input");
                input.type = "hidden";
                input.name = name;
                input.value = JSON.stringify(value);
                form.appendChild(input);
            };

            addHidden("RCode", RCode == undefined ? "" : RCode);
            addHidden("Date", Date);
            addHidden("ToDate", ToDate);
            addHidden("Title", Title);

            document.body.appendChild(form);
            form.submit();
            document.body.removeChild(form);
        }

    });
</script>
<script>
    $('#Date').datepicker({
        format: "dd-M-yyyy",
        autoclose: true,
        todayHighlight: true
    });

    $('#ToDate').datepicker({
        format: "dd-M-yyyy",
        autoclose: true,
        todayHighlight: true
    });
</script>
