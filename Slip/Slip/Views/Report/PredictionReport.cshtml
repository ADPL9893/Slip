@{
    ViewBag.Title = "Prediction Report";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}


<div ng-controller="Diamond" class="prediction-page">
    <!-- Top Header Card (SaaS Ice-Blue Theme with Action Toolbar) -->
    <div class="pred-header-card">
        <div class="pred-header-left">
            <div class="pred-header-icon">
                <i class="fa fa-line-chart"></i>
            </div>
            <div>
                <div class="pred-breadcrumb">
                    <a href="@Url.Action("Index", "Home")"><i class="fa fa-home"></i> Home</a> / 
                    <span>Report</span> / 
                    <span>Prediction Report</span>
                </div>
                <h4 class="pred-header-title">Prediction Report</h4>
            </div>
        </div>

        <!-- Header Actions Toolbar (RCode Select, From Date, To Date, Fetch, Excel) -->
        <div class="pred-header-actions">
            <!-- RCode Dropdown -->
            <div class="pred-select-wrap">
                <select id="RCode" chosen="GetRCodeList" class="form-control input-sm" ng-options="item.id as item.value for item in GetRCodeList" ng-model="Diamond.RCode">
                    <option value="">Select RCode</option>
                </select>
            </div>

            <!-- From Date -->
            <span class="pred-filter-label">From:</span>
            <div class="pred-date-wrap">
                <input id="FromDate" type="text" class="pred-date-input" placeholder="dd-M-yyyy" autocomplete="off" ng-model="Diamond.FromDate" readonly />
            </div>

            <!-- To Date -->
            <span class="pred-filter-label">To:</span>
            <div class="pred-date-wrap">
                <input id="ToDate" type="text" class="pred-date-input" placeholder="dd-M-yyyy" autocomplete="off" ng-model="Diamond.ToDate" readonly />
            </div>

            <!-- Action Buttons -->
            <button class="btn-pred-fetch" type="button" ng-click="FatchData()">
                <i class="fa fa-search"></i> Fetch
            </button>
            <button class="btn-pred-excel" type="button" ng-click="ExcelExport()">
                <i class="fa fa-file-excel-o"></i> Excel
            </button>
        </div>
    </div>

    <!-- DevExtreme DataGrid Card -->
    <div class="pred-grid-card">
        <div class="pred-card-header">
            <div class="pred-card-title-left">
                <i class="fa fa-table"></i>
                <h3>Prediction Details</h3>
            </div>
        </div>

        <div class="pred-grid-body">
            <div class="uigrid">
                <div id="gridContainer" style="width: 100%;"></div>
            </div>
        </div>
    </div>
</div>

<script>
    let IssueList = [];
    let List = [];
    let DataField = [];
    let DataFieldSummary = [];

    var module;
    try {
        module = angular.module('app');
    } catch (e) {
        module = angular.module('app', ['frapontillo.bootstrap-duallistbox', 'ngTouch', 'angularjs-dropdown-multiselect']);
    }

    module.directive('chosen', ['$timeout', function ($timeout) {
        var linker = function (scope, element, attrs) {
            var list = attrs['chosen'];

            if (list) {
                scope.$watchCollection(list, function () {
                    $timeout(function () {
                        element.trigger('chosen:updated');
                    }, 50);
                });
            }

            if (attrs['ngModel']) {
                scope.$watch(attrs['ngModel'], function () {
                    $timeout(function () {
                        element.trigger('chosen:updated');
                    }, 50);
                });
            }

            element.chosen({ width: '100%', search_contains: true, allow_single_deselect: true });
        };

        return {
            restrict: 'A',
            link: linker
        };
    }]);

    module.controller("Diamond", function ($scope, $http, $timeout) {
        $scope.Diamond = {};

        var loopPromises = [];
        var promise = $http.get('@Url.Action("Getdata_For_DropDown", "Master")').then(function (response) {
            var RCodeList = [];
            for (var i = 0; i < response.data.RCodeList.length; i++) {
                var obj = { id: response.data.RCodeList[i]["RCode"], value: response.data.RCodeList[i]["RCode"] };
                RCodeList.push(obj);
            }
            $scope.GetRCodeList = RCodeList;
            $timeout(function () {
                $('#RCode').trigger('chosen:updated');
            }, 60);
        });
        loopPromises.push(promise);

        $scope.FatchData = function () {
            const RCode = $scope.Diamond.RCode;
            const FromDate = $('#FromDate').val();
            const ToDate = $('#ToDate').val();

            if (!RCode && !FromDate && !ToDate) {
                Noty("error", "Please Select RCode.");
                return;
            }

            if (RCode) {
                if (FromDate || ToDate) {
                    Noty("error", "You Can Only Select RCode OR Date");
                    return;
                }
            }

            if (FromDate || ToDate) {
                if (FromDate && !ToDate) {
                    Noty("error", "Please Select ToDate.");
                    return;
                }
                if (!FromDate && ToDate) {
                    Noty("error", "Please Select FromDate.");
                    return;
                }
                if (FromDate != "" && ToDate != "") {
                    if (new Date(FromDate) > new Date(ToDate)) {
                        Noty("error", "Please Select Valid ToDate!");
                        return;
                    }
                }
                if (RCode) {
                    Noty("error", "You Can Only Select RCode OR Date");
                    return;
                }
            }

            show_loader();
            $http({
                method: "POST",
                url: '@Url.Action("RP_Pridiction_Getdata", "Report")',
                data: { RCode, FromDate, ToDate }
            }).then(function (response) {
                hide_loader();
                List = response.data.List;
                DataField = response.data.DataField;
                DataFieldSummary = response.data.DataFieldSummary;

                GridData();
            }).catch(function (error) {
                hide_loader();
                Noty("error", "Error loading prediction data.");
            });
        };

        const GridData = () => {
            $("#gridContainer").dxDataGrid({
                dataSource: List,
                columns: DataField,
                editing: {
                    allowUpdating: false,
                    allowDeleting: false,
                    useIcons: true,
                },
                keyExpr: 'ID',
                columnAutoWidth: true,
                columnResizingMode: 'widget',
                allowColumnResizing: true,
                showColumnLines: true,
                showRowLines: true,
                showBorders: true,
                height: 'calc(100vh - 210px)',
                paging: { enabled: false },
                sorting: { mode: "multiple" },
                scrolling: {
                    mode: 'virtual',
                },
                filterRow: {
                    visible: true,
                    applyFilter: 'auto',
                },
                filterPanel: { visible: true },
                searchPanel: {
                    visible: true,
                    width: 240,
                    placeholder: 'Search...',
                },
                loadPanel: {
                    enabled: true,
                    showPane: false,
                    indicatorSrc: '/Content/icons/Loader.gif',
                },
                headerFilter: {
                    visible: true,
                },
                pager: {
                    visible: false,
                },
                selection: {
                    mode: 'single',
                },
                keyboardNavigation: {
                    enterKeyAction: 'moveFocus',
                    enterKeyDirection: 'column',
                    editOnKeyPress: true,
                },
                summary: {
                    totalItems: DataFieldSummary
                },
                export: {
                    enabled: true,
                    formats: ['xlxs'],
                    allowExportSelectedData: false,
                },
                onExporting(e) {
                    if (e.format == 'pdf') {
                        const doc = new jsPDF();

                        DevExpress.pdfExporter.exportDataGrid({
                            jsPDFDocument: doc,
                            component: e.component,
                            indent: 5,
                        }).then(() => {
                            doc.save('Labour.pdf');
                        });
                    }
                    else if (e.format == 'xlxs') {
                        const workbook = new ExcelJS.Workbook();
                        const worksheet = workbook.addWorksheet('Details');

                        DevExpress.excelExporter.exportDataGrid({
                            component: e.component,
                            worksheet,
                            autoFilterEnabled: true,
                        }).then(() => {
                            workbook.xlsx.writeBuffer().then((buffer) => {
                                saveAs(new Blob([buffer], { type: 'application/octet-stream' }), 'Pridiction Details.xlsx');
                            });
                        });
                    }
                },
            });
        };

        $scope.ExcelExport = function () {
            const RCode = $scope.Diamond.RCode;
            const FromDate = $('#FromDate').val();
            const ToDate = $('#ToDate').val();

            if (!RCode && !FromDate && !ToDate) {
                Noty("error", "Please Select RCode.");
                return;
            }

            if (RCode) {
                if (FromDate || ToDate) {
                    Noty("error", "You Can Only Select RCode OR Date");
                    return;
                }
            }

            if (FromDate || ToDate) {
                if (FromDate && !ToDate) {
                    Noty("error", "Please Select ToDate.");
                    return;
                }
                if (!FromDate && ToDate) {
                    Noty("error", "Please Select FromDate.");
                    return;
                }
                if (FromDate != "" && ToDate != "") {
                    if (new Date(FromDate) > new Date(ToDate)) {
                        Noty("error", "Please Select Valid ToDate!");
                        return;
                    }
                }
                if (RCode) {
                    Noty("error", "You Can Only Select RCode OR Date");
                    return;
                }
            }

            show_loader();
            $http({
                method: "post",
                async: true,
                url: '@Url.Action("RP_Prd_Summary_Export", "Report")',
                data: JSON.stringify({ RCode, FromDate, ToDate }),
                dataType: "json"
            }).then(function (data) {
                hide_loader();
                $scope.DownloadExcel(data.data.Data);
            }).catch(function (error) {
                hide_loader();
                Noty("error", "Error exporting prediction summary.");
            });
        };

        $scope.DownloadExcel = function (path) {
            var url = '@Url.Action("DownloadExcel", "Home")/?filepath=' + path;
            var hiddenIFrameID = 'hiddenDownloaderReportResult';
            var iframe = document.getElementById(hiddenIFrameID);
            if (iframe === null) {
                iframe = document.createElement('iframe');
                iframe.id = hiddenIFrameID;
                iframe.style.display = 'none';
                document.body.appendChild(iframe);
            }
            iframe.src = url;
        };
    });
</script>
<script>
    $(document).ready(function () {
        $('#FromDate, #ToDate').datepicker({
            format: "dd-M-yyyy",
            autoclose: true,
            todayHighlight: true
        });

        // Ensure clicking or tapping on mobile immediately opens the datepicker
        $(document).on('click focus touchstart', '#FromDate, #ToDate', function (e) {
            if (!$(this).prop('disabled')) {
                $(this).datepicker('show');
            }
        });
    });
</script>
