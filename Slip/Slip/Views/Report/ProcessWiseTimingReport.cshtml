@{
    ViewBag.Title = "Process Wise Timing Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* ==========================================================================
       Process Wise Timing Report - SaaS Card View & Ice Blue Theming
       ========================================================================== */
    @@keyframes fadeInUpSmooth {
        from {
            opacity: 0;
            transform: translateY(10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .timing-page {
        padding: 0 !important;
        margin-top: 0 !important;
        margin-bottom: 0 !important;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    }

    /* Staggered Card Entrance Animations */
    .timing-header-card { animation: fadeInUpSmooth 0.35s cubic-bezier(0.16, 1, 0.3, 1) 0.05s both; }
    .timing-main-card { animation: fadeInUpSmooth 0.35s cubic-bezier(0.16, 1, 0.3, 1) 0.15s both; }

    /* Page Header Card - Balanced z-index & overflow visible for Chosen dropdown */
    .timing-header-card {
        background: #ffffff !important;
        border-radius: 12px !important;
        padding: 12px 18px !important;
        margin-bottom: 10px !important;
        box-shadow: 0 2px 10px rgba(15, 23, 42, 0.04) !important;
        border: 1.5px solid #cbd5e1 !important;
        border-left: 5px solid #0284c7 !important;
        display: flex !important;
        justify-content: space-between !important;
        align-items: center !important;
        flex-wrap: wrap !important;
        gap: 14px !important;
        position: relative !important;
        z-index: 50 !important;
        overflow: visible !important;
        transition: all 0.25s ease !important;
    }
    .timing-header-card:hover {
        box-shadow: 0 6px 18px rgba(15, 23, 42, 0.08) !important;
        border-color: #94a3b8 !important;
        border-left-color: #0369a1 !important;
    }

    .timing-header-left {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .timing-header-icon {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        box-shadow: 0 4px 12px rgba(2, 132, 199, 0.28);
        transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
        flex-shrink: 0;
    }
    .timing-header-card:hover .timing-header-icon {
        transform: scale(1.08) rotate(4deg);
    }

    .timing-header-title {
        font-size: 18px !important;
        font-weight: 700 !important;
        color: #0f172a !important;
        margin: 0 !important;
        line-height: 1.2 !important;
        letter-spacing: -0.2px;
    }

    .timing-breadcrumb {
        font-size: 11.5px;
        color: #64748b;
        margin-bottom: 3px;
        font-weight: 500;
    }
    .timing-breadcrumb a {
        color: #0284c7;
        text-decoration: none;
        transition: color 0.15s ease;
        font-weight: 500;
    }
    .timing-breadcrumb a:hover {
        color: #0369a1;
        text-decoration: underline;
    }

    /* Header Actions Toolbar */
    .timing-header-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        position: relative;
        z-index: 1060;
    }

    .timing-filter-label {
        font-size: 12px;
        font-weight: 700;
        color: #475569;
        margin: 0;
        white-space: nowrap;
    }

    .timing-date-wrap {
        position: relative;
        display: inline-flex;
        align-items: center;
    }

    .timing-date-input {
        height: 36px;
        padding: 5px 12px;
        font-size: 12.5px;
        color: #1e293b;
        background-color: #f8fafc;
        border: 1.5px solid #cbd5e1;
        border-radius: 8px;
        outline: none;
        transition: all 0.2s ease;
        font-weight: 600;
        width: 135px;
        cursor: pointer;
    }
    .timing-date-input:focus {
        border-color: #0284c7;
        background-color: #ffffff;
        box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.15);
    }

    /* Chosen Custom Dropdown Styling */
    .timing-select-wrap {
        width: 160px;
        position: relative;
        z-index: 1070;
    }

    .timing-select-wrap .chosen-container {
        width: 100% !important;
        font-size: 12.5px !important;
        position: relative !important;
    }

    .timing-select-wrap .chosen-container-single .chosen-single {
        height: 36px;
        line-height: 34px;
        border-radius: 8px;
        border: 1.5px solid #cbd5e1;
        background: #f8fafc;
        color: #1e293b;
        font-size: 12.5px;
        font-weight: 600;
        box-shadow: none;
        padding: 0 10px;
        transition: all 0.2s ease;
    }
    .timing-select-wrap .chosen-container-active.chosen-with-drop .chosen-single {
        border-color: #0284c7;
        background: #ffffff;
        box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.15);
    }

    .timing-select-wrap .chosen-container .chosen-drop {
        border-radius: 8px !important;
        border: 1.5px solid #cbd5e1 !important;
        box-shadow: 0 12px 28px rgba(15, 23, 42, 0.18) !important;
        font-size: 12.5px !important;
        background: #ffffff !important;
        z-index: 999999 !important;
        margin-top: 4px !important;
    }

    .timing-select-wrap .chosen-container .chosen-results {
        max-height: 240px !important;
        overflow-y: auto !important;
        padding: 4px 0 !important;
        margin: 0 !important;
    }

    .timing-select-wrap .chosen-container .chosen-results li {
        padding: 7px 12px !important;
        line-height: 1.4 !important;
        color: #1e293b !important;
        font-size: 12.5px !important;
    }

    .timing-select-wrap .chosen-container .chosen-results li.highlighted {
        background: #0284c7 !important;
        color: #ffffff !important;
    }

    .timing-select-wrap .chosen-container-single .chosen-search input[type="text"] {
        border-radius: 6px !important;
        border: 1px solid #cbd5e1 !important;
        padding: 5px 8px !important;
        font-size: 12px !important;
        outline: none !important;
    }
    .timing-select-wrap .chosen-container-single .chosen-search input[type="text"]:focus {
        border-color: #0284c7 !important;
        box-shadow: 0 0 0 2px rgba(2, 132, 199, 0.15) !important;
    }

    /* Action Buttons */
    .btn-timing-fetch {
        background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%) !important;
        color: #ffffff !important;
        border: none !important;
        border-radius: 8px !important;
        padding: 8px 18px !important;
        font-size: 12.5px !important;
        font-weight: 700 !important;
        display: inline-flex !important;
        align-items: center !important;
        gap: 6px !important;
        box-shadow: 0 2px 8px rgba(2, 132, 199, 0.3) !important;
        transition: all 0.2s ease !important;
        cursor: pointer !important;
        white-space: nowrap !important;
    }
    .btn-timing-fetch:hover {
        background: linear-gradient(135deg, #0369a1 0%, #075985 100%) !important;
        transform: translateY(-1px) !important;
        box-shadow: 0 4px 12px rgba(2, 132, 199, 0.4) !important;
        color: #ffffff !important;
    }

    .btn-timing-excel {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%) !important;
        color: #ffffff !important;
        border: none !important;
        border-radius: 8px !important;
        padding: 8px 18px !important;
        font-size: 12.5px !important;
        font-weight: 700 !important;
        display: inline-flex !important;
        align-items: center !important;
        gap: 6px !important;
        box-shadow: 0 2px 8px rgba(16, 185, 129, 0.28) !important;
        transition: all 0.2s ease !important;
        cursor: pointer !important;
        white-space: nowrap !important;
    }
    .btn-timing-excel:hover {
        background: linear-gradient(135deg, #059669 0%, #047857 100%) !important;
        transform: translateY(-1px) !important;
        box-shadow: 0 4px 12px rgba(16, 185, 129, 0.4) !important;
        color: #ffffff !important;
    }

    /* Main Container Card */
    .timing-main-card {
        background: #ffffff !important;
        border-radius: 12px !important;
        padding: 16px !important;
        box-shadow: 0 2px 10px rgba(15, 23, 42, 0.04) !important;
        border: 1.5px solid #cbd5e1 !important;
        position: relative !important;
        z-index: 1 !important;
        transition: all 0.25s ease !important;
    }
    .timing-main-card:hover {
        box-shadow: 0 6px 18px rgba(15, 23, 42, 0.08) !important;
        border-color: #94a3b8 !important;
    }

    .timing-grid-layout {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 16px;
    }

    /* Sub Cards for Tables */
    .timing-sub-card {
        background: #ffffff;
        border: 1.5px solid #e2e8f0;
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 1px 4px rgba(15, 23, 42, 0.03);
        transition: all 0.2s ease;
    }
    .timing-sub-card:hover {
        border-color: #cbd5e1;
        box-shadow: 0 4px 12px rgba(15, 23, 42, 0.06);
    }

    .timing-sub-header {
        padding: 10px 14px;
        font-size: 13.5px;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: space-between;
        letter-spacing: -0.1px;
    }
    .header-jumbo-white {
        background: linear-gradient(135deg, #fef2f2 0%, #fee2e2 100%);
        color: #991b1b;
        border-bottom: 2px solid #fecaca;
    }
    .header-jumbo-color {
        background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%);
        color: #92400e;
        border-bottom: 2px solid #fde68a;
    }
    .header-small-white {
        background: linear-gradient(135deg, #ecfdf5 0%, #d1fae5 100%);
        color: #065f46;
        border-bottom: 2px solid #a7f3d0;
    }
    .header-small-color {
        background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%);
        color: #075985;
        border-bottom: 2px solid #bae6fd;
    }

    .timing-table-wrap {
        overflow-x: auto;
        width: 100%;
        max-height: 400px;
        overflow-y: auto;
    }

    .timing-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 12px;
        background: #ffffff;
    }

    .timing-table thead th {
        background: #f8fafc;
        color: #334155;
        font-weight: 700;
        font-size: 11.5px;
        padding: 9px 8px;
        text-align: center;
        border-bottom: 1.5px solid #e2e8f0;
        border-right: 1px solid #f1f5f9;
        text-transform: uppercase;
        letter-spacing: 0.3px;
        position: sticky;
        top: 0;
        z-index: 2;
    }
    .timing-table thead th:last-child {
        border-right: none;
    }

    .timing-table tbody td {
        padding: 7px 8px;
        text-align: center;
        border-bottom: 1px solid #f1f5f9;
        border-right: 1px solid #f8fafc;
        color: #1e293b;
        font-weight: 500;
        transition: background-color 0.15s ease;
    }
    .timing-table tbody td:last-child {
        border-right: none;
    }
    .timing-table tbody tr:nth-child(even) {
        background-color: #fafbfc;
    }
    .timing-table tbody tr:hover {
        background-color: #f1f8fe !important;
    }

    .timing-empty-cell {
        padding: 32px 16px !important;
        text-align: center !important;
        color: #94a3b8 !important;
        font-size: 12.5px !important;
        font-weight: 500 !important;
        background: #ffffff !important;
    }

    /* Responsive Design */
    @@media (max-width: 992px) {
        .timing-header-card {
            flex-direction: column !important;
            align-items: stretch !important;
            padding: 12px 14px !important;
            gap: 12px !important;
        }

        .timing-header-left {
            width: 100%;
        }

        .timing-header-actions {
            width: 100%;
            display: flex;
            flex-direction: row;
            flex-wrap: wrap;
            gap: 8px;
        }

        .timing-grid-layout {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 768px) {
        .timing-header-actions {
            flex-direction: column;
        }

        .timing-date-wrap,
        .timing-date-input,
        .timing-select-wrap,
        .btn-timing-fetch,
        .btn-timing-excel {
            width: 100% !important;
            justify-content: center !important;
            text-align: center !important;
        }
    }
</style>

<div ng-controller="Diamond" class="timing-page">
    <!-- Top Header Card (SaaS Ice-Blue Theme with Action Toolbar) -->
    <div class="timing-header-card">
        <div class="timing-header-left">
            <div class="timing-header-icon">
                <i class="fa fa-clock-o"></i>
            </div>
            <div>
                <div class="timing-breadcrumb">
                    <a href="@Url.Action("Index", "Home")"><i class="fa fa-home"></i> Home</a> / 
                    <span>Report</span> / 
                    <span>Process Wise Timing Report</span>
                </div>
                <h4 class="timing-header-title">Process Wise Timing Report</h4>
            </div>
        </div>

        <!-- Header Actions Toolbar (Date, Table Select, Fetch, Excel) -->
        <div class="timing-header-actions">
            <!-- Date Filter -->
            <span class="timing-filter-label">Date:</span>
            <div class="timing-date-wrap">
                <input id="reportDate" type="text" class="timing-date-input" placeholder="dd-M-yyyy" autocomplete="off" ng-model="Diamond.reportDate" readonly />
            </div>

            <!-- Table Dropdown -->
            <div class="timing-select-wrap">
                <select id="TableNo" chosen="GetTableList" class="form-control input-sm" ng-options="item.id as item.value for item in GetTableList" ng-model="Diamond.TableNo">
                    <option value="">Table Select</option>
                </select>
            </div>

            <!-- Action Buttons -->
            <button class="btn-timing-fetch" type="button" ng-click="FetchData()">
                <i class="fa fa-search"></i> Fetch
            </button>
            <button class="btn-timing-excel" type="button" ng-click="ExcelExport()">
                <i class="fa fa-file-excel-o"></i> Excel
            </button>
        </div>
    </div>

    <!-- Main Card View Container (2x2 Grid Layout) -->
    <div class="timing-main-card">
        <div class="timing-grid-layout">
            <!-- 1. Jambo White (40 days) -->
            <div class="timing-sub-card">
                <div class="timing-sub-header header-jumbo-white">
                    <span><i class="fa fa-cubes"></i> JAMBO WHITE (40 days)</span>
                    <span class="badge" style="background: rgba(153, 27, 27, 0.15); color: #991b1b; font-weight: 700;">{{JumboWhite.length || 0}} Items</span>
                </div>
                <div class="timing-table-wrap">
                    <table class="timing-table" id="JumboWhiteTable">
                        <thead>
                            <tr>
                                <th>Process</th>
                                <th>Days</th>
                                <th>Max Prc Days</th>
                                <th>Total Pcs</th>
                                <th>On-Time %</th>
                                <th>Over-Time %</th>
                            </tr>
                        </thead>
                        <tbody id="JumboWhiteTableBody">
                            <tr ng-repeat="item in JumboWhite">
                                <td style="font-weight: 600; text-align: left; padding-left: 12px;">{{item.Process}}</td>
                                <td>{{item.Days}}</td>
                                <td>{{item.MaxPrcDays}}</td>
                                <td>{{item.TotalPcs}}</td>
                                <td ng-style="getOnTimeStyle(item.ONTIMEPer)">
                                    {{item.ONTIMEPer}}%
                                </td>
                                <td ng-style="getOverTimeStyle(item.OVERDAYPer)">
                                    {{item.OVERDAYPer}}%
                                </td>
                            </tr>
                            <tr ng-if="!JumboWhite || JumboWhite.length == 0">
                                <td colspan="6" class="timing-empty-cell">
                                    <i class="fa fa-info-circle"></i> No data available. Select date and click Fetch.
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- 2. Jambo Color (40 days) -->
            <div class="timing-sub-card">
                <div class="timing-sub-header header-jumbo-color">
                    <span><i class="fa fa-diamond"></i> JAMBO COLOR (40 days)</span>
                    <span class="badge" style="background: rgba(146, 64, 14, 0.15); color: #92400e; font-weight: 700;">{{JumboColor.length || 0}} Items</span>
                </div>
                <div class="timing-table-wrap">
                    <table class="timing-table" id="JumboColorTable">
                        <thead>
                            <tr>
                                <th>Process</th>
                                <th>Days</th>
                                <th>Max Prc Days</th>
                                <th>Total Pcs</th>
                                <th>On-Time %</th>
                                <th>Over-Time %</th>
                            </tr>
                        </thead>
                        <tbody id="JumboColorTableBody">
                            <tr ng-repeat="item in JumboColor">
                                <td style="font-weight: 600; text-align: left; padding-left: 12px;">{{item.Process}}</td>
                                <td>{{item.Days}}</td>
                                <td>{{item.MaxPrcDays}}</td>
                                <td>{{item.TotalPcs}}</td>
                                <td ng-style="getOnTimeStyle(item.ONTIMEPer)">
                                    {{item.ONTIMEPer}}%
                                </td>
                                <td ng-style="getOverTimeStyle(item.OVERDAYPer)">
                                    {{item.OVERDAYPer}}%
                                </td>
                            </tr>
                            <tr ng-if="!JumboColor || JumboColor.length == 0">
                                <td colspan="6" class="timing-empty-cell">
                                    <i class="fa fa-info-circle"></i> No data available. Select date and click Fetch.
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- 3. Small White (64 days) -->
            <div class="timing-sub-card">
                <div class="timing-sub-header header-small-white">
                    <span><i class="fa fa-cubes"></i> SMALL WHITE (64 days)</span>
                    <span class="badge" style="background: rgba(6, 95, 70, 0.15); color: #065f46; font-weight: 700;">{{SmallWhite.length || 0}} Items</span>
                </div>
                <div class="timing-table-wrap">
                    <table class="timing-table" id="SmallWhiteTable">
                        <thead>
                            <tr>
                                <th>Process</th>
                                <th>Days</th>
                                <th>Max Prc Days</th>
                                <th>Total Pcs</th>
                                <th>On-Time %</th>
                                <th>Over-Time %</th>
                            </tr>
                        </thead>
                        <tbody id="SmallWhiteTableBody">
                            <tr ng-repeat="item in SmallWhite">
                                <td style="font-weight: 600; text-align: left; padding-left: 12px;">{{item.Process}}</td>
                                <td>{{item.Days}}</td>
                                <td>{{item.MaxPrcDays}}</td>
                                <td>{{item.TotalPcs}}</td>
                                <td ng-style="getOnTimeStyle(item.ONTIMEPer)">
                                    {{item.ONTIMEPer}}%
                                </td>
                                <td ng-style="getOverTimeStyle(item.OVERDAYPer)">
                                    {{item.OVERDAYPer}}%
                                </td>
                            </tr>
                            <tr ng-if="!SmallWhite || SmallWhite.length == 0">
                                <td colspan="6" class="timing-empty-cell">
                                    <i class="fa fa-info-circle"></i> No data available. Select date and click Fetch.
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- 4. Small Color (64 days) -->
            <div class="timing-sub-card">
                <div class="timing-sub-header header-small-color">
                    <span><i class="fa fa-diamond"></i> SMALL COLOR (64 days)</span>
                    <span class="badge" style="background: rgba(7, 89, 133, 0.15); color: #075985; font-weight: 700;">{{SmallColor.length || 0}} Items</span>
                </div>
                <div class="timing-table-wrap">
                    <table class="timing-table" id="SmallColorTable">
                        <thead>
                            <tr>
                                <th>Process</th>
                                <th>Days</th>
                                <th>Max Prc Days</th>
                                <th>Total Pcs</th>
                                <th>On-Time %</th>
                                <th>Over-Time %</th>
                            </tr>
                        </thead>
                        <tbody id="SmallColorTableBody">
                            <tr ng-repeat="item in SmallColor">
                                <td style="font-weight: 600; text-align: left; padding-left: 12px;">{{item.Process}}</td>
                                <td>{{item.Days}}</td>
                                <td>{{item.MaxPrcDays}}</td>
                                <td>{{item.TotalPcs}}</td>
                                <td ng-style="getOnTimeStyle(item.ONTIMEPer)">
                                    {{item.ONTIMEPer}}%
                                </td>
                                <td ng-style="getOverTimeStyle(item.OVERDAYPer)">
                                    {{item.OVERDAYPer}}%
                                </td>
                            </tr>
                            <tr ng-if="!SmallColor || SmallColor.length == 0">
                                <td colspan="6" class="timing-empty-cell">
                                    <i class="fa fa-info-circle"></i> No data available. Select date and click Fetch.
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    var List = "";
    var DataField = "";

    var module;
    try {
        module = angular.module('app');
    } catch (e) {
        module = angular.module('app', ['ngTouch', 'ui.grid', 'ui.grid.edit', 'ui.grid.rowEdit', 'ui.grid.cellNav', 'ui.grid.pagination', 'ui.grid.moveColumns', 'ui.grid.exporter', 'ui.grid.pinning', 'ui.grid.resizeColumns', 'angularjs-dropdown-multiselect']);
    }

    module.directive('chosen', ['$timeout', function ($timeout) {
        var linker = function (scope, element, attrs) {
            var list = attrs['chosen'];

            if (list) {
                scope.$watchCollection(list, function () {
                    $timeout(function () {
                        element.trigger('chosen:updated');
                    }, 50);
                });
            }

            if (attrs['ngModel']) {
                scope.$watch(attrs['ngModel'], function () {
                    $timeout(function () {
                        element.trigger('chosen:updated');
                    }, 50);
                });
            }

            element.chosen({ width: '100%', search_contains: true, allow_single_deselect: true });
        };

        return {
            restrict: 'A',
            link: linker
        };
    }]);

    module.controller("Diamond", ['$scope', '$filter', '$http', '$q', '$interval', '$timeout', function ($scope, $filter, $http, $q, $interval, $timeout) {
        $scope.Diamond = {};
        $scope.JumboWhite = [];
        $scope.JumboColor = [];
        $scope.SmallWhite = [];
        $scope.SmallColor = [];

        var loopPromises = [];
        var promise = $http.get('@Url.Action("Getdata_For_DropDown", "Master")').then(function (response) {
            var TableList = [];
            for (var i = 0; i < response.data.TableList.length; i++) {
                var obj = { id: response.data.TableList[i]["TableID"], value: response.data.TableList[i]["TableNo"] };
                TableList.push(obj);
            }
            $scope.GetTableList = TableList;
            $timeout(function () {
                $('#TableNo').trigger('chosen:updated');
            }, 60);
        });
        loopPromises.push(promise);

        // ON-TIME → Green (Light → Dark)
        $scope.getOnTimeStyle = function (percent) {
            percent = parseFloat(percent) || 0;

            if (percent === 0) {
                return { 'background-color': '#ffffff', 'color': '#64748b' };
            }

            let BgColor;
            if (percent > 1 && percent <= 20) {
                BgColor = "#dcfce7";
            } else if (percent > 20 && percent <= 40) {
                BgColor = "#bbf7d0";
            } else if (percent > 40 && percent <= 60) {
                BgColor = "#86efac";
            } else if (percent > 60 && percent <= 80) {
                BgColor = "#4ade80";
            } else if (percent > 80) {
                BgColor = "#22c55e";
            }

            return {
                'background-color': BgColor,
                'color': percent > 60 ? '#ffffff' : '#14532d',
                'font-weight': '700'
            };
        };

        // OVER-TIME → Red (Light → Dark)
        $scope.getOverTimeStyle = function (percent) {
            percent = parseFloat(percent) || 0;

            if (percent === 0) {
                return { 'background-color': '#ffffff', 'color': '#64748b' };
            }

            let BgColor;
            if (percent > 1 && percent <= 20) {
                BgColor = "#fee2e2";
            } else if (percent > 20 && percent <= 40) {
                BgColor = "#fecaca";
            } else if (percent > 40 && percent <= 60) {
                BgColor = "#fca5a5";
            } else if (percent > 60 && percent <= 80) {
                BgColor = "#f87171";
            } else if (percent > 80) {
                BgColor = "#ef4444";
            }

            return {
                'background-color': BgColor,
                'color': percent > 60 ? '#ffffff' : '#7f1d1d',
                'font-weight': '700'
            };
        };

        $scope.FetchData = function () {
            const selectedDate = $("#reportDate").val();
            if (!selectedDate) {
                Noty("error", "Please select a date.");
                return;
            }

            show_loader();
            $http({
                method: "post",
                async: true,
                url: '@Url.Action("GetData_For_Process_Wise_Timing_Report", "Report")',
                data: { Date: selectedDate, TableNo: $scope.Diamond.TableNo },
                dataType: "json"
            }).then(function (response) {
                hide_loader();
                $scope.JumboWhite = response.data.List || [];
                $scope.JumboColor = response.data.List1 || [];
                $scope.SmallWhite = response.data.List2 || [];
                $scope.SmallColor = response.data.List3 || [];
            }).catch(function (error) {
                hide_loader();
                Noty("error", "Error loading process wise timing report.");
            });
        };

        $scope.ExcelExport = function () {
            const selectedDate = $("#reportDate").val();
            if (!selectedDate) {
                Noty("error", "Please select a date.");
                return;
            }

            show_loader();
            $http({
                method: "post",
                async: true,
                url: '@Url.Action("Get_DataList_Process_Wise_Timing_Excel", "Report")',
                data: { Date: selectedDate, TableNo: $scope.Diamond.TableNo },
                dataType: "json"
            }).then(function (response) {
                hide_loader();
                $scope.DownloadExcel(response.data);
            }).catch(function (error) {
                hide_loader();
                Noty("error", "Error exporting process wise timing report.");
            });
        };

        $scope.DownloadExcel = function (path) {
            var url = '@Url.Action("DownloadExcel", "Home")/?filepath=' + (path ? path.Data : '');
            var hiddenIFrameID = 'hiddenDownloaderReportResult';
            var iframe = document.getElementById(hiddenIFrameID);
            if (iframe === null) {
                iframe = document.createElement('iframe');
                iframe.id = hiddenIFrameID;
                iframe.style.display = 'none';
                document.body.appendChild(iframe);
            }
            iframe.src = url;
        };
    }]);
</script>
<script>
    $(document).ready(function () {
        $('#reportDate').datepicker({
            format: "dd-M-yyyy",
            autoclose: true,
            todayHighlight: true
        });

        // Mobile touch & focus triggering
        $(document).on('click focus touchstart', '#reportDate', function (e) {
            if (!$(this).prop('disabled')) {
                $(this).datepicker('show');
            }
        });
    });
</script>