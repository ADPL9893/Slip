@{
    ViewBag.Title = "Process Wise Timing Report";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}


<div ng-controller="Diamond" class="timing-page">
    <!-- Top Header Card (SaaS Ice-Blue Theme with Action Toolbar) -->
    <div class="timing-header-card">
        <div class="timing-header-left">
            <div class="timing-header-icon">
                <i class="fa fa-clock-o"></i>
            </div>
            <div>
                <div class="timing-breadcrumb">
                    <a href="@Url.Action("Index", "Home")"><i class="fa fa-home"></i> Home</a> / 
                    <span>Report</span> / 
                    <span>Process Wise Timing Report</span>
                </div>
                <h4 class="timing-header-title">Process Wise Timing Report</h4>
            </div>
        </div>

        <!-- Header Actions Toolbar (Date, Table Select, Fetch, Excel) -->
        <div class="timing-header-actions">
            <!-- Date Filter -->
            <span class="timing-filter-label">Date:</span>
            <div class="timing-date-wrap">
                <input id="reportDate" type="text" class="timing-date-input" placeholder="dd-M-yyyy" autocomplete="off" ng-model="Diamond.reportDate" readonly />
            </div>

            <!-- Table Dropdown -->
            <div class="timing-select-wrap">
                <select id="TableNo" chosen="GetTableList" class="form-control input-sm" ng-options="item.id as item.value for item in GetTableList" ng-model="Diamond.TableNo">
                    <option value="">Table Select</option>
                </select>
            </div>

            <!-- Action Buttons -->
            <button class="btn-timing-fetch" type="button" ng-click="FetchData()">
                <i class="fa fa-search"></i> Fetch
            </button>
            <button class="btn-timing-excel" type="button" ng-click="ExcelExport()">
                <i class="fa fa-file-excel-o"></i> Excel
            </button>
        </div>
    </div>

    <!-- Main Card View Container (2x2 Grid Layout) -->
    <div class="timing-main-card">
        <div class="timing-grid-layout">
            <!-- 1. Jambo White (40 days) -->
            <div class="timing-sub-card">
                <div class="timing-sub-header header-jumbo-white">
                    <span><i class="fa fa-cubes"></i> JAMBO WHITE (40 days)</span>
                    <span class="badge" style="background: rgba(153, 27, 27, 0.15); color: #991b1b; font-weight: 700;">{{JumboWhite.length || 0}} Items</span>
                </div>
                <div class="timing-table-wrap">
                    <table class="timing-table" id="JumboWhiteTable">
                        <thead>
                            <tr>
                                <th>Process</th>
                                <th>Days</th>
                                <th>Max Prc Days</th>
                                <th>Total Pcs</th>
                                <th>On-Time %</th>
                                <th>Over-Time %</th>
                            </tr>
                        </thead>
                        <tbody id="JumboWhiteTableBody">
                            <tr ng-repeat="item in JumboWhite">
                                <td style="font-weight: 600; text-align: left; padding-left: 12px;">{{item.Process}}</td>
                                <td>{{item.Days}}</td>
                                <td>{{item.MaxPrcDays}}</td>
                                <td>{{item.TotalPcs}}</td>
                                <td ng-style="getOnTimeStyle(item.ONTIMEPer)">
                                    {{item.ONTIMEPer}}%
                                </td>
                                <td ng-style="getOverTimeStyle(item.OVERDAYPer)">
                                    {{item.OVERDAYPer}}%
                                </td>
                            </tr>
                            <tr ng-if="!JumboWhite || JumboWhite.length == 0">
                                <td colspan="6" class="timing-empty-cell">
                                    <i class="fa fa-info-circle"></i> No data available. Select date and click Fetch.
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- 2. Jambo Color (40 days) -->
            <div class="timing-sub-card">
                <div class="timing-sub-header header-jumbo-color">
                    <span><i class="fa fa-diamond"></i> JAMBO COLOR (40 days)</span>
                    <span class="badge" style="background: rgba(146, 64, 14, 0.15); color: #92400e; font-weight: 700;">{{JumboColor.length || 0}} Items</span>
                </div>
                <div class="timing-table-wrap">
                    <table class="timing-table" id="JumboColorTable">
                        <thead>
                            <tr>
                                <th>Process</th>
                                <th>Days</th>
                                <th>Max Prc Days</th>
                                <th>Total Pcs</th>
                                <th>On-Time %</th>
                                <th>Over-Time %</th>
                            </tr>
                        </thead>
                        <tbody id="JumboColorTableBody">
                            <tr ng-repeat="item in JumboColor">
                                <td style="font-weight: 600; text-align: left; padding-left: 12px;">{{item.Process}}</td>
                                <td>{{item.Days}}</td>
                                <td>{{item.MaxPrcDays}}</td>
                                <td>{{item.TotalPcs}}</td>
                                <td ng-style="getOnTimeStyle(item.ONTIMEPer)">
                                    {{item.ONTIMEPer}}%
                                </td>
                                <td ng-style="getOverTimeStyle(item.OVERDAYPer)">
                                    {{item.OVERDAYPer}}%
                                </td>
                            </tr>
                            <tr ng-if="!JumboColor || JumboColor.length == 0">
                                <td colspan="6" class="timing-empty-cell">
                                    <i class="fa fa-info-circle"></i> No data available. Select date and click Fetch.
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- 3. Small White (64 days) -->
            <div class="timing-sub-card">
                <div class="timing-sub-header header-small-white">
                    <span><i class="fa fa-cubes"></i> SMALL WHITE (64 days)</span>
                    <span class="badge" style="background: rgba(6, 95, 70, 0.15); color: #065f46; font-weight: 700;">{{SmallWhite.length || 0}} Items</span>
                </div>
                <div class="timing-table-wrap">
                    <table class="timing-table" id="SmallWhiteTable">
                        <thead>
                            <tr>
                                <th>Process</th>
                                <th>Days</th>
                                <th>Max Prc Days</th>
                                <th>Total Pcs</th>
                                <th>On-Time %</th>
                                <th>Over-Time %</th>
                            </tr>
                        </thead>
                        <tbody id="SmallWhiteTableBody">
                            <tr ng-repeat="item in SmallWhite">
                                <td style="font-weight: 600; text-align: left; padding-left: 12px;">{{item.Process}}</td>
                                <td>{{item.Days}}</td>
                                <td>{{item.MaxPrcDays}}</td>
                                <td>{{item.TotalPcs}}</td>
                                <td ng-style="getOnTimeStyle(item.ONTIMEPer)">
                                    {{item.ONTIMEPer}}%
                                </td>
                                <td ng-style="getOverTimeStyle(item.OVERDAYPer)">
                                    {{item.OVERDAYPer}}%
                                </td>
                            </tr>
                            <tr ng-if="!SmallWhite || SmallWhite.length == 0">
                                <td colspan="6" class="timing-empty-cell">
                                    <i class="fa fa-info-circle"></i> No data available. Select date and click Fetch.
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- 4. Small Color (64 days) -->
            <div class="timing-sub-card">
                <div class="timing-sub-header header-small-color">
                    <span><i class="fa fa-diamond"></i> SMALL COLOR (64 days)</span>
                    <span class="badge" style="background: rgba(7, 89, 133, 0.15); color: #075985; font-weight: 700;">{{SmallColor.length || 0}} Items</span>
                </div>
                <div class="timing-table-wrap">
                    <table class="timing-table" id="SmallColorTable">
                        <thead>
                            <tr>
                                <th>Process</th>
                                <th>Days</th>
                                <th>Max Prc Days</th>
                                <th>Total Pcs</th>
                                <th>On-Time %</th>
                                <th>Over-Time %</th>
                            </tr>
                        </thead>
                        <tbody id="SmallColorTableBody">
                            <tr ng-repeat="item in SmallColor">
                                <td style="font-weight: 600; text-align: left; padding-left: 12px;">{{item.Process}}</td>
                                <td>{{item.Days}}</td>
                                <td>{{item.MaxPrcDays}}</td>
                                <td>{{item.TotalPcs}}</td>
                                <td ng-style="getOnTimeStyle(item.ONTIMEPer)">
                                    {{item.ONTIMEPer}}%
                                </td>
                                <td ng-style="getOverTimeStyle(item.OVERDAYPer)">
                                    {{item.OVERDAYPer}}%
                                </td>
                            </tr>
                            <tr ng-if="!SmallColor || SmallColor.length == 0">
                                <td colspan="6" class="timing-empty-cell">
                                    <i class="fa fa-info-circle"></i> No data available. Select date and click Fetch.
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    var List = "";
    var DataField = "";

    var module;
    try {
        module = angular.module('app');
    } catch (e) {
        module = angular.module('app', ['ngTouch', 'ui.grid', 'ui.grid.edit', 'ui.grid.rowEdit', 'ui.grid.cellNav', 'ui.grid.pagination', 'ui.grid.moveColumns', 'ui.grid.exporter', 'ui.grid.pinning', 'ui.grid.resizeColumns', 'angularjs-dropdown-multiselect']);
    }

    module.directive('chosen', ['$timeout', function ($timeout) {
        var linker = function (scope, element, attrs) {
            var list = attrs['chosen'];

            if (list) {
                scope.$watchCollection(list, function () {
                    $timeout(function () {
                        element.trigger('chosen:updated');
                    }, 50);
                });
            }

            if (attrs['ngModel']) {
                scope.$watch(attrs['ngModel'], function () {
                    $timeout(function () {
                        element.trigger('chosen:updated');
                    }, 50);
                });
            }

            element.chosen({ width: '100%', search_contains: true, allow_single_deselect: true });
        };

        return {
            restrict: 'A',
            link: linker
        };
    }]);

    module.controller("Diamond", ['$scope', '$filter', '$http', '$q', '$interval', '$timeout', function ($scope, $filter, $http, $q, $interval, $timeout) {
        $scope.Diamond = {};
        $scope.JumboWhite = [];
        $scope.JumboColor = [];
        $scope.SmallWhite = [];
        $scope.SmallColor = [];

        var loopPromises = [];
        var promise = $http.get('@Url.Action("Getdata_For_DropDown", "Master")').then(function (response) {
            var TableList = [];
            for (var i = 0; i < response.data.TableList.length; i++) {
                var obj = { id: response.data.TableList[i]["TableID"], value: response.data.TableList[i]["TableNo"] };
                TableList.push(obj);
            }
            $scope.GetTableList = TableList;
            $timeout(function () {
                $('#TableNo').trigger('chosen:updated');
            }, 60);
        });
        loopPromises.push(promise);

        // ON-TIME → Green (Light → Dark)
        $scope.getOnTimeStyle = function (percent) {
            percent = parseFloat(percent) || 0;

            if (percent === 0) {
                return { 'background-color': '#ffffff', 'color': '#64748b' };
            }

            let BgColor;
            if (percent > 1 && percent <= 20) {
                BgColor = "#dcfce7";
            } else if (percent > 20 && percent <= 40) {
                BgColor = "#bbf7d0";
            } else if (percent > 40 && percent <= 60) {
                BgColor = "#86efac";
            } else if (percent > 60 && percent <= 80) {
                BgColor = "#4ade80";
            } else if (percent > 80) {
                BgColor = "#22c55e";
            }

            return {
                'background-color': BgColor,
                'color': percent > 60 ? '#ffffff' : '#14532d',
                'font-weight': '700'
            };
        };

        // OVER-TIME → Red (Light → Dark)
        $scope.getOverTimeStyle = function (percent) {
            percent = parseFloat(percent) || 0;

            if (percent === 0) {
                return { 'background-color': '#ffffff', 'color': '#64748b' };
            }

            let BgColor;
            if (percent > 1 && percent <= 20) {
                BgColor = "#fee2e2";
            } else if (percent > 20 && percent <= 40) {
                BgColor = "#fecaca";
            } else if (percent > 40 && percent <= 60) {
                BgColor = "#fca5a5";
            } else if (percent > 60 && percent <= 80) {
                BgColor = "#f87171";
            } else if (percent > 80) {
                BgColor = "#ef4444";
            }

            return {
                'background-color': BgColor,
                'color': percent > 60 ? '#ffffff' : '#7f1d1d',
                'font-weight': '700'
            };
        };

        $scope.FetchData = function () {
            const selectedDate = $("#reportDate").val();
            if (!selectedDate) {
                Noty("error", "Please select a date.");
                return;
            }

            show_loader();
            $http({
                method: "post",
                async: true,
                url: '@Url.Action("GetData_For_Process_Wise_Timing_Report", "Report")',
                data: { Date: selectedDate, TableNo: $scope.Diamond.TableNo },
                dataType: "json"
            }).then(function (response) {
                hide_loader();
                $scope.JumboWhite = response.data.List || [];
                $scope.JumboColor = response.data.List1 || [];
                $scope.SmallWhite = response.data.List2 || [];
                $scope.SmallColor = response.data.List3 || [];
            }).catch(function (error) {
                hide_loader();
                Noty("error", "Error loading process wise timing report.");
            });
        };

        $scope.ExcelExport = function () {
            const selectedDate = $("#reportDate").val();
            if (!selectedDate) {
                Noty("error", "Please select a date.");
                return;
            }

            show_loader();
            $http({
                method: "post",
                async: true,
                url: '@Url.Action("Get_DataList_Process_Wise_Timing_Excel", "Report")',
                data: { Date: selectedDate, TableNo: $scope.Diamond.TableNo },
                dataType: "json"
            }).then(function (response) {
                hide_loader();
                $scope.DownloadExcel(response.data);
            }).catch(function (error) {
                hide_loader();
                Noty("error", "Error exporting process wise timing report.");
            });
        };

        $scope.DownloadExcel = function (path) {
            var url = '@Url.Action("DownloadExcel", "Home")/?filepath=' + (path ? path.Data : '');
            var hiddenIFrameID = 'hiddenDownloaderReportResult';
            var iframe = document.getElementById(hiddenIFrameID);
            if (iframe === null) {
                iframe = document.createElement('iframe');
                iframe.id = hiddenIFrameID;
                iframe.style.display = 'none';
                document.body.appendChild(iframe);
            }
            iframe.src = url;
        };
    }]);
</script>
<script>
    $(document).ready(function () {
        $('#reportDate').datepicker({
            format: "dd-M-yyyy",
            autoclose: true,
            todayHighlight: true
        });

        // Mobile touch & focus triggering
        $(document).on('click focus touchstart', '#reportDate', function (e) {
            if (!$(this).prop('disabled')) {
                $(this).datepicker('show');
            }
        });
    });
</script>