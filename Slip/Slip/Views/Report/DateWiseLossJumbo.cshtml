
@{
    ViewBag.Title = "DateWiseLossJumbo";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    label {
        margin-top: 5px;
    }

    #After4POkgrid .dx-datagrid-headers .dx-header-row > td, #After4POkgrid .dx-treelist-table .dx-header-row > td, #After4POkgrid .dx-pivotgrid-horizontal-headers > tr > td {
        font-size: 14px !important;
        background-color: #F2DCDB !important;
        color: black !important;
        padding-top: 8px !important;
        padding-bottom: 8px !important;
    }

    #After4POkgrid .dx-scrollable-scroll-content {
        background-color: #F2DCDB !important;
    }

    #After4POkgrid .dx-row td, #After4POkgrid .dx-datagrid-borders > .dx-datagrid-filter-panel {
        border: 1px solid #efb4b1 !important;
    }

    #After4POkgrid .dx-datagrid-total-footer > .dx-datagrid-content .dx-row > td {
        font-size: 14px !important;
        color: black !important;
        background-color: #F2DCDB !important;
        padding-top: 6px !important;
        padding-bottom: 6px !important;
        font-size: 15px;
    }

    #After4POkgrid .dx-datagrid-filter-panel .dx-datagrid-filter-panel-clear-filter, #After4POkgrid .dx-datagrid-filter-panel .dx-icon-filter, #After4POkgrid .dx-datagrid-filter-panel .dx-datagrid-filter-panel-text {
        color: black !important;
        font-size: 15px !important;
        line-height: 13px;
        font-weight: bold;
    }

    #After4POkgrid .dx-datagrid-headers .dx-datagrid-table .dx-row > td .dx-sort,
    #After4POkgrid .dx-datagrid-headers .dx-datagrid-table .dx-row > td:hover .dx-sort,
    #After4POkgrid .dx-datagrid-headers .dx-datagrid-table .dx-row > td .dx-sort-indicator,
    #After4POkgrid .dx-datagrid-headers .dx-datagrid-table .dx-row > td:hover .dx-datagrid-text-content,
    #After4POkgrid .dx-datagrid .dx-header-filter-empty {
        color: rgb(0 0 0) !important;
    }
</style>
<div ng-controller="Diamond">
    <div class="page-title">
        <div class="col-lg-12">
            <label class="col-md-1 control-label">Date</label>
            <div class="col-lg-1">
                <input id="Date" type="text" class="form-control input-sm" placeholder="dd/mm/yyyy" autocomplete="off" ng-model="Diamond.Date" readonly />
            </div>
            <div class="col-lg-6">
                <button class="btn btn-primary" ng-click="FatchData()">Fatch</button>
                @*<button class="btn btn-primary" ng-click="Print()">Print</button>*@
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="well bs-component">
                    <legend class="font-green-sharp">
                        <b style="position:absolute">Date Wise Loss Summary - JUMBO</b>
                        <div align="right">
                            &nbsp; @*<button class="btn btn-primary" ng-click="Print()" type="button">Print</button>*@
                        </div>
                    </legend>
                    <div class="card-body">
                        <div>
                            <div id="After4POkgrid"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    module = angular.module('app', ['frapontillo.bootstrap-duallistbox', 'ngTouch', 'angularjs-dropdown-multiselect']);

    module.directive('chosen', function () {
        var linker = function (scope, element, attrs) {
            var list = attrs['chosen'];

            scope.$watch(list, function () {
                element.trigger('chosen:updated');
            });

            scope.$watch(attrs['ngModel'], function () {
                element.trigger('chosen:updated');
            });

            element.chosen();
        };

        return {
            restrict: 'A',
            link: linker
        };
    });

    module.controller("Diamond", function ($scope, $http) {

        $scope.Diamond = {};
        let After4POk_Loss = [];
        let RoughTo4P_Loss = [];

        $scope.FatchData = function () {
            const Date = $('#Date').val();
            debugger
            show_loader();
            $http({
                method: "POST",
                url: '@Url.Action("Jumbo_GetData_For_Date_Wise_Loss_Summary", "Report")',
                data: { Date }
            }).then(function (response) {
                hide_loader();
                List = response.data.List;

                GridData();
            });
        };

        const GridData = () => {
            $("#After4POkgrid").dxDataGrid({
                dataSource: List,
                columns: [
                    {
                        caption: $('#Date').val(), alignment: "center",
                        columns: [
                            { dataField: "Process", caption: "Process", dataType: "string", fixed: true },
                            {
                                caption: "ISSUE", alignment: "center",
                                columns: [
                                    { dataField: "IPcs", caption: "Pcs", dataType: "number", },
                                    { dataField: "IRPartWeight", caption: "RPartWeight", dataType: "number", },
                                    { dataField: "IPolishWeight", caption: "PolishWeight", dataType: "number" },
                                    { dataField: "IModel", caption: "Model", dataType: "number" },
                                ]
                            },
                            {
                                caption: "RECEIVE", alignment: "center",
                                columns: [
                                    { dataField: "RPcs", caption: "Pcs", dataType: "number", },
                                    { dataField: "RRPartWeight", caption: "RPartWeight", dataType: "number", },
                                    { dataField: "RPolishWeight", caption: "PolishWeight", dataType: "number" },
                                    { dataField: "RModel", caption: "Model", dataType: "number" },
                                ]
                            },
                            {
                                caption: "DIFFRENCE", alignment: "center",
                                columns: [
                                    { dataField: "DRPartWeight", caption: "RPartWeight", dataType: "number", },
                                    { dataField: "DiffRPer", caption: "%", dataType: "number", },
                                    { dataField: "DPolishWeight", caption: "PolishWeight", dataType: "number" },
                                    { dataField: "DiffPPer", caption: "%", dataType: "number" },
                                ]
                            },
                            {
                                caption: "TOTALLOSS", alignment: "center",
                                columns: [
                                    { dataField: "TPcs", caption: "Pcs", dataType: "number", },
                                    { dataField: "TRPartWeight", caption: "RPartWeight", dataType: "number", },
                                    { dataField: "TPolishWeight", caption: "PolishWeight", dataType: "number" },
                                ]
                            },
                        ],
                    },
                ],
                columnAutoWidth: true,
                columnResizingMode: 'widget',
                allowColumnResizing: true,
                showColumnLines: true,
                showRowLines: true,
                rowAlternationEnabled: true,
                showBorders: true,
                height: '100%',
                paging: { enabled: false },
                sorting: { mode: "none" },
                scrolling: {
                    mode: 'virtual',
                },
                filterPanel: { visible: true },
                searchPanel: {
                    visible: true,
                    width: 240,
                    placeholder: 'Search...',
                },
                loadPanel: {
                    enabled: true,
                    showPane: false,
                    indicatorSrc: '/Content/icons/Loader.gif',
                },
                headerFilter: {
                    visible: true,
                },
                pager: {
                    visible: false,
                },
                selection: {
                    mode: 'single',
                    //mode: 'multiple',
                    //mode: 'none',
                },
                keyboardNavigation: {
                    enterKeyAction: 'moveFocus',
                    enterKeyDirection: 'column',
                    editOnKeyPress: true,
                },
                summary: {
                    totalItems: [{
                        column: 'LotCode',
                        summaryType: 'count',
                    },]
                },
                export: {
                    enabled: true,
                    //formats: ['pdf', 'xlxs'],
                    formats: ['xlxs'],
                    allowExportSelectedData: false,
                },
                onExporting(e) {
                    debugger
                    if (e.format == 'pdf') {
                        const doc = new jsPDF();

                        DevExpress.pdfExporter.exportDataGrid({
                            jsPDFDocument: doc,
                            component: e.component,
                            indent: 5,
                        }).then(() => {
                            doc.save('Companies.pdf');
                        });
                    }
                    else if (e.format == 'xlxs') {
                        const workbook = new ExcelJS.Workbook();
                        const worksheet = workbook.addWorksheet('Details');

                        DevExpress.excelExporter.exportDataGrid({
                            component: e.component,
                            worksheet,
                            autoFilterEnabled: true,
                        }).then(() => {
                            workbook.xlsx.writeBuffer().then((buffer) => {
                                saveAs(new Blob([buffer], { type: 'application/octet-stream' }), 'After 4P Ok Lot Summary.xlsx');
                            });
                        });
                    }
                },
            });
        }

    });
</script>
<script>
    $('#Date').datepicker({
        format: "dd-M-yyyy",
        autoclose: true,
        todayHighlight: true
    });

    $('#ToDate').datepicker({
        format: "dd-M-yyyy",
        autoclose: true,
        todayHighlight: true
    });
</script>
