@{
    ViewBag.Title = "UserRoleUpdate";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* ==========================================================================
       User Role Update - Modern Scoped Card View & SaaS Styling
       ========================================================================== */
    @@keyframes fadeInUpSmooth {
        from {
            opacity: 0;
            transform: translateY(10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .userrole-update-wrapper {
        padding: 0 !important;
        margin-top: 0 !important;
        margin-bottom: 0 !important;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    }

    /* Staggered Card Entrance Animations */
    .userrole-header-card { animation: fadeInUpSmooth 0.35s cubic-bezier(0.16, 1, 0.3, 1) 0.05s both; }
    .userrole-form-card { animation: fadeInUpSmooth 0.35s cubic-bezier(0.16, 1, 0.3, 1) 0.1s both; }
    .userrole-perm-card { animation: fadeInUpSmooth 0.35s cubic-bezier(0.16, 1, 0.3, 1) 0.15s both; }

    /* Page Header Top Card */
    .userrole-header-card {
        background: #ffffff !important;
        border-radius: 12px !important;
        padding: 12px 18px !important;
        margin-bottom: 12px !important;
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04) !important;
        border: 1.5px solid #cbd5e1 !important;
        border-left: 5px solid #0284c7 !important;
        display: flex !important;
        justify-content: space-between !important;
        align-items: center !important;
        flex-wrap: wrap !important;
        gap: 12px !important;
        transition: all 0.25s ease !important;
    }
    .userrole-header-card:hover {
        box-shadow: 0 6px 18px rgba(15, 23, 42, 0.08) !important;
        border-color: #94a3b8 !important;
        border-left-color: #0369a1 !important;
    }

    .userrole-header-left {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .userrole-header-icon {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        box-shadow: 0 4px 12px rgba(2, 132, 199, 0.28);
        transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
        flex-shrink: 0;
    }
    .userrole-header-card:hover .userrole-header-icon {
        transform: scale(1.08) rotate(4deg);
    }

    .userrole-header-title-wrap {
        display: flex;
        flex-direction: column;
    }

    .userrole-breadcrumb {
        font-size: 11.5px;
        color: #64748b;
        margin-bottom: 3px;
        font-weight: 500;
    }
    .userrole-breadcrumb a {
        color: #0284c7;
        text-decoration: none;
        transition: color 0.15s ease;
        font-weight: 500;
    }
    .userrole-breadcrumb a:hover {
        color: #0369a1;
        text-decoration: underline;
    }

    .userrole-title-row {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .userrole-header-title {
        font-size: 18px !important;
        font-weight: 700 !important;
        color: #0f172a !important;
        margin: 0 !important;
        line-height: 1.2 !important;
        letter-spacing: -0.2px;
    }

    .userrole-mode-pill {
        background: #e0f2fe;
        color: #0369a1;
        font-size: 11px;
        font-weight: 700;
        padding: 2px 10px;
        border-radius: 20px;
        border: 1px solid #bae6fd;
    }

    .userrole-header-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    /* Action Buttons */
    .btn-userrole-save {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%) !important;
        color: #ffffff !important;
        border: none !important;
        border-radius: 8px !important;
        padding: 8px 20px !important;
        font-size: 13px !important;
        font-weight: 700 !important;
        display: inline-flex !important;
        align-items: center !important;
        gap: 6px !important;
        box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3) !important;
        transition: all 0.22s ease !important;
        cursor: pointer !important;
    }
    .btn-userrole-save:hover {
        background: linear-gradient(135deg, #059669 0%, #047857 100%) !important;
        transform: translateY(-2px) !important;
        box-shadow: 0 6px 16px rgba(16, 185, 129, 0.4) !important;
        color: #ffffff !important;
    }

    .btn-userrole-clear {
        background: #f8fafc !important;
        color: #475569 !important;
        border: 1.5px solid #cbd5e1 !important;
        border-radius: 8px !important;
        padding: 8px 16px !important;
        font-size: 13px !important;
        font-weight: 600 !important;
        display: inline-flex !important;
        align-items: center !important;
        gap: 6px !important;
        transition: all 0.2s ease !important;
        cursor: pointer !important;
    }
    .btn-userrole-clear:hover {
        background: #e2e8f0 !important;
        color: #1e293b !important;
        border-color: #94a3b8 !important;
        transform: translateY(-1px) !important;
    }

    .btn-userrole-back {
        background: #ffffff !important;
        color: #0284c7 !important;
        border: 1.5px solid #0284c7 !important;
        border-radius: 8px !important;
        padding: 8px 16px !important;
        font-size: 13px !important;
        font-weight: 600 !important;
        display: inline-flex !important;
        align-items: center !important;
        gap: 6px !important;
        text-decoration: none !important;
        transition: all 0.2s ease !important;
        cursor: pointer !important;
    }
    .btn-userrole-back:hover {
        background: #e0f2fe !important;
        color: #0369a1 !important;
        transform: translateY(-1px) !important;
    }

    /* Section Cards */
    .userrole-card {
        background: #ffffff !important;
        border-radius: 12px !important;
        border: 1.5px solid #cbd5e1 !important;
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04) !important;
        margin-bottom: 12px !important;
        overflow: hidden !important;
        transition: all 0.25s ease !important;
    }
    .userrole-card:hover {
        box-shadow: 0 6px 18px rgba(15, 23, 42, 0.08) !important;
        border-color: #94a3b8 !important;
    }

    .userrole-card-header {
        padding: 12px 18px !important;
        background: #f8fafc !important;
        border-bottom: 1.5px solid #e2e8f0 !important;
        display: flex !important;
        align-items: center !important;
        justify-content: space-between !important;
    }

    .userrole-card-title {
        font-size: 14px !important;
        font-weight: 700 !important;
        color: #0f172a !important;
        margin: 0 !important;
        display: flex !important;
        align-items: center !important;
        gap: 8px !important;
    }

    .userrole-card-body {
        padding: 18px 20px !important;
    }

    /* Form Fields */
    .userrole-form-grid {
        display: grid;
        grid-template-columns: 1.5fr 1fr 2fr;
        gap: 16px;
        align-items: flex-end;
    }

    .form-group-custom {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .form-group-custom label {
        font-size: 11px !important;
        font-weight: 700 !important;
        color: #475569 !important;
        text-transform: uppercase !important;
        letter-spacing: 0.5px !important;
        margin: 0 !important;
    }

    .form-control-custom {
        height: 38px;
        border-radius: 8px;
        border: 1.5px solid #cbd5e1 !important;
        padding: 6px 12px;
        font-size: 13px;
        font-weight: 500;
        color: #0f172a;
        background-color: #ffffff !important;
        outline: none;
        box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
        transition: all 0.2s ease;
        width: 100%;
    }
    .form-control-custom:focus {
        border-color: #0284c7 !important;
        box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.18) !important;
    }

    /* Checkbox Badge Container */
    .checkbox-pill-wrap {
        height: 38px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 0 14px;
        border-radius: 8px;
        border: 1.5px solid #cbd5e1;
        background: #f8fafc;
        cursor: pointer;
        user-select: none;
        transition: all 0.2s ease;
    }
    .checkbox-pill-wrap:hover {
        background: #f1f5f9;
        border-color: #94a3b8;
    }
    .checkbox-pill-wrap input[type="checkbox"] {
        width: 16px;
        height: 16px;
        cursor: pointer;
        accent-color: #0284c7;
        margin: 0;
    }
    .checkbox-pill-wrap span {
        font-size: 12.5px;
        font-weight: 600;
        color: #334155;
    }

    /* Module Group Grid Layout */
    .module-group-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 16px;
    }

    .module-group-card {
        background: #f8fafc;
        border: 1.5px solid #e2e8f0;
        border-radius: 10px;
        overflow: hidden;
        transition: all 0.2s ease;
    }
    .module-group-card:hover {
        border-color: #cbd5e1;
        box-shadow: 0 4px 12px rgba(15, 23, 42, 0.05);
    }

    .module-group-header {
        padding: 8px 12px;
        background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
        color: #ffffff;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.3px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .module-group-body {
        padding: 10px 12px;
        display: flex;
        flex-direction: column;
        gap: 8px;
        max-height: 280px;
        overflow-y: auto;
    }

    .module-item-row {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 6px 10px;
        border-radius: 6px;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        cursor: pointer;
        transition: all 0.15s ease;
    }
    .module-item-row:hover {
        background: #f0f9ff;
        border-color: #7dd3fc;
    }
    .module-item-row input[type="checkbox"] {
        width: 15px;
        height: 15px;
        cursor: pointer;
        accent-color: #0284c7;
        margin: 0;
    }
    .module-item-row .label-text {
        font-size: 12px;
        font-weight: 600;
        color: #1e293b;
        cursor: pointer;
        user-select: none;
    }

    .userrole-footer-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        padding-top: 6px;
    }

    /* Responsive */
    @@media (max-width: 992px) {
        .userrole-form-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 768px) {
        .userrole-header-card {
            flex-direction: column;
            align-items: flex-start;
        }
        .userrole-header-actions {
            width: 100%;
            justify-content: flex-start;
        }
        .module-group-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div ng-controller="RoleMaster" class="userrole-update-wrapper">
    <a id="lnkGoogle" style="display:none;" href="@Url.Action("Index", "INV_StockHistory")"></a>

    <!-- Top Page Header Card -->
    <div class="userrole-header-card">
        <div class="userrole-header-left">
            <div class="userrole-header-icon">
                <i class="fa fa-shield"></i>
            </div>
            <div class="userrole-header-title-wrap">
                <div class="userrole-breadcrumb">
                    <a href="@Url.Action("Index", "Home")"><i class="fa fa-home"></i> Home</a> / <a href="@Url.Action("UserRole", "User")">User Role</a> / <span>{{BtnName === 'UPDATE' ? 'Edit Role' : 'Create Role'}}</span>
                </div>
                <div class="userrole-title-row">
                    <h4 class="userrole-header-title">{{BtnName === 'UPDATE' ? 'Edit User Role' : 'Create User Role'}}</h4>
                    <span class="userrole-mode-pill">{{BtnName}} MODE</span>
                </div>
            </div>
        </div>
        <div class="userrole-header-actions">
            <button class="btn-userrole-save" ng-click="InsertUpdateRole()" type="button">
                <i class="fa fa-check-circle"></i> {{BtnName}}
            </button>
            <button class="btn-userrole-clear" ng-click="Clear()" type="button">
                <i class="fa fa-eraser"></i> Clear
            </button>
            <a class="btn-userrole-back" href="@Url.Action("UserRole", "User")">
                <i class="fa fa-arrow-left"></i> Back
            </a>
        </div>
    </div>

    <!-- Section 1: Role Information Card -->
    <div class="userrole-card userrole-form-card">
        <div class="userrole-card-header">
            <h5 class="userrole-card-title">
                <i class="fa fa-info-circle text-primary"></i> Role Master Details
            </h5>
        </div>
        <div class="userrole-card-body">
            <div class="userrole-form-grid">
                <!-- Hidden Role ID -->
                <input type="hidden" ng-model="RoleMaster.RoleID" />

                <!-- Role Name -->
                <div class="form-group-custom">
                    <label for="RoleName">Role Name <span class="text-danger">*</span></label>
                    <input type="text" id="RoleName" class="form-control-custom" ng-model="RoleMaster.RoleName" placeholder="Enter Role Name" autocomplete="off" />
                </div>

                <!-- IsActive Checkbox -->
                <div class="form-group-custom">
                    <label>Status</label>
                    <label class="checkbox-pill-wrap">
                        <input type="checkbox" ng-model="RoleMaster.IsActive" ng-click="HideShowIsActive(RoleMaster.IsActive);" />
                        <span>Active Role</span>
                    </label>
                </div>

                <!-- Remarks -->
                <div class="form-group-custom">
                    <label for="Remarks">Remarks</label>
                    <input type="text" id="Remarks" class="form-control-custom" ng-model="RoleMaster.Remarks" placeholder="Enter Remarks / Description" autocomplete="off" />
                </div>
            </div>
        </div>
    </div>

    <!-- Section 2: Module Permissions Card -->
    <div class="userrole-card userrole-perm-card">
        <div class="userrole-card-header">
            <h5 class="userrole-card-title">
                <i class="fa fa-th-large text-primary"></i> Module Permissions Matrix
            </h5>
        </div>
        <div class="userrole-card-body">
            <div class="module-group-grid">
                <div class="module-group-card" ng-repeat="items in GetSYSModuleGroupList">
                    <div class="module-group-header">
                        <i class="fa fa-folder-open-o"></i> {{items.GroupName}}
                    </div>
                    <div class="module-group-body">
                        <label class="module-item-row" ng-repeat="item in GetSYSModuleList" ng-if="item.GroupName==items.GroupName">
                            <input type="checkbox" ng-model="item.selected" ng-change="CheckBoxList(item.selected,item.ModuleID);" />
                            <span class="label-text">{{item.value}}</span>
                        </label>
                    </div>
                </div>
            </div>

            <!-- Bottom Actions -->
            <div class="userrole-footer-actions" style="margin-top: 18px; border-top: 1px solid #e2e8f0; padding-top: 14px;">
                <button class="btn-userrole-save" ng-click="InsertUpdateRole()" type="button">
                    <i class="fa fa-check-circle"></i> {{BtnName}}
                </button>
                <button class="btn-userrole-clear" ng-click="Clear()" type="button">
                    <i class="fa fa-eraser"></i> Clear
                </button>
                <a class="btn-userrole-back" href="@Url.Action("UserRole", "User")">
                    <i class="fa fa-arrow-left"></i> Back
                </a>
            </div>
        </div>
    </div>
</div>

<script>
    var Paramdata = [{ RoleID: 0 }];
    var Action = "INSERT";
    var RoleID = 0;

    if ('@ViewBag.UserID' != 0) {
        RoleID = '@ViewBag.UserID';
    }

    module = angular.module('app', ['ngTouch', 'ui.grid', 'ui.grid.edit', 'ui.grid.rowEdit', 'ui.grid.cellNav', 'ui.grid.pagination', 'ui.grid.moveColumns', 'ui.grid.exporter', 'ui.grid.pinning', 'ui.grid.resizeColumns', 'angularjs-dropdown-multiselect']);
    module.controller("RoleMaster", ['$scope', '$filter', '$http', '$q', '$interval', 'uiGridConstants', function ($scope, $filter, $http, $q, $interval, uiGridConstants, $window) {

        $scope.RoleMaster = {};
        $scope.ImportTerms = [];
        $scope.DaytermsDetails = [];
        $scope.GetSYSModuleList = [];
        $scope.BtnName = "SAVE";
        $scope.IsActiveShow = true;

        // ***************************** GetData ******************************************//
        var loopPromises = [];
        var promise = $http.get('@Url.Action("Get_SYS_ModuleDataList", "User")').then(function (response) {
            var SYSModuleList = [];
            for (var i = 0; i < response.data.SYSModuleList.length; i++) {
                var obj = { id: response.data.SYSModuleList[i]["ModuleID"], value: response.data.SYSModuleList[i]["ModuleName"], ModuleID: response.data.SYSModuleList[i]["ModuleID"], GroupName: response.data.SYSModuleList[i]["GroupName"] };
                SYSModuleList.push(obj);
            }

            $scope.GetSYSModuleList = SYSModuleList;
            var SYSModuleGroupList = [];
            for (var i = 0; i < response.data.SYSModuleGroupList.length; i++) {
                var obj = { id: response.data.SYSModuleGroupList[i]["GroupID"], value: response.data.SYSModuleGroupList[i]["GroupName"], GroupName: response.data.SYSModuleGroupList[i]["GroupName"] };
                SYSModuleGroupList.push(obj);
            }
            $scope.GetSYSModuleGroupList = SYSModuleGroupList;
        });
        loopPromises.push(promise);
        // ***************************** EndGetData ***************************************//


        // Load Edit Data if RoleID exists
        $scope.SetEditData = function () {
            if (RoleID != 0) {
                $scope.BtnName = "UPDATE";
                Action = "UPDATE";
                show_loader();

                $http({
                    method: "POST",
                    url: '@Url.Action("Get_SEC_RolePrivileges_Edit", "User")',
                    data: JSON.stringify({ "RoleID": RoleID }),
                    dataType: "json",
                    headers: { 'Content-Type': 'application/json' }
                }).then(function (ret) {
                    hide_loader();
                    debugger;

                    if (ret.data && ret.data.List && ret.data.List.length > 0) {
                        $scope.RoleMaster = ret.data.List[0];
                        $scope.RoleMaster.IsActive = ret.data.List[0].IsActive == "True";

                        $scope.GetSYSModuleList.forEach(function (itm) {
                            ret.data.SEC_RolePrivileges.forEach(function (item) {
                                if (itm.ModuleID === item.ModuleID) {
                                    itm.selected = true;
                                    $scope.ImportTerms.push({
                                        'ModuleID': parseInt(itm.ModuleID),
                                        'Remarks': $scope.RoleMaster.Remarks || ""
                                    });
                                }
                            });
                        });
                    }
                });
            }
        };

        $q.all(loopPromises).then(function (data) {
            $scope.SetEditData();
        });

        $scope.CheckBoxList = function (id, ModuleID) {
            if (id === true) {
                $scope.ImportTerms.push({
                    'ModuleID': parseInt(ModuleID),
                    'Remarks': $scope.RoleMaster.Remarks
                });
            }
            else if (id === false) {
                var DTArr = eval($scope.ImportTerms);
                var index = -1;
                for (var i = 0; i < DTArr.length; i++) {
                    if (DTArr[i].ModuleID === parseInt(ModuleID)) {
                        index = i;
                        break;
                    }
                }
                if (index === -1) {
                    Noty("error", "Something gone wrong");
                }
                $scope.ImportTerms.splice(index, 1);
            }
            $scope.DaytermsDetails = $scope.ImportTerms;

        }

        // Insert / Update Role
        $scope.InsertUpdateRole = function () {
            if (!$scope.RoleMaster.RoleName || $scope.RoleMaster.RoleName.trim() === "") {
                Noty("error", "Please Enter Role Name");
                return;
            }

            if (Action === "UPDATE" && (!$scope.RoleMaster.Remarks || $scope.RoleMaster.Remarks.trim() === "")) {
                Noty("error", "Please Enter Remark");
                return;
            }

            show_loader();
            var response = $http({
                method: "POST",
                async: true,
                url: '@Url.Action("MST_Role_Insert_Update_Delete", "User")',
                data: {
                    model: $scope.RoleMaster,
                    ImportTerms: $scope.ImportTerms,
                    Action: Action
                },
                headers: {
                    'Content-Type': 'application/json'
                },
                dataType: "json"
            }).then(function (ret) {
                hide_loader();
                var resultMsg = ret.data?.trim?.();
                if (resultMsg === "Record Is Inserted") {
                    Noty("success", "Data Saved Successfully!");
                    $scope.Clear();
                } else if (resultMsg === "Record Is Updated") {
                    Noty("success", "Data Updated Successfully!");
                    $scope.Clear();
                } else {
                    Noty("error", "!!! Data not saved. Reason: " + resultMsg);
                }
            });
        };

        // Clear Form
        $scope.Clear = function () {
            $scope.RoleMaster = {};
            $scope.BtnName = "SAVE";
            Action = "INSERT";
            window.location.href = '@Url.Action("UserRole", "User")';
        };

    }]);
</script>