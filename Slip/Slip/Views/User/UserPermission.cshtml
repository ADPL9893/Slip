@{
    ViewBag.Title = "User Permission";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}


<div ng-controller="PermissionCtrl" class="user-perm-page">
    <!-- Header Banner Card -->
    <div class="perm-header-card">
        <div class="perm-header-left">
            <div class="perm-header-icon">
                <i class="fa fa-shield"></i>
            </div>
            <div>
                <div class="perm-breadcrumb">
                    <a href="@Url.Action("Index", "Home")"><i class="fa fa-home"></i> Home</a> / 
                    <a href="@Url.Action("UserDetail", "User")">User List</a> / 
                    <span>User Permission</span>
                </div>
                <h4 class="perm-header-title">
                    User Permission Matrix
                    <span class="badge-status-pill badge-pill-info" style="font-size: 12px; vertical-align: middle; margin-left: 6px;" ng-if="TargetUserName">
                        <i class="fa fa-user"></i> {{TargetUserName}}
                    </span>
                </h4>
            </div>
        </div>

        <div class="perm-header-actions">
            <!-- Same As Group -->
            <div class="same-as-group">
                <label class="same-as-label" for="sameAsUserSelect">
                    <i class="fa fa-clone" style="color: #0284c7;"></i> Same As:
                </label>
                <select id="sameAsUserSelect" 
                        class="same-as-select form-control" 
                        ng-model="SelectedSourceUserID" 
                        ng-options="item.ID as item.UserName for item in SameAsUserList">
                    <option value="">-- Select Source User --</option>
                </select>
                <button type="button" 
                        class="btn-apply-sameas" 
                        ng-click="ApplySameAs()" 
                        title="Copy all permissions from selected user">
                    <i class="fa fa-check-circle"></i> Apply
                </button>
            </div>

            <!-- Save Permissions Action -->
            <button type="button" 
                    class="btn-save-permissions" 
                    ng-click="SavePermissions()" 
                    title="Save all modified permissions to database">
                <i class="fa fa-floppy-o"></i> Save Permissions
            </button>
        </div>
    </div>

    <!-- Main Grid Card Container -->
    <div class="perm-grid-card">
        <div class="perm-card-header">
            <div class="perm-card-title-left">
                <i class="fa fa-th-list"></i>
                <h3>Module Privileges & Access Control</h3>
            </div>
            <div class="perm-card-actions">
                <span class="badge-status-pill badge-pill-info">
                    <i class="fa fa-cubes"></i> Permission Matrix
                </span>
            </div>
        </div>

        <!-- Body Section: 3-Tier ERP Table Aligned to Left -->
        <div class="grid-card-body">
            <div class="table-responsive shadow-sm rounded" style="max-width: 950px; width: 100%; margin: 0;">
                <table class="table table-bordered table-sm custom-erp-table mb-0">
                        <!-- Global Header (Tier 1) -->
                        <thead>
                            <tr>
                                <th>MODULE NAME</th>
                                <th>
                                    SELECT ALL<br />
                                    <input type="checkbox" ng-model="GlobalCheck.SelectAll" ng-change="ToggleGlobal('SelectAll')" title="Select all columns globally" />
                                </th>
                                <th>
                                    VIEW<br />
                                    <input type="checkbox" ng-model="GlobalCheck.View" ng-change="ToggleGlobal('View')" title="Select View globally" />
                                </th>
                                <th>
                                    ADD<br />
                                    <input type="checkbox" ng-model="GlobalCheck.Add" ng-change="ToggleGlobal('Add')" title="Select Add globally" />
                                </th>
                                <th>
                                    EDIT<br />
                                    <input type="checkbox" ng-model="GlobalCheck.Edit" ng-change="ToggleGlobal('Edit')" title="Select Edit globally" />
                                </th>
                                <th>
                                    DELETE<br />
                                    <input type="checkbox" ng-model="GlobalCheck.Delete" ng-change="ToggleGlobal('Delete')" title="Select Delete globally" />
                                </th>
                                <th>
                                    EXPORT<br />
                                    <input type="checkbox" ng-model="GlobalCheck.Export" ng-change="ToggleGlobal('Export')" title="Select Export globally" />
                                </th>
                                <th>
                                    MAIL<br />
                                    <input type="checkbox" ng-model="GlobalCheck.Mail" ng-change="ToggleGlobal('Mail')" title="Select Mail globally" />
                                </th>
                                <th>
                                    PRINT<br />
                                    <input type="checkbox" ng-model="GlobalCheck.Print" ng-change="ToggleGlobal('Print')" title="Select Print globally" />
                                </th>
                                <th>
                                    HISTORY<br />
                                    <input type="checkbox" ng-model="GlobalCheck.History" ng-change="ToggleGlobal('History')" title="Select History globally" />
                                </th>
                            </tr>
                        </thead>

                        <tbody ng-if="!HasGroups()">
                            <tr>
                                <td colspan="10" class="text-center py-4 text-muted" style="text-align: center; padding: 25px; color: #64748b;">
                                    <i class="fa fa-info-circle"></i> No permissions data loaded.
                                </td>
                            </tr>
                        </tbody>

                        <tbody ng-repeat="(groupName, group) in GroupedPermissions">
                            <!-- Group Header Row (Tier 2: Accordion + Group Checkboxes with #deedf5) -->
                            <tr class="group-header">
                                <!-- Cell 1: Clickable for Expand/Collapse -->
                                <td ng-click="group.isExpanded = !group.isExpanded" style="cursor: pointer;" title="Click to expand/collapse {{groupName}}">
                                    <i class="fa" ng-class="group.isExpanded ? 'fa-chevron-down' : 'fa-chevron-right'" style="margin-right: 6px; width: 14px; color: #36c6d3;"></i>
                                    <b>{{groupName}}</b>
                                    <span class="badge badge-light" style="font-size: 11px; margin-left: 6px; color: #495057; background: #c5dbe8; font-weight: 600;">{{group.modules.length}}</span>
                                </td>
                                <!-- Cells 2-10: Group Checkboxes -->
                                <td class="text-center">
                                    <input type="checkbox" ng-model="group.groupCheck.SelectAll" ng-change="ToggleGroup(group, 'SelectAll')" title="Select all in {{groupName}}" />
                                </td>
                                <td class="text-center">
                                    <input type="checkbox" ng-model="group.groupCheck.View" ng-change="ToggleGroup(group, 'View')" title="Select View in {{groupName}}" />
                                </td>
                                <td class="text-center">
                                    <input type="checkbox" ng-model="group.groupCheck.Add" ng-change="ToggleGroup(group, 'Add')" title="Select Add in {{groupName}}" />
                                </td>
                                <td class="text-center">
                                    <input type="checkbox" ng-model="group.groupCheck.Edit" ng-change="ToggleGroup(group, 'Edit')" title="Select Edit in {{groupName}}" />
                                </td>
                                <td class="text-center">
                                    <input type="checkbox" ng-model="group.groupCheck.Delete" ng-change="ToggleGroup(group, 'Delete')" title="Select Delete in {{groupName}}" />
                                </td>
                                <td class="text-center">
                                    <input type="checkbox" ng-model="group.groupCheck.Export" ng-change="ToggleGroup(group, 'Export')" title="Select Export in {{groupName}}" />
                                </td>
                                <td class="text-center">
                                    <input type="checkbox" ng-model="group.groupCheck.Mail" ng-change="ToggleGroup(group, 'Mail')" title="Select Mail in {{groupName}}" />
                                </td>
                                <td class="text-center">
                                    <input type="checkbox" ng-model="group.groupCheck.Print" ng-change="ToggleGroup(group, 'Print')" title="Select Print in {{groupName}}" />
                                </td>
                                <td class="text-center">
                                    <input type="checkbox" ng-model="group.groupCheck.History" ng-change="ToggleGroup(group, 'History')" title="Select History in {{groupName}}" />
                                </td>
                            </tr>

                            <!-- Individual Module Rows (Tier 3: Row-level Checkboxes & Highlighting with #deedf5) -->
                            <tr ng-repeat="m in group.modules" 
                                class="module-row" 
                                ng-show="group.isExpanded"
                                ng-class="{'row-selected': (m.View || m.Add || m.Edit || m.Delete || m.Export || m.Mail || m.Print || m.History || selectedRow === m)}"
                                ng-click="$parent.$parent.selectedRow = m">
                                <td>{{m.ModuleName}}</td>
                                <td class="text-center">
                                    <input type="checkbox" class="erp-checkbox" ng-model="m.SelectAll" ng-change="ToggleAll(m)" title="Toggle all for {{m.ModuleName}}" />
                                </td>
                                <td class="text-center">
                                    <input type="checkbox" class="erp-checkbox" ng-model="m.View" ng-change="UpdateSelectAll(m)" />
                                </td>
                                <td class="text-center">
                                    <input type="checkbox" class="erp-checkbox" ng-model="m.Add" ng-change="UpdateSelectAll(m)" />
                                </td>
                                <td class="text-center">
                                    <input type="checkbox" class="erp-checkbox" ng-model="m.Edit" ng-change="UpdateSelectAll(m)" />
                                </td>
                                <td class="text-center">
                                    <input type="checkbox" class="erp-checkbox" ng-model="m.Delete" ng-change="UpdateSelectAll(m)" />
                                </td>
                                <td class="text-center">
                                    <input type="checkbox" class="erp-checkbox" ng-model="m.Export" ng-change="UpdateSelectAll(m)" />
                                </td>
                                <td class="text-center">
                                    <input type="checkbox" class="erp-checkbox" ng-model="m.Mail" ng-change="UpdateSelectAll(m)" />
                                </td>
                                <td class="text-center">
                                    <input type="checkbox" class="erp-checkbox" ng-model="m.Print" ng-change="UpdateSelectAll(m)" />
                                </td>
                                <td class="text-center">
                                    <input type="checkbox" class="erp-checkbox" ng-model="m.History" ng-change="UpdateSelectAll(m)" />
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Isolated AngularJS Controller -->
<script>
    var module;
    try {
        module = angular.module('app');
    } catch (e) {
        module = angular.module('app', ['ngAnimate', 'ngTouch', 'ui.grid']);
    }

    module.controller('PermissionCtrl', ['$scope', '$http', function ($scope, $http) {

        // Scope State Initialization
        $scope.TargetUserID = parseInt('@ViewBag.UserID') || 0;
        $scope.TargetUserName = '@Html.Raw(HttpUtility.JavaScriptStringEncode(ViewBag.TargetUserName as string ?? ""))';
        $scope.SameAsUserList = [];
        $scope.SelectedSourceUserID = "";
        $scope.GroupedPermissions = {};
        $scope.selectedRow = null;

        // Global Selection State (Tier 1)
        $scope.GlobalCheck = {
            SelectAll: false,
            View: false,
            Add: false,
            Edit: false,
            Delete: false,
            Export: false,
            Mail: false,
            Print: false,
            History: false
        };

        // Helper to check if any groups exist
        $scope.HasGroups = function () {
            return $scope.GroupedPermissions && Object.keys($scope.GroupedPermissions).length > 0;
        };

        // 1. Fetch User List for "Same As" Dropdown
        $scope.LoadSameAsUsers = function () {
            if (!$scope.TargetUserID) return;

            $http({
                method: 'GET',
                url: '@Url.Action("Get_SameAs_UserList", "User")',
                params: { UserID: $scope.TargetUserID }
            }).then(function (response) {
                if (response.data && response.data.list) {
                    $scope.SameAsUserList = response.data.list;
                } else if (Array.isArray(response.data)) {
                    $scope.SameAsUserList = response.data;
                }
            }, function (err) {
                console.error("Error loading Same As user list:", err);
            });
        };

        // 2. Fetch Permissions & Initialize 3-Tier Hierarchy
        $scope.LoadPermissions = function () {
            if (!$scope.TargetUserID) {
                if (typeof Noty === "function") {
                    Noty("error", "Invalid User ID.");
                }
                return;
            }

            if (typeof show_loader === "function") show_loader();

            $http({
                method: 'GET',
                url: '@Url.Action("Get_PermissionGridData", "User")',
                params: { UserID: $scope.TargetUserID }
            }).then(function (response) {
                if (typeof hide_loader === "function") hide_loader();

                var rawList = [];
                if (response.data && response.data.data) {
                    rawList = response.data.data;
                } else if (Array.isArray(response.data)) {
                    rawList = response.data;
                }

                // Group by GroupName with groupCheck state
                $scope.GroupedPermissions = {};
                angular.forEach(rawList, function (item) {
                    var grp = item.GroupName || "General";
                    if (!$scope.GroupedPermissions[grp]) {
                        $scope.GroupedPermissions[grp] = {
                            isExpanded: true,
                            groupCheck: {
                                SelectAll: false,
                                View: false,
                                Add: false,
                                Edit: false,
                                Delete: false,
                                Export: false,
                                Mail: false,
                                Print: false,
                                History: false
                            },
                            modules: []
                        };
                    }

                    // Normalize booleans
                    item.View = Boolean(item.View);
                    item.Add = Boolean(item.Add);
                    item.Edit = Boolean(item.Edit);
                    item.Delete = Boolean(item.Delete);
                    item.Export = Boolean(item.Export);
                    item.Mail = Boolean(item.Mail);
                    item.Print = Boolean(item.Print);
                    item.History = Boolean(item.History);
                    item.SelectAll = Boolean(item.SelectAll || (item.View && item.Add && item.Edit && item.Delete && item.Export && item.Mail && item.Print && item.History));

                    $scope.GroupedPermissions[grp].modules.push(item);
                });

            }, function (error) {
                if (typeof hide_loader === "function") hide_loader();
                if (typeof Noty === "function") {
                    Noty("error", "Failed to load permission data: " + (error.statusText || "Server Error"));
                }
            });
        };

        // 3. Global Checkbox Handler (Tier 1)
        $scope.ToggleGlobal = function (column) {
            var val = Boolean($scope.GlobalCheck[column]);

            angular.forEach($scope.GroupedPermissions, function (group) {
                if (column === 'SelectAll') {
                    // Toggle ALL columns across this group
                    group.groupCheck.SelectAll = val;
                    group.groupCheck.View = val;
                    group.groupCheck.Add = val;
                    group.groupCheck.Edit = val;
                    group.groupCheck.Delete = val;
                    group.groupCheck.Export = val;
                    group.groupCheck.Mail = val;
                    group.groupCheck.Print = val;
                    group.groupCheck.History = val;

                    angular.forEach(group.modules, function (m) {
                        m.SelectAll = val;
                        m.View = val;
                        m.Add = val;
                        m.Edit = val;
                        m.Delete = val;
                        m.Export = val;
                        m.Mail = val;
                        m.Print = val;
                        m.History = val;
                    });
                } else {
                    // Toggle specific column across this group
                    group.groupCheck[column] = val;
                    angular.forEach(group.modules, function (m) {
                        m[column] = val;
                        m.SelectAll = Boolean(m.View && m.Add && m.Edit && m.Delete && m.Export && m.Mail && m.Print && m.History);
                    });
                }
            });

            if (column === 'SelectAll') {
                $scope.GlobalCheck.View = val;
                $scope.GlobalCheck.Add = val;
                $scope.GlobalCheck.Edit = val;
                $scope.GlobalCheck.Delete = val;
                $scope.GlobalCheck.Export = val;
                $scope.GlobalCheck.Mail = val;
                $scope.GlobalCheck.Print = val;
                $scope.GlobalCheck.History = val;
            }
        };

        // 4. Group Checkbox Handler (Tier 2)
        $scope.ToggleGroup = function (group, column) {
            var val = Boolean(group.groupCheck[column]);

            if (column === 'SelectAll') {
                group.groupCheck.View = val;
                group.groupCheck.Add = val;
                group.groupCheck.Edit = val;
                group.groupCheck.Delete = val;
                group.groupCheck.Export = val;
                group.groupCheck.Mail = val;
                group.groupCheck.Print = val;
                group.groupCheck.History = val;

                angular.forEach(group.modules, function (m) {
                    m.SelectAll = val;
                    m.View = val;
                    m.Add = val;
                    m.Edit = val;
                    m.Delete = val;
                    m.Export = val;
                    m.Mail = val;
                    m.Print = val;
                    m.History = val;
                });
            } else {
                angular.forEach(group.modules, function (m) {
                    m[column] = val;
                    m.SelectAll = Boolean(m.View && m.Add && m.Edit && m.Delete && m.Export && m.Mail && m.Print && m.History);
                });
            }
        };

        // 5. Row-Level "Select All" Toggle (Tier 3)
        $scope.ToggleAll = function (m) {
            var val = Boolean(m.SelectAll);
            m.View = val;
            m.Add = val;
            m.Edit = val;
            m.Delete = val;
            m.Export = val;
            m.Mail = val;
            m.Print = val;
            m.History = val;
        };

        // 6. Update SelectAll when individual row checkbox changes
        $scope.UpdateSelectAll = function (m) {
            m.SelectAll = Boolean(m.View && m.Add && m.Edit && m.Delete && m.Export && m.Mail && m.Print && m.History);
        };

        // 7. Apply "Same As" Feature
        $scope.ApplySameAs = function () {
            if (!$scope.SelectedSourceUserID) {
                if (typeof Noty === "function") {
                    Noty("error", "Please select a user from the 'Same As' dropdown.");
                } else {
                    alert("Please select a user from the 'Same As' dropdown.");
                }
                return;
            }

            if (!confirm("Are you sure you want to copy all permissions from the selected user?")) {
                return;
            }

            if (typeof show_loader === "function") show_loader();

            $http({
                method: 'POST',
                url: '@Url.Action("CopyPermissions", "User")',
                data: JSON.stringify({
                    SourceUserID: parseInt($scope.SelectedSourceUserID),
                    TargetUserID: parseInt($scope.TargetUserID)
                }),
                headers: { 'Content-Type': 'application/json; charset=utf-8' },
                dataType: "json"
            }).then(function (response) {
                if (typeof hide_loader === "function") hide_loader();

                var result = response.data;
                if (result && (result.success || (typeof result.message === "string" && !result.message.startsWith("ERROR")))) {
                    if (typeof Noty === "function") {
                        Noty("success", result.message || "Permissions Copied Successfully!");
                    }
                    $scope.LoadPermissions();
                } else {
                    var errMsg = (result && result.message) ? result.message : "Failed to copy permissions.";
                    if (typeof Noty === "function") {
                        Noty("error", errMsg);
                    } else {
                        alert(errMsg);
                    }
                }
            }, function (error) {
                if (typeof hide_loader === "function") hide_loader();
                if (typeof Noty === "function") {
                    Noty("error", "An error occurred while copying permissions.");
                }
            });
        };

        // 8. Save Permissions (Flatten group.modules Data & POST)
        $scope.SavePermissions = function () {
            if (!$scope.TargetUserID) return;

            var flatList = [];
            angular.forEach($scope.GroupedPermissions, function (group) {
                if (group && angular.isArray(group.modules)) {
                    flatList = flatList.concat(group.modules);
                }
            });

            if (flatList.length === 0) {
                if (typeof Noty === "function") {
                    Noty("error", "No permission data available to save.");
                }
                return;
            }

            if (typeof show_loader === "function") show_loader();

            $http({
                method: 'POST',
                url: '@Url.Action("Save_UserPermissions", "User")',
                data: JSON.stringify({
                    TargetUserID: parseInt($scope.TargetUserID),
                    permissions: flatList
                }),
                headers: { 'Content-Type': 'application/json; charset=utf-8' },
                dataType: "json"
            }).then(function (response) {
                if (typeof hide_loader === "function") hide_loader();

                var result = response.data;
                if (result && result.success) {
                    if (typeof Noty === "function") {
                        Noty("success", result.message || "Permissions saved successfully!");
                    }
                    $scope.LoadPermissions();
                } else {
                    var msg = (result && result.message) ? result.message : "Failed to save permissions.";
                    if (typeof Noty === "function") {
                        Noty("error", msg);
                    } else {
                        alert(msg);
                    }
                }
            }, function (error) {
                if (typeof hide_loader === "function") hide_loader();
                if (typeof Noty === "function") {
                    Noty("error", "An error occurred while saving permissions.");
                }
            });
        };

        // Initial Execution on Page Load
        $scope.LoadSameAsUsers();
        $scope.LoadPermissions();

    }]);
</script>