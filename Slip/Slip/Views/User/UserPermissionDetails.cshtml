@{
    ViewBag.Title = "User Permission Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* ==========================================================================
       User Permission Details - Distinct Mid-Tone Ice Blue Theming & SaaS Styling
       ========================================================================== */
    @@keyframes fadeInUpSmooth {
        from {
            opacity: 0;
            transform: translateY(10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .user-list-page {
        padding: 0 0 20px 0;
        margin-top: -10px;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    }

    /* Staggered Card Entrance Animations */
    .user-header-card { animation: fadeInUpSmooth 0.35s cubic-bezier(0.16, 1, 0.3, 1) 0.05s both; }
    .user-grid-card { animation: fadeInUpSmooth 0.35s cubic-bezier(0.16, 1, 0.3, 1) 0.15s both; }

    /* Page Header Card (Clean Neutral White Background with Distinct Border) */
    .user-header-card {
        background: #ffffff !important;
        border-radius: 12px !important;
        padding: 14px 20px !important;
        margin-bottom: 14px !important;
        box-shadow: 0 2px 10px rgba(15, 23, 42, 0.04) !important;
        border: 1.5px solid #cbd5e1 !important;
        border-left: 5px solid #0284c7 !important;
        display: flex !important;
        justify-content: space-between !important;
        align-items: center !important;
        flex-wrap: wrap !important;
        gap: 12px !important;
        transition: all 0.25s ease !important;
    }
    .user-header-card:hover {
        box-shadow: 0 6px 18px rgba(15, 23, 42, 0.08) !important;
        border-color: #94a3b8 !important;
        border-left-color: #0369a1 !important;
    }

    .user-header-left {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .user-header-icon {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        box-shadow: 0 4px 12px rgba(2, 132, 199, 0.28);
        transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
        flex-shrink: 0;
    }
    .user-header-card:hover .user-header-icon {
        transform: scale(1.08) rotate(4deg);
    }

    .user-header-title {
        font-size: 18px !important;
        font-weight: 700 !important;
        color: #0f172a !important;
        margin: 0 !important;
        line-height: 1.2 !important;
        letter-spacing: -0.2px;
    }

    .user-breadcrumb {
        font-size: 11.5px;
        color: #64748b;
        margin-bottom: 3px;
        font-weight: 500;
    }
    .user-breadcrumb a {
        color: #0284c7;
        text-decoration: none;
        transition: color 0.15s ease;
        font-weight: 500;
    }
    .user-breadcrumb a:hover {
        color: #0369a1;
        text-decoration: underline;
    }

    .user-header-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .btn-user-add {
        background: linear-gradient(135deg, #1d4ed8 0%, #1e3a8a 100%) !important; /* Premium Dark Blue */
        color: #ffffff !important;
        border: none !important;
        border-radius: 8px !important;
        padding: 9px 18px !important;
        font-size: 13px !important;
        font-weight: 700 !important;
        display: inline-flex !important;
        align-items: center !important;
        gap: 7px !important;
        box-shadow: 0 4px 14px rgba(29, 78, 216, 0.35) !important;
        transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1) !important;
        cursor: pointer !important;
        text-decoration: none !important;
    }
    .btn-user-add:hover {
        background: linear-gradient(135deg, #1e40af 0%, #172554 100%) !important;
        transform: translateY(-2px) !important;
        box-shadow: 0 8px 20px rgba(29, 78, 216, 0.45) !important;
        color: #ffffff !important;
        text-decoration: none !important;
    }
    .btn-user-add:active {
        transform: translateY(0) !important;
    }

    .btn-user-permission {
        background: linear-gradient(135deg, #4f46e5 0%, #3730a3 100%) !important; /* Royal Indigo */
        color: #ffffff !important;
        border: none !important;
        border-radius: 8px !important;
        padding: 9px 16px !important;
        font-size: 13px !important;
        font-weight: 600 !important;
        display: inline-flex !important;
        align-items: center !important;
        gap: 7px !important;
        box-shadow: 0 4px 14px rgba(79, 70, 229, 0.30) !important;
        transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1) !important;
        cursor: pointer !important;
        text-decoration: none !important;
    }
    .btn-user-permission:hover {
        background: linear-gradient(135deg, #4338ca 0%, #312e81 100%) !important;
        transform: translateY(-2px) !important;
        box-shadow: 0 8px 20px rgba(79, 70, 229, 0.40) !important;
        color: #ffffff !important;
        text-decoration: none !important;
    }

    /* Grid Card Container (Clean Neutral White Background with Distinct Border) */
    .user-grid-card {
        background: #ffffff !important;
        border-radius: 12px !important;
        padding: 0 !important;
        box-shadow: 0 2px 10px rgba(15, 23, 42, 0.04) !important;
        border: 1.5px solid #cbd5e1 !important;
        min-height: calc(100vh - 180px);
        overflow: hidden !important;
        position: relative !important;
        transition: all 0.25s ease !important;
    }
    .user-grid-card:hover {
        box-shadow: 0 6px 18px rgba(15, 23, 42, 0.08) !important;
        border-color: #94a3b8 !important;
    }

    .user-card-header {
        background: #ffffff !important;
        padding: 13px 18px !important;
        border-bottom: 1.5px solid #e2e8f0 !important;
        display: flex !important;
        align-items: center !important;
        justify-content: space-between !important;
        flex-wrap: wrap !important;
        gap: 10px !important;
    }
    .user-card-title-left {
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .user-card-title-left i {
        font-size: 15px;
        color: #0284c7;
    }
    .user-card-title-left h3 {
        margin: 0 !important;
        font-size: 15px !important;
        font-weight: 700 !important;
        color: #0f172a !important;
        letter-spacing: -0.1px;
    }

    .user-card-actions {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .user-grid-body {
        padding: 0 !important;
    }

    .user-grid-card .uigrid,
    .user-grid-card #gridContainer {
        width: 100% !important;
        background: transparent !important;
        border: none !important;
        border-radius: 0 !important;
        padding: 0 !important;
        box-shadow: none !important;
        min-height: calc(100vh - 210px);
    }

    #gridContainer {
        width: 100% !important;
    }

    /* Badges */
    .badge-status-pill {
        display: inline-block;
        padding: 3px 9px;
        border-radius: 12px;
        font-size: 11px;
        font-weight: 700;
        line-height: 1.2;
    }
    .badge-pill-success { background: #dcfce7; color: #15803d; border: 1px solid #bbf7d0; }
    .badge-pill-danger { background: #fee2e2; color: #b91c1c; border: 1px solid #fecaca; }
    .badge-pill-info { background: #e0f2fe; color: #0369a1; border: 1px solid #bae6fd; }
    .badge-pill-warning { background: #fef3c7; color: #b45309; border: 1px solid #fde68a; }
    .badge-pill-indigo { background: #e0e7ff; color: #3730a3; border: 1px solid #c7d2fe; }
    .badge-pill-muted { background: #f1f5f9; color: #475569; border: 1px solid #e2e8f0; }

    /* Action Buttons in Grid */
    .grid-btn-group {
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .grid-action-btn-edit {
        color: #0284c7 !important;
        background: #e0f2fe !important;
        border: none !important;
        width: 30px !important;
        height: 30px !important;
        border-radius: 6px !important;
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        cursor: pointer !important;
        transition: all 0.2s ease !important;
        text-decoration: none !important;
    }
    .grid-action-btn-edit:hover {
        background: #0284c7 !important;
        color: #ffffff !important;
        transform: scale(1.08) translateY(-1px) !important;
    }

    .grid-action-btn-del {
        color: #ef4444 !important;
        background: #fee2e2 !important;
        border: none !important;
        width: 30px !important;
        height: 30px !important;
        border-radius: 6px !important;
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        cursor: pointer !important;
        transition: all 0.2s ease !important;
    }
    .grid-action-btn-del:hover {
        background: #ef4444 !important;
        color: #ffffff !important;
        transform: scale(1.08) translateY(-1px) !important;
    }

    .grid-action-btn-perm {
        color: #4f46e5 !important;
        background: #e0e7ff !important;
        border: none !important;
        width: 30px !important;
        height: 30px !important;
        border-radius: 6px !important;
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        cursor: pointer !important;
        transition: all 0.2s ease !important;
        text-decoration: none !important;
    }
    .grid-action-btn-perm:hover {
        background: #4f46e5 !important;
        color: #ffffff !important;
        transform: scale(1.08) translateY(-1px) !important;
    }

    /* Delete Modal */
    #ConfirmDeleteModal .modal-dialog {
        max-width: 500px;
        margin: 60px auto;
    }
    #ConfirmDeleteModal .modal-content {
        border-radius: 12px !important;
        border: 1px solid #334155 !important;
        box-shadow: 0 20px 45px rgba(0, 0, 0, 0.35) !important;
        overflow: hidden !important;
        background: #ffffff !important;
    }
    #ConfirmDeleteModal .modal-header {
        background: #0f172a !important; /* Obsidian Slate Navy Header */
        color: #ffffff !important;
        padding: 14px 20px !important;
        border-bottom: 1px solid #1e293b !important;
        display: flex !important;
        justify-content: space-between !important;
        align-items: center !important;
    }
    #ConfirmDeleteModal .modal-header:before,
    #ConfirmDeleteModal .modal-header:after {
        display: none !important;
    }
    .modal-header-brand {
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .modal-header-title,
    #ConfirmDeleteModal .modal-header-title,
    #ConfirmDeleteModal .modal-header h4,
    #ConfirmDeleteModal h4 {
        font-size: 15px !important;
        font-weight: 700 !important;
        color: #ffffff !important;
        margin: 0 !important;
        letter-spacing: 0.25px !important;
        line-height: 1.3 !important;
    }
    .modal-close-btn,
    #ConfirmDeleteModal .close,
    #ConfirmDeleteModal .modal-close-btn {
        background: transparent !important;
        border: none !important;
        font-size: 24px !important;
        font-weight: 300 !important;
        color: #cbd5e1 !important;
        cursor: pointer !important;
        opacity: 0.85 !important;
        transition: all 0.2s ease !important;
        line-height: 1 !important;
        padding: 0 !important;
        margin: 0 !important;
        text-shadow: none !important;
    }
    .modal-close-btn:hover,
    #ConfirmDeleteModal .close:hover,
    #ConfirmDeleteModal .modal-close-btn:hover {
        color: #ffffff !important;
        opacity: 1 !important;
        transform: scale(1.15) !important;
    }

    .delete-dialog-content {
        text-align: center;
        padding: 20px 10px 10px;
    }
    .delete-warning-icon {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: #fef2f2;
        color: #ef4444;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
        margin-bottom: 12px;
    }
    .delete-dialog-title {
        font-size: 17px;
        font-weight: 700;
        color: #1e293b;
        margin: 0 0 6px 0;
    }
    .delete-dialog-text {
        font-size: 13px;
        color: #64748b;
        margin: 0;
    }

    .btn-modal-action {
        border-radius: 8px;
        padding: 7px 16px;
        font-size: 12.5px;
        font-weight: 600;
        border: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.2s ease;
    }
    .btn-modal-action:hover {
        transform: translateY(-2px);
    }
    .btn-modal-reset {
        background: #f1f5f9;
        color: #475569;
    }
    .btn-modal-reset:hover {
        background: #e2e8f0;
    }
    .btn-modal-delete {
        background: #ef4444;
        color: #ffffff;
    }
    .btn-modal-delete:hover {
        background: #dc2626;
    }

    /* ==========================================================================
       DevExtreme DataGrid Styling Overrides (Modern Ice Blue Look & Feel)
       ========================================================================== */
    .dx-datagrid-headers {
        background: #f0f9ff !important;
        color: #0369a1 !important;
        border-bottom: 2px solid #bae6fd !important;
        font-weight: 700 !important;
        font-size: 12.5px !important;
        text-transform: uppercase !important;
        letter-spacing: 0.3px;
    }
    .dx-datagrid-headers .dx-header-row > td {
        padding: 11px 12px !important;
        color: #0369a1 !important;
        font-weight: 700 !important;
        border-right: 1px solid #e0f2fe !important;
    }
    .dx-datagrid-rowsview .dx-row > td {
        padding: 9px 12px !important;
        font-size: 13px !important;
        color: #334155;
        border-bottom: 1px solid #f1f5f9 !important;
        border-right: 1px solid #f1f5f9 !important;
        vertical-align: middle !important;
    }
    .dx-datagrid-rowsview .dx-row-alt > td {
        background: #f8fafc !important;
    }
    .dx-datagrid-rowsview .dx-state-hover > td {
        background: #f0f9ff !important;
    }
    .dx-datagrid-filter-row > td {
        padding: 5px 8px !important;
        background: #f8fafc !important;
        border-bottom: 1.5px solid #e2e8f0 !important;
    }
    .dx-datagrid-filter-row .dx-texteditor {
        border-radius: 6px !important;
        border: 1px solid #cbd5e1 !important;
        background: #ffffff !important;
    }
    .dx-datagrid-filter-row .dx-texteditor.dx-state-focused {
        border-color: #0284c7 !important;
        box-shadow: 0 0 0 2px rgba(2, 132, 199, 0.15) !important;
    }
    .dx-datagrid-search-panel {
        margin: 0 !important;
    }
    .dx-datagrid-search-panel .dx-texteditor {
        border-radius: 8px !important;
        border: 1.5px solid #cbd5e1 !important;
        padding: 2px 6px !important;
        box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04) !important;
        transition: all 0.2s ease !important;
    }
    .dx-datagrid-search-panel .dx-texteditor.dx-state-focused {
        border-color: #0284c7 !important;
        box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.18) !important;
    }

    /* Column Chooser & Toolbar Buttons */
    .dx-toolbar-button .dx-button {
        border-radius: 7px !important;
        border: 1.5px solid #cbd5e1 !important;
        background: #ffffff !important;
        color: #475569 !important;
        transition: all 0.2s ease !important;
    }
    .dx-toolbar-button .dx-button:hover {
        background: #f1f5f9 !important;
        border-color: #94a3b8 !important;
        color: #0f172a !important;
    }

    /* Total Summary Footer */
    .dx-datagrid-total-footer {
        background: #f8fafc !important;
        border-top: 2px solid #e2e8f0 !important;
        padding: 8px 14px !important;
        font-weight: 700 !important;
        color: #0f172a !important;
    }

    /* ==========================================================================
       Mobile Responsive Styling
       ========================================================================== */
    @@media (max-width: 768px) {
        .user-list-page {
            padding: 0 0 15px 0;
            margin-top: -6px;
        }

        .user-header-card {
            flex-direction: column !important;
            align-items: stretch !important;
            padding: 12px 14px !important;
            gap: 12px !important;
        }

        .user-header-left {
            width: 100%;
        }

        .user-header-actions {
            width: 100%;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .btn-user-add,
        .btn-user-permission {
            width: 100% !important;
            justify-content: center !important;
            padding: 10px 16px !important;
            font-size: 13.5px !important;
        }

        .user-card-header {
            flex-direction: column !important;
            align-items: flex-start !important;
            gap: 8px !important;
            padding: 12px 14px !important;
        }

        .user-card-actions {
            width: 100%;
            justify-content: flex-start;
        }

        .user-grid-card {
            min-height: 480px;
        }

        .user-grid-card .uigrid,
        .user-grid-card #gridContainer {
            min-height: 440px !important;
            height: calc(100vh - 240px) !important;
        }

        .dx-datagrid-search-panel {
            width: 100% !important;
            max-width: 100% !important;
            margin-bottom: 6px !important;
        }

        #ConfirmDeleteModal .modal-dialog {
            margin: 20px 12px !important;
            max-width: calc(100% - 24px) !important;
        }
    }

    @@media (max-width: 480px) {
        .user-header-icon {
            width: 38px;
            height: 38px;
            font-size: 17px;
        }

        .user-header-title {
            font-size: 16px !important;
        }

        .user-card-title-left h3 {
            font-size: 14px !important;
        }
    }
</style>

<div ng-controller="Clearing" class="user-list-page">
    <!-- Header Banner Card -->
    <div class="user-header-card">
        <div class="user-header-left">
            <div class="user-header-icon">
                <i class="fa fa-shield"></i>
            </div>
            <div>
                <div class="user-breadcrumb">
                    <a href="@Url.Action("Index", "Home")"><i class="fa fa-home"></i> Home</a> / 
                    <a href="@Url.Action("UserDetail", "User")">User List</a> / 
                    <span>Permission Details</span>
                </div>
                <h4 class="user-header-title">User Permission Details</h4>
            </div>
        </div>
        <div class="user-header-actions">
            <a href="@Url.Action("UserDetail", "User")" class="btn-user-permission" title="Back to User List">
                <i class="fa fa-users"></i> User List
            </a>
            @*<a href="@Url.Action("Register", "Login")" target="_blank" class="btn-user-add" title="Register New User">
                <i class="fa fa-user-plus"></i> Create User
            </a>*@
        </div>
    </div>

    <!-- DataGrid Container Card -->
    <div class="user-grid-card">
        <div class="user-card-header">
            <div class="user-card-title-left">
                <i class="fa fa-table"></i>
                <h3>Permission Records ({{List.length || 0}} Records)</h3>
            </div>
            <div class="user-card-actions">
                <span class="badge-status-pill badge-pill-info">
                    <i class="fa fa-database"></i> {{List.length || 0}} Total Records
                </span>
            </div>
        </div>
        <div class="user-grid-body">
            <div class="uigrid">
                <div id="gridContainer" style="width: 100%;"></div>
            </div>
        </div>
    </div>

    <!-- Obsidian Delete Confirmation Modal -->
    <div class="modal fade" id="ConfirmDeleteModal" role="dialog" data-backdrop="static">
        <div class="modal-dialog modal-md">
            <div class="modal-content">
                <div class="modal-header">
                    <div class="modal-header-brand">
                        <i class="fa fa-exclamation-triangle" style="color: #ef4444; font-size: 18px;"></i>
                        <h4 class="modal-header-title">Confirm Delete User</h4>
                    </div>
                    <button type="button" class="close modal-close-btn" data-dismiss="modal">&times;</button>
                </div>
                <div class="modal-body" style="background: #ffffff;">
                    <div class="delete-dialog-content">
                        <div class="delete-warning-icon">
                            <i class="fa fa-trash-o"></i>
                        </div>
                        <h4 class="delete-dialog-title">Delete User Account?</h4>
                        <p class="delete-dialog-text">
                            Are you sure you want to delete user account <strong>{{SelectedDeleteItem.UserName || SelectedDeleteItem.EmployeeName || 'this record'}}</strong> 
                            <span ng-if="SelectedDeleteItem.EmployeeName">({{SelectedDeleteItem.EmployeeName}})</span>?
                        </p>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn-modal-action btn-modal-reset" data-dismiss="modal" type="button">
                        <i class="fa fa-times"></i> Cancel
                    </button>
                    <button class="btn-modal-action btn-modal-delete" ng-click="ExecuteDelete()" type="button">
                        <i class="fa fa-trash"></i> Confirm Delete
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    var module;
    try {
        module = angular.module('app');
    } catch (e) {
        module = angular.module('app', ['ngAnimate', 'ngTouch', 'ui.grid']);
    }

    module.controller("Clearing", ['$scope', '$http', '$timeout', function ($scope, $http, $timeout) {
        $scope.List = [];
        $scope.DataField = [];
        $scope.IsLoading = false;
        $scope.SelectedDeleteItem = null;

        // Open Add/Register New User in new browser tab
        $scope.OpenAddNew = function () {
            window.open('@Url.Action("Register", "Login")', '_blank');
        };

        // Open Edit User in new browser tab
        $scope.EditRow = function (id) {
            window.open('@Url.Action("Index", "User")?id=' + (id || 0), '_blank');
        };

        // Open Permission in new browser tab
        $scope.EditPermissionRow = function (id) {
            window.open('@Url.Action("UserPermission", "User")?id=' + (id || 0), '_blank');
        };

        // Fetch Data from Server
        $scope.FetchData = function () {
            $scope.IsLoading = true;
            if (typeof show_loader === 'function') show_loader();

            $http.get('@Url.Action("Getdata_User_Permission", "User")')
            .then(function (response) {
                $scope.IsLoading = false;
                if (typeof hide_loader === 'function') hide_loader();

                var rawList = (response.data && response.data.List) ? response.data.List : [];
                $scope.List = rawList;

                var rawFields = (response.data && response.data.DataField) ? response.data.DataField : [];
                $scope.BuildGridColumns(rawFields);
            }, function () {
                $scope.IsLoading = false;
                if (typeof hide_loader === 'function') hide_loader();
                if (typeof Noty === 'function') {
                    Noty("error", "Error loading user permission details from server.");
                }
            });
        };

        // Format Grid Columns
        $scope.BuildGridColumns = function (dataFields) {
            var gridColumns = [];

            // 1. Index / Serial # Column
            gridColumns.push({
                caption: '#',
                width: 55,
                alignment: 'center',
                allowReordering: false,
                fixed: true,
                fixedPosition: 'left',
                cellTemplate: function (container, options) {
                    $("<span>")
                        .text(options.rowIndex + 1)
                        .css({ "font-weight": "600", "color": "#64748b" })
                        .appendTo(container);
                }
            });

            // 2. Process backend dynamic DataFields
            if (dataFields && dataFields.length > 0) {
                angular.forEach(dataFields, function (field) {
                    var col = angular.copy(field);
                    var fieldKey = (col.dataField || '').toLowerCase();

                    // Minimum column width for aesthetics
                    if (!col.minWidth && !col.width) {
                        col.minWidth = 120;
                    }

                    // User Name
                    if (fieldKey === 'username' || fieldKey === 'user_name') {
                        col.minWidth = 140;
                        col.cellTemplate = function (container, options) {
                            $("<div>")
                                .css({ "display": "flex", "align-items": "center", "gap": "6px" })
                                .html('<i class="fa fa-user-circle" style="color: #0284c7; font-size: 14px;"></i> <strong style="color: #0f172a; font-weight: 700;">' + (options.value || '-') + '</strong>')
                                .appendTo(container);
                        };
                    }
                    // Password
                    else if (fieldKey === 'password') {
                        col.minWidth = 110;
                        col.alignment = 'center';
                        col.cellTemplate = function (container, options) {
                            $("<span>")
                                .text(options.value !== undefined && options.value !== null && options.value !== '' ? options.value : '-')
                                .css({ "font-weight": "600", "color": "#1e293b" })
                                .appendTo(container);
                        };
                    }
                    // Employee Name
                    else if (fieldKey === 'employeename' || fieldKey === 'empname' || fieldKey === 'name') {
                        col.minWidth = 150;
                        col.cellTemplate = function (container, options) {
                            $("<strong>")
                                .text(options.value || '-')
                                .css({ "color": "#1e293b", "font-weight": "600" })
                                .appendTo(container);
                        };
                    }
                    // IsAdmin
                    else if (fieldKey === 'isadmin' || fieldKey === 'admin') {
                        col.minWidth = 100;
                        col.alignment = 'center';
                        col.cellTemplate = function (container, options) {
                            var val = options.value;
                            var isAdmin = (val === true || val === 'True' || val === 'true' || val === 1 || val === '1');
                            if (isAdmin) {
                                $("<span>").addClass("badge-status-pill badge-pill-info").html('<i class="fa fa-shield"></i> Admin').appendTo(container);
                            } else {
                                $("<span>").addClass("badge-status-pill badge-pill-muted").text("Standard").appendTo(container);
                            }
                        };
                    }
                    // IsActive Status
                    else if (fieldKey === 'isactive' || fieldKey === 'status') {
                        col.minWidth = 95;
                        col.alignment = 'center';
                        col.cellTemplate = function (container, options) {
                            var val = options.value;
                            var isActive = (val === true || val === 'True' || val === 'true' || val === 1 || val === '1');
                            if (isActive) {
                                $("<span>").addClass("badge-status-pill badge-pill-success").text("Active").appendTo(container);
                            } else {
                                $("<span>").addClass("badge-status-pill badge-pill-danger").text("Inactive").appendTo(container);
                            }
                        };
                    }
                    // Age
                    else if (fieldKey === 'age') {
                        col.minWidth = 75;
                        col.alignment = 'center';
                        col.cellTemplate = function (container, options) {
                            $("<span>")
                                .text(options.value ? options.value : '-')
                                .css({ "font-weight": "600", "color": "#334155" })
                                .appendTo(container);
                        };
                    }
                    // Created By User
                    else if (fieldKey === 'createdbyuser' || fieldKey === 'createdbyusername' || fieldKey === 'createdby') {
                        col.minWidth = 130;
                        col.cellTemplate = function (container, options) {
                            if (options.value) {
                                $("<span>")
                                    .addClass("badge-status-pill badge-pill-indigo")
                                    .text(options.value)
                                    .appendTo(container);
                            } else {
                                $("<span>").text("-").appendTo(container);
                            }
                        };
                    }
                    // Boolean Permission Flags (View, Add, Edit, Delete, Export, Mail, Print, History)
                    else if (fieldKey === 'view' || fieldKey === 'add' || fieldKey === 'edit' || fieldKey === 'delete' || fieldKey === 'export' || fieldKey === 'mail' || fieldKey === 'print' || fieldKey === 'history') {
                        col.minWidth = 80;
                        col.alignment = 'center';
                        col.cellTemplate = function (container, options) {
                            var val = options.value;
                            var isTrue = (val === true || val === 'True' || val === 'true' || val === 1 || val === '1');
                            if (isTrue) {
                                $("<span>")
                                    .html('<i class="fa fa-check" style="color: #10b981; font-weight: bold; font-size: 14px;"></i>')
                                    .appendTo(container);
                            } else {
                                $("<span>")
                                    .html('<i class="fa fa-times" style="color: #cbd5e1; font-size: 13px;"></i>')
                                    .appendTo(container);
                            }
                        };
                    }
                    // Date Formatting
                    else if (fieldKey.indexOf('date') !== -1 || fieldKey === 'created' || fieldKey === 'modified') {
                        col.minWidth = 120;
                        col.dataType = 'date';
                        col.format = 'dd-MMM-yyyy';
                        col.alignment = 'center';
                    }

                    gridColumns.push(col);
                });
            }

            // 3. Action Column (Edit & Delete)
            gridColumns.push({
                caption: 'Action',
                width: 95,
                alignment: 'center',
                fixed: true,
                fixedPosition: 'right',
                allowReordering: false,
                cellTemplate: function (container, options) {
                    var group = $("<div>").addClass("grid-btn-group");

                    // Edit Button
                    $("<button>")
                        .addClass("grid-action-btn-edit")
                        .attr("title", "Edit User")
                        .html('<i class="fa fa-pencil"></i>')
                        .on("click", function (e) {
                            e.preventDefault();
                            $scope.$apply(function () {
                                $scope.EditRow(options.data.ID || options.data.UserID);
                            });
                        })
                        .appendTo(group);

                    // Delete Button
                    $("<button>")
                        .addClass("grid-action-btn-del")
                        .attr("title", "Delete User")
                        .html('<i class="fa fa-trash-o"></i>')
                        .on("click", function (e) {
                            e.preventDefault();
                            $scope.$apply(function () {
                                $scope.PromptDelete(options.data);
                            });
                        })
                        .appendTo(group);

                    group.appendTo(container);
                }
            });

            // 4. Permission Action Column
            gridColumns.push({
                caption: 'Permission',
                width: 95,
                alignment: 'center',
                fixed: true,
                fixedPosition: 'right',
                allowReordering: false,
                cellTemplate: function (container, options) {
                    var group = $("<div>").addClass("grid-btn-group");

                    // Permission Matrix Button
                    $("<button>")
                        .addClass("grid-action-btn-perm")
                        .attr("title", "Edit User Permissions")
                        .html('<i class="fa fa-key"></i>')
                        .on("click", function (e) {
                            e.preventDefault();
                            $scope.$apply(function () {
                                $scope.EditPermissionRow(options.data.ID || options.data.UserID);
                            });
                        })
                        .appendTo(group);

                    group.appendTo(container);
                }
            });

            $scope.InitGrid(gridColumns);
        };

        // Delete handlers
        $scope.PromptDelete = function (item) {
            $scope.SelectedDeleteItem = item;
            $("#ConfirmDeleteModal").modal("show");
        };

        $scope.ExecuteDelete = function () {
            if (!$scope.SelectedDeleteItem) {
                $("#ConfirmDeleteModal").modal("hide");
                return;
            }
            var empId = $scope.SelectedDeleteItem.ID || $scope.SelectedDeleteItem.EmployeeID || $scope.SelectedDeleteItem.UserID;
            if (!empId) {
                $("#ConfirmDeleteModal").modal("hide");
                return;
            }

            $scope.IsLoading = true;
            if (typeof show_loader === 'function') show_loader();

            var JsonPassData = { "EmployeeID": empId };
            var Action = "DELETE";

            $http({
                method: "post",
                url: '@Url.Action("InsertUpdateEmployee", "Employees")',
                data: { model: JsonPassData, Action: Action },
                dataType: "json"
            }).then(function (ret) {
                $scope.IsLoading = false;
                if (typeof hide_loader === 'function') hide_loader();
                $("#ConfirmDeleteModal").modal("hide");

                var respMsg = (ret.data && typeof ret.data === 'string') ? ret.data : (ret.data && ret.data.message ? ret.data.message : '');
                if (respMsg === "Recored Is Deleted" || respMsg.toLowerCase().indexOf("deleted") !== -1) {
                    if (typeof Noty === 'function') Noty("success", "Record Deleted Successfully");
                    $scope.FetchData();
                } else {
                    if (typeof Noty === 'function') Noty("error", respMsg || "Record Not Deleted");
                }
            }, function () {
                $scope.IsLoading = false;
                if (typeof hide_loader === 'function') hide_loader();
                $("#ConfirmDeleteModal").modal("hide");
                if (typeof Noty === 'function') Noty("error", "Error connecting to server.");
            });
        };

        // DevExtreme DataGrid Initialization
        $scope.InitGrid = function (columns) {
            $("#gridContainer").dxDataGrid({
                dataSource: $scope.List,
                keyExpr: 'UserName',
                columns: columns,
                height: 'calc(100vh - 210px)',
                columnAutoWidth: true,
                allowColumnResizing: true,
                columnResizingMode: 'widget',
                allowColumnReordering: true,
                columnChooser: {
                    enabled: true,
                    mode: 'select'
                },
                columnFixing: {
                    enabled: true
                },
                showColumnLines: true,
                showRowLines: true,
                showBorders: true,
                rowAlternationEnabled: true,
                wordWrapEnabled: false,
                sorting: { mode: "multiple" },
                scrolling: {
                    mode: 'virtual'
                },
                paging: { 
                    enabled: false 
                },
                pager: { 
                    visible: false 
                },
                searchPanel: {
                    visible: true,
                    width: 280,
                    placeholder: 'Search permission details...'
                },
                filterRow: { 
                    visible: true,
                    applyFilter: 'auto'
                },
                headerFilter: { visible: true },
                selection: {
                    mode: 'single'
                },
                export: {
                    enabled: true,
                    formats: ['xlxs'],
                    allowExportSelectedData: false
                },
                onExporting: function (e) {
                    if (e.format === 'xlxs') {
                        if (typeof ExcelJS !== 'undefined') {
                            var workbook = new ExcelJS.Workbook();
                            var worksheet = workbook.addWorksheet('PermissionDetails');
                            DevExpress.excelExporter.exportDataGrid({
                                component: e.component,
                                worksheet: worksheet,
                                autoFilterEnabled: true
                            }).then(function () {
                                workbook.xlsx.writeBuffer().then(function (buffer) {
                                    saveAs(new Blob([buffer], { type: 'application/octet-stream' }), 'User_Permission_Details.xlsx');
                                });
                            });
                        }
                    }
                },
                summary: {
                    totalItems: [
                        {
                            column: 'UserName',
                            summaryType: 'count',
                            displayFormat: 'Total: {0}'
                        }
                    ]
                }
            });
        };

        // Fetch data on load
        $scope.FetchData();
    }]);
</script>