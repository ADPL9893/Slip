@{
    ViewBag.Title = "User Permission Details";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}


<div ng-controller="Clearing" class="user-list-page">
    <!-- Header Banner Card -->
    <div class="user-header-card">
        <div class="user-header-left">
            <div class="user-header-icon">
                <i class="fa fa-shield"></i>
            </div>
            <div>
                <div class="user-breadcrumb">
                    <a href="@Url.Action("Index", "Home")"><i class="fa fa-home"></i> Home</a> / 
                    <a href="@Url.Action("UserDetail", "User")">User List</a> / 
                    <span>Permission Details</span>
                </div>
                <h4 class="user-header-title">User Permission Details</h4>
            </div>
        </div>
        <div class="user-header-actions">
            <a href="@Url.Action("UserDetail", "User")" class="btn-user-permission" title="Back to User List">
                <i class="fa fa-users"></i> User List
            </a>
            @*<a href="@Url.Action("Register", "Login")" target="_blank" class="btn-user-add" title="Register New User">
                <i class="fa fa-user-plus"></i> Create User
            </a>*@
        </div>
    </div>

    <!-- DataGrid Container Card -->
    <div class="user-grid-card">
        <div class="user-card-header">
            <div class="user-card-title-left">
                <i class="fa fa-table"></i>
                <h3>Permission Records ({{List.length || 0}} Records)</h3>
            </div>
            <div class="user-card-actions">
                <span class="badge-status-pill badge-pill-info">
                    <i class="fa fa-database"></i> {{List.length || 0}} Total Records
                </span>
            </div>
        </div>
        <div class="user-grid-body">
            <div class="uigrid">
                <div id="gridContainer" style="width: 100%;"></div>
            </div>
        </div>
    </div>

    <!-- Obsidian Delete Confirmation Modal -->
    <div class="modal fade" id="ConfirmDeleteModal" role="dialog" data-backdrop="static">
        <div class="modal-dialog modal-md">
            <div class="modal-content">
                <div class="modal-header">
                    <div class="modal-header-brand">
                        <i class="fa fa-exclamation-triangle" style="color: #ef4444; font-size: 18px;"></i>
                        <h4 class="modal-header-title">Confirm Delete User</h4>
                    </div>
                    <button type="button" class="close modal-close-btn" data-dismiss="modal">&times;</button>
                </div>
                <div class="modal-body" style="background: #ffffff;">
                    <div class="delete-dialog-content">
                        <div class="delete-warning-icon">
                            <i class="fa fa-trash-o"></i>
                        </div>
                        <h4 class="delete-dialog-title">Delete User Account?</h4>
                        <p class="delete-dialog-text">
                            Are you sure you want to delete user account <strong>{{SelectedDeleteItem.UserName || SelectedDeleteItem.EmployeeName || 'this record'}}</strong> 
                            <span ng-if="SelectedDeleteItem.EmployeeName">({{SelectedDeleteItem.EmployeeName}})</span>?
                        </p>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn-modal-action btn-modal-reset" data-dismiss="modal" type="button">
                        <i class="fa fa-times"></i> Cancel
                    </button>
                    <button class="btn-modal-action btn-modal-delete" ng-click="ExecuteDelete()" type="button">
                        <i class="fa fa-trash"></i> Confirm Delete
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    var module;
    try {
        module = angular.module('app');
    } catch (e) {
        module = angular.module('app', ['ngAnimate', 'ngTouch', 'ui.grid']);
    }

    module.controller("Clearing", ['$scope', '$http', '$timeout', function ($scope, $http, $timeout) {
        $scope.List = [];
        $scope.DataField = [];
        $scope.IsLoading = false;
        $scope.SelectedDeleteItem = null;

        // Open Add/Register New User in new browser tab
        $scope.OpenAddNew = function () {
            window.open('@Url.Action("Register", "Login")', '_blank');
        };

        // Open Edit User in new browser tab
        $scope.EditRow = function (id) {
            window.open('@Url.Action("Index", "User")?id=' + (id || 0), '_blank');
        };

        // Open Permission in new browser tab
        $scope.EditPermissionRow = function (id) {
            window.open('@Url.Action("UserPermission", "User")?id=' + (id || 0), '_blank');
        };

        // Fetch Data from Server
        $scope.FetchData = function () {
            $scope.IsLoading = true;
            if (typeof show_loader === 'function') show_loader();

            $http.get('@Url.Action("Getdata_User_Permission", "User")')
            .then(function (response) {
                $scope.IsLoading = false;
                if (typeof hide_loader === 'function') hide_loader();

                var rawList = (response.data && response.data.List) ? response.data.List : [];
                $scope.List = rawList;

                var rawFields = (response.data && response.data.DataField) ? response.data.DataField : [];
                $scope.BuildGridColumns(rawFields);
            }, function () {
                $scope.IsLoading = false;
                if (typeof hide_loader === 'function') hide_loader();
                if (typeof Noty === 'function') {
                    Noty("error", "Error loading user permission details from server.");
                }
            });
        };

        // Format Grid Columns
        $scope.BuildGridColumns = function (dataFields) {
            var gridColumns = [];

            // 1. Index / Serial # Column
            gridColumns.push({
                caption: '#',
                width: 55,
                alignment: 'center',
                allowReordering: false,
                fixed: true,
                fixedPosition: 'left',
                cellTemplate: function (container, options) {
                    $("<span>")
                        .text(options.rowIndex + 1)
                        .css({ "font-weight": "600", "color": "#64748b" })
                        .appendTo(container);
                }
            });

            // 2. Process backend dynamic DataFields
            if (dataFields && dataFields.length > 0) {
                angular.forEach(dataFields, function (field) {
                    var col = angular.copy(field);
                    var fieldKey = (col.dataField || '').toLowerCase();

                    // Minimum column width for aesthetics
                    if (!col.minWidth && !col.width) {
                        col.minWidth = 120;
                    }

                    // User Name
                    if (fieldKey === 'username' || fieldKey === 'user_name') {
                        col.minWidth = 140;
                        col.cellTemplate = function (container, options) {
                            $("<div>")
                                .css({ "display": "flex", "align-items": "center", "gap": "6px" })
                                .html('<i class="fa fa-user-circle" style="color: #0284c7; font-size: 14px;"></i> <strong style="color: #0f172a; font-weight: 700;">' + (options.value || '-') + '</strong>')
                                .appendTo(container);
                        };
                    }
                    // Password
                    else if (fieldKey === 'password') {
                        col.minWidth = 110;
                        col.alignment = 'center';
                        col.cellTemplate = function (container, options) {
                            $("<span>")
                                .text(options.value !== undefined && options.value !== null && options.value !== '' ? options.value : '-')
                                .css({ "font-weight": "600", "color": "#1e293b" })
                                .appendTo(container);
                        };
                    }
                    // Employee Name
                    else if (fieldKey === 'employeename' || fieldKey === 'empname' || fieldKey === 'name') {
                        col.minWidth = 150;
                        col.cellTemplate = function (container, options) {
                            $("<strong>")
                                .text(options.value || '-')
                                .css({ "color": "#1e293b", "font-weight": "600" })
                                .appendTo(container);
                        };
                    }
                    // IsAdmin
                    else if (fieldKey === 'isadmin' || fieldKey === 'admin') {
                        col.minWidth = 100;
                        col.alignment = 'center';
                        col.cellTemplate = function (container, options) {
                            var val = options.value;
                            var isAdmin = (val === true || val === 'True' || val === 'true' || val === 1 || val === '1');
                            if (isAdmin) {
                                $("<span>").addClass("badge-status-pill badge-pill-info").html('<i class="fa fa-shield"></i> Admin').appendTo(container);
                            } else {
                                $("<span>").addClass("badge-status-pill badge-pill-muted").text("Standard").appendTo(container);
                            }
                        };
                    }
                    // IsActive Status
                    else if (fieldKey === 'isactive' || fieldKey === 'status') {
                        col.minWidth = 95;
                        col.alignment = 'center';
                        col.cellTemplate = function (container, options) {
                            var val = options.value;
                            var isActive = (val === true || val === 'True' || val === 'true' || val === 1 || val === '1');
                            if (isActive) {
                                $("<span>").addClass("badge-status-pill badge-pill-success").text("Active").appendTo(container);
                            } else {
                                $("<span>").addClass("badge-status-pill badge-pill-danger").text("Inactive").appendTo(container);
                            }
                        };
                    }
                    // Age
                    else if (fieldKey === 'age') {
                        col.minWidth = 75;
                        col.alignment = 'center';
                        col.cellTemplate = function (container, options) {
                            $("<span>")
                                .text(options.value ? options.value : '-')
                                .css({ "font-weight": "600", "color": "#334155" })
                                .appendTo(container);
                        };
                    }
                    // Created By User
                    else if (fieldKey === 'createdbyuser' || fieldKey === 'createdbyusername' || fieldKey === 'createdby') {
                        col.minWidth = 130;
                        col.cellTemplate = function (container, options) {
                            if (options.value) {
                                $("<span>")
                                    .addClass("badge-status-pill badge-pill-indigo")
                                    .text(options.value)
                                    .appendTo(container);
                            } else {
                                $("<span>").text("-").appendTo(container);
                            }
                        };
                    }
                    // Boolean Permission Flags (View, Add, Edit, Delete, Export, Mail, Print, History)
                    else if (fieldKey === 'view' || fieldKey === 'add' || fieldKey === 'edit' || fieldKey === 'delete' || fieldKey === 'export' || fieldKey === 'mail' || fieldKey === 'print' || fieldKey === 'history') {
                        col.minWidth = 80;
                        col.alignment = 'center';
                        col.cellTemplate = function (container, options) {
                            var val = options.value;
                            var isTrue = (val === true || val === 'True' || val === 'true' || val === 1 || val === '1');
                            if (isTrue) {
                                $("<span>")
                                    .html('<i class="fa fa-check" style="color: #10b981; font-weight: bold; font-size: 14px;"></i>')
                                    .appendTo(container);
                            } else {
                                $("<span>")
                                    .html('<i class="fa fa-times" style="color: #cbd5e1; font-size: 13px;"></i>')
                                    .appendTo(container);
                            }
                        };
                    }
                    // Date Formatting
                    else if (fieldKey.indexOf('date') !== -1 || fieldKey === 'created' || fieldKey === 'modified') {
                        col.minWidth = 120;
                        col.dataType = 'date';
                        col.format = 'dd-MMM-yyyy';
                        col.alignment = 'center';
                    }

                    gridColumns.push(col);
                });
            }

            // 3. Action Column (Edit & Delete)
            gridColumns.push({
                caption: 'Action',
                width: 95,
                alignment: 'center',
                fixed: true,
                fixedPosition: 'right',
                allowReordering: false,
                cellTemplate: function (container, options) {
                    var group = $("<div>").addClass("grid-btn-group");

                    // Edit Button
                    $("<button>")
                        .addClass("grid-action-btn-edit")
                        .attr("title", "Edit User")
                        .html('<i class="fa fa-pencil"></i>')
                        .on("click", function (e) {
                            e.preventDefault();
                            $scope.$apply(function () {
                                $scope.EditRow(options.data.ID || options.data.UserID);
                            });
                        })
                        .appendTo(group);

                    // Delete Button
                    $("<button>")
                        .addClass("grid-action-btn-del")
                        .attr("title", "Delete User")
                        .html('<i class="fa fa-trash-o"></i>')
                        .on("click", function (e) {
                            e.preventDefault();
                            $scope.$apply(function () {
                                $scope.PromptDelete(options.data);
                            });
                        })
                        .appendTo(group);

                    group.appendTo(container);
                }
            });

            // 4. Permission Action Column
            gridColumns.push({
                caption: 'Permission',
                width: 95,
                alignment: 'center',
                fixed: true,
                fixedPosition: 'right',
                allowReordering: false,
                cellTemplate: function (container, options) {
                    var group = $("<div>").addClass("grid-btn-group");

                    // Permission Matrix Button
                    $("<button>")
                        .addClass("grid-action-btn-perm")
                        .attr("title", "Edit User Permissions")
                        .html('<i class="fa fa-key"></i>')
                        .on("click", function (e) {
                            e.preventDefault();
                            $scope.$apply(function () {
                                $scope.EditPermissionRow(options.data.ID || options.data.UserID);
                            });
                        })
                        .appendTo(group);

                    group.appendTo(container);
                }
            });

            $scope.InitGrid(gridColumns);
        };

        // Delete handlers
        $scope.PromptDelete = function (item) {
            $scope.SelectedDeleteItem = item;
            $("#ConfirmDeleteModal").modal("show");
        };

        $scope.ExecuteDelete = function () {
            if (!$scope.SelectedDeleteItem) {
                $("#ConfirmDeleteModal").modal("hide");
                return;
            }
            var empId = $scope.SelectedDeleteItem.ID || $scope.SelectedDeleteItem.EmployeeID || $scope.SelectedDeleteItem.UserID;
            if (!empId) {
                $("#ConfirmDeleteModal").modal("hide");
                return;
            }

            $scope.IsLoading = true;
            if (typeof show_loader === 'function') show_loader();

            var JsonPassData = { "EmployeeID": empId };
            var Action = "DELETE";

            $http({
                method: "post",
                url: '@Url.Action("InsertUpdateEmployee", "Employees")',
                data: { model: JsonPassData, Action: Action },
                dataType: "json"
            }).then(function (ret) {
                $scope.IsLoading = false;
                if (typeof hide_loader === 'function') hide_loader();
                $("#ConfirmDeleteModal").modal("hide");

                var respMsg = (ret.data && typeof ret.data === 'string') ? ret.data : (ret.data && ret.data.message ? ret.data.message : '');
                if (respMsg === "Recored Is Deleted" || respMsg.toLowerCase().indexOf("deleted") !== -1) {
                    if (typeof Noty === 'function') Noty("success", "Record Deleted Successfully");
                    $scope.FetchData();
                } else {
                    if (typeof Noty === 'function') Noty("error", respMsg || "Record Not Deleted");
                }
            }, function () {
                $scope.IsLoading = false;
                if (typeof hide_loader === 'function') hide_loader();
                $("#ConfirmDeleteModal").modal("hide");
                if (typeof Noty === 'function') Noty("error", "Error connecting to server.");
            });
        };

        // DevExtreme DataGrid Initialization
        $scope.InitGrid = function (columns) {
            $("#gridContainer").dxDataGrid({
                dataSource: $scope.List,
                keyExpr: 'UserName',
                columns: columns,
                height: 'calc(100vh - 210px)',
                columnAutoWidth: true,
                allowColumnResizing: true,
                columnResizingMode: 'widget',
                allowColumnReordering: true,
                columnChooser: {
                    enabled: true,
                    mode: 'select'
                },
                columnFixing: {
                    enabled: true
                },
                showColumnLines: true,
                showRowLines: true,
                showBorders: true,
                rowAlternationEnabled: true,
                wordWrapEnabled: false,
                sorting: { mode: "multiple" },
                scrolling: {
                    mode: 'virtual'
                },
                paging: { 
                    enabled: false 
                },
                pager: { 
                    visible: false 
                },
                searchPanel: {
                    visible: true,
                    width: 280,
                    placeholder: 'Search permission details...'
                },
                filterRow: { 
                    visible: true,
                    applyFilter: 'auto'
                },
                headerFilter: { visible: true },
                selection: {
                    mode: 'single'
                },
                export: {
                    enabled: true,
                    formats: ['xlxs'],
                    allowExportSelectedData: false
                },
                onExporting: function (e) {
                    if (e.format === 'xlxs') {
                        if (typeof ExcelJS !== 'undefined') {
                            var workbook = new ExcelJS.Workbook();
                            var worksheet = workbook.addWorksheet('PermissionDetails');
                            DevExpress.excelExporter.exportDataGrid({
                                component: e.component,
                                worksheet: worksheet,
                                autoFilterEnabled: true
                            }).then(function () {
                                workbook.xlsx.writeBuffer().then(function (buffer) {
                                    saveAs(new Blob([buffer], { type: 'application/octet-stream' }), 'User_Permission_Details.xlsx');
                                });
                            });
                        }
                    }
                },
                summary: {
                    totalItems: [
                        {
                            column: 'UserName',
                            summaryType: 'count',
                            displayFormat: 'Total: {0}'
                        }
                    ]
                }
            });
        };

        // Fetch data on load
        $scope.FetchData();
    }]);
</script>