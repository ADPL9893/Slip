@{
    ViewBag.Title = "Change Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* ==========================================================================
       Change Password - SaaS Card View & Ice Blue Theming
       ========================================================================== */
    @@keyframes fadeInUpSmooth {
        from {
            opacity: 0;
            transform: translateY(10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .change-pwd-page {
        padding: 0 0 25px 0;
        margin-top: -10px;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    }

    /* Staggered Card Entrance Animations */
    .change-pwd-header-card { animation: fadeInUpSmooth 0.35s cubic-bezier(0.16, 1, 0.3, 1) 0.05s both; }
    .change-pwd-card { animation: fadeInUpSmooth 0.35s cubic-bezier(0.16, 1, 0.3, 1) 0.12s both; }

    /* Page Header Card (Clean Neutral White Background with Distinct Border) */
    .change-pwd-header-card {
        background: #ffffff !important;
        border-radius: 12px !important;
        padding: 14px 20px !important;
        margin-bottom: 16px !important;
        box-shadow: 0 2px 10px rgba(15, 23, 42, 0.04) !important;
        border: 1.5px solid #cbd5e1 !important;
        border-left: 5px solid #0284c7 !important;
        display: flex !important;
        justify-content: space-between !important;
        align-items: center !important;
        flex-wrap: wrap !important;
        gap: 12px !important;
        transition: all 0.25s ease !important;
    }
    .change-pwd-header-card:hover {
        box-shadow: 0 6px 18px rgba(15, 23, 42, 0.08) !important;
        border-color: #94a3b8 !important;
        border-left-color: #0369a1 !important;
    }

    .change-pwd-header-left {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .change-pwd-header-icon {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        box-shadow: 0 4px 12px rgba(2, 132, 199, 0.28);
        transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
        flex-shrink: 0;
    }
    .change-pwd-header-card:hover .change-pwd-header-icon {
        transform: scale(1.08) rotate(4deg);
    }

    .change-pwd-header-title {
        font-size: 18px !important;
        font-weight: 700 !important;
        color: #0f172a !important;
        margin: 0 !important;
        line-height: 1.2 !important;
        letter-spacing: -0.2px;
    }

    .change-pwd-breadcrumb {
        font-size: 11.5px;
        color: #64748b;
        margin-bottom: 3px;
        font-weight: 500;
    }
    .change-pwd-breadcrumb a {
        color: #0284c7;
        text-decoration: none;
        transition: color 0.15s ease;
        font-weight: 500;
    }
    .change-pwd-breadcrumb a:hover {
        color: #0369a1;
        text-decoration: underline;
    }

    /* Buttons */
    .btn-pwd-save {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%) !important;
        color: #ffffff !important;
        border: none !important;
        border-radius: 8px !important;
        padding: 9px 20px !important;
        font-size: 13px !important;
        font-weight: 700 !important;
        display: inline-flex !important;
        align-items: center !important;
        gap: 7px !important;
        box-shadow: 0 4px 14px rgba(16, 185, 129, 0.30) !important;
        transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1) !important;
        cursor: pointer !important;
        text-decoration: none !important;
    }
    .btn-pwd-save:hover {
        background: linear-gradient(135deg, #059669 0%, #047857 100%) !important;
        transform: translateY(-2px) !important;
        box-shadow: 0 8px 20px rgba(16, 185, 129, 0.45) !important;
        color: #ffffff !important;
    }
    .btn-pwd-save:active {
        transform: translateY(0) !important;
    }

    .btn-pwd-clear {
        background: #ffffff !important;
        color: #475569 !important;
        border: 1.5px solid #cbd5e1 !important;
        border-radius: 8px !important;
        padding: 8px 16px !important;
        font-size: 13px !important;
        font-weight: 600 !important;
        display: inline-flex !important;
        align-items: center !important;
        gap: 6px !important;
        transition: all 0.2s ease !important;
        cursor: pointer !important;
        text-decoration: none !important;
    }
    .btn-pwd-clear:hover {
        background: #f1f5f9 !important;
        color: #1e293b !important;
        border-color: #94a3b8 !important;
        transform: translateY(-1px) !important;
    }

    .btn-pwd-back {
        background: #ffffff !important;
        color: #0369a1 !important;
        border: 1.5px solid #bae6fd !important;
        border-radius: 8px !important;
        padding: 8px 16px !important;
        font-size: 13px !important;
        font-weight: 600 !important;
        display: inline-flex !important;
        align-items: center !important;
        gap: 6px !important;
        transition: all 0.2s ease !important;
        cursor: pointer !important;
        text-decoration: none !important;
    }
    .btn-pwd-back:hover {
        background: #0284c7 !important;
        color: #ffffff !important;
        border-color: #0284c7 !important;
        transform: translateY(-1px) !important;
    }

    /* Main Form Card (Left-Aligned with Soft Pastel Ice Blue Background) */
    .change-pwd-card {
        background: #f0f9ff !important; /* Soft Pastel Ice Blue */
        border-radius: 12px !important;
        box-shadow: 0 2px 10px rgba(15, 23, 42, 0.04) !important;
        border: 1.5px solid #bae6fd !important;
        overflow: hidden !important;
        max-width: 680px;
        margin: 0; /* Left Aligned */
        transition: all 0.25s ease !important;
    }
    .change-pwd-card:hover {
        box-shadow: 0 6px 18px rgba(2, 132, 199, 0.12) !important;
        border-color: #7dd3fc !important;
    }

    .change-pwd-card-header {
        background: #e0f2fe !important; /* Distinct Header Tint */
        padding: 14px 20px !important;
        border-bottom: 1.5px solid #bae6fd !important;
        display: flex !important;
        align-items: center !important;
        justify-content: space-between !important;
    }
    .change-pwd-card-header-left {
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .change-pwd-card-header-left i {
        font-size: 16px;
        color: #0284c7;
    }
    .change-pwd-card-header-left h3 {
        margin: 0 !important;
        font-size: 15px !important;
        font-weight: 700 !important;
        color: #0369a1 !important;
        letter-spacing: -0.1px;
    }

    .change-pwd-card-body {
        padding: 24px 26px !important;
        background: #f0f9ff !important; /* Pastel Background Behind Fields */
    }

    /* Form Fields */
    .form-group-custom {
        margin-bottom: 18px;
    }
    .form-group-custom:last-child {
        margin-bottom: 0;
    }

    .form-label-custom {
        font-size: 13px !important;
        font-weight: 600 !important;
        color: #1e293b !important;
        margin-bottom: 6px !important;
        display: block !important;
    }

    .input-group-custom {
        position: relative;
        display: flex;
        align-items: stretch;
        width: 100%;
    }

    .input-icon-left {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: #94a3b8;
        font-size: 14px;
        z-index: 2;
        pointer-events: none;
    }

    .form-control-custom {
        width: 100% !important;
        height: 42px !important;
        padding: 8px 40px 8px 40px !important;
        border-radius: 8px !important;
        border: 1.5px solid #cbd5e1 !important;
        font-size: 13.5px !important;
        color: #0f172a !important;
        background: #ffffff !important; /* Clean White Input Fields */
        transition: all 0.2s ease !important;
        outline: none !important;
    }
    .form-control-custom:focus {
        border-color: #0284c7 !important;
        box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.15) !important;
    }
    .form-control-custom::placeholder {
        color: #94a3b8;
        font-size: 13px;
    }

    .btn-toggle-eye {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        background: transparent;
        border: none;
        color: #94a3b8;
        cursor: pointer;
        padding: 4px 6px;
        font-size: 14px;
        z-index: 3;
        transition: color 0.15s ease;
    }
    .btn-toggle-eye:hover {
        color: #0284c7;
    }

    /* Security Tips Box */
    .pwd-tips-box {
        background: #e0f2fe;
        border: 1px solid #bae6fd;
        border-radius: 8px;
        padding: 12px 16px;
        margin-top: 20px;
        display: flex;
        align-items: flex-start;
        gap: 10px;
    }
    .pwd-tips-icon {
        color: #0284c7;
        font-size: 16px;
        margin-top: 2px;
    }
    .pwd-tips-text {
        font-size: 12.5px;
        color: #0369a1;
        margin: 0;
        line-height: 1.4;
    }

    .change-pwd-card-footer {
        background: #e0f2fe !important;
        padding: 14px 26px;
        border-top: 1.5px solid #bae6fd;
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 10px;
    }

    /* Responsive Design */
    @@media (max-width: 768px) {
        .change-pwd-header-card {
            flex-direction: column !important;
            align-items: stretch !important;
            padding: 12px 14px !important;
            gap: 12px !important;
        }

        .change-pwd-header-left {
            width: 100%;
        }

        .change-pwd-card {
            max-width: 100%;
        }

        .change-pwd-card-body {
            padding: 18px 16px !important;
        }

        .change-pwd-card-footer {
            flex-direction: column-reverse;
            gap: 8px;
            padding: 14px 16px;
        }

        .btn-pwd-save,
        .btn-pwd-clear,
        .btn-pwd-back {
            width: 100% !important;
            justify-content: center !important;
            padding: 10px 16px !important;
            font-size: 13.5px !important;
        }
    }
</style>

<div ng-controller="UserMaster" class="change-pwd-page">
    <!-- Header Banner Card (Clean Title & Breadcrumb without Top Action Buttons) -->
    <div class="change-pwd-header-card">
        <div class="change-pwd-header-left">
            <div class="change-pwd-header-icon">
                <i class="fa fa-key"></i>
            </div>
            <div>
                <div class="change-pwd-breadcrumb">
                    <a href="@Url.Action("Index", "Home")"><i class="fa fa-home"></i> Home</a> / 
                    <a href="@Url.Action("UserDetail", "User")">User List</a> / 
                    <span>Change Password</span>
                </div>
                <h4 class="change-pwd-header-title">Change Password</h4>
            </div>
        </div>
    </div>

    <!-- Main Card Container (Left-Aligned with Light Ice Blue Background) -->
    <div class="change-pwd-card">
        <div class="change-pwd-card-header">
            <div class="change-pwd-card-header-left">
                <i class="fa fa-shield"></i>
                <h3>Account Credentials</h3>
            </div>
        </div>

        <div class="change-pwd-card-body">
            <form role="form">
                <!-- User Name -->
                <div class="form-group-custom">
                    <label class="form-label-custom">User Name <span style="color: #ef4444;">*</span></label>
                    <div class="input-group-custom">
                        <i class="fa fa-user input-icon-left"></i>
                        <input type="text" 
                               class="form-control-custom" 
                               ng-model="UserMaster.UserName" 
                               placeholder="Enter username" 
                               autocomplete="username" />
                    </div>
                </div>

                <!-- Old Password -->
                <div class="form-group-custom">
                    <label class="form-label-custom">Old Password <span style="color: #ef4444;">*</span></label>
                    <div class="input-group-custom">
                        <i class="fa fa-lock input-icon-left"></i>
                        <input type="{{showOldPwd ? 'text' : 'password'}}" 
                               class="form-control-custom" 
                               ng-model="UserMaster.Password" 
                               placeholder="Enter current password" 
                               autocomplete="current-password" />
                        <button type="button" 
                                class="btn-toggle-eye" 
                                ng-click="showOldPwd = !showOldPwd" 
                                tabindex="-1" 
                                title="{{showOldPwd ? 'Hide password' : 'Show password'}}">
                            <i class="fa" ng-class="showOldPwd ? 'fa-eye-slash' : 'fa-eye'"></i>
                        </button>
                    </div>
                </div>

                <!-- New Password -->
                <div class="form-group-custom">
                    <label class="form-label-custom">New Password <span style="color: #ef4444;">*</span></label>
                    <div class="input-group-custom">
                        <i class="fa fa-key input-icon-left"></i>
                        <input type="{{showNewPwd ? 'text' : 'password'}}" 
                               class="form-control-custom" 
                               ng-model="UserMaster.NewPassword" 
                               placeholder="Enter new password" 
                               autocomplete="new-password" />
                        <button type="button" 
                                class="btn-toggle-eye" 
                                ng-click="showNewPwd = !showNewPwd" 
                                tabindex="-1" 
                                title="{{showNewPwd ? 'Hide password' : 'Show password'}}">
                            <i class="fa" ng-class="showNewPwd ? 'fa-eye-slash' : 'fa-eye'"></i>
                        </button>
                    </div>
                </div>

                <!-- Confirm Password -->
                <div class="form-group-custom">
                    <label class="form-label-custom">Confirm Password <span style="color: #ef4444;">*</span></label>
                    <div class="input-group-custom">
                        <i class="fa fa-check-circle input-icon-left"></i>
                        <input type="{{showConfirmPwd ? 'text' : 'password'}}" 
                               class="form-control-custom" 
                               ng-model="UserMaster.ConfirmPassword" 
                               placeholder="Confirm new password" 
                               autocomplete="new-password" />
                        <button type="button" 
                                class="btn-toggle-eye" 
                                ng-click="showConfirmPwd = !showConfirmPwd" 
                                tabindex="-1" 
                                title="{{showConfirmPwd ? 'Hide password' : 'Show password'}}">
                            <i class="fa" ng-class="showConfirmPwd ? 'fa-eye-slash' : 'fa-eye'"></i>
                        </button>
                    </div>
                </div>

                <!-- Tips Box -->
                <div class="pwd-tips-box">
                    <i class="fa fa-info-circle pwd-tips-icon"></i>
                    <p class="pwd-tips-text">
                        Make sure your new password is secure and matches the confirmation password before clicking <strong>Save</strong>.
                    </p>
                </div>
            </form>
        </div>

        <div class="change-pwd-card-footer">
            <button type="button" class="btn-pwd-clear" ng-click="Clear()" title="Clear form fields">
                <i class="fa fa-refresh"></i> Clear Form
            </button>
            <button type="button" class="btn-pwd-save" ng-click="LoginCheck()" title="Save password">
                <i class="fa fa-floppy-o"></i> Save
            </button>
        </div>
    </div>
</div>

<script>
    var Paramdata = [{}];
    var module;
    try {
        module = angular.module('app');
    } catch (e) {
        module = angular.module('app', []);
    }

    module.controller("UserMaster", ['$scope', '$filter', '$http', '$q', '$interval', function ($scope, $filter, $http, $q, $interval, $window) {
        $scope.UserMaster = {};
        $scope.showOldPwd = false;
        $scope.showNewPwd = false;
        $scope.showConfirmPwd = false;

        $scope.LoginCheck = function () {
            if ($scope.UserMaster.UserName == undefined || $scope.UserMaster.UserName == "") {
                if (typeof Noty === "function") {
                    Noty("error", "Please Enter UserName!");
                } else {
                    alert("Please Enter UserName!");
                }
                return;
            }
            if ($scope.UserMaster.Password == undefined || $scope.UserMaster.Password == "") {
                if (typeof Noty === "function") {
                    Noty("error", "Please Enter OLD Password!");
                } else {
                    alert("Please Enter OLD Password!");
                }
                return;
            }

            var User = {
                username: $scope.UserMaster.UserName,
                password: $scope.UserMaster.Password
            };

            if (typeof show_loader === 'function') show_loader();

            $http({
                url: '@Url.Action("LoginUserForPassChange", "Login")',
                method: "GET",
                params: User
            }).then(function (msg) {
                if (typeof hide_loader === 'function') hide_loader();

                if (msg.data == 1) {
                    $scope.ChangePassword();
                } else {
                    if (typeof Noty === "function") {
                        Noty("error", "username or password incorrect.!!!");
                    } else {
                        alert("username or password incorrect.!!!");
                    }
                }
            }, function () {
                if (typeof hide_loader === 'function') hide_loader();
                if (typeof Noty === "function") {
                    Noty("error", "Error verifying credentials.");
                }
            });
        };

        $scope.ChangePassword = function () {
            if ($scope.UserMaster.NewPassword == undefined || $scope.UserMaster.NewPassword == "") {
                if (typeof Noty === "function") {
                    Noty("error", "Please New Password!");
                } else {
                    alert("Please New Password!");
                }
                return;
            }
            if ($scope.UserMaster.ConfirmPassword == undefined || $scope.UserMaster.ConfirmPassword == "") {
                if (typeof Noty === "function") {
                    Noty("error", "Please Enter Confirm Password!");
                } else {
                    alert("Please Enter Confirm Password!");
                }
                return;
            }
            if ($scope.UserMaster.NewPassword != $scope.UserMaster.ConfirmPassword) {
                if (typeof Noty === "function") {
                    Noty("error", "New password OR confirm password not match!");
                } else {
                    alert("New password OR confirm password not match!");
                }
                return;
            }

            if (typeof show_loader === 'function') show_loader();

            $http({
                method: "post",
                async: true,
                url: '@Url.Action("ChangeThePasswordForUser", "User")',
                data: { UserName: $scope.UserMaster.UserName, Password: $scope.UserMaster.NewPassword, Action: "UPDATE" },
                dataType: "json"
            }).then(function (ret) {
                if (typeof hide_loader === 'function') hide_loader();

                if (ret.data == "Record Is Updated") {
                    if (typeof Noty === "function") {
                        Noty("success", "Data Update Success Fully....");
                    } else {
                        alert("Data Update Success Fully....");
                    }
                    $scope.Clear();
                } else {
                    if (typeof Noty === "function") {
                        Noty("error", "!!!data not save");
                    } else {
                        alert("!!!data not save");
                    }
                }
            }, function () {
                if (typeof hide_loader === 'function') hide_loader();
                if (typeof Noty === "function") {
                    Noty("error", "Error connecting to server.");
                }
            });
        };

        $scope.Clear = function () {
            $scope.UserMaster = {};
            $scope.showOldPwd = false;
            $scope.showNewPwd = false;
            $scope.showConfirmPwd = false;
        };
    }]);
</script>