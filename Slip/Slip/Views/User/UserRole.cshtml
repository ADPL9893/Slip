@{
    ViewBag.Title = "UserRole";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* ==========================================================================
       User Role - Modern Scoped Card View & SaaS Styling
       ========================================================================== */
    @@keyframes fadeInUpSmooth {
        from {
            opacity: 0;
            transform: translateY(10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .userrole-page-wrapper {
        padding: 0 !important;
        margin-top: 0 !important;
        margin-bottom: 0 !important;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    }

    /* Staggered Card Entrance Animations */
    .userrole-header-card { animation: fadeInUpSmooth 0.35s cubic-bezier(0.16, 1, 0.3, 1) 0.05s both; }
    .userrole-grid-card { animation: fadeInUpSmooth 0.35s cubic-bezier(0.16, 1, 0.3, 1) 0.15s both; }

    /* Top Page Header Card (Clean Neutral White with Distinct Border) */
    .userrole-header-card {
        background: #ffffff !important;
        border-radius: 12px !important;
        padding: 12px 18px !important;
        margin-bottom: 10px !important;
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04) !important;
        border: 1.5px solid #cbd5e1 !important;
        border-left: 5px solid #0284c7 !important;
        display: flex !important;
        justify-content: space-between !important;
        align-items: center !important;
        flex-wrap: wrap !important;
        gap: 12px !important;
        transition: all 0.25s ease !important;
    }
    .userrole-header-card:hover {
        box-shadow: 0 6px 18px rgba(15, 23, 42, 0.08) !important;
        border-color: #94a3b8 !important;
        border-left-color: #0369a1 !important;
    }

    .userrole-header-left {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .userrole-header-icon {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        box-shadow: 0 4px 12px rgba(2, 132, 199, 0.28);
        transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
        flex-shrink: 0;
    }
    .userrole-header-card:hover .userrole-header-icon {
        transform: scale(1.08) rotate(4deg);
    }

    .userrole-header-title-wrap {
        display: flex;
        flex-direction: column;
    }

    .userrole-breadcrumb {
        font-size: 11.5px;
        color: #64748b;
        margin-bottom: 3px;
        font-weight: 500;
    }
    .userrole-breadcrumb a {
        color: #0284c7;
        text-decoration: none;
        transition: color 0.15s ease;
        font-weight: 500;
    }
    .userrole-breadcrumb a:hover {
        color: #0369a1;
        text-decoration: underline;
    }

    .userrole-title-row {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .userrole-header-title {
        font-size: 18px !important;
        font-weight: 700 !important;
        color: #0f172a !important;
        margin: 0 !important;
        line-height: 1.2 !important;
        letter-spacing: -0.2px;
    }

    .userrole-count-pill {
        background: #f1f5f9;
        color: #475569;
        font-size: 11px;
        font-weight: 700;
        padding: 2px 9px;
        border-radius: 20px;
        border: 1px solid #cbd5e1;
    }

    .userrole-header-right {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    /* Create Role Action Button */
    .btn-userrole-add {
        background: linear-gradient(135deg, #1d4ed8 0%, #1e3a8a 100%) !important;
        color: #ffffff !important;
        border: none !important;
        border-radius: 8px !important;
        padding: 9px 18px !important;
        font-size: 13px !important;
        font-weight: 700 !important;
        display: inline-flex !important;
        align-items: center !important;
        gap: 7px !important;
        box-shadow: 0 4px 14px rgba(29, 78, 216, 0.35) !important;
        transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1) !important;
        cursor: pointer !important;
        text-decoration: none !important;
    }
    .btn-userrole-add:hover {
        background: linear-gradient(135deg, #1e40af 0%, #172554 100%) !important;
        transform: translateY(-2px) !important;
        box-shadow: 0 8px 20px rgba(29, 78, 216, 0.45) !important;
        color: #ffffff !important;
    }
    .btn-userrole-add:active {
        transform: translateY(0) !important;
    }

    /* Grid Card Container */
    .userrole-grid-card {
        background: #ffffff !important;
        border-radius: 12px !important;
        border: 1.5px solid #cbd5e1 !important;
        padding: 0 !important;
        box-shadow: 0 2px 10px rgba(15, 23, 42, 0.04) !important;
        min-height: calc(100vh - 165px);
        overflow: hidden !important;
        position: relative !important;
        transition: all 0.25s ease !important;
    }
    .userrole-grid-card:hover {
        box-shadow: 0 6px 18px rgba(15, 23, 42, 0.08) !important;
        border-color: #94a3b8 !important;
    }

    .userrole-grid-card .uigrid,
    .userrole-grid-card #gridContainer {
        width: 100% !important;
        background: transparent !important;
        border: none !important;
        border-radius: 0 !important;
        padding: 0 !important;
        box-shadow: none !important;
        min-height: calc(100vh - 165px);
    }

    #gridContainer {
        width: 100% !important;
    }

    .LightRed {
        background-color: #fee2e2 !important;
        color: #991b1b !important;
    }

    @@media (max-width: 768px) {
        .userrole-header-card {
            flex-direction: column;
            align-items: flex-start;
        }
        .userrole-header-right {
            width: 100%;
            justify-content: flex-start;
        }
        .btn-userrole-add {
            width: 100%;
            justify-content: center;
        }
    }
</style>

<div ng-controller="RoleList" class="userrole-page-wrapper">
    <!-- Top Page Header Card -->
    <div class="userrole-header-card">
        <div class="userrole-header-left">
            <div class="userrole-header-icon">
                <i class="fa fa-shield"></i>
            </div>
            <div class="userrole-header-title-wrap">
                <div class="userrole-breadcrumb">
                    <a href="@Url.Action("Index", "Home")"><i class="fa fa-home"></i> Home</a> / <span>User</span> / <span>User Role</span>
                </div>
                <div class="userrole-title-row">
                    <h4 class="userrole-header-title">USER ROLE</h4>
                    <span class="userrole-count-pill" ng-show="List && List.length">{{List.length}} Roles</span>
                </div>
            </div>
        </div>
        <div class="userrole-header-right">
            <a class="btn-userrole-add" href="@Url.Action("UserRoleUpdate", "User")?id=0" title="Create New Role">
                <i class="fa fa-plus-circle"></i> Create Role
            </a>
        </div>
    </div>

    <!-- DevExtreme Grid Card Container -->
    <div class="userrole-grid-card">
        <div class="uigrid">
            <div id="gridContainer"></div>
        </div>
    </div>
</div>

<script>
    var List = "";
    var DataField = "";

    module = angular.module('app', ['ngTouch', 'ui.grid', 'ui.grid.edit', 'ui.grid.rowEdit', 'ui.grid.cellNav', 'ui.grid.pagination', 'ui.grid.moveColumns', 'ui.grid.exporter', 'ui.grid.pinning', 'ui.grid.resizeColumns', 'angularjs-dropdown-multiselect']);
    module.controller("RoleList", ['$scope', '$filter', '$http', '$q', '$interval', 'uiGridConstants', function ($scope, $filter, $http, $q, $interval, uiGridConstants, $window) {

        $scope.FetchData = function () {
            show_loader();
            $http.get('@Url.Action("Getdata_Role", "User")')
                .then(function (response) {
                    hide_loader();
                    debugger;
                    List = response.data.RoleList;
                    $scope.List = List;
                    console.log("Fetched List:", List);

                    // Define columns
                    DataField = [
                        { dataField: "RoleID", caption: "ID", width: 80 },
                        { dataField: "RoleName", caption: "Role Name" },
                        { dataField: "IsActive", caption: "IsActive", dataType: "string" },
                        //{ dataField: "Remarks", caption: "Remarks" },
                        { dataField: "CreatedByUserName", caption: "Created By User" },
                        {
                            type: "buttons",
                            caption: "Action",
                            buttons: [
                                {
                                    hint: "Edit",       // tooltip
                                    icon: "edit",       // built-in DevExtreme icon
                                    onClick: function (e) {
                                        $scope.EditRow(e.row.data.RoleID);
                                        e.event.preventDefault();
                                    }
                                }
                            ]
                        }
                    ];

                    GridData();
                });
        };

        $scope.FetchData();

        const GridData = () => {
            $("#gridContainer").dxDataGrid({
                dataSource: List,
                columns: DataField,
                editing: {
                    //mode: 'row',
                    allowUpdating: true,
                    allowDeleting: false,
                    useIcons: true,
                },
                keyExpr: 'RoleID',
                columnAutoWidth: true,
                columnResizingMode: 'widget',
                allowColumnResizing: true,
                showColumnLines: true,
                showRowLines: true,
                //rowAlternationEnabled: true,
                showBorders: true,
                height: '100%',
                paging: { enabled: false },
                sorting: { mode: "multiple" },
                scrolling: {
                    mode: 'virtual',
                },
                filterRow: {
                    visible: true,
                    applyFilter: 'auto',
                },
                filterPanel: { visible: true },
                searchPanel: {
                    visible: true,
                    width: 240,
                    placeholder: 'Search...',
                },
                loadPanel: {
                    enabled: true,
                    showPane: false,
                    indicatorSrc: '/Content/icons/Loader.gif',
                },
                headerFilter: {
                    visible: true,
                },
                pager: {
                    visible: false,
                },
                selection: {
                    mode: 'single',
                },
                keyboardNavigation: {
                    enterKeyAction: 'moveFocus',
                    enterKeyDirection: 'column',
                    editOnKeyPress: true,
                },

                summary: {
                    totalItems: [{
                        column: 'RoleName',
                        summaryType: 'count',
                    }]
                },

                onRowPrepared: function (e) {
                    debugger
                    if (e.rowType === "data") {
                        if (e.data.IsActive === "False") {
                            //$(e.rowElement).css("background-color", "red");
                            $(e.rowElement).addClass("LightRed");
                        }
                    }
                },

                export: {
                    enabled: true,
                    //formats: ['pdf', 'xlxs'],
                    formats: ['xlxs'],
                    allowExportSelectedData: false,
                },
                onExporting(e) {
                    debugger
                    const workbook = new ExcelJS.Workbook();
                    const worksheet = workbook.addWorksheet('Employees');

                    DevExpress.excelExporter.exportDataGrid({
                        component: e.component,
                        worksheet,
                        autoFilterEnabled: true,
                    }).then(() => {
                        workbook.xlsx.writeBuffer().then((buffer) => {
                            saveAs(new Blob([buffer], { type: 'application/octet-stream' }), 'ProcessDays.xlsx');
                        });
                    });
                },
            });
        };

        $scope.EditRow = function (RoleID) {
            window.open('@Url.Action("UserRoleUpdate", "User")?id=' + RoleID, '_blank');
        };

    }]);
</script>