@model System.Data.DataSet
@{
    ViewBag.Title = "FourP_Daily_SlipPrint";
    Layout = null;
}

<style>
    .Bold {
        font-weight: 600
    }

    table {
        width: 100%;
        font-size: 9px;
    }

    .container {
        padding: 0 !important;
    }

    table tr th, table tr td {
        vertical-align: middle !important;
        padding: 2px 3px 0 3px;
    }

    .main-container {
        width: 100%;
        display: flex;
        gap: 5px;
        flex-direction: row;
        flex-wrap: wrap;
        margin: auto
    }

    .table-container {
        width: 49.5%
    }
</style>

<div class="main-container">
    @for (var i = 0; i < Model.Tables[0].Rows.Count; i++)
    {
        <div class="table-container">
            <table border="1">
                <thead>
                    <tr>
                        <th colspan="4" style="background-color:grey;color:white;text-align:center">4P MODEL REPORT</th>
                    </tr>
                    <tr>
                        <th colspan="2">DATE : @Model.Tables[0].Rows[i]["Date"]</th>
                        <th colspan="2">SHIFT : @Model.Tables[0].Rows[i]["Shift"]</th>
                    </tr>
                    <tr>
                        <th>SHAPE</th>
                        <th>R.WEIGHT</th>
                        <th>P.WEIGHT</th>
                        <th>MODEL</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var j = 0; j < Model.Tables[1].Rows.Count; j++)
                    {
                        if (Convert.ToInt32(Model.Tables[0].Rows[i]["LogID"]) == Convert.ToInt32(Model.Tables[1].Rows[j]["LogID"]))
                        {
                            <tr>
                                <td>@Model.Tables[1].Rows[j]["Shape"]</td>
                                <td>@Model.Tables[1].Rows[j]["RPartWeight"]</td>
                                <td>@Model.Tables[1].Rows[j]["PolishWeight"]</td>
                                <td>@Model.Tables[1].Rows[j]["Model"]</td>
                            </tr>
                        }
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td class="Bold">Total</td>
                        <td class="Bold">@Model.Tables[0].Rows[i]["RPartWeight"]</td>
                        <td class="Bold">@Model.Tables[0].Rows[i]["PolishWeight"]</td>
                        <td class="Bold">@Model.Tables[0].Rows[i]["Model"]</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    }
</div>
<script>
    document.title = "4P MODEL REPORT";
    window.print();
</script>