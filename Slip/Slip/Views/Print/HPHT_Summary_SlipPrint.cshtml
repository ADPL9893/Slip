                                    <td>@Model.Tables[0].Rows[j]["WeightLossPcs"]</td>
                                    <td>@Model.Tables[0].Rows[j]["WeightLossWeight"]</td>
                                    <td>@Model.Tables[0].Rows[j]["WeightLossPer"]</td>
                                </tr>
