                                    <th>COLOR</th>
                                    <th>PCS</th>
                                    <th>WEIGHT</th>
                                    <th>%</th>
                                </tr>

                                <tr>
                                    <td>F</td>
                                    <td>@Model.Tables[0].Rows[j]["FPcs"]</td>
                                    <td>@Model.Tables[0].Rows[j]["FWeight"]</td>
                                    <td>@Model.Tables[0].Rows[j]["FPer"]</td>
                                </tr>
                                <tr>
