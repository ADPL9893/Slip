                                    <td>@Model.Tables[1].Rows[k]["TotalWeight"]</td>
                                    <td>@Model.Tables[1].Rows[k]["TotalPer"]</td>
                                </tr>
                            }
                        }
                    </table>
                </div>

                <!-- ROUND / FANCY -->
                <div class="report-box">
                    <table>
                        <tr>
                            <th colspan="4">ROUND / FANCY</th>
                        </tr>
                        <tr>
                            <th colspan="4">HPHT REPORT</th>
                        </tr>
                        @for (var l = 0; l < Model.Tables[2].Rows.Count; l++)
                        {
                            if (Model.Tables[3].Rows[i]["RCode"].ToString() == Model.Tables[2].Rows[l]["RCode"].ToString())
                            {
                            <tr>
                                <th colspan="4">@Model.Tables[2].Rows[l]["RCode"] &nbsp;&nbsp; @Model.Tables[2].Rows[l]["Power"]</th>
