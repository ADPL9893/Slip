<!DOCTYPE html>
<html ng-app="app" lang="en">
<head>
    <title>@ViewBag.Title</title>
    @RenderSection("head", required: false)
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
    <link rel="icon" type="image/x-icon" href="@Url.Content("~/Content/images/Symbol1.png")">
    <!-- CSS & Bundle Styles -->
    @System.Web.Optimization.Styles.Render("~/bundles/bootstrapcss")
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    @System.Web.Optimization.Scripts.Render("~/bundles/angularjs")
    @System.Web.Optimization.Scripts.Render("~/bundles/bootstrapJS")
    @System.Web.Optimization.Scripts.Render("~/bundles/bootstrapplugin")
    <link rel="stylesheet" href="@Url.Content("~/Content/css/Login.css")">
</head>
<body class="adpl-login-page-body">
    @RenderBody()
</body>
</html>



