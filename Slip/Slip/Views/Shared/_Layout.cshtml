    <script>
        DevExpress.config({ licenseKey: 'ewogICJmb3JtYXQiOiAxLAogICJjdXN0b21lcklkIjogIjc3YWNjMjc4LWJjMWQtNGYzZS1iZTRlLWRmYTVhY2MzMTY0NyIsCiAgIm1heFZlcnNpb25BbGxvd2VkIjogMjQyCn0=.o0I38uew6ot4KdU99q++Pi1725KtWxFib6HCSDhJVtI9iY3EzMhoc3yv7PGbqe+UftVEH7QRg6Zj6uINPxwmIRieADZzB14g0XU0FVMszx4RQdKBV4uM6RFg9SqHuoIV9SxyXw==' });

        // Globally Remove '#' (Row Number / Serial) Column & Enable Filter Operation Chooser (Magnifying Glass) on all DevExtreme Grids
        (function () {
            function isHashColumn(col) {
                if (!col) return false;
                var cap = (col.caption || '').toString().trim();
                var df = (col.dataField || '').toString().trim();
                var nm = (col.name || '').toString().trim();
                return (cap === '#' || df === '#' || nm === '#');
            }

            function ensureFilterOperations(col) {
                if (!col || typeof col !== 'object') return col;
                if (col.allowFiltering !== false) {
                    var dt = (col.dataType || '').toLowerCase();
                    var df = (col.dataField || '').toLowerCase();
                    var isBool = (dt === 'boolean' || df === 'isactive' || df === 'status');

                    if (isBool || col.lookup) {
                        col.showOperationChooser = false;
                        col.filterOperations = ["="];
                        col.selectedFilterOperation = "=";
                        if (isBool) {
                            col.dataType = 'boolean';
                            if (!col.trueText) col.trueText = 'Active';
                            if (!col.falseText) col.falseText = 'Inactive';
                        }
                    } else if (!col.filterOperations || !Array.isArray(col.filterOperations) || col.filterOperations.length === 0) {
                        if (dt === 'number' || dt === 'date' || dt === 'datetime') {
                            col.filterOperations = ["=", "<>", "<", "<=", ">", ">=", "between"];
                            if (!col.selectedFilterOperation && !col.defaultFilterOperation) {
                                col.selectedFilterOperation = "=";
                            }
                        } else {
                            col.filterOperations = ["contains", "notcontains", "startswith", "endswith", "=", "<>"];
                            if (!col.selectedFilterOperation && !col.defaultFilterOperation) {
                                col.selectedFilterOperation = "contains";
                            }
                        }
                    }
                }
                return col;
            }

            function processColumnsArray(columns) {
                if (!Array.isArray(columns)) return columns;
                return columns
                    .filter(function (col) {
                        return !isHashColumn(col);
                    })
                    .map(function (col) {
                        if (col && typeof col === 'object') {
                            if ((col.caption === null || col.caption === '' || typeof col.caption === 'undefined') && col.dataField) {
                                col.caption = col.dataField
                                    .replace(/([a-z])([A-Z])/g, '$1 $2')
                                    .replace(/_/g, ' ')
                                    .trim();
                            }
                            ensureFilterOperations(col);
                        }
                        return col;
                    });
            }

            if (window.DevExpress && DevExpress.ui) {
                if (DevExpress.ui.dxDataGrid) {
                    DevExpress.ui.dxDataGrid.defaultOptions({
                        options: {
                            filterRow: {
                                visible: true,
                                showOperationChooser: true,
                                applyFilter: 'auto',
                                resetOperationText: 'Reset'
                            },
                            headerFilter: {
                                visible: true
                            },
                            columnChooser: {
                                enabled: true,
                                mode: 'select',
                                allowSearch: true,
                                searchTimeout: 300,
                                allowSelectAll: true,
                                selection: {
                                    allowSelectAll: true,
                                    selectByClick: true,
                                    recursive: true
                                },
                                position: {
                                    my: 'right top',
                                    at: 'right top',
                                    of: '.dx-datagrid',
                                    offset: '-15 45'
                                },
                                width: 260,
                                height: 400,
                                title: 'Column Chooser'
                            },
                            customizeColumns: function (columns) {
                                if (Array.isArray(columns)) {
                                    for (var i = 0; i < columns.length; i++) {
                                        var col = columns[i];
                                        if (col) {
                                            if (isHashColumn(col)) {
                                                col.visible = false;
                                            }
                                            ensureFilterOperations(col);
                                        }
                                    }
                                }
                            }
                        }
                    });
                }
                if (DevExpress.ui.dxTreeList) {
                    DevExpress.ui.dxTreeList.defaultOptions({
                        options: {
                            filterRow: {
                                visible: true,
                                showOperationChooser: true,
                                applyFilter: 'auto',
                                resetOperationText: 'Reset'
                            },
                            headerFilter: {
                                visible: true
                            },
                            columnChooser: {
                                enabled: true,
                                mode: 'select',
                                allowSearch: true,
                                searchTimeout: 300,
                                allowSelectAll: true,
                                selection: {
                                    allowSelectAll: true,
                                    selectByClick: true,
                                    recursive: true
                                },
                                position: {
                                    my: 'right top',
                                    at: 'right top',
                                    of: '.dx-treelist',
                                    offset: '-15 45'
                                },
                                width: 260,
                                height: 400,
                                title: 'Column Chooser'
                            },
                            customizeColumns: function (columns) {
                                if (Array.isArray(columns)) {
                                    for (var i = 0; i < columns.length; i++) {
                                        var col = columns[i];
                                        if (col) {
                                            if (isHashColumn(col)) {
                                                col.visible = false;
                                            }
                                            ensureFilterOperations(col);
                                        }
                                    }
                                }
                            }
                        }
                    });
                }
            }

            if (window.jQuery && jQuery.fn) {
                if (jQuery.fn.dxDataGrid) {
                    var origDataGrid = jQuery.fn.dxDataGrid;
                    jQuery.fn.dxDataGrid = function () {
                        if (arguments.length > 0 && typeof arguments[0] === 'object' && arguments[0] !== null) {
                            var opts = arguments[0];
                            if (Array.isArray(opts.columns)) {
                                opts.columns = processColumnsArray(opts.columns);
                            }
                            // Globally enforce filterRow with showOperationChooser: true (magnifying glass)
                            opts.filterRow = jQuery.extend(true, {
                                visible: true,
                                showOperationChooser: true,
                                applyFilter: 'auto',
                                resetOperationText: 'Reset'
                            }, opts.filterRow || {});
                            opts.filterRow.showOperationChooser = true;

                            // Globally enforce headerFilter: { visible: true }
                            if (typeof opts.headerFilter === 'undefined') {
                                opts.headerFilter = { visible: true };
                            }

                            var gridEl = this;
                            opts.columnChooser = jQuery.extend(true, {
                                enabled: true,
                                mode: 'select',
                                allowSearch: true,
                                searchTimeout: 300,
                                allowSelectAll: true,
                                selection: {
                                    allowSelectAll: true,
                                    selectByClick: true,
                                    recursive: true
                                },
                                position: {
                                    my: 'right top',
                                    at: 'right top',
                                    of: gridEl,
                                    offset: '-15 45'
                                },
                                width: 260,
                                height: 400,
                                title: 'Column Chooser'
                            }, opts.columnChooser || {});
                        }
                        return origDataGrid.apply(this, arguments);
                    };
                }
                if (jQuery.fn.dxTreeList) {
                    var origTreeList = jQuery.fn.dxTreeList;
                    jQuery.fn.dxTreeList = function () {
                        if (arguments.length > 0 && typeof arguments[0] === 'object' && arguments[0] !== null) {
                            var opts = arguments[0];
                            if (Array.isArray(opts.columns)) {
                                opts.columns = processColumnsArray(opts.columns);
                            }
                            opts.filterRow = jQuery.extend(true, {
                                visible: true,
                                showOperationChooser: true,
                                applyFilter: 'auto',
                                resetOperationText: 'Reset'
                            }, opts.filterRow || {});
                            opts.filterRow.showOperationChooser = true;

                            if (typeof opts.headerFilter === 'undefined') {
                                opts.headerFilter = { visible: true };
                            }

                            var treeEl = this;
                            opts.columnChooser = jQuery.extend(true, {
                                enabled: true,
                                mode: 'select',
                                allowSearch: true,
                                searchTimeout: 300,
                                allowSelectAll: true,
                                selection: {
                                    allowSelectAll: true,
                                    selectByClick: true,
                                    recursive: true
                                },
                                position: {
                                    my: 'right top',
                                    at: 'right top',
                                    of: treeEl,
                                    offset: '-15 45'
                                },
                                width: 260,
                                height: 400,
                                title: 'Column Chooser'
                            }, opts.columnChooser || {});
                        }
                        return origTreeList.apply(this, arguments);
                    };
                }
            }
        })();
    </script>

