        /* ==========================================================================
           GLOBAL ULTRA-MODERN DIAMOND 3D SPINNING LOADER (Compact & Sleek)
           ========================================================================== */
        #custom-diamond-loader.diamond-loader-overlay,
        .diamond-loader-overlay {
            position: fixed !important;
            top: 0 !important;
            left: 0 !important;
            right: 0 !important;
            bottom: 0 !important;
            width: 100% !important;
            height: 100% !important;
            min-width: 100vw !important;
            min-height: 100vh !important;
            background: rgba(15, 23, 42, 0.65) !important;
            backdrop-filter: blur(6px) !important;
            -webkit-backdrop-filter: blur(6px) !important;
            display: none !important;
            flex-direction: column !important;
            justify-content: center !important;
            align-items: center !important;
            z-index: 99999999 !important;
            opacity: 0 !important;
            visibility: hidden !important;
            pointer-events: none !important;
            transition: opacity 0.2s ease, visibility 0.2s ease !important;
        }

        #custom-diamond-loader.diamond-loader-overlay.active,
        .diamond-loader-overlay.active,
        #loader.loader {
            display: flex !important;
            opacity: 1 !important;
            visibility: visible !important;
            pointer-events: all !important;
        }

        .diamond-loader-card {
            background: rgba(15, 23, 42, 0.85);
            border: 1px solid rgba(56, 189, 248, 0.35);
            border-radius: 12px;
            padding: 12px 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5), 0 0 16px rgba(56, 189, 248, 0.2);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            transform: scale(0.95);
            transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        .diamond-loader-overlay.active .diamond-loader-card,
        #loader.loader .diamond-loader-card {
            transform: scale(1);
        }

        .diamond-3d-stage {
            position: relative;
            width: 44px;
            height: 44px;
            display: flex;
            justify-content: center;
            align-items: center;
            perspective: 500px;
        }

        .diamond-3d-gem {
            width: 32px;
            height: 32px;
            transform-style: preserve-3d;
            animation: diamondSpin3D 3.2s cubic-bezier(0.45, 0.05, 0.55, 0.95) infinite;
            filter: drop-shadow(0 3px 10px rgba(56, 189, 248, 0.5)) drop-shadow(0 0 6px rgba(255, 255, 255, 0.6));
            will-change: transform;
        }

        .diamond-svg {
            width: 32px !important;
            height: 32px !important;
            max-width: 32px !important;
            max-height: 32px !important;
            overflow: visible;
        }

        @@keyframes diamondSpin3D {
            0% {
                transform: rotateY(0deg) rotateX(14deg) rotateZ(-3deg) translateY(0px);
            }
            25% {
                transform: rotateY(90deg) rotateX(-12deg) rotateZ(4deg) translateY(-3px);
            }
            50% {
                transform: rotateY(180deg) rotateX(14deg) rotateZ(-3deg) translateY(0px);
            }
            75% {
                transform: rotateY(270deg) rotateX(-12deg) rotateZ(4deg) translateY(-3px);
            }
            100% {
                transform: rotateY(360deg) rotateX(14deg) rotateZ(-3deg) translateY(0px);
            }
        }

        .diamond-aura {
            position: absolute;
            width: 38px;
            height: 12px;
            bottom: 0px;
            left: 50%;
            transform: translateX(-50%);
            background: radial-gradient(ellipse at center, rgba(56, 189, 248, 0.65) 0%, rgba(37, 99, 235, 0.35) 45%, rgba(15, 23, 42, 0) 75%);
            border-radius: 50%;
            filter: blur(4px);
            animation: auraPulse 3.2s ease-in-out infinite;
            pointer-events: none;
        }

        @@keyframes auraPulse {
            0%, 100% {
                transform: translateX(-50%) scale(0.85);
                opacity: 0.5;
            }
            50% {
                transform: translateX(-50%) scale(1.2);
                opacity: 0.9;
            }
        }

        .diamond-sparkle {
            position: absolute;
            pointer-events: none;
            animation: sparkleTwinkle 2.2s ease-in-out infinite;
            color: #ffffff;
            filter: drop-shadow(0 0 3px #38bdf8);
        }

        .sparkle-1 {
            top: 0px;
            right: 4px;
            font-size: 7px;
            animation-delay: 0s;
        }

        .sparkle-2 {
            bottom: 4px;
            left: 2px;
            font-size: 6px;
            animation-delay: 0.7s;
        }

        .sparkle-3 {
            top: 6px;
            left: 0px;
            font-size: 8px;
            animation-delay: 1.3s;
        }

        .sparkle-4 {
            bottom: 6px;
            right: 0px;
            font-size: 6px;
            animation-delay: 1.8s;
        }

        @@keyframes sparkleTwinkle {
            0%, 100% {
                opacity: 0;
                transform: scale(0.2) rotate(0deg);
            }
            50% {
                opacity: 1;
                transform: scale(1.2) rotate(90deg);
            }
        }

        .diamond-loading-text {
            margin-top: 8px;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            font-size: 10.5px;
            font-weight: 700;
            letter-spacing: 0.8px;
            text-transform: uppercase;
            background: linear-gradient(90deg, #94a3b8 0%, #ffffff 25%, #38bdf8 50%, #ffffff 75%, #94a3b8 100%);
            background-size: 200% auto;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: textShimmer 2.2s linear infinite;
            display: flex;
            align-items: center;
            gap: 3px;
        }

        @@keyframes textShimmer {
            0% {
                background-position: 200% center;
            }
            100% {
                background-position: -200% center;
            }
        }

        .loading-dots .dot {
            animation: dotPulse 1.4s infinite;
            opacity: 0;
            font-weight: 700;
        }
        .loading-dots .d1 { animation-delay: 0s; }
        .loading-dots .d2 { animation-delay: 0.2s; }
        .loading-dots .d3 { animation-delay: 0.4s; }

        @@keyframes dotPulse {
            0%, 20% { opacity: 0; }
            50% { opacity: 1; }
            100% { opacity: 0; }
        }

