            </div>
            <!-- Dynamic Iframes rendered here -->
        </div>

        <!-- Context Menu for Tabs (Right Click) -->
        <div class="chrome-tabs-context-menu" id="chromeTabContextMenu">
            <a href="javascript:void(0)" class="chrome-ctx-item" data-action="reload">
                <i class="fa fa-refresh"></i> Reload Tab
            </a>
            <a href="javascript:void(0)" class="chrome-ctx-item" data-action="duplicate">
                <i class="fa fa-clone"></i> Duplicate Tab
            </a>
            <div class="chrome-ctx-sep"></div>
            <a href="javascript:void(0)" class="chrome-ctx-item" data-action="close">
                <i class="fa fa-times"></i> Close Tab
            </a>
            <a href="javascript:void(0)" class="chrome-ctx-item" data-action="close-others">
                <i class="fa fa-times-circle-o"></i> Close Other Tabs
            </a>
            <a href="javascript:void(0)" class="chrome-ctx-item" data-action="close-right">
                <i class="fa fa-arrow-right"></i> Close Tabs to Right
            </a>
            <div class="chrome-ctx-sep"></div>
            <a href="javascript:void(0)" class="chrome-ctx-item danger" data-action="close-all">
                <i class="fa fa-trash-o"></i> Close All Tabs
            </a>
        </div>

        <!-- All Open Tabs Dropdown List -->
        <div class="chrome-tabs-dropdown-menu" id="chromeTabsDropdown">
        </div>

        <!-- Child Iframe Content Wrapper (Satisfies Razor RenderBody requirement) -->
        <div class="content-wrapper">
            @RenderBody()
        </div>

            <!-- Ultra-Modern Diamond 3D Spinning Loader Overlay -->
            <div id="custom-diamond-loader" class="diamond-loader-overlay" style="display: none;">
                <div class="diamond-loader-card">
                    <!-- 3D Stage & Ambient Glow -->
                    <div class="diamond-3d-stage">
                        <div class="diamond-aura"></div>

                        <!-- Sparkles -->
                        <div class="diamond-sparkle sparkle-1"><i class="fa fa-star"></i></div>
                        <div class="diamond-sparkle sparkle-2"><i class="fa fa-diamond"></i></div>
                        <div class="diamond-sparkle sparkle-3"><i class="fa fa-star"></i></div>
                        <div class="diamond-sparkle sparkle-4"><i class="fa fa-diamond"></i></div>

                        <!-- 3D Tumbling Diamond SVG -->
                        <div class="diamond-3d-gem">
                            <svg viewBox="0 0 120 120" width="32" height="32" class="diamond-svg" xmlns="http://www.w3.org/2000/svg">
                                <defs>
                                    <!-- Specular & Refraction Gradients -->
                                    <linearGradient id="facet-top" x1="0%" y1="0%" x2="100%" y2="100%">
                                        <stop offset="0%" stop-color="#ffffff" stop-opacity="0.95" />
                                        <stop offset="40%" stop-color="#e0f2fe" stop-opacity="0.9" />
                                        <stop offset="100%" stop-color="#38bdf8" stop-opacity="0.85" />
                                    </linearGradient>

                                    <linearGradient id="facet-crown-center" x1="0%" y1="100%" x2="100%" y2="0%">
                                        <stop offset="0%" stop-color="#0284c7" />
                                        <stop offset="60%" stop-color="#38bdf8" />
                                        <stop offset="100%" stop-color="#ffffff" />
                                    </linearGradient>

                                    <linearGradient id="facet-crown-l" x1="0%" y1="0%" x2="100%" y2="100%">
                                        <stop offset="0%" stop-color="#7dd3fc" />
                                        <stop offset="100%" stop-color="#0369a1" />
                                    </linearGradient>

                                    <linearGradient id="facet-crown-r" x1="100%" y1="0%" x2="0%" y2="100%">
                                        <stop offset="0%" stop-color="#bae6fd" />
                                        <stop offset="100%" stop-color="#0284c7" />
                                    </linearGradient>

                                    <linearGradient id="facet-pav-c" x1="0%" y1="0%" x2="0%" y2="100%">
                                        <stop offset="0%" stop-color="#38bdf8" />
                                        <stop offset="60%" stop-color="#0284c7" />
                                        <stop offset="100%" stop-color="#1e3a8a" />
                                    </linearGradient>

                                    <linearGradient id="facet-pav-l" x1="0%" y1="0%" x2="100%" y2="100%">
                                        <stop offset="0%" stop-color="#0369a1" />
                                        <stop offset="100%" stop-color="#0f172a" />
                                    </linearGradient>

                                    <linearGradient id="facet-pav-r" x1="100%" y1="0%" x2="0%" y2="100%">
                                        <stop offset="0%" stop-color="#60a5fa" />
                                        <stop offset="100%" stop-color="#1d4ed8" />
                                    </linearGradient>

                                    <linearGradient id="facet-pav-outer-l" x1="0%" y1="0%" x2="100%" y2="100%">
                                        <stop offset="0%" stop-color="#0284c7" />
                                        <stop offset="100%" stop-color="#082f49" />
                                    </linearGradient>

                                    <linearGradient id="facet-pav-outer-r" x1="100%" y1="0%" x2="0%" y2="100%">
                                        <stop offset="0%" stop-color="#93c5fd" />
                                        <stop offset="100%" stop-color="#1e40af" />
                                    </linearGradient>

                                    <filter id="diamond-glow-filter" x="-20%" y="-20%" width="140%" height="140%">
                                        <feGaussianBlur stdDeviation="2" result="blur" />
                                        <feMerge>
                                            <feMergeNode in="blur" />
                                            <feMergeNode in="SourceGraphic" />
                                        </feMerge>
                                    </filter>
                                </defs>

                                <g filter="url(#diamond-glow-filter)">
                                    <!-- CROWN / TOP TABLE -->
                                    <polygon points="40,24 80,24 96,44 24,44" fill="url(#facet-top)" stroke="#e0f2fe" stroke-width="0.75" stroke-linejoin="round" />

                                    <!-- CROWN STAR / KITE FACETS -->
                                    <polygon points="40,24 60,24 60,44 48,44" fill="url(#facet-crown-center)" stroke="#bae6fd" stroke-width="0.5" />
                                    <polygon points="60,24 80,24 72,44 60,44" fill="url(#facet-crown-r)" stroke="#7dd3fc" stroke-width="0.5" />
                                    <polygon points="24,44 40,24 48,44" fill="url(#facet-crown-l)" stroke="#bae6fd" stroke-width="0.5" />
                                    <polygon points="96,44 80,24 72,44" fill="url(#facet-crown-center)" stroke="#ffffff" stroke-width="0.5" />

                                    <!-- GIRDLE HIGHLIGHT LINE -->
                                    <line x1="24" y1="44" x2="96" y2="44" stroke="#ffffff" stroke-width="1" opacity="0.8" />

                                    <!-- PAVILION / LOWER FACETS TAPERING TO CULET (60, 102) -->
                                    <polygon points="24,44 42,44 60,102" fill="url(#facet-pav-l)" stroke="#0284c7" stroke-width="0.5" />
                                    <polygon points="42,44 60,44 60,102" fill="url(#facet-pav-c)" stroke="#38bdf8" stroke-width="0.5" />
                                    <polygon points="60,44 78,44 60,102" fill="url(#facet-pav-r)" stroke="#60a5fa" stroke-width="0.5" />
                                    <polygon points="78,44 96,44 60,102" fill="url(#facet-pav-outer-r)" stroke="#93c5fd" stroke-width="0.5" />
                                    <polygon points="24,44 32,44 60,102" fill="url(#facet-pav-outer-l)" stroke="#0369a1" stroke-width="0.5" />

                                    <!-- SHIMMER SPECULAR REFLECTIONS -->
                                    <polygon points="48,27 72,27 60,41" fill="#ffffff" opacity="0.4" />
                                    <circle cx="60" cy="102" r="1.5" fill="#ffffff" />
                                </g>
                            </svg>
                        </div>
                    </div>

                    <!-- Glowing Animated Shimmer Text -->
                    <div class="diamond-loading-text">
                        <span id="diamond-loader-msg">Processing Gems...</span>
                        <span class="loading-dots">
                            <span class="dot d1">.</span>
                            <span class="dot d2">.</span>
                            <span class="dot d3">.</span>
                        </span>
                    </div>
                </div>
            </div>

            <!-- Legacy fallback compatibility anchor -->
            <div id="loader" style="display:none;"></div>
        </div>
</body>
</html>
<script>
    var Cur_Date = '@CurDate';
    var StartMonthDateType = '@StartMonthDateType';
    var Cur_Dates = '@CurDates';
    var StartMonthDateTypes = '@StartMonthDateTypes';
    $('.BirthDate').datepicker({
        format: "dd-M-yyyy",
        autoclose: true,
        todayHighlight: true,
        setDate: StartMonthDateType
    });

    var userSession = @Html.Raw(JsonConvert.SerializeObject(SessionFacade.UserSession));

    function show_loader(message) {
        if (message && typeof message === 'string') {
            $("#diamond-loader-msg").text(message);
        } else {
            $("#diamond-loader-msg").text("Processing Gems...");
        }
        $("#custom-diamond-loader").stop(true, true).css("display", "flex").addClass("active");
        $("#loader").addClass("loader");
    }

    function hide_loader() {
        $("#custom-diamond-loader").removeClass("active").css("display", "none");
        $("#loader").removeClass("loader");
    }

    let $modal = $(".modal");
    $modal.draggable({
        handle: ".modal-header",
    });

    $(document).ready(function () {
        $(".allownumericwithoutdecimal").on("keypress keyup blur", function (event) {
            $(this).val($(this).val().replace(/[^\d].+/, ""));
            if ((event.which < 48 || event.which > 57)) {
                event.preventDefault();
            }
        });

        $(".allownumericwithdecimal").on("keypress keyup blur", function (event) {
            $(this).val($(this).val().replace(/[^0-9\.]/g, ''));
            if ((event.which != 46 || $(this).val().indexOf('.') != -1) && (event.which < 48 || event.which > 57)) {
                event.preventDefault();
            }
        });

        $(document).keyup(function (e) {
            var key = (e.keyCode ? e.keyCode : e.charCode);
            switch (key) {
                case 120:
                case 120:
                    openWebsite($('#lnkGoogle'));
                    break;
                default:
                    ;
            }
        });

        function openWebsite(obj) {
            window.location.href = $(obj).attr("href");
        }

        // ---- Topbar: menu/user dropdowns (tb-*) ----
        function tbCloseAll(exceptBtn) {
            $(".main-header .tb-menu-btn, .main-header .tb-user-btn").each(function () {
                var $btn = $(this);
                if (exceptBtn && $btn.is(exceptBtn)) { return; }
                $btn.attr("aria-expanded", "false");
                $btn.next(".tb-dropdown").removeClass("open");
            });
        }

        $(".main-header .tb-menu-btn, .main-header .tb-user-btn").on("click", function (e) {
            e.stopPropagation();
            var $btn = $(this);
            var $dd = $btn.next(".tb-dropdown");
            var willOpen = !$dd.hasClass("open");
            tbCloseAll($btn);
            $dd.toggleClass("open", willOpen);
            $btn.attr("aria-expanded", willOpen);
        });

        $(document).on("click", function (e) {
            if (!$(e.target).closest(".tb-dropdown").length) {
                tbCloseAll();
            }
        });

        $(document).on("keyup", function (e) {
            if (e.key === "Escape") {
                tbCloseAll();
            }
        });

        // ---- Topbar: light/dark theme toggle (persisted) ----
        var tbThemeRoot = document.documentElement;
        try {
            var tbSavedTheme = localStorage.getItem("slip-erp-theme");
            if (tbSavedTheme) { tbThemeRoot.setAttribute("data-theme", tbSavedTheme); }
        } catch (ex) { }

        $("#tbThemeToggle").on("click", function () {
            var next = tbThemeRoot.getAttribute("data-theme") === "dark" ? "light" : "dark";
            if (next === "dark") {
                tbThemeRoot.setAttribute("data-theme", "dark");
            } else {
                tbThemeRoot.removeAttribute("data-theme");
            }
            try { localStorage.setItem("slip-erp-theme", next); } catch (ex) { }
        });

        // ---- Initialize Chrome Tabs Multi-Tab View (in master shell only) ----
        if (window.ChromeTabs && !document.documentElement.classList.contains('in-tab-iframe')) {
            window.ChromeTabs.init({
                homeUrl: '@Url.Action("Index", "Home")',
                homeTitle: 'Home'
            });
        }
    });
</script>
