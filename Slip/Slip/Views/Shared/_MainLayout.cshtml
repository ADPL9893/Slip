                <div class="collapse navbar-collapse" id="navbar-collapse">
                    <ul class="nav tb-menu" id="tbMenu">

                        @{

                            foreach (var Group in Slip.Utility.SessionFacade.FormPermissionsGroup)
                            {
                                var groupItems = Slip.Utility.SessionFacade.FormPermissions.Where(x => x.GroupID == Group.GroupID).ToList();
                                var isWide = groupItems.Count > 4;
                                var half = (int)Math.Ceiling(groupItems.Count / 2.0);


                                if (groupItems.Count == 1)
                                {
                                    var singleItem = groupItems[0];
                                    <li>
                                        <a class="tb-menu-link" href="@Url.Action(singleItem.Action, singleItem.Controller)">
                                            <span class="tb-txt">@Group.GroupName</span>
                                        </a>
                                    </li>

                                }
                                else
                                {
                                    <li>
                                        <button class="tb-menu-btn" type="button" aria-expanded="false" aria-haspopup="true">@Group.GroupName <svg class="tb-chev i"><use href="#i-down"></use></svg></button>
                                        <div class="tb-dropdown @(isWide ? "wide" : "")">
                                            
                                                @if (isWide)
                                                {
                                                    <div class="tb-cols">
                                                        <div>
                                                            @foreach (var i in groupItems.Take(half))
                                                            {
                                                                <a class="tb-item" href="@Url.Action(i.Action, i.Controller)"><span class="tb-ico"><svg class="i"><use href="#i-gem"></use></svg></span><span class="tb-txt">@i.ModuleName</span></a>
                                                            }
                                                        </div>
                                                        <div>
                                                            @foreach (var t in groupItems.Skip(half))
                                                            {
                                                                <a class="tb-item" href="@Url.Action(t.Action, t.Controller)"><span class="tb-ico"><svg class="i"><use href="#i-gem"></use></svg></span><span class="tb-txt">@t.ModuleName</span></a>
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="tb-cols">
                                                        <div>

                                                            @foreach (var i in groupItems)
                                                            {
                                                                <a class="tb-item" href="@Url.Action(i.Action, i.Controller)"><span class="tb-ico"><svg class="i"><use href="#i-gem"></use></svg></span><span class="tb-txt">@i.ModuleName</span></a>
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                            
                                        </div>
                                    </li>
                                }


                            }




                        }



                    </ul>
