                 foundInData[0].Rate = newRate;
             } else {
                 group.Data.push({
                     ColorID: colorId,
                     ClarityID: clarityId,
                     Rate: newRate
                 });
             }
        };

        $scope.SelectAllText = function (event) {
            $timeout(function () {
                var range = document.createRange();
                var sel = window.getSelection();
                range.selectNodeContents(event.target);
                sel.removeAllRanges(); // Clear previous selection
                sel.addRange(range);   // Fully highlight cell content
            }, 10);
        };

        $scope.HandleKeydown = function (event, rowIndex, colIndex, group, colorId, clarityId) {
            // Save on Enter
            if (event.keyCode === 13) {
                event.preventDefault();
                event.target.blur(); // Blur triggers UpdateRate naturally

                // Focus the cell below automatically on Enter
                var nextRowCell = document.getElementById('cell-' + (rowIndex + 1) + '-' + colIndex);
                if (nextRowCell) {
                    $timeout(function () {
                        nextRowCell.focus(); // will trigger SelectAllText
                    }, 10);
                }
                return;
            }

            // Arrow Keys Navigation
            var nextId = null;
            if (event.keyCode === 37) { // Left arrow
                nextId = 'cell-' + rowIndex + '-' + (colIndex - 1);
            } else if (event.keyCode === 39) { // Right arrow
                nextId = 'cell-' + rowIndex + '-' + (colIndex + 1);
            } else if (event.keyCode === 38) { // Up arrow
                nextId = 'cell-' + (rowIndex - 1) + '-' + colIndex;
            } else if (event.keyCode === 40) { // Down arrow
                nextId = 'cell-' + (rowIndex + 1) + '-' + colIndex;
            }

            if (nextId) {
                var nextElement = document.getElementById(nextId);
                if (nextElement) {
                    event.preventDefault();
                    nextElement.focus(); // will trigger SelectAllText
                }
            }
        };

