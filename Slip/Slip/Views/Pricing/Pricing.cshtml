        $scope.DataSave = function () {
            if ($scope.PricingDetails.length == 0) {
                Noty("error", "No changes to save!");
                return;
            }

            // Filter to ensure we are sending meaningful data
            var detailsToSend = $scope.PricingDetails;

            if (detailsToSend.length > 0) {
                show_loader();
                var response = $http({
                    method: "post",
                    async: true,
                    url: '@Url.Action("TRN_Pricing_Insert_Update_Delete", "Pricing")',
                    data: { PricingDetails: detailsToSend },
                    dataType: "json"
                }).then(function (ret) {
                    hide_loader();
                    if (ret.data == "Record Is Inserted") { // Message from backend
                        // Noty("success", "Stock Pricing Updated Successfully!");
                        alert("Stock Pricing Updated Successfully!");
                        $scope.PricingDetails = [];
                        $scope.isEditable = false;

                        $scope.GetdataTRNRap();
                        // Reload or stay
                        //window.location.reload();
                    }
                    else {
                        // Noty("error", "Error saving data: " + ret.data);
                        alert("Error saving data: " + ret.data);
                    }
                });
            }
        }

        $scope.Clear = function () {
            $scope.Diamond = {};
            $scope.GridGroups = [];
            $scope.PricingDetails = [];
            $scope.isEditable = false;
        };

        $scope.ExportExcel = function () {
            if ($scope.Diamond.Shape == undefined || $scope.Diamond.Shape == "") {
                Noty("error", "Please Select Shape !");
                return;
            }
            if ($scope.Diamond.GradType == undefined || $scope.Diamond.GradType == "") {
                Noty("error", "Please Select GradType !");
                return;
            }

            var sizeIdToSend = $scope.Diamond.SizeID;
            var SizeList = [];

            if (sizeIdToSend != null) {
                sizeIdToSend.forEach(function (item) {
                    SizeList.push({
                        SizeID: item
                    })
                })
            }
            else {
                SizeList.push({
                    SizeID: 0
                })
            }

            let SizeType = "";

            if ($scope.Diamond.GradType == "GR") {
                SizeType = 'CT UP';
            }
            else {
                SizeType = 'CT DOWN';
            }

            show_loader();
            var response = $http({
                method: "post",
                async: true,
                url: '@Url.Action("Getdata_TRN_Pricing_Export", "Pricing")',
                data: { SizeType: SizeType, SizeList: SizeList, Shape: $scope.Diamond.Shape, GradType: $scope.Diamond.GradType, Action: "Export" },
                dataType: "json"
            }).then(function (ret) {
                hide_loader();
                if (ret.data && ret.data.Data != "") {
                    window.location.href = '@Url.Action("DownloadExcel", "Home")' + '?filepath=' + encodeURIComponent(ret.data.Data);
                } else {
                    Noty("error", "No data found export.");
                }
            }, function (error) {
                hide_loader();
                Noty("error", "Error export data.");
            });
        };

        $scope.OpenUploadModal = function () {
            if ($scope.Diamond.Shape == undefined || $scope.Diamond.Shape == "") {
                Noty("error", "Please Select Shape before uploading !");
                return;
            }
            if ($scope.Diamond.GradType == undefined || $scope.Diamond.GradType == "") {
                Noty("error", "Please Select GradType before uploading !");
                return;
            }
            document.getElementById('pricingExcelFile').value = '';
            $('#uploadPricingExcelModal').modal('show');
        };

        $scope.UploadExcel = function () {
            var fileInput = document.getElementById('pricingExcelFile');
            if (fileInput.files.length === 0) {
                Noty("error", "Please select an Excel file to upload.");
                return;
            }

            var formData = new FormData();
            formData.append("excelFile", fileInput.files[0]);
            formData.append("Shape", $scope.Diamond.Shape);
            formData.append("GradType", $scope.Diamond.GradType);

            show_loader();
            $http.post('@Url.Action("Pricing_Insert_Using_Excel", "Pricing")', formData, {
                transformRequest: angular.identity,
                headers: { 'Content-Type': undefined }
            }).then(function (ret) {
                hide_loader();
                var msg = ret.data.Message;
                if (msg && msg.toLowerCase().indexOf("error") === -1) {
                    $('#uploadPricingExcelModal').modal('hide');
                    Noty("success", msg);
                    $scope.GetdataTRNRap(); // Refresh grid
                } else {
                    Noty("error", msg || "Unknown error occurred during upload.");
                }
            }, function (error) {
                hide_loader();
                Noty("error", "Upload failed.");
            });
        };

        $scope.toggleGroup = function(group) {
            group.Expanded = !group.Expanded;
        };

