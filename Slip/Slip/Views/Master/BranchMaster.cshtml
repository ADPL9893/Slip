@{
    ViewBag.Title = "Branch Master";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}


@if (ViewBag.CanView != null && (bool)ViewBag.CanView)
{
<div ng-controller="BranchMasterCtrl" class="bm-page">
    <div class="bm-header-card">
        <div class="bm-header-left">
            <div class="bm-header-icon"><i class="fa fa-building"></i></div>
            <div>
                <div class="bm-breadcrumb">
                    <a href="@Url.Action("Index", "Home")"><i class="fa fa-home"></i> Home</a> /
                    <span>Branch Master</span>
                </div>
                <h4 class="bm-header-title">Branch Master</h4>
            </div>
        </div>
        <div>
            <button class="btn-bm-add-main" type="button" ng-show="CanAdd" ng-click="OpenAddModal()">
                <i class="fa fa-plus"></i> ADD NEW BRANCH
            </button>
        </div>
    </div>

    <div class="bm-grid-card">
        <div class="bm-card-header">
            <div class="bm-card-title-left">
                <i class="fa fa-table"></i>
                <h3>Branch Records</h3>
                <span class="badge-status-pill badge-pill-info" style="margin-left: 6px;">
                    <i class="fa fa-database"></i> {{BranchList.length || 0}} Records
                </span>
            </div>
        </div>
        <div class="bm-grid-body">
            <div id="branchGridContainer" style="width: 100%;"></div>
        </div>
    </div>

    <!-- Add / Edit Modal -->
    <div class="modal fade" id="BranchModal" role="dialog" data-backdrop="static">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <div class="modal-header-flex">
                        <div class="modal-header-title-left">
                            <i class="fa fa-building modal-title-icon"></i>
                            <h4 class="modal-title">{{FormModel.BranchID > 0 ? 'Edit Branch' : 'Add New Branch'}}</h4>
                        </div>
                        <button type="button" class="btn-close-header" data-dismiss="modal">&times;</button>
                    </div>
                </div>

                <div class="modal-body">
                    <div class="bm-modal-section">
                        <div class="bm-modal-section-title"><i class="fa fa-id-card text-primary"></i> BASIC DETAILS</div>
                        <div class="row">
                            <div class="col-md-4 col-sm-6 col-xs-12 bm-form-group">
                                <label class="bm-label" for="ModalBranchCode">BRANCH CODE <span class="req">*</span></label>
                                <input type="text" id="ModalBranchCode" ng-model="FormModel.BranchCode" placeholder="e.g. HO, GF01" class="bm-input" />
                            </div>
                            <div class="col-md-4 col-sm-6 col-xs-12 bm-form-group">
                                <label class="bm-label" for="ModalBranchName">BRANCH NAME <span class="req">*</span></label>
                                <input type="text" id="ModalBranchName" ng-model="FormModel.BranchName" placeholder="Enter Branch Name" class="bm-input" />
                            </div>
                            <div class="col-md-4 col-sm-6 col-xs-12 bm-form-group">
                                <label class="bm-label" for="ModalBranchTypeID">BRANCH TYPE <span class="req">*</span></label>
                                <select id="ModalBranchTypeID" chosen="BranchTypeList" class="form-control bm-input" ng-model="FormModel.BranchTypeID" ng-options="item.BranchTypeID as item.BranchTypeName for item in BranchTypeList">
                                    <option value="">Select Branch Type</option>
                                </select>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-4 col-sm-6 col-xs-12 bm-form-group">
                                <label class="bm-label" for="ModalContactPerson">CONTACT PERSON</label>
                                <input type="text" id="ModalContactPerson" ng-model="FormModel.ContactPerson" placeholder="Enter Contact Person" class="bm-input" />
                            </div>
                            <div class="col-md-4 col-sm-6 col-xs-12 bm-form-group">
                                <label class="bm-label" for="ModalPhone">PHONE</label>
                                <input type="text" id="ModalPhone" ng-model="FormModel.Phone" placeholder="Enter Phone" class="bm-input" />
                            </div>
                        </div>
                    </div>

                    <div class="bm-modal-section">
                        <div class="bm-modal-section-title"><i class="fa fa-map-marker text-primary"></i> ADDRESS</div>
                        <div class="row">
                            <div class="col-md-12 bm-form-group">
                                <label class="bm-label" for="ModalAddress">ADDRESS</label>
                                <textarea id="ModalAddress" ng-model="FormModel.Address" placeholder="Enter Address" class="bm-input"></textarea>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 col-sm-6 col-xs-12 bm-form-group">
                                <label class="bm-label" for="ModalCity">CITY</label>
                                <input type="text" id="ModalCity" ng-model="FormModel.City" placeholder="City" class="bm-input" />
                            </div>
                        </div>
                    </div>

                    <div class="bm-modal-section" style="margin-bottom: 5px;">
                        <div class="bm-modal-section-title"><i class="fa fa-file-text-o text-primary"></i> STATUTORY</div>
                        <div class="row">
                            <div class="col-md-6 col-sm-6 col-xs-12 bm-form-group">
                                <label class="bm-label" for="ModalGSTIN">GSTIN</label>
                                <input type="text" id="ModalGSTIN" ng-model="FormModel.GSTIN" placeholder="Enter GSTIN" maxlength="15" class="bm-input" />
                            </div>
                            <div class="col-md-6 col-sm-6 col-xs-12 bm-form-group">
                                <label class="bm-label" for="ModalStateCode">STATE CODE</label>
                                <input type="text" id="ModalStateCode" ng-model="FormModel.StateCode" placeholder="e.g. 24" maxlength="2" class="bm-input" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button class="btn-bm-reset" type="button" ng-click="ResetForm()">
                        <i class="fa fa-refresh"></i> Reset
                    </button>
                    <button class="btn-bm-save" type="button" ng-click="SaveBranch()" ng-disabled="IsSaving">
                        <i class="fa fa-check" ng-class="{'fa-spin fa-spinner': IsSaving}"></i>
                        {{FormModel.BranchID > 0 ? 'UPDATE' : 'SAVE'}}
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Delete Confirmation Modal -->
    <div class="modal fade" id="BranchConfirmDeleteModal" role="dialog" data-backdrop="static">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header" style="background: #111827 !important; padding: 12px 18px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
                        <h4 class="modal-title" style="font-size: 14px; font-weight: 700; color: #ffffff; margin: 0;">Confirm Delete</h4>
                        <button type="button" class="btn-close-header" data-dismiss="modal">&times;</button>
                    </div>
                </div>
                <div class="modal-body text-center" style="padding: 20px; background: #ffffff;">
                    <i class="fa fa-trash-o text-danger" style="font-size: 38px; margin-bottom: 12px; display: block;"></i>
                    <p style="font-size: 13px; color: #334155; margin: 0;">
                        Are you sure you want to delete branch <strong>{{SelectedDeleteItem.BranchName}}</strong> ({{SelectedDeleteItem.BranchCode}})?
                    </p>
                </div>
                <div class="modal-footer" style="padding: 10px 18px; background: #f8fafc;">
                    <button class="btn btn-default btn-sm" data-dismiss="modal" type="button" style="font-weight: 600;">Cancel</button>
                    <button class="btn btn-danger btn-sm" ng-click="ExecuteDelete()" type="button" style="font-weight: 600;">Delete</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    var module;
    try {
        module = angular.module('app');
    } catch (e) {
        module = angular.module('app', ['ngAnimate', 'ngTouch']);
    }

    try {
        module.directive('chosen', ['$timeout', function ($timeout) {
            return {
                restrict: 'A',
                link: function (scope, element, attrs) {
                    var list = attrs['chosen'];
                    if (list) {
                        scope.$watchCollection(list, function () {
                            $timeout(function () { element.trigger('chosen:updated'); }, 50);
                        });
                    }
                    if (attrs['ngModel']) {
                        scope.$watch(attrs['ngModel'], function () {
                            $timeout(function () { element.trigger('chosen:updated'); }, 50);
                        });
                    }
                    element.chosen({ width: '100%', search_contains: true, allow_single_deselect: true });
                }
            };
        }]);
    } catch (e) { /* chosen directive already registered on this module */ }

    module.controller("BranchMasterCtrl", ['$scope', '$http', '$timeout', function ($scope, $http, $timeout) {
        $scope.CanAdd = ('@ViewBag.CanAdd' === 'True' || '@ViewBag.IsAdmin' === 'True');
        $scope.CanEdit = ('@ViewBag.CanEdit' === 'True' || '@ViewBag.IsAdmin' === 'True');
        $scope.CanDelete = ('@ViewBag.CanDelete' === 'True' || '@ViewBag.IsAdmin' === 'True');
        $scope.IsAdmin = ('@ViewBag.IsAdmin' === 'True');

        $scope.BranchList = [];
        $scope.BranchTypeList = [];
        $scope.IsLoading = false;
        $scope.IsSaving = false;
        $scope.SelectedDeleteItem = null;

        $scope.FormModel = {
            BranchID: 0,
            BranchCode: '',
            BranchName: '',
            BranchTypeID: null,
            GSTIN: '',
            StateCode: '',
            Address: '',
            City: '',
            ContactPerson: '',
            Phone: ''
        };

        $scope.OpenAddModal = function () {
            $scope.ResetForm();
            $("#BranchModal").modal("show");
            $timeout(function () { $('#ModalBranchTypeID').trigger('chosen:updated'); }, 60);
        };

        $scope.ResetForm = function () {
            $scope.FormModel = {
                BranchID: 0,
                BranchCode: '',
                BranchName: '',
                BranchTypeID: null,
                GSTIN: '',
                StateCode: '',
                Address: '',
                City: '',
                ContactPerson: '',
                Phone: ''
            };
            $timeout(function () { $('#ModalBranchTypeID').trigger('chosen:updated'); }, 40);
        };

        $scope.EditItem = function (item) {
            if (!item) return;
            $scope.FormModel = {
                BranchID: item.BranchID,
                BranchCode: item.BranchCode || '',
                BranchName: item.BranchName || '',
                BranchTypeID: item.BranchTypeID,
                GSTIN: item.GSTIN || '',
                StateCode: item.StateCode || '',
                Address: item.Address || '',
                City: item.City || '',
                ContactPerson: item.ContactPerson || '',
                Phone: item.Phone || ''
            };
            $("#BranchModal").modal("show");
            $timeout(function () { $('#ModalBranchTypeID').trigger('chosen:updated'); }, 80);
        };

        $scope.PromptDelete = function (item) {
            if (!item || !item.BranchID) return;
            $scope.SelectedDeleteItem = item;
            $("#BranchConfirmDeleteModal").modal("show");
        };

        $scope.ExecuteDelete = function () {
            if (!$scope.SelectedDeleteItem) return;
            $http.post('@Url.Action("BranchMaster_Delete", "Master")', { BranchID: $scope.SelectedDeleteItem.BranchID })
                .then(function (res) {
                    $("#BranchConfirmDeleteModal").modal("hide");
                    if (res.data && res.data.success) {
                        Noty("success", res.data.message || "Branch deleted successfully!");
                        $scope.LoadBranchList();
                    } else {
                        Noty("error", (res.data && res.data.message) || "Failed to delete branch.");
                    }
                }, function () {
                    $("#BranchConfirmDeleteModal").modal("hide");
                    Noty("error", "Error connecting to server.");
                });
        };

        $scope.GetGridInstance = function () {
            var $el = $("#branchGridContainer");
            if (!$el.data("dxDataGrid")) {
                return null;
            }
            return $el.dxDataGrid("instance");
        };

        $scope.RefreshGrid = function () {
            var gridInstance = $scope.GetGridInstance();
            if (gridInstance) {
                gridInstance.refresh();
            } else {
                $scope.InitGrid();
            }
        };

        $scope.ToggleActive = function (item) {
            if (!item || !item.BranchID) return;
            var newStatus = !item.IsActive;
            $http.post('@Url.Action("BranchMaster_ActiveInactive", "Master")', { BranchID: item.BranchID, IsActive: newStatus })
                .then(function (res) {
                    if (res.data && res.data.success) {
                        item.IsActive = newStatus;
                        $scope.RefreshGrid();
                        Noty("success", res.data.message || "Status updated successfully!");
                    } else {
                        Noty("error", (res.data && res.data.message) || "Failed to update status.");
                    }
                }, function () {
                    Noty("error", "Error connecting to server.");
                });
        };

        $scope.LoadBranchTypes = function () {
            debugger
            $http.get('@Url.Action("Get_MST_BranchTypeList", "Master")').then(function (res) {
                if (res.data && res.data.success) {
                    $scope.BranchTypeList = res.data.list || [];
                    $timeout(function () { $('#ModalBranchTypeID').trigger('chosen:updated'); }, 100);
                }
            });
        };

        $scope.LoadBranchList = function (searchText) {
            $scope.IsLoading = true;
            $http.get('@Url.Action("Get_MST_BranchList", "Master")', { params: { SearchText: searchText || '' } })
                .then(function (res) {
                    $scope.IsLoading = false;
                    if (res.data && res.data.success) {
                        $scope.BranchList = res.data.list || [];
                        $scope.InitGrid();
                    } else {
                        Noty("error", (res.data && res.data.message) || "Failed to load branches.");
                    }
                }, function () {
                    $scope.IsLoading = false;
                    Noty("error", "Error connecting to server.");
                });
        };

        $scope.SaveBranch = function () {
            if (!$scope.FormModel.BranchCode) {
                Noty("error", "Please enter Branch Code!");
                $('#ModalBranchCode').focus();
                return;
            }
            if (!$scope.FormModel.BranchName) {
                Noty("error", "Please enter Branch Name!");
                $('#ModalBranchName').focus();
                return;
            }
            if (!$scope.FormModel.BranchTypeID) {
                Noty("error", "Please select Branch Type!");
                $('#ModalBranchTypeID').trigger('chosen:open');
                return;
            }

            var action = ($scope.FormModel.BranchID > 0) ? 'UPDATE' : 'INSERT';
            $scope.IsSaving = true;

            $http.post('@Url.Action("BranchMaster_Save", "Master")', { model: $scope.FormModel, Action: action })
                .then(function (res) {
                    $scope.IsSaving = false;
                    if (res.data && res.data.success) {
                        $("#BranchModal").modal("hide");
                        Noty("success", res.data.message || (action === 'UPDATE' ? "Branch updated successfully!" : "Branch saved successfully!"));
                        $scope.ResetForm();
                        $scope.LoadBranchList();
                    } else {
                        Noty("error", (res.data && res.data.message) || "Failed to save branch.");
                    }
                }, function () {
                    $scope.IsSaving = false;
                    Noty("error", "Error saving branch to server.");
                });
        };

        $scope.InitGrid = function () {
            var gridInstance = $scope.GetGridInstance();
            if (gridInstance) {
                gridInstance.option("dataSource", $scope.BranchList);
                return;
            }
            $("#branchGridContainer").dxDataGrid({
                dataSource: $scope.BranchList,
                keyExpr: 'BranchID',
                onRowPrepared: function (e) {
                    if (e.rowType === "data") {
                        e.rowElement.addClass("ri-row-animate");
                        e.rowElement.css("--ri-row-i", e.rowIndex);
                    }
                },
                height: 'calc(100vh - 210px)',
                columnAutoWidth: true,
                allowColumnResizing: true,
                columnResizingMode: 'widget',
                showColumnLines: true,
                showRowLines: true,
                showBorders: true,
                sorting: { mode: "multiple" },
                scrolling: { mode: 'standard', rowRenderingMode: 'standard' },
                paging: { enabled: false },
                pager: { visible: false },
                searchPanel: { visible: true, width: 250, placeholder: 'Search branches...' },
                filterRow: { visible: true },
                headerFilter: { visible: true },
                columns: [
                    {
                        caption: '#', width: 45, alignment: 'center',
                        cellTemplate: function (container, options) {
                            $("<span>").text(options.rowIndex + 1).css({ "font-weight": "600", "color": "#64748b" }).appendTo(container);
                        }
                    },
                    {
                        caption: 'Branch Code', dataField: 'BranchCode', minWidth: 110,
                        cellTemplate: function (container, options) {
                            $("<strong>").text(options.data.BranchCode).css({ "color": "#1e293b" }).appendTo(container);
                        }
                    },
                    { caption: 'Branch Name', dataField: 'BranchName', minWidth: 160 },
                    {
                        caption: 'Type', dataField: 'BranchTypeName', width: 110, alignment: 'center',
                        cellTemplate: function (container, options) {
                            $("<span>").addClass("badge-status-pill badge-pill-info").text(options.data.BranchTypeName).appendTo(container);
                        }
                    },
                    { caption: 'Contact Person', dataField: 'ContactPerson', minWidth: 140 },
                    { caption: 'Phone', dataField: 'Phone', minWidth: 110 },
                    { caption: 'City', dataField: 'City', minWidth: 100 },
                    { caption: 'GSTIN', dataField: 'GSTIN', minWidth: 140 },
                    { caption: 'State Code', dataField: 'StateCode', width: 95, alignment: 'center' },
                    {
                        caption: 'Status', dataField: 'IsActive', width: 95, alignment: 'center',
                        cellTemplate: function (container, options) {
                            if (options.data.IsActive) {
                                $("<span>").addClass("badge-status-pill badge-pill-success").text("Active").appendTo(container);
                            } else {
                                $("<span>").addClass("badge-status-pill badge-pill-danger").text("Inactive").appendTo(container);
                            }
                        }
                    },
                    {
                        caption: 'Action', width: 120, alignment: 'center', fixed: true, fixedPosition: 'right',
                        visible: ($scope.CanEdit || $scope.CanDelete),
                        cellTemplate: function (container, options) {
                            var div = $("<div>").addClass("grid-btn-group");

                            if ($scope.CanEdit) {
                                $("<button>").addClass("grid-btn-edit").attr("title", "Edit Branch").html('<i class="fa fa-pencil"></i>')
                                    .on("click", function () { $scope.$apply(function () { $scope.EditItem(options.data); }); })
                                    .appendTo(div);

                                var isActive = !!options.data.IsActive;
                                var $toggleBtn = $("<button>").addClass("grid-btn-toggle")
                                    .attr("title", isActive ? "Deactivate Branch" : "Activate Branch")
                                    .html('<i class="fa ' + (isActive ? "fa-toggle-on" : "fa-toggle-off") + '"></i>');
                                if (!isActive) {
                                    $toggleBtn.addClass("is-inactive-state");
                                }
                                $toggleBtn.on("click", function () { $scope.$apply(function () { $scope.ToggleActive(options.data); }); })
                                    .appendTo(div);
                            }

                            if ($scope.CanDelete) {
                                $("<button>").addClass("grid-btn-del").attr("title", "Delete Branch").html('<i class="fa fa-trash-o"></i>')
                                    .on("click", function () { $scope.$apply(function () { $scope.PromptDelete(options.data); }); })
                                    .appendTo(div);
                            }

                            div.appendTo(container);
                        }
                    }
                ]
            });
        };

        $('#BranchModal').on('shown.bs.modal', function () {
            $timeout(function () { $('#ModalBranchTypeID').trigger('chosen:updated'); }, 40);
        });

        $scope.LoadBranchTypes();
        $scope.LoadBranchList();
    }]);
</script>
}
else
{
    <div class="container-fluid" style="margin-top: 25px;">
        <div class="alert alert-danger text-center" style="border-radius: 8px; font-size: 14px; padding: 20px; box-shadow: 0 4px 12px rgba(239, 68, 68, 0.12);">
            <h4 style="margin-top: 0; font-weight: 700;"><i class="fa fa-ban"></i> Access Denied</h4>
            <p style="margin-bottom: 0;">You do not have permission to view the <strong>Branch Master</strong> module. Please contact your administrator to request access.</p>
        </div>
    </div>
}
