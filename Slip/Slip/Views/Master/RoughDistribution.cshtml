@{
    ViewBag.Title = "Rough Distribution";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}


<div ng-controller="RoughDistributionCtrl" class="rough-dist-page">
    <!-- Header Banner -->
    <div class="rd-header-card">
        <div class="rd-header-left">
            <div class="rd-header-icon">
                <i class="fa fa-share-alt"></i>
            </div>
            <div>
                <div class="rd-breadcrumb">
                    <a href="@Url.Action("Index", "Home")"><i class="fa fa-home"></i> Home</a> / 
                    <a href="@Url.Action("RoughDistributionList", "Master")">RoughDistributionList</a> / 
                    <span>Rough Distribution</span>
                </div>
                <h4 class="rd-header-title">Rough Distribution</h4>
            </div>
        </div>
        <div class="rd-header-actions">
            <!-- Save Distribution Button & Changes Counter (Keeps Enabled on Delete/Add) -->
            <button class="btn-rd-save-main" type="button" ng-show="CanAdd" ng-disabled="!CanSave()" ng-click="SaveAllStagedDistributions()">
                <i class="fa fa-save" ng-class="{'fa-spin': IsSaving}"></i> Save Distribution 
                <span ng-if="CanSave() && (GetChangesCount() > 0)">
                    ({{GetChangesCount()}} Changes)
                </span>
            </button>
        </div>
    </div>

    <!-- Top Master Lot Selection & Auto-Fetched Details Card -->
    <div class="rd-card rd-card-specs">
        <div class="rd-card-header">
            <h5 class="rd-card-title">
                <i class="fa fa-diamond text-primary"></i> 1. Select Jangad &amp; Lot Specifications
            </h5>
        </div>
        <div class="rd-card-body">
            <div class="row">
                <!-- Primary Jangad Dropdown (Clean Jangad No only & Clean Disabled Styling) -->
                <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 rd-form-group">
                    <label class="rd-label" for="SelectedJangadNo">
                        Select Jangad No <span class="req">*</span>
                    </label>
                    <select id="SelectedJangadNo"
                            chosen="JangadDropdownList"
                            ng-model="SelectedJangadNo"
                            ng-change="OnJangadNoChange()"
                            ng-disabled="DistributionList.length > 0 || MasterLot.DistributedPcs > 0 || AllDistributionsList.length > 0 || TotalDistributedPcs > 0"
                            class="form-control rd-input">
                        <option value="">-- Choose Jangad No --</option>
                        <option ng-repeat="item in JangadDropdownList" value="{{item.JangadNo}}">
                            {{item.JangadNo}}
                        </option>
                    </select>
                </div>

                <!-- Lot No Dropdown (populated from the selected Jangad's lots) -->
                <div class="col-lg-2 col-md-3 col-sm-6 col-xs-12 rd-form-group">
                    <label class="rd-label" for="SelectedLotNo">
                        Select Lot No <span class="req">*</span>
                    </label>
                    <select id="SelectedLotNo"
                            chosen="LotDropdownList"
                            ng-model="SelectedPreRoughID"
                            ng-change="OnLotNoChange()"
                            ng-disabled="!SelectedJangadNo || DistributionList.length > 0 || MasterLot.DistributedPcs > 0 || AllDistributionsList.length > 0 || TotalDistributedPcs > 0"
                            class="form-control rd-input">
                        <option value="">-- Choose Lot No --</option>
                        <option ng-repeat="item in LotDropdownList" value="{{item.PreRoughID}}">
                            {{item.RName}}
                        </option>
                    </select>
                </div>
                <div class="clearfix visible-xs"></div>

                <div class="col-lg-1 col-md-2 col-sm-3 col-xs-6 rd-form-group">
                    <label class="rd-label">Rough Pcs</label>
                    <input type="text" ng-model="Master.RoughPcs" class="rd-input rd-master-input" readonly placeholder="0" />
                </div>

                <div class="col-lg-2 col-md-3 col-sm-3 col-xs-6 rd-form-group">
                    <label class="rd-label">Rough Weight (Cts)</label>
                    <input type="text" ng-model="Master.RoughWeight" class="rd-input rd-master-input" readonly placeholder="0.000" />
                </div>
                <div class="clearfix visible-xs visible-sm visible-md"></div>

                <div class="col-lg-2 col-md-4 col-sm-6 col-xs-12 rd-form-group">
                    <label class="rd-label">Height Range (From - To)</label>
                    <div class="rd-input-group">
                        <input type="text" ng-model="Master.FromHeight" class="rd-input rd-master-input" readonly placeholder="From" />
                        <span class="rd-range-sep">-</span>
                        <input type="text" ng-model="Master.ToHeight" class="rd-input rd-master-input" readonly placeholder="To" />
                    </div>
                </div>
                <div class="clearfix visible-xs"></div>

                <div class="col-lg-1 col-md-2 col-sm-3 col-xs-6 rd-form-group">
                    <label class="rd-label">Master Rate</label>
                    <input type="text" ng-model="Master.Rate" class="rd-input rd-master-input" readonly placeholder="0.00" />
                </div>

                <div class="col-lg-1 col-md-2 col-sm-3 col-xs-6 rd-form-group">
                    <label class="rd-label">Master Grad No</label>
                    <input type="text" ng-model="Master.GradNo" class="rd-input rd-master-input" ng-class="{'highlight-mix': IsMixGrade}" readonly placeholder="Grad No" />
                </div>
                <div class="clearfix"></div>
            </div>
        </div>
    </div>

    <!-- SEPARATE DYNAMIC ADJUSTMENT & KPI CARDS -->
    <div class="kpi-container">
        <!-- 1. Original Lot Card -->
        <div class="kpi-box kpi-original">
            <div class="kpi-icon-wrap">
                <i class="fa fa-cubes"></i>
            </div>
            <div class="kpi-content">
                <div class="kpi-label">Original Pre-Rough Lot</div>
                <div class="kpi-value">{{(Master.RoughPcs || 0) | number:0}} <span style="font-size:13px; font-weight:600; color:#64748b;">Pcs</span></div>
                <div class="kpi-sub">
                    <i class="fa fa-balance-scale"></i> Total Weight: <strong>{{(Master.RoughWeight || 0) | number:3}} Cts</strong>
                </div>
            </div>
        </div>

        <!-- 2. Total Distributed Card -->
        <div class="kpi-box kpi-distributed">
            <div class="kpi-icon-wrap">
                <i class="fa fa-pie-chart"></i>
            </div>
            <div class="kpi-content">
                <div class="kpi-label">Total Distributed</div>
                <div class="kpi-value">{{TotalDistributedPcs | number:0}} <span style="font-size:13px; font-weight:600; color:#64748b;">Pcs</span></div>
                <div class="kpi-sub">
                    <i class="fa fa-check-circle"></i> Distributed Weight: <strong>{{TotalDistributedWeight | number:3}} Cts</strong>
                </div>
            </div>
        </div>

        <!-- 3. SEPARATE FIELD: ADJUST PCS -->
        <div class="kpi-box kpi-adj-pcs" ng-class="{'status-match': AdjustPcs === 0, 'status-over': AdjustPcs < 0}">
            <div class="kpi-icon-wrap">
                <i class="fa fa-calculator"></i>
            </div>
            <div class="kpi-content">
                <div class="kpi-label">Adjust Pcs (Remaining)</div>
                <div class="kpi-value">{{AdjustPcs | number:0}} <span style="font-size:13px; font-weight:600; color:#64748b;">Pcs</span></div>
                <div class="kpi-sub">
                    <span ng-if="AdjustPcs === 0" class="badge-status-pill badge-pill-success"><i class="fa fa-check"></i> Pcs Balanced</span>
                    <span ng-if="AdjustPcs > 0" class="badge-status-pill badge-pill-warning"><i class="fa fa-clock-o"></i> {{AdjustPcs}} Pcs Remaining</span>
                    <span ng-if="AdjustPcs < 0" class="badge-status-pill badge-pill-danger"><i class="fa fa-exclamation-triangle"></i> Over by {{-(AdjustPcs)}} Pcs</span>
                </div>
            </div>
        </div>

        <!-- 4. SEPARATE FIELD: ADJUST WEIGHT -->
        <div class="kpi-box kpi-adj-wt" ng-class="{'status-match': AdjustWeight === 0, 'status-over': AdjustWeight < 0}">
            <div class="kpi-icon-wrap">
                <i class="fa fa-balance-scale"></i>
            </div>
            <div class="kpi-content">
                <div class="kpi-label">Adjust Weight (Remaining)</div>
                <div class="kpi-value">{{AdjustWeight | number:3}} <span style="font-size:13px; font-weight:600; color:#64748b;">Cts</span></div>
                <div class="kpi-sub">
                    <span ng-if="AdjustWeight === 0" class="badge-status-pill badge-pill-success"><i class="fa fa-check"></i> Weight Balanced</span>
                    <span ng-if="AdjustWeight > 0" class="badge-status-pill badge-pill-warning"><i class="fa fa-clock-o"></i> {{AdjustWeight | number:3}} Cts Remaining</span>
                    <span ng-if="AdjustWeight < 0" class="badge-status-pill badge-pill-danger"><i class="fa fa-exclamation-triangle"></i> Over by {{-(AdjustWeight) | number:3}} Cts</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Input Form Row for New Distribution Entry (All Mandatory & Clean 2-Row Layout) -->
    <div class="rd-card rd-card-entry">
        <div class="rd-card-header">
            <h5 class="rd-card-title">
                <i class="fa fa-plus-circle text-primary"></i> 2. Add New Distribution Entry
            </h5>
            <span class="text-muted" style="font-size: 11.5px;">
                All fields marked with <span class="req">*</span> are strictly mandatory
            </span>
        </div>
        <div class="rd-card-body">
            <!-- Row 1: Branch (2), R. Code (2), Rough Pcs (2), Rough Weight (2), Rate (2), Grad No (2) = 12 cols -->
            <div class="row">
                <!-- Target Branch (Bound from MST_GeneralSetting) -->
                <div class="col-lg-2 col-md-3 col-sm-6 col-xs-12 rd-form-group">
                    <label class="rd-label" for="BranchID">
                        Branch <span class="req">*</span>
                    </label>
                    <select id="BranchID" chosen="BranchList" class="form-control rd-input input-sm" ng-model="NewEntry.BranchID" ng-change="OnBranchChange()" ng-options="item.id as item.value for item in BranchList">
                        <option value="">-- Select Target Branch --</option>
                    </select>
                </div>

                <!-- Task 3: Dynamic R. Code Input Field (Automatic vs Manual) -->
                <div class="col-lg-2 col-md-3 col-sm-6 col-xs-12 rd-form-group">
                    <label class="rd-label" for="EntryRCode">
                        R. Code <span class="req">*</span>
                        <span class="helper-note text-primary" ng-if="IsRCodeAuto">(Auto)</span>
                        <span class="helper-note text-muted" ng-if="!IsRCodeAuto && NewEntry.BranchID">(Manual)</span>
                    </label>
                    <input type="text" id="EntryRCode" ng-model="NewEntry.RCode" ng-disabled="IsRCodeAuto" placeholder="{{IsRCodeAuto ? 'Auto-Generated' : 'Enter R. Code'}}" class="rd-input" ng-class="{'rd-master-input': IsRCodeAuto}" />
                </div>
                <div class="clearfix visible-xs"></div>

                <!-- Rough Pcs -->
                <div class="col-lg-2 col-md-2 col-sm-3 col-xs-6 rd-form-group">
                    <label class="rd-label" for="EntryRoughPcs">
                        Rough Pcs <span class="req">*</span>
                        <span class="quick-tag" ng-if="AdjustPcs > 0" ng-click="QuickFillPcs()" title="Fill Remaining Adjust Pcs">All ({{AdjustPcs}})</span>
                    </label>
                    <input type="text" id="EntryRoughPcs" ng-model="NewEntry.RoughPcs" placeholder="Enter Pcs" class="rd-input allownumericwithoutdecimal" />
                </div>

                <!-- Rough Weight -->
                <div class="col-lg-2 col-md-2 col-sm-3 col-xs-6 rd-form-group">
                    <label class="rd-label" for="EntryRoughWeight">
                        Rough Weight <span class="req">*</span>
                        <span class="quick-tag" ng-if="AdjustWeight > 0" ng-click="QuickFillWeight()" title="Fill Remaining Adjust Weight">All ({{AdjustWeight | number:3}})</span>
                    </label>
                    <input type="text" id="EntryRoughWeight" ng-model="NewEntry.RoughWeight" placeholder="0.000" class="rd-input allownumericwithdecimal" />
                </div>
                <div class="clearfix visible-xs visible-sm visible-md"></div>

                <!-- Rate: Disabled by default, except when GradNo equals 'MIX' -->
                <div class="col-lg-2 col-md-2 col-sm-3 col-xs-6 rd-form-group">
                    <label class="rd-label" for="EntryRate">
                        Rate <span class="req">*</span>
                        <span class="helper-note" ng-if="IsMixGrade">(MIX Custom)</span>
                        <span class="helper-note text-muted" ng-if="!IsMixGrade">(Locked)</span>
                    </label>
                    <input type="text" id="EntryRate" ng-model="NewEntry.Rate" ng-disabled="!IsMixGrade" ng-class="{'highlight-mix': IsMixGrade}" placeholder="Enter Rate" class="rd-input allownumericwithdecimal" />
                </div>

                <!-- GradNo: Dropdown when 'MIX', Locked/Disabled when not 'MIX' -->
                <div class="col-lg-2 col-md-2 col-sm-3 col-xs-6 rd-form-group">
                    <label class="rd-label" for="EntryGradNo">
                        Grad No <span class="req">*</span>
                        <span class="helper-note" ng-if="IsMixGrade">(MIX Custom)</span>
                        <span class="helper-note text-muted" ng-if="!IsMixGrade">(Locked)</span>
                    </label>
                    <div ng-show="IsMixGrade">
                        <select id="EntryGradNo" chosen="GradeList" ng-model="NewEntry.GradNo" class="form-control rd-input">
                            <option value="">-- Select Grade --</option>
                            <option value="A">A</option>
                            <option value="B">B</option>
                            <option value="C">C</option>
                            <option value="D">D</option>
                            <option value="MIX">MIX</option>
                        </select>
                    </div>
                    <div ng-show="!IsMixGrade">
                        <input type="text" ng-model="NewEntry.GradNo" disabled readonly placeholder="Grad No" class="rd-input rd-master-input" />
                    </div>
                </div>
                <div class="clearfix"></div>
            </div>

            <!-- Row 2: Height Range (2), Priority (2), Remarks (3), Status (2), Action Buttons (3) = 12 cols -->
            <div class="row">
                <!-- From Height & To Height -->
                <div class="col-lg-2 col-md-3 col-sm-6 col-xs-12 rd-form-group">
                    <label class="rd-label">Height (From - To) <span class="req">*</span></label>
                    <div class="rd-input-group">
                        <input type="text" id="EntryFromHeight" ng-model="NewEntry.FromHeight" placeholder="From Height" class="rd-input allownumericwithdecimal" />
                        <span class="rd-range-sep">-</span>
                        <input type="text" id="EntryToHeight" ng-model="NewEntry.ToHeight" placeholder="To Height" class="rd-input allownumericwithdecimal" />
                    </div>
                </div>

                <!-- Priority Selection Dropdown (REGULAR, SAMPLE, ARGENT) -->
                <div class="col-lg-2 col-md-2 col-sm-4 col-xs-6 rd-form-group">
                    <label class="rd-label" for="EntryPriority">Priority <span class="req">*</span></label>
                    <select id="EntryPriority" class="form-control rd-input" ng-model="NewEntry.Priority">
                        <option value="REGULAR">REGULAR</option>
                        <option value="SAMPLE">SAMPLE</option>
                        <option value="ARGENT">ARGENT</option>
                    </select>
                </div>

                <!-- Remarks (Mandatory) -->
                <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12 rd-form-group">
                    <label class="rd-label" for="EntryRemarks">
                        Remarks <span class="req">*</span>
                    </label>
                    <input type="text" id="EntryRemarks" ng-model="NewEntry.Remarks" placeholder="Enter mandatory remarks..." class="rd-input" />
                </div>
                <div class="clearfix visible-xs visible-sm"></div>

                <!-- IsActive Checkbox -->
                <div class="col-lg-2 col-md-2 col-sm-4 col-xs-6 rd-form-group">
                    <label class="rd-label">Status</label>
                    <div class="active-toggle-wrap">
                        <input type="checkbox" id="EntryIsActive" ng-model="NewEntry.IsActive" />
                        <label for="EntryIsActive" style="margin: 0; font-size: 12.5px; font-weight: 600; cursor: pointer;">
                            <span ng-if="NewEntry.IsActive" class="text-success"><i class="fa fa-check-circle"></i> Active</span>
                            <span ng-if="!NewEntry.IsActive" class="text-danger"><i class="fa fa-times-circle"></i> Inactive</span>
                        </label>
                    </div>
                </div>

                <!-- Action Add & Clear Buttons -->
                <div class="col-lg-3 col-md-2 col-sm-8 col-xs-12 rd-form-group">
                    <label class="rd-label rd-action-label">&nbsp;</label>
                    <div class="rd-btn-action-row">
                        <button class="btn-rd-add" type="button" ng-click="AddDistributionRow()">
                            <i class="fa fa-plus"></i> Add Entry
                        </button>
                        <button class="btn-rd-clear" type="button" ng-click="ResetEntryForm()" title="Clear form fields">
                            <i class="fa fa-eraser"></i> Clear
                        </button>
                    </div>
                </div>
                <div class="clearfix"></div>
            </div>
        </div>
    </div>

    <!-- Child Grid Container (DevExtreme DataGrid) -->
    <div class="grid-container-card">
        <div class="d-flex justify-content-between align-items-center" style="margin-bottom: 10px; display:flex; justify-content:space-between; align-items:center;">
            <h5 class="rd-card-title">
                <i class="fa fa-table text-primary"></i> 3. Distribution Allocations ({{DistributionList.length}} Records)
            </h5>
            <div>
                <span class="badge-status-pill badge-pill-success" ng-if="SavedList.length > 0">
                    <i class="fa fa-database"></i> {{SavedList.length}} Saved
                </span>
                <span class="badge-status-pill badge-pill-warning" ng-if="StagedList.length > 0" style="margin-left: 5px;">
                    <i class="fa fa-pencil-square-o"></i> {{StagedList.length}} Staged (Unsaved)
                </span>
                <span class="badge-status-pill badge-pill-danger" ng-if="DeletedIDs.length > 0" style="margin-left: 5px;">
                    <i class="fa fa-trash"></i> {{DeletedIDs.length}} Marked Deleted
                </span>
            </div>
        </div>

        <div class="uigrid3">
            <div id="rdGridContainer" style="width: 100%;"></div>
        </div>
    </div>

    <!-- Delete Confirmation Modal -->
    <div class="modal fade" id="ConfirmDeleteModal" role="dialog" data-backdrop="static">
        <div class="modal-dialog modal-md">
            <div class="modal-content">
                <div class="modal-header">
                    <div class="modal-header-brand">
                        <i class="fa fa-exclamation-triangle" style="color: #ef4444; font-size: 18px;"></i>
                        <h4 class="modal-header-title" style="color: #ffffff !important; font-weight: 700 !important; margin: 0 !important;">Confirm Remove Distribution</h4>
                    </div>
                    <button type="button" class="close modal-close-btn" data-dismiss="modal" style="color: #cbd5e1 !important; opacity: 0.9 !important;">&times;</button>
                </div>
                <div class="modal-body" style="background: #ffffff;">
                    <div class="delete-dialog-content">
                        <div class="delete-warning-icon">
                            <i class="fa fa-trash-o"></i>
                        </div>
                        <h4 class="delete-dialog-title">Remove Branch Distribution?</h4>
                        <p class="delete-dialog-text">
                            Are you sure you want to remove distribution for <strong>{{SelectedDeleteItem.BranchName}}</strong> 
                            ({{SelectedDeleteItem.RoughPcs}} Pcs, {{SelectedDeleteItem.RoughWeight}} Cts)?
                            <br /><br />
                            <small class="text-muted"><i class="fa fa-info-circle"></i> This row will be removed locally and permanently deleted from the database when you click <strong>Save Distribution</strong>.</small>
                        </p>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn-modal-action btn-modal-reset" data-dismiss="modal" type="button">
                        <i class="fa fa-times"></i> Cancel
                    </button>
                    <button class="btn-modal-action btn-modal-delete" ng-click="ExecuteDelete()" type="button">
                        <i class="fa fa-trash"></i> Yes, Remove
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    var appModule;
    try {
        appModule = angular.module('app');
    } catch (e) {
        appModule = angular.module('app', ['ngAnimate', 'ngTouch', 'ui.grid', 'angularjs-dropdown-multiselect']);
    }

    // Dynamic Z-Index elevation for Chosen dropdowns to prevent clipping by sibling cards
    $(document).on('chosen:showing_dropdown', '.chosen-container', function () {
        var $el = $(this);
        $el.closest('.rd-form-group').addClass('chosen-open-group');
        $el.closest('.rd-card').addClass('chosen-open-card');
    });

    $(document).on('chosen:hiding_dropdown', '.chosen-container', function () {
        var $el = $(this);
        $el.closest('.rd-form-group').removeClass('chosen-open-group');
        $el.closest('.rd-card').removeClass('chosen-open-card');
    });

    // Chosen Directive with option watcher & robust update hooks
    appModule.directive('chosen', ['$timeout', function ($timeout) {
        return {
            restrict: 'A',
            link: function (scope, element, attrs) {
                var updateChosen = function () {
                    $timeout(function () {
                        element.trigger('chosen:updated');
                    }, 50);
                };

                var list = attrs['chosen'];
                if (list) {
                    scope.$watchCollection(list, function () {
                        updateChosen();
                    });
                }
                if (attrs['ngModel']) {
                    scope.$watch(attrs['ngModel'], function () {
                        updateChosen();
                    });
                }
                if (attrs['ngDisabled']) {
                    scope.$watch(attrs['ngDisabled'], function (newVal) {
                        $timeout(function () {
                            element.prop('disabled', !!newVal).trigger('chosen:updated');
                        }, 50);
                    });
                }

                scope.$watch(function () {
                    return element.find('option').length;
                }, function (newVal, oldVal) {
                    if (newVal !== oldVal) {
                        updateChosen();
                    }
                });

                element.chosen({ width: '100%', search_contains: true, allow_single_deselect: true });
            }
        };
    }]);

    appModule.controller("RoughDistributionCtrl", ['$scope', '$http', '$timeout', '$q', function ($scope, $http, $timeout, $q) {
        // Permissions
        $scope.CanAdd = ('@ViewBag.CanAdd' === 'True' || '@ViewBag.IsAdmin' === 'True' || true);
        $scope.CanEdit = ('@ViewBag.CanEdit' === 'True' || '@ViewBag.IsAdmin' === 'True');
        $scope.CanDelete = ('@ViewBag.CanDelete' === 'True' || '@ViewBag.IsAdmin' === 'True');
        $scope.IsAdmin = ('@ViewBag.IsAdmin' === 'True');

        // URL / Parameter ID
        $scope.InitPreRoughID = parseInt('@ViewBag.PreRoughID') || 0;
        $scope.SelectedPreRoughID = $scope.InitPreRoughID > 0 ? $scope.InitPreRoughID.toString() : '';

        // Master Lot Details
        $scope.Master = {
            PreRoughID: 0,
            JangadNo: '',
            RoughPcs: 0,
            RoughWeight: 0,
            Rate: 0,
            GradNo: '',
            FromHeight: 0,
            ToHeight: 0
        };

        // Condition Flag: Is MIX grade?
        $scope.IsMixGrade = false;

        // R.Code Auto / Manual State from MST_VoucherDetails
        $scope.IsRCodeAuto = false;
        $scope.RCodeConfig = null;

        // Dropdown Lists
        $scope.PreRoughDropdownList = []; // Full flat list: one entry per lot line (Jangad + Lot combined)
        $scope.JangadDropdownList = [];   // Distinct Jangad Nos derived from PreRoughDropdownList
        $scope.LotDropdownList = [];      // Lots belonging to the selected Jangad No
        $scope.SelectedJangadNo = '';
        $scope.BranchList = [];
        $scope.GradeList = ['A', 'B', 'C', 'D', 'MIX'];

        // Distribution lists: Saved in DB vs Staged (New)
        $scope.SavedList = [];
        $scope.StagedList = [];
        $scope.AllDistributionsList = [];
        $scope.DistributionList = [];
        $scope.MasterLot = { DistributedPcs: 0, DistributedWeight: 0 };

        // Deferred deletion tracking (save-dependent deletion)
        $scope.DeletedIDs = [];
        $scope.DeletedDistributionIDs = $scope.DeletedIDs; // Alias
        $scope.SelectedDeleteItem = null;
        $scope.HasChanges = false;

        // Dynamic Totals & Adjustment Balances
        $scope.TotalDistributedPcs = 0;
        $scope.TotalDistributedWeight = 0;
        $scope.AdjustPcs = 0;
        $scope.AdjustWeight = 0;

        // Form Model for New Entry (Kept clean / blank by default with RCode)
        $scope.NewEntry = {
            DistributionID: 0,
            PreRoughID: 0,
            BranchID: '',
            BranchName: '',
            RCode: '',
            RoughPcs: null,
            RoughWeight: null,
            Rate: null,
            GradNo: '',
            FromHeight: null,
            ToHeight: null,
            Remarks: '',
            Priority: 'REGULAR',
            IsActive: true
        };

        $scope.IsLoading = false;
        $scope.IsSaving = false;
        $scope.BasePreviewRCode = '';

        // Dynamic In-Memory Sequence Calculation for Automatic R.Code
        $scope.EvaluateNextRCode = function (branchId, basePreviewRCode) {
            if (!basePreviewRCode || typeof basePreviewRCode !== 'string') return basePreviewRCode || '';

            // Collect all existing RCodes in the current lot for this branch (Staged + Saved)
            var currentGridRows = ($scope.SavedList || []).concat($scope.StagedList || []);

            // Pattern to separate prefix and trailing number (e.g. "BRN-26-1" -> prefix "BRN-26-", number "1")
            var match = basePreviewRCode.trim().match(/^(.*?)(\d+)$/);
            if (!match) {
                var branchStagedCount = ($scope.StagedList || []).filter(function (x) {
                    return parseInt(x.BranchID || 0) === branchId;
                }).length;
                return branchStagedCount > 0 ? (basePreviewRCode + '-' + (branchStagedCount + 1)) : basePreviewRCode;
            }

            var prefix = match[1];
            var numStr = match[2];
            var minDigits = numStr.length;
            var baseNum = parseInt(numStr, 10);

            // Find all used numbers in staged and saved lists that match this prefix for this branch
            var usedNums = [];
            angular.forEach(currentGridRows, function (row) {
                if (row && row.RCode && (parseInt(row.BranchID || 0) === branchId)) {
                    var rMatch = (row.RCode || '').trim().match(/^(.*?)(\d+)$/);
                    if (rMatch && rMatch[1].toLowerCase() === prefix.toLowerCase()) {
                        var usedN = parseInt(rMatch[2], 10);
                        if (!isNaN(usedN)) {
                            usedNums.push(usedN);
                        }
                    }
                }
            });

            var targetNum = baseNum;
            if (usedNums.length > 0) {
                var maxUsed = Math.max.apply(null, usedNums);
                if (maxUsed >= baseNum) {
                    targetNum = maxUsed + 1;
                }
            }

            // Zero-pad to preserve original formatting width (e.g. 001 -> 002)
            function padNumber(n, width) {
                var s = n + '';
                while (s.length < width) {
                    s = '0' + s;
                }
                return s;
            }

            return prefix + padNumber(targetNum, minDigits);
        };

        // Fetch R.Code Configuration on Branch Selection
        $scope.OnBranchChange = function () {
            var branchId = parseInt($scope.NewEntry.BranchID || 0);
            if (!branchId || branchId <= 0) {
                $scope.IsRCodeAuto = false;
                $scope.RCodeConfig = null;
                $scope.BasePreviewRCode = '';
                $scope.NewEntry.RCode = '';
                return;
            }

            // Call Get_RoughCodeConfig to fetch configuration for this Branch & Module
            $http.post('@Url.Action("Get_RoughCodeConfig", "Master")', {
                BranchID: branchId,
                VoucherType: 'Rough Distribution',
                ActionType: 'GET_CONFIG'
            }).then(function (res) {
                if (res.data && res.data.success && res.data.Config) {
                    $scope.RCodeConfig = res.data.Config;
                    var numMethod = ($scope.RCodeConfig.NumericMethod || '').trim();
                    if (numMethod.toLowerCase() === 'automatic') {
                        $scope.IsRCodeAuto = true;
                        // Safe preview of next expected R.Code without incrementing counter
                        $http.post('@Url.Action("Get_RoughCodeConfig", "Master")', {
                            BranchID: branchId,
                            VoucherType: 'Rough Distribution',
                            ActionType: 'PREVIEW_AUTO'
                        }).then(function (genRes) {
                            if (genRes.data && genRes.data.success && genRes.data.GeneratedRCode) {
                                $scope.BasePreviewRCode = genRes.data.GeneratedRCode;
                                $scope.NewEntry.RCode = $scope.EvaluateNextRCode(branchId, $scope.BasePreviewRCode);
                            }
                        });
                    } else {
                        $scope.IsRCodeAuto = false;
                        $scope.BasePreviewRCode = '';
                        $scope.NewEntry.RCode = '';
                    }
                } else {
                    $scope.IsRCodeAuto = false;
                    $scope.RCodeConfig = null;
                    $scope.BasePreviewRCode = '';
                    $scope.NewEntry.RCode = '';
                }
            }, function () {
                $scope.IsRCodeAuto = false;
                $scope.RCodeConfig = null;
                $scope.BasePreviewRCode = '';
                $scope.NewEntry.RCode = '';
            });
        };

        // Reactive Changes Counter & Pending Changes Detection (For Save Button State)
        $scope.GetChangesCount = function () {
            var stagedCount = ($scope.StagedList && $scope.StagedList.length) ? $scope.StagedList.length : 0;
            var deletedCount = ($scope.DeletedIDs && $scope.DeletedIDs.length) ? $scope.DeletedIDs.length : 0;
            return stagedCount + deletedCount;
        };

        $scope.CanSave = function () {
            if ($scope.IsSaving) return false;
            var stagedCount = ($scope.StagedList && $scope.StagedList.length) ? $scope.StagedList.length : 0;
            var deletedCount = ($scope.DeletedIDs && $scope.DeletedIDs.length) ? $scope.DeletedIDs.length : 0;
            return (stagedCount > 0 || deletedCount > 0 || $scope.HasChanges === true);
        };

        // Numeric validation handlers
        $('.allownumericwithoutdecimal').on('keypress', function (e) {
            if (e.which !== 8 && e.which !== 0 && (e.which < 48 || e.which > 57)) return false;
        });
        $('.allownumericwithdecimal').on('keypress', function (e) {
            if (e.which !== 8 && e.which !== 0 && (e.which !== 46 || $(this).val().indexOf('.') !== -1) && (e.which < 48 || e.which > 57)) return false;
        });

        // 1. Fetch Dropdown Lists (Jangad List & Branch List from MST_GeneralSetting)
        $scope.InitDropdowns = function () {
            $scope.IsLoading = true;

            // Fetch Pre-Rough Lots for Dropdown
            var p1 = $http.get('@Url.Action("GetRoughInwardLotsForDistribution", "Master")').then(function (res) {
                var list = [];
                if (res.data && res.data.DIARoughList) {
                    angular.forEach(res.data.DIARoughList, function (item) {
                        var pid = item.ID || item.ProcessID || item.PreRoughID;
                        if (pid) {
                            list.push({
                                PreRoughID: parseInt(pid),
                                JangadNo: item.JangadNo || ('Lot #' + pid),
                                RName: item.RName || item.StoneID || '',
                                RoughPcs: parseInt(item.RoughPcs || item.CakePcs || 0),
                                RoughWeight: parseFloat(item.RoughWeight || item.CakeWeight || 0),
                                GradNo: item.GradNo || '',
                                Rate: parseFloat(item.Rate || 0),
                                FromHeight: item.FromHeight ? parseFloat(item.FromHeight) : null,
                                ToHeight: item.ToHeight ? parseFloat(item.ToHeight) : null
                            });
                        }
                    });
                }
                $scope.PreRoughDropdownList = list;

                // Build the distinct Jangad No list for the top-level dropdown
                var seenJangad = {};
                var jangadArr = [];
                angular.forEach(list, function (item) {
                    if (item.JangadNo && !seenJangad[item.JangadNo]) {
                        seenJangad[item.JangadNo] = true;
                        jangadArr.push({ JangadNo: item.JangadNo });
                    }
                });
                $scope.JangadDropdownList = jangadArr;

                $timeout(function () {
                    $('#SelectedJangadNo').trigger('chosen:updated');
                    $('#SelectedLotNo').trigger('chosen:updated');
                }, 100);
            });

            // Fetch Branch List from Getdata_For_DropDown (Table 5: MST_GeneralSetting WHERE MasterType = 'Branch')
            var p2 = $http.post('@Url.Action("Getdata_For_DropDown", "Master")').then(function (res) {
                var bList = [];
                if (res.data && res.data.BranchList && res.data.BranchList.length > 0) {
                    for (var i = 0; i < res.data.BranchList.length; i++) {
                        var bId = res.data.BranchList[i]["ID"] || res.data.BranchList[i]["id"];
                        var bVal = res.data.BranchList[i]["Value"] || res.data.BranchList[i]["value"];
                        if (bId !== undefined && bId !== null) {
                            bList.push({
                                id: parseInt(bId),
                                value: bVal
                            });
                        }
                    }
                } else if (res.data && res.data.UserList && res.data.UserList.length > 0) {
                    for (var j = 0; j < res.data.UserList.length; j++) {
                        var uId = res.data.UserList[j]["UserID"] || res.data.UserList[j]["ID"] || res.data.UserList[j]["id"];
                        var uVal = res.data.UserList[j]["UserName"] || res.data.UserList[j]["Value"] || res.data.UserList[j]["value"];
                        if (uId !== undefined && uId !== null) {
                            bList.push({
                                id: parseInt(uId),
                                value: uVal
                            });
                        }
                    }
                }
                if (bList.length > 0) {
                    $scope.BranchList = bList;
                    $timeout(function () {
                        $('#BranchID').trigger('chosen:updated');
                    }, 100);
                } else {
                    $scope.FetchFallbackBranches();
                }
            }, function () {
                $scope.FetchFallbackBranches();
            });

            $q.all([p1, p2]).then(function () {
                $scope.IsLoading = false;
                if ($scope.InitPreRoughID > 0) {
                    // LoadPreRoughDetails injects the lot into the dropdown lists if the
                    // balance-filtered fetch omitted it, then syncs the Jangad/Lot selection itself.
                    $scope.LoadPreRoughDetails($scope.InitPreRoughID);
                }
            });
        };

        $scope.FetchFallbackBranches = function () {
            $http.get('@Url.Action("SEC_UserPrivileges_Getdata", "User")').then(function (res) {
                var rawList = (res.data && res.data.SYSModuleList) ? res.data.SYSModuleList : (Array.isArray(res.data) ? res.data : []);
                var list = [];
                angular.forEach(rawList, function (item) {
                    var uid = item.UserID || item.ID;
                    var uname = item.UserName || item.Name;
                    if (uid && uname) {
                        list.push({ id: parseInt(uid), value: uname });
                    }
                });
                $scope.BranchList = list;
                $timeout(function () {
                    $('#BranchID').trigger('chosen:updated');
                }, 100);
            });
        };

        // 2. Load Pre-Rough Master & Child Data by ID
        $scope.LoadPreRoughDetails = function (preRoughId) {
            if (!preRoughId || parseInt(preRoughId) <= 0) {
                $scope.ResetMaster();
                return;
            }

            $scope.IsLoading = true;
            $http.get('@Url.Action("GetRoughInwardLotDetails", "Master")?id=' + preRoughId).then(function (res) {
                $scope.IsLoading = false;
                if (res.data && res.data.success) {
                    var m = res.data.MasterDetails || {};
                    $scope.Master = {
                        PreRoughID: parseInt(m.PreRoughID || preRoughId),
                        JangadNo: m.JangadNo || '',
                        RoughPcs: parseInt(m.RoughPcs || 0),
                        RoughWeight: parseFloat(m.RoughWeight || 0),
                        Rate: parseFloat(m.Rate || 0),
                        GradNo: m.GradNo || '',
                        FromHeight: m.FromHeight !== null && m.FromHeight !== undefined ? parseFloat(m.FromHeight) : null,
                        ToHeight: m.ToHeight !== null && m.ToHeight !== undefined ? parseFloat(m.ToHeight) : null
                    };

                    // Check if GradNo is 'MIX' (case-insensitive)
                    $scope.IsMixGrade = ($scope.Master.GradNo || '').trim().toUpperCase() === 'MIX';

                    // The dropdown source only lists lots with remaining balance, so a lot that is
                    // already fully (or partially) distributed - e.g. opened via the List page's
                    // View/Edit link - may be missing from it. Inject it so the Jangad/Lot dropdowns
                    // can still resolve and display the current selection.
                    var existsInDropdown = $scope.PreRoughDropdownList.some(function (x) { return x.PreRoughID === $scope.Master.PreRoughID; });
                    if (!existsInDropdown) {
                        $scope.PreRoughDropdownList.push({
                            PreRoughID: $scope.Master.PreRoughID,
                            JangadNo: $scope.Master.JangadNo || ('Lot #' + $scope.Master.PreRoughID),
                            RName: m.RName || '',
                            RoughPcs: $scope.Master.RoughPcs,
                            RoughWeight: $scope.Master.RoughWeight,
                            GradNo: $scope.Master.GradNo,
                            Rate: $scope.Master.Rate,
                            FromHeight: $scope.Master.FromHeight,
                            ToHeight: $scope.Master.ToHeight
                        });
                        if (!$scope.JangadDropdownList.some(function (j) { return j.JangadNo === $scope.Master.JangadNo; })) {
                            $scope.JangadDropdownList.push({ JangadNo: $scope.Master.JangadNo });
                        }
                    }

                    // Parse Child List from DB & Resolve Accurate Branch Name, BranchID, and RCode
                    var cList = [];
                    if (res.data.ChildList && res.data.ChildList.length > 0) {
                        angular.forEach(res.data.ChildList, function (c) {
                            var bId = parseInt(c.BranchID || c.BranchId || 0);
                            var bName = (c.BranchName || '').trim();

                            // If bId is missing, resolve it from BranchList using BranchName
                            if ((!bId || bId === 0) && bName) {
                                var matchObj = $scope.BranchList.find(function (x) {
                                    return (x.value || x.Value || '').trim().toLowerCase() === bName.toLowerCase();
                                });
                                if (matchObj) {
                                    bId = parseInt(matchObj.id || matchObj.ID || 0);
                                }
                            }

                            // If bName is missing or numeric, resolve it from BranchList using bId
                            if (bId > 0) {
                                var bObj = $scope.BranchList.find(function (x) {
                                    return (parseInt(x.id || x.ID || 0) === bId);
                                });
                                if (bObj && (bObj.value || bObj.Value)) {
                                    bName = (bObj.value || bObj.Value).trim();
                                }
                            }

                            cList.push({
                                DistributionID: parseInt(c.DistributionID || c.ID || 0),
                                PreRoughID: parseInt(c.PreRoughID || preRoughId),
                                BranchID: bId,
                                BranchName: bName || ('Branch #' + bId),
                                RCode: c.RCode || c.R_Code || '',
                                RoughPcs: parseInt(c.RoughPcs || 0),
                                RoughWeight: parseFloat(c.RoughWeight || 0),
                                Rate: c.Rate !== null && c.Rate !== undefined ? parseFloat(c.Rate) : null,
                                GradNo: c.GradNo || '',
                                FromHeight: c.FromHeight !== null && c.FromHeight !== undefined ? parseFloat(c.FromHeight) : null,
                                ToHeight: c.ToHeight !== null && c.ToHeight !== undefined ? parseFloat(c.ToHeight) : null,
                                Remarks: c.Remarks || '',
                                Priority: (c.Priority || c.priority || 'REGULAR').toUpperCase(),
                                IsActive: c.IsActive === true || c.IsActive === 'True' || c.IsActive === '1' || c.IsActive === 1,
                                IsReceived: c.IsReceived === true || c.IsReceived === 'True' || c.IsReceived === '1' || c.IsReceived === 1,
                                IsStaged: false,
                                IsSaved: true
                            });
                        });
                    }
                    $scope.SavedList = cList;
                    $scope.StagedList = []; // Reset staged rows on fresh load
                    $scope.DeletedIDs = []; // Reset deferred deletion array
                    $scope.DeletedDistributionIDs = $scope.DeletedIDs;
                    $scope.HasChanges = false;

                    // Clean blank entry form
                    $scope.ResetEntryForm();
                    $scope.RecalculateBalances();
                    $scope.InitGrid();

                    $timeout(function () {
                        if ($scope.Master && $scope.Master.PreRoughID) {
                            $scope.SyncJangadLotSelection($scope.Master.PreRoughID);
                        }
                        $('#EntryGradNo').trigger('chosen:updated');
                    }, 200);
                } else {
                    Noty("error", res.data.message || "Failed to load pre-rough details.");
                }
            }, function () {
                $scope.IsLoading = false;
                Noty("error", "Error connecting to server.");
            });
        };

        // Jangad No selection change handler: rebuilds the Lot No dropdown for the chosen Jangad
        $scope.OnJangadNoChange = function () {
            $scope.SelectedPreRoughID = '';
            $scope.LotDropdownList = $scope.SelectedJangadNo
                ? $scope.PreRoughDropdownList.filter(function (item) { return item.JangadNo === $scope.SelectedJangadNo; })
                : [];
            $scope.ResetMaster();
        };

        // Lot No selection change handler
        $scope.OnLotNoChange = function () {
            if ($scope.SelectedPreRoughID) {
                $scope.LoadPreRoughDetails(parseInt($scope.SelectedPreRoughID));
            } else {
                $scope.ResetMaster();
            }
        };

        // Given a PreRoughID (lot line id), select its Jangad No + Lot No in both dropdowns
        $scope.SyncJangadLotSelection = function (preRoughId) {
            var match = $scope.PreRoughDropdownList.find(function (x) { return x.PreRoughID === parseInt(preRoughId); });
            if (!match) return;
            $scope.SelectedJangadNo = match.JangadNo;
            $scope.LotDropdownList = $scope.PreRoughDropdownList.filter(function (item) {
                return item.JangadNo === match.JangadNo;
            });
            $scope.SelectedPreRoughID = preRoughId.toString();
            $timeout(function () {
                $('#SelectedJangadNo').val($scope.SelectedJangadNo).trigger('chosen:updated');
                $('#SelectedLotNo').val($scope.SelectedPreRoughID).trigger('chosen:updated');
            }, 50);
        };

        // Reset Master State
        $scope.ResetMaster = function () {
            $scope.Master = {
                PreRoughID: 0,
                JangadNo: '',
                RoughPcs: 0,
                RoughWeight: 0,
                Rate: 0,
                GradNo: '',
                FromHeight: null,
                ToHeight: null
            };
            $scope.IsMixGrade = false;
            $scope.SavedList = [];
            $scope.StagedList = [];
            $scope.AllDistributionsList = [];
            $scope.DistributionList = [];
            $scope.MasterLot = { DistributedPcs: 0, DistributedWeight: 0 };
            $scope.DeletedIDs = [];
            $scope.DeletedDistributionIDs = $scope.DeletedIDs;
            $scope.HasChanges = false;
            $scope.BasePreviewRCode = '';
            $scope.RecalculateBalances();
            $scope.ResetEntryForm();
            $scope.InitGrid();
            $timeout(function () {
                $('#SelectedLotNo').trigger('chosen:updated');
            }, 50);
        };

        // Reset Entry Form Fields - KEPT COMPLETELY BLANK / CLEAN
        $scope.ResetEntryForm = function () {
            $scope.IsRCodeAuto = false;
            $scope.RCodeConfig = null;
            $scope.BasePreviewRCode = '';
            $scope.NewEntry = {
                DistributionID: 0,
                PreRoughID: $scope.Master.PreRoughID || 0,
                BranchID: '',
                BranchName: '',
                RCode: '',
                RoughPcs: null,
                RoughWeight: null,
                Rate: $scope.IsMixGrade ? null : ($scope.Master.Rate || null),
                GradNo: $scope.IsMixGrade ? '' : ($scope.Master.GradNo || ''),
                FromHeight: null,
                ToHeight: null,
                Remarks: '',
                Priority: 'REGULAR',
                IsActive: true
            };
            $timeout(function () {
                $('#BranchID').val('').trigger('chosen:updated');
                $('#EntryGradNo').val('').trigger('chosen:updated');
            }, 50);
        };

        // Alias for ClearEntryForm
        $scope.ClearEntryForm = $scope.ResetEntryForm;

        // Quick auto-fill helper tags
        $scope.QuickFillPcs = function () {
            if ($scope.AdjustPcs > 0) {
                $scope.NewEntry.RoughPcs = $scope.AdjustPcs;
            }
        };

        $scope.QuickFillWeight = function () {
            if ($scope.AdjustWeight > 0) {
                $scope.NewEntry.RoughWeight = parseFloat($scope.AdjustWeight.toFixed(3));
            }
        };

        // 3. Dynamic Calculation of Distributed & Adjust Balances
        $scope.RecalculateBalances = function () {
            $scope.AllDistributionsList = angular.copy($scope.SavedList).concat(angular.copy($scope.StagedList));
            $scope.DistributionList = $scope.AllDistributionsList;

            var totalPcs = 0;
            var totalWt = 0;

            angular.forEach($scope.DistributionList, function (row) {
                totalPcs += parseInt(row.RoughPcs || 0);
                totalWt += parseFloat(row.RoughWeight || 0);
            });

            $scope.TotalDistributedPcs = totalPcs;
            $scope.TotalDistributedWeight = parseFloat(totalWt.toFixed(3));

            $scope.MasterLot = {
                DistributedPcs: $scope.TotalDistributedPcs,
                DistributedWeight: $scope.TotalDistributedWeight
            };

            var origPcs = parseInt($scope.Master.RoughPcs || 0);
            var origWt = parseFloat($scope.Master.RoughWeight || 0);

            // Separate calculations
            $scope.AdjustPcs = origPcs - $scope.TotalDistributedPcs;
            $scope.AdjustWeight = parseFloat((origWt - $scope.TotalDistributedWeight).toFixed(3));

            $timeout(function () {
                $('#SelectedLotNo').trigger('chosen:updated');
            }, 50);
        };

        // 4. Add Entry into Temporary / Staged List with Dynamic Sequence Generation & Strict R.Code Uniqueness
        $scope.AddDistributionRow = function () {
            if (!$scope.Master.PreRoughID || $scope.Master.PreRoughID <= 0) {
                Noty("warning", "Please select a Jangad No first!");
                $('#SelectedLotNo').trigger('chosen:open');
                return;
            }

            // 1. Branch Validation
            if (!$scope.NewEntry.BranchID || parseInt($scope.NewEntry.BranchID) <= 0) {
                Noty("error", "Please select Target Branch !");
                $('#BranchID').trigger('chosen:open');
                return;
            }

            var selectedBranchId = parseInt($scope.NewEntry.BranchID || 0);
            var selectedBranchName = "";

            // Find Selected Branch Name from BranchList
            if ($scope.BranchList && $scope.BranchList.length > 0) {
                var bMatch = $scope.BranchList.find(function (x) {
                    return (parseInt(x.id || x.ID || 0) === selectedBranchId);
                });
                if (bMatch) {
                    selectedBranchName = (bMatch.value || bMatch.Value || bMatch.BranchName || "").trim();
                }
            }

            // Refresh & Evaluate Dynamic Sequential R.Code if Automatic Numbering is Configured
            if ($scope.IsRCodeAuto) {
                $scope.NewEntry.RCode = $scope.EvaluateNextRCode(selectedBranchId, $scope.BasePreviewRCode || $scope.NewEntry.RCode);
            }

            // Task 1: R. Code Validation (Mandatory)
            var rCode = ($scope.NewEntry.RCode || "").trim();
            if (!rCode) {
                Noty("error", "Please enter R. Code !");
                $('#EntryRCode').focus();
                return;
            }

            // Strict In-Memory Duplicate Check across all current rows (Saved + Staged)
            var allCurrentRows = ($scope.SavedList || []).concat($scope.StagedList || []);
            var isLocalDuplicateRCode = false;
            for (var rc = 0; rc < allCurrentRows.length; rc++) {
                if ((allCurrentRows[rc].RCode || "").trim().toLowerCase() === rCode.toLowerCase()) {
                    isLocalDuplicateRCode = true;
                    break;
                }
            }
            if (isLocalDuplicateRCode) {
                Noty("error", "R.Code '" + rCode + "' already exists in the distribution table! Each packet must have a unique R.Code.");
                $('#EntryRCode').focus();
                return;
            }

            // 2. Rough Pcs Validation (Strict Capacity Check)
            var pcs = parseInt($scope.NewEntry.RoughPcs);
            if ($scope.NewEntry.RoughPcs === undefined || $scope.NewEntry.RoughPcs === null || $scope.NewEntry.RoughPcs === "" || isNaN(pcs) || pcs <= 0) {
                Noty("error", "Please enter valid Rough Pcs (greater than 0) !");
                $('#EntryRoughPcs').focus();
                return;
            }
            if (pcs > $scope.AdjustPcs) {
                Noty("error", "Rough Pcs (" + pcs + ") cannot exceed remaining Adjust Pcs (" + $scope.AdjustPcs + ")!");
                $('#EntryRoughPcs').focus();
                return;
            }

            // 3. Rough Weight Validation (Strict Capacity Check)
            var weight = parseFloat($scope.NewEntry.RoughWeight);
            if ($scope.NewEntry.RoughWeight === undefined || $scope.NewEntry.RoughWeight === null || $scope.NewEntry.RoughWeight === "" || isNaN(weight) || weight <= 0) {
                Noty("error", "Please enter valid Rough Weight (greater than 0) !");
                $('#EntryRoughWeight').focus();
                return;
            }
            if (weight > ($scope.AdjustWeight + 0.0001)) {
                Noty("error", "Rough Weight (" + weight.toFixed(3) + " Cts) cannot exceed remaining Adjust Weight (" + $scope.AdjustWeight.toFixed(3) + " Cts)!");
                $('#EntryRoughWeight').focus();
                return;
            }

            // 4. Rate Validation
            var rate = 0;
            if ($scope.IsMixGrade) {
                rate = parseFloat($scope.NewEntry.Rate);
                if ($scope.NewEntry.Rate === undefined || $scope.NewEntry.Rate === null || $scope.NewEntry.Rate === "" || isNaN(rate) || rate <= 0) {
                    Noty("error", "Please enter Rate for MIX grade !");
                    $('#EntryRate').focus();
                    return;
                }
            } else {
                rate = parseFloat($scope.Master.Rate || 0);
            }

            // 5. Grad No Validation
            var gradNo = "";
            if ($scope.IsMixGrade) {
                gradNo = ($scope.NewEntry.GradNo || "").trim();
                if (!gradNo) {
                    Noty("error", "Please select Grade No !");
                    $('#EntryGradNo').trigger('chosen:open');
                    return;
                }
            } else {
                gradNo = ($scope.Master.GradNo || "").trim();
                if (!gradNo) {
                    Noty("error", "Grade No is missing in master lot !");
                    return;
                }
            }

            // 6. From Height Validation
            var fromH = parseFloat($scope.NewEntry.FromHeight);
            if ($scope.NewEntry.FromHeight === undefined || $scope.NewEntry.FromHeight === null || $scope.NewEntry.FromHeight === "" || isNaN(fromH) || fromH <= 0) {
                Noty("error", "Please enter From Height (greater than 0) !");
                $('#EntryFromHeight').focus();
                return;
            }

            // 7. To Height Validation
            var toH = parseFloat($scope.NewEntry.ToHeight);
            if ($scope.NewEntry.ToHeight === undefined || $scope.NewEntry.ToHeight === null || $scope.NewEntry.ToHeight === "" || isNaN(toH) || toH <= 0) {
                Noty("error", "Please enter To Height (greater than 0) !");
                $('#EntryToHeight').focus();
                return;
            }

            if (fromH > toH) {
                Noty("error", "From Height cannot be greater than To Height !");
                $('#EntryFromHeight').focus();
                return;
            }

            // 8. Remarks Validation (Strictly Mandatory)
            var remarks = ($scope.NewEntry.Remarks || "").trim();
            if (!remarks) {
                Noty("error", "Please enter Remarks !");
                $('#EntryRemarks').focus();
                return;
            }

            // If manual R.Code entry, verify against database for uniqueness
            if (!$scope.IsRCodeAuto) {
                $scope.IsLoading = true;
                $http.post('@Url.Action("Get_RoughCodeConfig", "Master")', {
                    BranchID: selectedBranchId,
                    VoucherType: 'Rough Distribution',
                    ActionType: 'CHECK_DUPLICATE',
                    ManualRCode: rCode
                }).then(function (chkRes) {
                    $scope.IsLoading = false;
                    if (chkRes.data && chkRes.data.success && chkRes.data.IsExists) {
                        Noty("error", "R.Code '" + rCode + "' already exists in database! Please enter a unique R.Code.");
                        $('#EntryRCode').focus();
                        return;
                    }
                    $scope.CommitAddDistributionRow(selectedBranchId, selectedBranchName, rCode, pcs, weight, rate, gradNo, fromH, toH, remarks);
                }, function () {
                    $scope.IsLoading = false;
                    $scope.CommitAddDistributionRow(selectedBranchId, selectedBranchName, rCode, pcs, weight, rate, gradNo, fromH, toH, remarks);
                });
            } else {
                $scope.CommitAddDistributionRow(selectedBranchId, selectedBranchName, rCode, pcs, weight, rate, gradNo, fromH, toH, remarks);
            }
        };

        // Commit and add validated distribution row to staged list
        $scope.CommitAddDistributionRow = function (selectedBranchId, selectedBranchName, rCode, pcs, weight, rate, gradNo, fromH, toH, remarks) {
            // Resolve Branch Name from MST_GeneralSetting
            var branchName = selectedBranchName || ('Branch #' + selectedBranchId);

            // Build new staged object including RCode & Priority
            var stagedItem = {
                DistributionID: 0,
                PreRoughID: $scope.Master.PreRoughID,
                BranchID: selectedBranchId,
                BranchName: branchName,
                RCode: rCode,
                RoughPcs: pcs,
                RoughWeight: parseFloat(weight.toFixed(3)),
                Rate: rate,
                GradNo: gradNo,
                FromHeight: fromH,
                ToHeight: toH,
                Remarks: remarks,
                Priority: ($scope.NewEntry.Priority || 'REGULAR').toUpperCase(),
                IsActive: $scope.NewEntry.IsActive !== false,
                IsStaged: true,
                IsSaved: false
            };

            $scope.StagedList.push(stagedItem);
            $scope.HasChanges = true;
            $scope.RecalculateBalances();
            $scope.ResetEntryForm();
            $scope.InitGrid();

            Noty("success", "Added " + pcs + " Pcs (" + weight.toFixed(3) + " Cts) for " + branchName + " (R.Code: " + rCode + ") to distribution table.");
        };

        // Aliased function names
        $scope.AddEntryToGrid = $scope.AddDistributionRow;

        // Numerical Suffix & Prefix Extraction Helpers for LIFO Sequential Enforcement
        $scope.GetRCodeSequenceNumber = function (rcode) {
            if (!rcode || typeof rcode !== 'string') return 0;
            var match = rcode.trim().match(/(\d+)$/);
            return match ? parseInt(match[1], 10) : 0;
        };

        $scope.GetRCodePrefix = function (rcode) {
            if (!rcode || typeof rcode !== 'string') return '';
            var match = rcode.trim().match(/^(.*?)(\d+)$/);
            return match ? match[1].toLowerCase() : rcode.trim().toLowerCase();
        };

        // LIFO Sequential Deletion Validation Helper
        $scope.ValidateSequentialDeletion = function (item) {
            if (!item || !item.RCode) return { isValid: true };

            var branchId = parseInt(item.BranchID || 0);
            var currentSeq = $scope.GetRCodeSequenceNumber(item.RCode);
            var itemPrefix = $scope.GetRCodePrefix(item.RCode);

            if (branchId <= 0 || currentSeq <= 0) {
                return { isValid: true };
            }

            // Get all active rows across SavedList and StagedList (excluding rows already marked for deferred deletion)
            var activeRows = ($scope.SavedList || []).concat($scope.StagedList || []);
            var higherRows = [];

            for (var i = 0; i < activeRows.length; i++) {
                var row = activeRows[i];
                if (!row || !row.RCode) continue;

                var rowBranchId = parseInt(row.BranchID || 0);
                var rowDelId = parseInt(row.DistributionID || 0);

                // Must belong to the same branch
                if (rowBranchId !== branchId) continue;

                // Ignore if row is the exact item being deleted
                if (row === item || (rowDelId > 0 && item.DistributionID > 0 && rowDelId === parseInt(item.DistributionID))) continue;

                // Ignore if already marked in deferred DeletedIDs
                if (rowDelId > 0 && ($scope.DeletedIDs || []).indexOf(rowDelId) !== -1) continue;

                // Match prefix family
                var rowPrefix = $scope.GetRCodePrefix(row.RCode);
                if (rowPrefix !== itemPrefix) continue;

                var rowSeq = $scope.GetRCodeSequenceNumber(row.RCode);
                if (rowSeq > currentSeq) {
                    higherRows.push({ row: row, seq: rowSeq });
                }
            }

            if (higherRows.length > 0) {
                higherRows.sort(function (a, b) {
                    return b.seq - a.seq;
                });
                var highestRCode = higherRows[0].row.RCode;
                return {
                    isValid: false,
                    highestRCode: highestRCode,
                    message: "Cannot delete this entry! Sequential rule (LIFO): You must delete the latest entry (" + highestRCode + ") first before deleting this record."
                };
            }

            return { isValid: true };
        };

        // Prompt Delete Modal with Strict LIFO Sequential Check
        $scope.PromptDelete = function (item) {
            if (!item) return;

            if (item.IsReceived) {
                Noty("error", "Cannot delete: this distribution has already been received.");
                return;
            }

            var check = $scope.ValidateSequentialDeletion(item);
            if (!check.isValid) {
                Noty("error", check.message);
                return;
            }

            $scope.SelectedDeleteItem = item;
            $("#ConfirmDeleteModal").modal("show");
        };

        // Aliased delete function name
        $scope.DeleteDistributionRow = $scope.PromptDelete;

        // Execute Immediate Local Splicing & State Refresh with Deferred DB Deletion
        $scope.ExecuteDelete = function () {
            if (!$scope.SelectedDeleteItem) {
                $("#ConfirmDeleteModal").modal("hide");
                return;
            }

            var item = $scope.SelectedDeleteItem;

            // Re-validate sequential rule before deleting
            var check = $scope.ValidateSequentialDeletion(item);
            if (!check.isValid) {
                $("#ConfirmDeleteModal").modal("hide");
                $scope.SelectedDeleteItem = null;
                Noty("error", check.message);
                return;
            }

            var delId = parseInt(item.DistributionID || item.ID || 0);

            // If it was already saved in DB, track its ID in DeletedIDs
            if (delId > 0) {
                if ($scope.DeletedIDs.indexOf(delId) === -1) {
                    $scope.DeletedIDs.push(delId);
                }
            }

            // Remove specifically from SavedList by DistributionID or object reference
            for (var i = $scope.SavedList.length - 1; i >= 0; i--) {
                var s = $scope.SavedList[i];
                if (s === item || (delId > 0 && parseInt(s.DistributionID || s.ID || 0) === delId)) {
                    $scope.SavedList.splice(i, 1);
                    break;
                }
            }

            // Remove specifically from StagedList by object reference or RCode
            for (var j = $scope.StagedList.length - 1; j >= 0; j--) {
                var st = $scope.StagedList[j];
                if (st === item || (item.RCode && st.RCode && st.RCode.trim().toLowerCase() === item.RCode.trim().toLowerCase())) {
                    $scope.StagedList.splice(j, 1);
                    break;
                }
            }

            // Mark change state
            $scope.HasChanges = true;

            // Recalculate dynamic balances and refresh grid instantly
            $scope.RecalculateBalances();
            $scope.InitGrid();

            // Re-evaluate current form R.Code if automatic for selected branch
            var currentBranchId = parseInt($scope.NewEntry.BranchID || 0);
            if (currentBranchId > 0 && $scope.IsRCodeAuto && $scope.BasePreviewRCode) {
                $scope.NewEntry.RCode = $scope.EvaluateNextRCode(currentBranchId, $scope.BasePreviewRCode);
            }

            $("#ConfirmDeleteModal").modal("hide");
            $scope.SelectedDeleteItem = null;

            $timeout(function () {
                $scope.$applyAsync();
            }, 50);

            Noty("warning", "Row removed locally. Click 'Save Distribution' to apply changes to database.");
        };

        // Save All Distributions (Staged Insertions + Deferred Deletions) & Auto-Redirect
        $scope.SaveAllStagedDistributions = function () {
            if (!$scope.Master.PreRoughID || $scope.Master.PreRoughID <= 0) {
                Noty("warning", "Please select a Jangad No!");
                return;
            }

            var stagedCount = ($scope.StagedList && $scope.StagedList.length) ? $scope.StagedList.length : 0;
            var deletedCount = ($scope.DeletedIDs && $scope.DeletedIDs.length) ? $scope.DeletedIDs.length : 0;

            if (stagedCount === 0 && deletedCount === 0) {
                Noty("warning", "No changes to save. Please add or remove entries first!");
                return;
            }

            $scope.IsSaving = true;
            $http.post('@Url.Action("SaveRoughDistribution", "Master")', {
                list: $scope.StagedList,
                deletedIDs: $scope.DeletedIDs,
                Action: 'INSERT'
            }).then(function (res) {
                $scope.IsSaving = false;
                if (res.data && res.data.success) {
                    $scope.HasChanges = false;
                    $scope.DeletedIDs = [];
                    $scope.StagedList = [];
                    Noty("success", res.data.message || "Distributions saved successfully!");
                    // Auto-Redirect to RoughDistributionList
                    $timeout(function () {
                        window.location.href = '@Url.Action("RoughDistributionList", "Master")';
                    }, 400);
                } else {
                    Noty("error", res.data.message || "Failed to save distributions.");
                }
            }, function () {
                $scope.IsSaving = false;
                Noty("error", "Error saving distributions to server.");
            });
        };

        $scope.SaveDistribution = $scope.SaveAllStagedDistributions;

        // DevExtreme DataGrid Initialization & Instant Refresh (InitGrid / RefreshGrid)
        $scope.InitGrid = function () {
            var isMobile = $(window).width() <= 768;
            var gridHeight = isMobile ? 360 : 420;

            $("#rdGridContainer").dxDataGrid({
                dataSource: $scope.DistributionList,
                keyExpr: 'DistributionID',
                height: gridHeight,
                columnAutoWidth: true,
                allowColumnResizing: true,
                columnResizingMode: 'widget',
                allowColumnReordering: true,
                columnChooser: { enabled: true, mode: 'select', title: 'Column Chooser' },
                columnFixing: { enabled: true },
                hoverStateEnabled: true,
                rowAlternationEnabled: true,
                wordWrapEnabled: false,
                showColumnLines: true,
                showRowLines: true,
                showBorders: true,
                sorting: { mode: "multiple" },
                scrolling: { 
                    mode: 'standard',
                    useNative: false
                },
                paging: { enabled: false },
                pager: { visible: false },
                searchPanel: {
                    visible: true,
                    width: isMobile ? 180 : 260,
                    placeholder: 'Search distribution...',
                    highlightCaseSensitive: false
                },
                filterRow: { visible: true, applyFilter: 'auto' },
                headerFilter: { visible: true },
                onRowPrepared: function (e) {
                    if (e.rowType === "data" && e.data.IsStaged) {
                        $(e.rowElement).addClass("staged-row");
                    }
                },
                columns: [
                    {
                        caption: '#',
                        width: 50,
                        alignment: 'center',
                        allowResizing: false,
                        allowReordering: false,
                        fixed: true,
                        fixedPosition: 'left',
                        cellTemplate: function (container, options) {
                            $("<span>")
                                .text(options.rowIndex + 1)
                                .css({ "font-weight": "600", "color": "#64748b" })
                                .appendTo(container);
                        }
                    },
                    {
                        caption: 'Status',
                        dataField: 'IsStaged',
                        minWidth: 105,
                        width: 110,
                        alignment: 'center',
                        cellTemplate: function (container, options) {
                            if (options.data.IsStaged) {
                                $("<span>")
                                    .addClass("badge-status-pill badge-pill-warning")
                                    .html('<i class="fa fa-pencil"></i> Staged')
                                    .appendTo(container);
                            } else {
                                $("<span>")
                                    .addClass("badge-status-pill badge-pill-success")
                                    .html('<i class="fa fa-check"></i> Saved')
                                    .appendTo(container);
                            }
                        }
                    },
                    {
                        caption: 'BR',
                        dataField: 'BranchName',
                        minWidth: 100,
                        alignment: 'center',
                        cellTemplate: function (container, options) {
                            var val = options.data.BranchName || options.data.ShortName || options.data.BranchShortName || ('BR-' + (options.data.BranchID || ''));
                            var displayVal = val.toString().replace(/Branch\s*#?/i, 'BR-').trim();
                            $("<strong>")
                                .text(displayVal)
                                .css({ "color": "#0f172a", "font-weight": "700" })
                                .appendTo(container);
                        }
                    },
                    {
                        caption: 'R. Code',
                        dataField: 'RCode',
                        minWidth: 110,
                        alignment: 'center',
                        cellTemplate: function (container, options) {
                            var priority = (options.data.Priority || 'REGULAR').toUpperCase();
                            var priorityClass = 'rcode-regular';

                            if (priority === 'SAMPLE') {
                                priorityClass = 'rcode-sample';
                            } else if (priority === 'ARGENT' || priority === 'URGENT') {
                                priorityClass = 'rcode-argent';
                            }

                            $("<span>")
                                .addClass(priorityClass)
                                .text(options.data.RCode || '-')
                                .appendTo(container);
                        }
                    },
                    {
                        caption: 'R.Pcs',
                        dataField: 'RoughPcs',
                        dataType: 'number',
                        minWidth: 120,
                        alignment: 'right',
                        format: '#,##0'
                    },
                    {
                        caption: 'R.WT',
                        dataField: 'RoughWeight',
                        dataType: 'number',
                        minWidth: 160,
                        alignment: 'right',
                        format: '#,##0.000'
                    },
                    {
                        caption: 'Rate',
                        dataField: 'Rate',
                        dataType: 'number',
                        minWidth: 100,
                        alignment: 'right',
                        format: '#,##0.00'
                    },
                    {
                        caption: 'Grad No',
                        dataField: 'GradNo',
                        minWidth: 100,
                        alignment: 'center'
                    },
                    {
                        caption: 'Height Range',
                        minWidth: 130,
                        alignment: 'center',
                        calculateCellValue: function (rowData) {
                            if (rowData.FromHeight || rowData.ToHeight) {
                                return (rowData.FromHeight || 0) + ' - ' + (rowData.ToHeight || 0);
                            }
                            return '-';
                        }
                    },
                    {
                        caption: 'Remarks',
                        dataField: 'Remarks',
                        minWidth: 140
                    },
                    {
                        caption: 'Active',
                        dataField: 'IsActive',
                        minWidth: 90,
                        width: 95,
                        alignment: 'center',
                        cellTemplate: function (container, options) {
                            if (options.data.IsActive) {
                                $("<span>").addClass("badge-status-pill badge-pill-success").text("Active").appendTo(container);
                            } else {
                                $("<span>").addClass("badge-status-pill badge-pill-danger").text("Inactive").appendTo(container);
                            }
                        }
                    },
                    {
                        caption: 'ACTION',
                        width: 70,
                        alignment: 'center',
                        allowResizing: false,
                        allowReordering: false,
                        fixed: true,
                        fixedPosition: 'right',
                        cellTemplate: function (container, options) {
                            var isStaged = options.data.IsStaged === true || (!options.data.DistributionID && !options.data.IsSaved);

                            if (options.data.IsReceived) {
                                // Already received - locked from deletion (editing happens via delete + re-add)
                                $("<span>")
                                    .css({ "color": "#94a3b8", "font-size": "14px" })
                                    .attr("title", "Received - locked from deletion")
                                    .html('<i class="fa fa-lock"></i>')
                                    .appendTo(container);
                            } else if (isStaged || $scope.CanDelete) {
                                $("<button>")
                                    .addClass("grid-action-btn-del")
                                    .attr("type", "button")
                                    .attr("title", isStaged ? "Remove Staged Row" : "Delete Saved Row")
                                    .html('<i class="fa fa-trash-o"></i>')
                                    .on("click", function (e) {
                                        e.stopPropagation();
                                        $scope.$apply(function () {
                                            $scope.PromptDelete(options.data);
                                        });
                                    })
                                    .appendTo(container);
                            }
                        }
                    }
                ],
                summary: {
                    totalItems: [
                        {
                            column: 'RoughPcs',
                            summaryType: 'sum',
                            valueFormat: '#,##0',
                            displayFormat: '{0}'
                        },
                        {
                            column: 'RoughWeight',
                            summaryType: 'sum',
                            valueFormat: '#,##0.000',
                            displayFormat: '{0}'
                        }
                    ]
                }
            });
        };

        $scope.RefreshGrid = $scope.InitGrid;

        // Initial setup
        $scope.InitDropdowns();
        $timeout(function () {
            $scope.InitGrid();
        }, 150);

        // Window resize responsive adjustment
        $(window).on('resize', function () {
            var gridInst = $("#rdGridContainer").dxDataGrid('instance');
            if (gridInst) {
                var isMobile = $(window).width() <= 768;
                gridInst.option('height', isMobile ? 360 : 420);
                gridInst.updateDimensions();
            }
        });
    }]);
</script>
