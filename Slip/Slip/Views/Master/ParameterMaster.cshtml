        // COLUMNS GENERATOR
        $scope.GetColumnsForCurrentParameter = function () {
            var indexCol = {
                caption: '#', width: 45, alignment: 'center', allowReordering: false, allowFiltering: false, allowSorting: false,
                cellTemplate: function (container, options) {
                    $("<span>").text(options.rowIndex + 1).css({ "font-weight": "600", "color": "#64748b" }).appendTo(container);
                }
            };

            if ($scope.SelectedParameter === 'Shape') {
                return [
                    indexCol,
                    {
                        caption: 'Shape Name', dataField: 'ShapeName', minWidth: 150,
                        cellTemplate: function (container, options) {
                            $("<strong>").text(options.data.ShapeName || '').css({ "color": "#1C5F8F" }).appendTo(container);
                        }
                    },
                    { caption: 'Short Name', dataField: 'ShortName', width: 100, alignment: 'center' },
                    { caption: 'Shape Group', dataField: 'ShapeGroup', minWidth: 120 },
                    { caption: 'Shape Category', dataField: 'ShapeCategory', minWidth: 130 },
                    {
                        caption: 'Shape Type',
                        dataField: 'ShapeTypeName',
                        width: 120,
                        alignment: 'center',
                        calculateCellValue: function (data) {
                            return data.ShapeTypeName || (data.ShapeTypeID ? 'Type ' + data.ShapeTypeID : '');
                        }
                    },
                    { caption: 'Sequence', dataField: 'Sequence', width: 90, alignment: 'center' },
                    { caption: 'Final Group', dataField: 'ShapeFinalGroup', minWidth: 120 },
                    { caption: 'Prd Group', dataField: 'ShapePrdGroup', minWidth: 120 },
                    { caption: 'Type', dataField: 'Type', minWidth: 90 },
                    { caption: 'Display Type', dataField: 'DisplayType', minWidth: 100 },
                    { caption: 'Remarks', dataField: 'Remarks', minWidth: 140 },
                    {
                        caption: 'Action', width: 65, alignment: 'center', fixed: true, fixedPosition: 'right', allowReordering: false,
                        visible: $scope.CanEdit,
                        cellTemplate: function (container, options) {
                            var div = $("<div>").addClass("grid-btn-group");
                            if ($scope.CanEdit) {
                                $("<button>").addClass("grid-btn-edit").attr("title", "Edit Shape").html('<i class="fa fa-pencil"></i>')
                                    .on("click", function () { $scope.$apply(function () { $scope.EditItem(options.data); }); })
                                    .appendTo(div);
                            }
                            div.appendTo(container);
                        }
                    }
                ];
            } else if ($scope.SelectedParameter === 'Color') {
                return [
                    indexCol,
                    {
                        caption: 'Color Name', dataField: 'ColorName', minWidth: 130,
                        cellTemplate: function (container, options) {
                            $("<strong>").text(options.data.ColorName || '').css({ "color": "#1C5F8F" }).appendTo(container);
                        }
                    },
                    {
                        caption: 'Color Type',
                        dataField: 'ColorType',
                        width: 120,
                        alignment: 'center',
                        calculateCellValue: function (data) {
                            return data.ColorType || (data.ColorTypeID == 1 ? 'Round' : (data.ColorTypeID == 2 ? 'Fancy' : ''));
                        }
                    },
                    { caption: 'Sequence', dataField: 'Sequence', width: 90, alignment: 'center' },
                    { caption: 'User File ID', dataField: 'ColorIDUserFile', width: 110, alignment: 'center' },
                    { caption: 'Remarks', dataField: 'Remarks', minWidth: 150 },
                    {
                        // ONLY Color has Status column
                        caption: 'Status', dataField: 'IsActive', width: 95, alignment: 'center',
                        cellTemplate: function (container, options) {
                            if (options.data.IsActive) {
                                $("<span>").addClass("badge-status-pill badge-pill-success").text("Active").appendTo(container);
                            } else {
                                $("<span>").addClass("badge-status-pill badge-pill-danger").text("Inactive").appendTo(container);
                            }
                        }
                    },
                    {
                        caption: 'Action', width: 105, alignment: 'center', fixed: true, fixedPosition: 'right', allowReordering: false,
                        visible: $scope.CanEdit,
                        cellTemplate: function (container, options) {
                            var div = $("<div>").addClass("grid-btn-group");
                            if ($scope.CanEdit) {
                                $("<button>").addClass("grid-btn-edit").attr("title", "Edit Color").html('<i class="fa fa-pencil"></i>')
                                    .on("click", function () { $scope.$apply(function () { $scope.EditItem(options.data); }); })
                                    .appendTo(div);

                                var isActive = !!options.data.IsActive;
                                var $toggleBtn = $("<button>").addClass("grid-btn-toggle")
                                    .attr("title", isActive ? "Deactivate" : "Activate")
