        $scope.GetKeyExpr = function () {
            if ($scope.SelectedParameter === 'Shape') return 'ShapeID';
            if ($scope.SelectedParameter === 'Color') return 'ColorID';
            if ($scope.SelectedParameter === 'Clarity') return 'ClarityID';
            if ($scope.SelectedParameter === 'Cut') return 'CutID';
            if ($scope.SelectedParameter === 'Dimension') return 'ID';
            if ($scope.SelectedParameter === 'FactoryCode') return 'ID';
            if ($scope.SelectedParameter === 'SizeCode') return 'ID';
            return 'ID';
        };

        $scope.GetSummaryField = function () {
            if ($scope.SelectedParameter === 'Shape') return 'ShapeName';
            if ($scope.SelectedParameter === 'Color') return 'ColorName';
            if ($scope.SelectedParameter === 'Clarity') return 'ClarityName';
            if ($scope.SelectedParameter === 'Cut') return 'CutName';
            if ($scope.SelectedParameter === 'Dimension') return 'DimensionName';
            if ($scope.SelectedParameter === 'FactoryCode') return 'FactoryCode';
            if ($scope.SelectedParameter === 'SizeCode') return 'SizeName';
            return 'Name';
        };

        $scope.InitGrid = function () {
            var el = $("#inwardGridContainer");
            if (el.data("dxDataGrid")) {
                el.dxDataGrid("instance").dispose();
            }

            var currentList = $scope.GetCurrentList();
            var columns = $scope.GetColumnsForCurrentParameter();
            var keyExpr = $scope.GetKeyExpr();
            var summaryCol = $scope.GetSummaryField();

            el.dxDataGrid({
                dataSource: currentList,
                keyExpr: keyExpr,
                height: '100%',
                columnAutoWidth: true,
                allowColumnResizing: true,
                columnResizingMode: 'widget',
                allowColumnReordering: true,
                columnChooser: {
                    enabled: true,
                    mode: 'select'
                },
                columnFixing: {
                    enabled: true
                },
                showColumnLines: false,
                showRowLines: true,
                showBorders: true,
                rowAlternationEnabled: true,
                wordWrapEnabled: false,
                sorting: { mode: "multiple" },
                scrolling: { mode: 'standard' },
                paging: { enabled: false },
                pager: { visible: false },
                searchPanel: { visible: false },
                filterRow: { visible: false, applyFilter: 'auto' },
                headerFilter: { visible: true },
                onToolbarPreparing: function (e) {
                    e.toolbarOptions.items = [];
                },
                onRowPrepared: function (e) {
                    if (e.rowType === "data") {
                        e.rowElement.addClass("ri-row-animate");
                        e.rowElement.css("--ri-row-i", e.rowIndex);
                        e.rowElement.find("> td").css({ "border-bottom": "1px solid #e2e8f0", "border-right": "1px solid #e2e8f0" });
                    }
                },
                onCellPrepared: function (e) {
                    if (e.rowType === "header") {
                        e.cellElement.find(".dx-column-indicators.dx-visibility-hidden").remove();
                        var $indicators = e.cellElement.find(".dx-column-indicators");
                        if ($indicators.length > 1) {
                            $indicators.slice(1).remove();
                        }
                        var $first = e.cellElement.find(".dx-column-indicators").first();
                        if ($first.length) {
                            e.cellElement.prepend($first);
                            $first.css({
                                "float": "right",
                                "margin-left": "6px",
                                "margin-right": "0",
                                "display": "inline-flex",
                                "visibility": "visible"
                            });
                        }
                    }
                },
                onContentReady: function (e) {
                    e.element.find(".dx-datagrid-headers .dx-header-row > td").each(function () {
                        var $td = $(this);
                        $td.find(".dx-column-indicators.dx-visibility-hidden").remove();
                        var $ind = $td.find(".dx-column-indicators");
                        if ($ind.length > 1) {
                            $ind.slice(1).remove();
                        }
                        var $first = $ind.first();
                        if ($first.length) {
                            $td.prepend($first);
                            $first.css({
                                "float": "right",
                                "margin-left": "6px",
                                "margin-right": "0",
                                "display": "inline-flex",
                                "visibility": "visible"
                            });
                        }
                    });
                },
                selection: { mode: 'single' },
                summary: {
                    totalItems: [
                        {
                            column: summaryCol,
                            summaryType: 'count',
                            displayFormat: 'Total: {0}',
                            alignByColumn: true
                        }
                    ]
                },
                export: { enabled: false },
                columns: columns
            });
        };

        // Modal Shown listener for chosen initialization
        $('#InwardModal').on('shown.bs.modal', function () {
            $timeout(function () {
                if ($scope.SelectedParameter === 'Shape') {
                    if (!$('#ModalShapeTypeID').data('chosen')) {
                        $('#ModalShapeTypeID').chosen({ width: '100%', search_contains: true, allow_single_deselect: true });
                    }
                    if (!$('#ModalShapeGroup').data('chosen')) {
                        $('#ModalShapeGroup').chosen({ width: '100%', search_contains: true, allow_single_deselect: true });
                    }
                    $('#ModalShapeTypeID').trigger('chosen:updated');
                    $('#ModalShapeGroup').trigger('chosen:updated');
                }
                else if ($scope.SelectedParameter === 'Color') {
                    if (!$('#ModalColorType').data('chosen')) {
                        $('#ModalColorType').chosen({ width: '100%', search_contains: true, allow_single_deselect: true });
                    }
                    $('#ModalColorType').trigger('chosen:updated');
                }
            }, 50);
        });

        // Initial Load (Default: Shape)
        $scope.LoadShapeLookups();
        $scope.LoadCurrentData();

        $timeout(function () {
            if (!$('#ParameterTypeSelect').data('chosen')) {
                $('#ParameterTypeSelect').chosen({ width: '100%', search_contains: true, allow_single_deselect: false });
            }
            $('#ParameterTypeSelect').trigger('chosen:updated');
        }, 60);

    }]);
    </script>
}
