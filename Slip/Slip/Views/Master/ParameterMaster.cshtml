                    { caption: 'Remarks', dataField: 'Remarks', minWidth: 150 },
                    {
                        caption: 'Action', width: 65, alignment: 'center', fixed: true, fixedPosition: 'right', allowReordering: false,
                        visible: $scope.CanEdit,
                        cellTemplate: function (container, options) {
                            var div = $("<div>").addClass("grid-btn-group");
