@{
    ViewBag.Title = "Size & ShapeGroup Wise Price Discount";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<div ng-controller="SizeAndFnlShpGrpWisePriceDiscCtrl" class="rough-dist-list-page">
    <div class="rdl-grid-card">
        <div class="rdl-card-header">
            <div class="rdl-card-title-left">
                <i class="fa fa-percent"></i>
                <h3>Size &amp; ShapeGroup Wise Price Discount</h3>
            </div>
            <div class="rdl-card-actions">
                <button type="button" class="btn-rdl-add" ng-disabled="!IsGridLoaded || IsSaving" ng-click="SaveData()">
                    <i class="fa fa-save" ng-class="{'fa-spin': IsSaving}"></i> Save
                </button>
            </div>
        </div>

        <div style="padding: 14px 18px; border-bottom: 1.5px solid #e2e8f0; flex: 0 0 auto;">
            <div class="row">
                <div class="col-lg-2 col-md-3 col-sm-4 col-xs-6 field-group" style="margin-bottom: 0;">
                    <label class="field-label">ShapeType</label>
                    <div class="field-select-wrap">
                        <select id="SelectedShapeType"
                                chosen="ShapeTypeList"
                                ng-model="SelectedShapeType"
                                ng-change="OnShapeTypeChange()">
                            <option value="">Select</option>
                            <option ng-repeat="item in ShapeTypeList" value="{{item.ShapeType}}">{{item.ShapeType}}</option>
                        </select>
                    </div>
                </div>

                <div class="col-lg-2 col-md-3 col-sm-4 col-xs-6 field-group" style="margin-bottom: 0;">
                    <label class="field-label">Type</label>
                    <div class="field-select-wrap">
                        <select id="SelectedType"
                                chosen="TypeList"
                                ng-model="SelectedType"
                                ng-change="OnFilterChange()">
                            <option value="">Select</option>
                            <option ng-repeat="item in TypeList" value="{{item.Value}}">{{item.Label}}</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <div style="padding: 14px 18px; border-bottom: 1.5px solid #e2e8f0; flex: 0 0 auto;" ng-show="IsGridLoaded">
            <div class="row">
                <div class="col-lg-3 col-md-4 col-sm-5 col-xs-7 field-group" style="margin-bottom: 0;">
                    <label class="field-label">ShapeGroup</label>
                    <div class="field-select-wrap">
                        <select id="BulkShapeGroupID"
                                chosen="ShapeGroupList"
                                ng-model="BulkShapeGroupID">
                            <option value="">Select</option>
                            <option ng-repeat="item in ShapeGroupList" value="{{item.ID}}">{{item.ShapeGroup}}</option>
                        </select>
                    </div>
                </div>

                <div class="col-lg-2 col-md-3 col-sm-3 col-xs-5 field-group" style="margin-bottom: 0;">
                    <label class="field-label">Discount %</label>
                    <input type="text" id="BulkDiscountPer" ng-model="BulkDiscountPer" placeholder="0.00" class="field-control allownumericwithdecimal" />
                </div>

                <div class="col-lg-2 col-md-3 col-sm-4 col-xs-6 field-group" style="margin-bottom: 0;">
                    <label class="field-label">&nbsp;</label>
                    <button type="button" class="btn-brand-secondary" ng-click="ApplyBulkDiscount()">
                        <i class="fa fa-check"></i> Apply To Column
                    </button>
                </div>
            </div>
        </div>

        <div class="rdl-grid-body" ng-show="IsGridLoaded">
            <div id="sgdGridContainer" style="width: 100%; height: 100%;"></div>
        </div>

        <div ng-if="!IsGridLoaded" style="flex: 1 1 auto; min-height: 0; display: flex; align-items: center; justify-content: center; color: #94a3b8; font-size: 13px;">
            <div><i class="fa fa-info-circle"></i>&nbsp; Please select ShapeType and Type to load the Pointer list.</div>
        </div>
    </div>
</div>

<script>
    var appModule;
    try {
        appModule = angular.module('app');
    } catch (e) {
        appModule = angular.module('app', ['ngAnimate', 'ngTouch', 'ui.grid', 'angularjs-dropdown-multiselect']);
    }

    appModule.directive('chosen', ['$timeout', function ($timeout) {
        return {
            restrict: 'A',
            link: function (scope, element, attrs) {
                var updateChosen = function () {
                    $timeout(function () {
                        element.trigger('chosen:updated');
                    }, 50);
                };

                var list = attrs['chosen'];
                if (list) {
                    scope.$watchCollection(list, function () {
                        updateChosen();
                    });
                }
                if (attrs['ngModel']) {
                    scope.$watch(attrs['ngModel'], function () {
                        updateChosen();
                    });
                }

                scope.$watch(function () {
                    return element.find('option').length;
                }, function (newVal, oldVal) {
                    if (newVal !== oldVal) {
                        updateChosen();
                    }
                });

                element.chosen({ width: '100%', search_contains: true, allow_single_deselect: true });
            }
        };
    }]);

    appModule.controller("SizeAndFnlShpGrpWisePriceDiscCtrl", ['$scope', '$http', function ($scope, $http) {

        $scope.ShapeTypeList = [];
        $scope.ShapeGroupList = [];
        $scope.TypeList = [
            { Value: 'CT DOWN', Label: 'NGR (Ct Down)' },
            { Value: 'CT UP', Label: 'GR (Ct Up)' }
        ];

        $scope.SelectedShapeType = '';
        $scope.SelectedType = '';
        $scope.GridData = [];
        $scope.IsGridLoaded = false;
        $scope.IsSaving = false;

        $scope.BulkShapeGroupID = '';
        $scope.BulkDiscountPer = '';

        // Load lookups
        $http.get('@Url.Action("Get_MST_Size_ShapeTypeList", "Master")').then(function (res) {
            if (res.data && res.data.success) {
                $scope.ShapeTypeList = res.data.list;
            }
        });

        $scope.OnShapeTypeChange = function () {
            $scope.BulkShapeGroupID = '';
            $scope.ShapeGroupList = [];
            $scope.GridData = [];
            $scope.IsGridLoaded = false;

            if (!$scope.SelectedShapeType) {
                return;
            }

            $http.get('@Url.Action("Get_Mst_ShapeFinalGroupList", "Master")', {
                params: { shapeType: $scope.SelectedShapeType }
            }).then(function (res) {
                if (res.data && res.data.success) {
                    $scope.ShapeGroupList = res.data.list;
                }
                $scope.OnFilterChange();
            });
        };

        $scope.OnFilterChange = function () {
            if ($scope.SelectedShapeType && $scope.SelectedType && $scope.ShapeGroupList.length > 0) {
                $scope.LoadGrid();
            }
        };

        $scope.LoadGrid = function () {
            $http.get('@Url.Action("Get_SizeAndFnlShpGrpWisePriceDisc_GridData", "Master")', {
                params: { shapeType: $scope.SelectedShapeType, type: $scope.SelectedType }
            }).then(function (res) {
                if (!res.data || !res.data.success) {
                    Noty("error", (res.data && res.data.message) || "Failed to load Pointer list.");
                    return;
                }

                var sizeList = res.data.sizeList || [];
                var discList = res.data.discList || [];

                if (sizeList.length === 0) {
                    $scope.GridData = [];
                    $scope.IsGridLoaded = false;
                    Noty("warning", "No Pointer found for the selected ShapeType / Type.");
                    return;
                }

                var gridData = [];
                for (var i = 0; i < sizeList.length; i++) {
                    var size = sizeList[i];
                    var row = {
                        SizeID: size.SizeID,
                        Pointer: Number(size.FromSize).toFixed(3) + ' - ' + Number(size.ToSize).toFixed(3)
                    };

                    for (var g = 0; g < $scope.ShapeGroupList.length; g++) {
                        var sg = $scope.ShapeGroupList[g];
                        var existing = null;
                        for (var d = 0; d < discList.length; d++) {
                            if (discList[d].MstSizeID === size.SizeID && discList[d].MStFinalShapGroupID === sg.ID) {
                                existing = discList[d].DiscountPer;
                                break;
                            }
                        }
                        row['SG_' + sg.ID] = existing;
                    }

                    gridData.push(row);
                }

                $scope.GridData = gridData;
                $scope.IsGridLoaded = true;
                $scope.InitGrid();
            }, function () {
                Noty("error", "Error loading Pointer list from server.");
            });
        };

        $scope.InitGrid = function () {
            var columns = [
                { dataField: 'Pointer', caption: 'Pointer', allowEditing: false, fixed: true, fixedPosition: 'left', width: 140 }
            ];

            for (var g = 0; g < $scope.ShapeGroupList.length; g++) {
                var sg = $scope.ShapeGroupList[g];
                columns.push({
                    dataField: 'SG_' + sg.ID,
                    caption: sg.ShapeGroup,
                    dataType: 'number',
                    format: { type: 'fixedPoint', precision: 2 },
                    editorOptions: { format: '#0.##' },
                    width: 110
                });
            }

            $("#sgdGridContainer").dxDataGrid({
                dataSource: $scope.GridData,
                keyExpr: 'SizeID',
                columns: columns,
                editing: { mode: 'cell', allowUpdating: true },
                columnAutoWidth: false,
                allowColumnResizing: true,
                columnFixing: { enabled: true },
                showBorders: true,
                showColumnLines: true,
                showRowLines: true,
                rowAlternationEnabled: true,
                filterRow: {
                    visible: false,
                    applyFilter: 'auto'
                },
                columnChooser: {
                        enabled: false,
                        mode: 'select'
                    },
                headerFilter: { visible: false },
                height: '100%',
                scrolling: { mode: 'standard' },
                paging: { enabled: false },
                pager: { visible: false }
            });
        };

        $scope.ApplyBulkDiscount = function () {
            if (!$scope.BulkShapeGroupID) {
                Noty("warning", "Please select a ShapeGroup first!");
                return;
            }

            var pct = parseFloat($scope.BulkDiscountPer);
            if ($scope.BulkDiscountPer === '' || $scope.BulkDiscountPer === null || isNaN(pct)) {
                Noty("warning", "Please enter a valid Discount %!");
                return;
            }

            var field = 'SG_' + $scope.BulkShapeGroupID;
            for (var i = 0; i < $scope.GridData.length; i++) {
                $scope.GridData[i][field] = pct;
            }

            var gridInst = $("#sgdGridContainer").dxDataGrid('instance');
            if (gridInst) {
                gridInst.refresh();
            }

            Noty("success", "Discount applied to the selected ShapeGroup column.");
        };

        $scope.SaveData = function () {
            if (!$scope.IsGridLoaded || $scope.GridData.length === 0) {
                Noty("warning", "Please load the Pointer list first!");
                return;
            }

            var list = [];
            for (var i = 0; i < $scope.GridData.length; i++) {
                var row = $scope.GridData[i];
                for (var g = 0; g < $scope.ShapeGroupList.length; g++) {
                    var sg = $scope.ShapeGroupList[g];
                    var val = row['SG_' + sg.ID];
                    if (val !== null && val !== undefined && val !== '') {
                        list.push({
                            MstSizeID: row.SizeID,
                            MStFinalShapGroupID: sg.ID,
                            FinalShapGroup: sg.ShapeGroup,
                            DiscountPer: parseFloat(val)
                        });
                    }
                }
            }

            if (list.length === 0) {
                Noty("warning", "Please enter at least one Discount % before saving!");
                return;
            }

            $scope.IsSaving = true;
            $http.post('@Url.Action("Save_SizeAndFnlShpGrpWisePriceDisc", "Master")', { list: list }).then(function (res) {
                $scope.IsSaving = false;
                if (res.data && res.data.success) {
                    Noty("success", res.data.message || "Saved successfully!");
                    $scope.LoadGrid();
                } else {
                    Noty("error", (res.data && res.data.message) || "Failed to save.");
                }
            }, function () {
                $scope.IsSaving = false;
                Noty("error", "Error saving to server.");
            });
        };
    }]);
</script>
