@{
    ViewBag.Title = "Lot Entry";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<div ng-controller="LotEntryCtrl" class="rough-dist-page">
    <!-- ============================== CREATE MODE ============================== -->
    <div ng-show="!FormModel.LotID">
        <!-- Select Inward Detail Balance -->
        <div class="rd-card rd-card-specs">
            <div class="rd-card-header">
                <h5 class="rd-card-title">
                    <i class="fa fa-cube text-primary"></i> 1. Select Inward Grade Balance
                </h5>
            </div>
            <div class="rd-card-body">
                <div class="row">
                    <div class="col-lg-6 col-md-7 col-sm-8 col-xs-12 rd-form-group">
                        <label class="rd-label" for="SelectedInwardDetailID">
                            Inward Lot<span class="req">*</span>
                        </label>
                        <div class="field-select-wrap">
                            <select id="SelectedInwardDetailID"
                                    chosen="SourceList"
                                    ng-model="SelectedInwardDetailID"
                                    ng-change="OnSourceChange()"
                                    ng-disabled="StagedSplits.length > 0"
                                    class="form-control rd-input">
                                <option value="">-- Select Inward Grade Balance --</option>
                                <option ng-repeat="item in SourceList" value="{{item.InwardDetailID}}">
                                    {{GetSourceLabel(item)}}
                                </option>
                            </select>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-3 col-sm-4 col-xs-12 rd-form-group rd-save-row-action">
                        <label class="rd-label rd-action-label">&nbsp;</label>
                        <button class="btn-rd-save-main" type="button" ng-disabled="IsSaving || StagedSplits.length === 0" ng-click="SaveAllSplits()">
                            <i class="fa fa-save" ng-class="{'fa-spin': IsSaving}"></i> Save All Splits
                            <span ng-if="StagedSplits.length > 0">({{StagedSplits.length}})</span>
                        </button>
                    </div>
                    <div class="clearfix"></div>
                </div>
                <div class="row" ng-show="Source.InwardDetailID">
                    <div class="col-xs-12">
                        <div class="rd-mini-stats">
                            Org <strong>{{Source.Pcs || 0 | number:0}}</strong> Pcs / <strong>{{Source.Carat || 0 | number:3}}</strong> Cts
                            &middot; Pending <strong>{{Source.PendingPcs || 0 | number:0}}</strong> Pcs / <strong>{{Source.PendingWeight || 0 | number:3}}</strong> Cts
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Add Split Entry -->
        <div class="rd-card rd-card-entry" ng-show="Source.InwardDetailID">
            <div class="rd-card-header">
                <h5 class="rd-card-title"><i class="fa fa-plus-circle text-primary"></i> 2. Add Split</h5>
                <span class="text-muted" style="font-size: 11.5px;">
                    Factory Code <strong>{{Source.FactoryCode || '-'}}</strong> &middot;
                    Color <strong>{{Source.ColorType || '-'}}</strong> &middot;
                    Size <strong>{{Source.SizeCodeType || '-'}}</strong>
                    &middot; Remaining To Split <strong>{{AdjustPcs | number:0}} Pcs / {{AdjustWeight | number:3}} Cts</strong>
                </span>
            </div>
            <div class="rd-card-body">
                <div class="row">
                    <div class="col-lg-1 col-md-2 col-sm-6 col-xs-6 rd-form-group">
                        <label class="rd-label" for="NewSplitPcs">
                            Pcs <span class="req">*</span>
                            <a href="javascript:void(0)" ng-if="AdjustPcs > 0" ng-click="NewSplit.Lot_Pcs = AdjustPcs" class="pull-right" style="font-weight:normal; font-size:11px; background-color:#d9f7be; padding:1px 5px; border-radius:3px;">All ({{AdjustPcs | number:0}})</a>
                        </label>
                        <input type="text" id="NewSplitPcs" ng-model="NewSplit.Lot_Pcs" placeholder="0" class="rd-input allownumericwithoutdecimal" />
                    </div>
                    <div class="col-lg-2 col-md-3 col-sm-6 col-xs-6 rd-form-group">
                        <label class="rd-label" for="NewSplitCarat">
                            Carat <span class="req">*</span>
                            <a href="javascript:void(0)" ng-if="AdjustWeight > 0" ng-click="NewSplit.Lot_Carat = AdjustWeight" class="pull-right" style="font-weight:normal; font-size:11px; background-color:#d9f7be; padding:1px 5px; border-radius:3px;">All ({{AdjustWeight | number:3}})</a>
                        </label>
                        <input type="text" id="NewSplitCarat" ng-model="NewSplit.Lot_Carat" placeholder="0.000" class="rd-input allownumericwithdecimal" />
                    </div>

                    <div class="col-lg-1 col-md-2 col-sm-6 col-xs-6 rd-form-group">
                        <label class="rd-label" for="NewSplitGradeID">Grade</label>
                        <div class="field-select-wrap">
                            <select id="NewSplitGradeID" chosen="GradeList" ng-model="NewSplit.GradeID" ng-change="OnNewSplitGradeChange()" ng-disabled="!IsSourceGradeMix()" class="form-control rd-input">
                                <option value="">-- Select --</option>
                                <option ng-repeat="item in GradeList" value="{{item.GradeID}}">{{item.Grade}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-lg-1 col-md-2 col-sm-6 col-xs-6 rd-form-group">
                        <label class="rd-label" for="NewSplitRoughRate">Rough Rate</label>
                        <input type="text" id="NewSplitRoughRate" ng-model="NewSplit.RoughRate" placeholder="0.00" ng-disabled="!IsSourceGradeMix()" class="rd-input allownumericwithdecimal" />
                    </div>
                    <div class="col-lg-2 col-md-3 col-sm-6 col-xs-6 rd-form-group">
                        <label class="rd-label" for="NewSplitReceipe">Receipe <span class="req">*</span></label>
                        <div class="field-select-wrap">
                            <select id="NewSplitReceipe" chosen="ReceipeList" ng-model="NewSplit.Receipe" ng-disabled="true" class="form-control rd-input">
                                <option value="">-- Select --</option>
                                <option ng-repeat="item in ReceipeList" value="{{item.Receipe}}">{{item.Receipe}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-lg-1 col-md-2 col-sm-6 col-xs-6 rd-form-group">
                        <label class="rd-label" for="NewSplitRejPcs">Rej. Pcs</label>
                        <input type="text" id="NewSplitRejPcs" ng-model="NewSplit.RejPcs" placeholder="0" ng-disabled="true" class="rd-input allownumericwithoutdecimal" />
                    </div>
                    <div class="col-lg-1 col-md-2 col-sm-6 col-xs-6 rd-form-group">
                        <label class="rd-label" for="NewSplitRejCarat">Rej. Carat</label>
                        <input type="text" id="NewSplitRejCarat" ng-model="NewSplit.RejCarat" placeholder="0.000" ng-disabled="true" class="rd-input allownumericwithdecimal" />
                    </div>
                    <div class="col-lg-1 col-md-2 col-sm-6 col-xs-6 rd-form-group">
                        <label class="rd-label" for="NewSplitSize">Size</label>
                        <input type="text" id="NewSplitSize" ng-model="NewSplit.Size" placeholder="Size" ng-disabled="true" class="rd-input" />
                    </div>
                    <div class="col-lg-1 col-md-2 col-sm-6 col-xs-6 rd-form-group">
                        <label class="rd-label" for="NewSplitGrowthRate">Growth Rate <span class="req">*</span></label>
                        <input type="text" id="NewSplitGrowthRate" ng-model="NewSplit.GrowthRate" placeholder="Growth Rate" ng-disabled="true" class="rd-input" />
                    </div>
                    <div class="clearfix"></div>
                </div>
                <div class="row">
                    <div class="col-lg-1 col-md-2 col-sm-6 col-xs-6 rd-form-group">
                        <label class="rd-label" for="NewSplitHeight">From Height</label>
                        <input type="text" id="NewSplitHeight" ng-model="NewSplit.Height" placeholder="0.000" class="rd-input allownumericwithdecimal" />
                    </div>
                    <div class="col-lg-1 col-md-2 col-sm-6 col-xs-6 rd-form-group">
                        <label class="rd-label" for="NewSplitNewHeight">To Height</label>
                        <input type="text" id="NewSplitNewHeight" ng-model="NewSplit.NewHeight" placeholder="0.000" class="rd-input allownumericwithdecimal" />
                    </div>
                    <div class="col-lg-1 col-md-2 col-sm-6 col-xs-6 rd-form-group">
                        <label class="rd-label" for="NewSplitBranchID">Branch</span></label>
                        <div class="field-select-wrap">
                            <select id="NewSplitBranchID" chosen="BranchList" ng-model="NewSplit.BranchID" ng-change="OnNewSplitBranchChange()" class="form-control rd-input">
                                <option value="">Select</option>
                                <option ng-repeat="item in BranchList" value="{{item.id}}">{{item.value}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-lg-1 col-md-2 col-sm-6 col-xs-6 rd-form-group">
                        <label class="rd-label" for="NewSplitDepartmentID">Department</label>
                        <div class="field-select-wrap">
                            <select id="NewSplitDepartmentID" chosen="NewSplitDepartmentList" ng-model="NewSplit.DepartmentID" ng-disabled="!NewSplit.BranchID" class="form-control rd-input">
                                <option value="">Select</option>
                                <option ng-repeat="item in NewSplitDepartmentList" value="{{item.ID}}">{{item.ShortName}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-lg-2 col-md-3 col-sm-6 col-xs-6 rd-form-group">
                        <label class="rd-label" for="NewSplitHeadManagerID">Head Manager</label>
                        <div class="field-select-wrap">
                            <select id="NewSplitHeadManagerID" chosen="HeadManagerList" ng-model="NewSplit.HeadManagerID" class="form-control rd-input">
                                <option value="">-- Select --</option>
                                <option ng-repeat="item in HeadManagerList" value="{{item.EmployeeID}}">{{item.EmployeeName}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-lg-2 col-md-3 col-sm-6 col-xs-6 rd-form-group">
                        <label class="rd-label" for="NewSplitLotPriority">Priority <span class="req">*</span></label>
                        <div class="field-select-wrap">
                            <select id="NewSplitLotPriority" chosen="PriorityList" class="form-control rd-input" ng-model="NewSplit.LotPriority">
                                <option value="">-- Select --</option>
                                <option ng-repeat="item in PriorityList" value="{{item.PriorityName}}">{{item.PriorityName}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="clearfix"></div>
                </div>
                <div class="row">

                    
                    <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 rd-form-group">
                        <label class="rd-label" for="NewSplitRemarks">Remarks</label>
                        <input type="text" id="NewSplitRemarks" ng-model="NewSplit.Remarks" placeholder="Remarks" class="rd-input" />
                    </div>
                    <div class="col-lg-2 col-md-3 col-sm-4 col-xs-6 rd-form-group">
                        <label class="rd-label">Status</label>
                        <div class="active-toggle-wrap">
                            <input type="checkbox" id="NewSplitIsActive" ng-model="NewSplit.IsActive" />
                            <label for="NewSplitIsActive" class="status-toggle-label">
                                <span ng-if="NewSplit.IsActive" class="text-success"><i class="fa fa-check-circle"></i> Active</span>
                                <span ng-if="!NewSplit.IsActive" class="text-danger"><i class="fa fa-times-circle"></i> Inactive</span>
                            </label>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-3 col-sm-8 col-xs-12 rd-form-group">
                        <label class="rd-label rd-action-label">&nbsp;</label>
                        <div class="rd-btn-action-row">
                            <button class="btn-rd-add" type="button" ng-click="AddSplitRow()">
                                <i class="fa fa-plus"></i> Add Split
                            </button>
                            <button class="btn-rd-clear" type="button" ng-click="ResetNewSplitForm()" title="Clear form fields">
                                <i class="fa fa-eraser"></i> Clear
                            </button>
                        </div>
                    </div>
                    <div class="clearfix"></div>
                </div>
                
            </div>
        </div>

        <!-- Staged Splits -->
        <div class="rd-card rd-card-entry" ng-show="StagedSplits.length > 0">
            <div class="rd-card-header">
                <h5 class="rd-card-title"><i class="fa fa-table text-primary"></i> 3. Staged Splits ({{StagedSplits.length}})</h5>
            </div>
            <div class="rd-card-body">
                <div class="uigrid3">
                    <div id="stagedSplitsGridContainer" style="width: 100%;"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- ============================== EDIT MODE ============================== -->
    <div ng-show="FormModel.LotID > 0">
        <div class="rd-card rd-card-specs">
            <div class="rd-card-header">
                <h5 class="rd-card-title"><i class="fa fa-info-circle text-primary"></i> Source (read-only)</h5>
            </div>
            <div class="rd-card-body">
                <div class="row">
                    <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 rd-form-group">
                        <label class="rd-label" for="FormBranchID">Branch <span class="text-muted">(assign/change anytime)</span></label>
                        <div class="field-select-wrap">
                            <select id="FormBranchID" chosen="BranchList" ng-model="FormModel.BranchID" ng-change="OnFormBranchChange()" class="form-control rd-input">
                                <option value="">-- Not Assigned --</option>
                                <option ng-repeat="item in BranchList" value="{{item.id}}">{{item.value}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-lg-2 col-md-3 col-sm-6 col-xs-6 rd-form-group">
                        <label class="rd-label">R.Code / Lot Code</label>
                        <input type="text" ng-model="FormModel.LotCode" class="rd-input rd-master-input" readonly />
                    </div>
                    <div class="col-lg-3 col-md-3 col-sm-4 col-xs-12 rd-form-group rd-save-row-action">
                        <label class="rd-label rd-action-label">&nbsp;</label>
                        <button class="btn-rd-save-main" type="button" ng-disabled="IsSaving" ng-click="SaveLot()">
                            <i class="fa fa-save" ng-class="{'fa-spin': IsSaving}"></i> Update Lot
                        </button>
                    </div>
                    <div class="clearfix"></div>
                </div>
                <div class="row">
                    <div class="col-xs-12">
                        <div class="rd-mini-stats">
                            Org <strong>{{Selected.RoughPcs || 0 | number:0}}</strong> Pcs / <strong>{{Selected.RoughWeight || 0 | number:3}}</strong> Cts
                            &middot; Avail <strong>{{Selected.PendingPcs || 0 | number:0}}</strong> Pcs / <strong>{{Selected.PendingWeight || 0 | number:3}}</strong> Cts
                        </div>
                    </div>
                </div>
                <div class="row" ng-show="BranchSplitSummary.length > 0">
                    <div class="col-xs-12">
                        <label class="rd-label">Branch Split (% of this source's already-split total)</label>
                        <div>
                            <span ng-repeat="b in BranchSplitSummary" class="rd-branch-split-pill" ng-class="{'rd-branch-split-pill-active': b.BranchID == FormModel.BranchID}">
                                {{b.BranchName}}: {{b.CaratPercent}}% Cts
                                <span class="rd-branch-split-pill-sub">({{b.Pcs | number:0}} / {{b.Carat | number:3}})</span>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Lot Details -->
        <div class="rd-card rd-card-entry">
            <div class="rd-card-header">
                <h5 class="rd-card-title"><i class="fa fa-info-circle text-primary"></i> Lot Details</h5>
                <span class="text-muted" style="font-size: 11.5px;">
                    Factory Code <strong>{{FormModel.FactoryCode || '-'}}</strong> &middot;
                    Color <strong>{{FormModel.ColorType || '-'}}</strong> &middot;
                    Size Code <strong>{{FormModel.SizeCodeType || '-'}}</strong>
                </span>
            </div>
            <div class="rd-card-body">
                <div class="row">
                    <div class="col-lg-1 col-md-2 col-sm-6 col-xs-6 rd-form-group">
                        <label class="rd-label" for="FormLotPcs">Pcs <span class="req">*</span></label>
                        <input type="text" id="FormLotPcs" ng-model="FormModel.Lot_Pcs" placeholder="0" ng-disabled="true" class="rd-input allownumericwithoutdecimal" />
                    </div>
                    <div class="col-lg-2 col-md-3 col-sm-6 col-xs-6 rd-form-group">
                        <label class="rd-label" for="FormLotCarat">Carat <span class="req">*</span></label>
                        <input type="text" id="FormLotCarat" ng-model="FormModel.Lot_Carat" placeholder="0.000" ng-disabled="true" class="rd-input allownumericwithdecimal" />
                    </div>
                    <div class="col-lg-1 col-md-2 col-sm-6 col-xs-6 rd-form-group">
                        <label class="rd-label" for="FormGradeID">Grade</label>
                        <div class="field-select-wrap">
                            <select id="FormGradeID" chosen="GradeList" ng-model="FormModel.GradeID" ng-change="OnGradeChange()" ng-disabled="!IsSourceGradeMix()" class="form-control rd-input">
                                <option value="">-- Select --</option>
                                <option ng-repeat="item in GradeList" value="{{item.GradeID}}">{{item.Grade}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-lg-1 col-md-2 col-sm-6 col-xs-6 rd-form-group">
                        <label class="rd-label" for="FormRoughRate">Rough Rate</label>
                        <input type="text" id="FormRoughRate" ng-model="FormModel.RoughRate" placeholder="0.00" ng-disabled="!IsSourceGradeMix()" class="rd-input allownumericwithdecimal" />
                    </div>
                    <div class="col-lg-2 col-md-3 col-sm-6 col-xs-6 rd-form-group">
                        <label class="rd-label" for="FormReceipe">Receipe <span class="req">*</span></label>
                        <div class="field-select-wrap">
                            <select id="FormReceipe" chosen="ReceipeList" ng-model="FormModel.Receipe" ng-disabled="true" class="form-control rd-input">
                                <option value="">-- Select --</option>
                                <option ng-repeat="item in ReceipeList" value="{{item.Receipe}}">{{item.Receipe}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-lg-1 col-md-2 col-sm-6 col-xs-6 rd-form-group">
                        <label class="rd-label" for="FormRejPcs">Rej. Pcs</label>
                        <input type="text" id="FormRejPcs" ng-model="FormModel.RejPcs" placeholder="0" ng-disabled="true" class="rd-input allownumericwithoutdecimal" />
                    </div>
                    <div class="col-lg-1 col-md-2 col-sm-6 col-xs-6 rd-form-group">
                        <label class="rd-label" for="FormRejCarat">Rej. Carat</label>
                        <input type="text" id="FormRejCarat" ng-model="FormModel.RejCarat" placeholder="0.000" ng-disabled="true" class="rd-input allownumericwithdecimal" />
                    </div>
                    <div class="col-lg-1 col-md-2 col-sm-6 col-xs-6 rd-form-group">
                        <label class="rd-label" for="FormSize">Size</label>
                        <input type="text" id="FormSize" ng-model="FormModel.Size" placeholder="Size" ng-disabled="true" class="rd-input" />
                    </div>
                    <div class="col-lg-1 col-md-2 col-sm-6 col-xs-6 rd-form-group">
                        <label class="rd-label" for="FormGrowthRate">Growth Rate <span class="req">*</span></label>
                        <input type="text" id="FormGrowthRate" ng-model="FormModel.GrowthRate" placeholder="Growth Rate" ng-disabled="true" class="rd-input" />
                    </div>
                    <div class="clearfix"></div>
                </div>
                <div class="row">
                    <div class="col-lg-1 col-md-2 col-sm-6 col-xs-6 rd-form-group">
                        <label class="rd-label" for="FormHeight">From Height</label>
                        <input type="text" id="FormHeight" ng-model="FormModel.Height" placeholder="0.000" ng-disabled="true" class="rd-input allownumericwithdecimal" />
                    </div>
                    <div class="col-lg-1 col-md-2 col-sm-6 col-xs-6 rd-form-group">
                        <label class="rd-label" for="FormNewHeight">To Height</label>
                        <input type="text" id="FormNewHeight" ng-model="FormModel.NewHeight" placeholder="0.000" ng-disabled="true" class="rd-input allownumericwithdecimal" />
                    </div>
                    <div class="col-lg-2 col-md-3 col-sm-6 col-xs-6 rd-form-group">
                        <label class="rd-label" for="FormDepartmentID">Department</label>
                        <div class="field-select-wrap">
                            <select id="FormDepartmentID" chosen="DepartmentList" ng-model="FormModel.DepartmentID" class="form-control rd-input">
                                <option value="">-- Select --</option>
                                <option ng-repeat="item in DepartmentList" value="{{item.ID}}">{{item.ShortName}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-lg-2 col-md-3 col-sm-6 col-xs-6 rd-form-group">
                        <label class="rd-label" for="FormHeadManagerID">Head Manager</label>
                        <div class="field-select-wrap">
                            <select id="FormHeadManagerID" chosen="HeadManagerList" ng-model="FormModel.HeadManagerID" class="form-control rd-input">
                                <option value="">-- Select --</option>
                                <option ng-repeat="item in HeadManagerList" value="{{item.EmployeeID}}">{{item.EmployeeName}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-lg-2 col-md-3 col-sm-6 col-xs-6 rd-form-group">
                        <label class="rd-label" for="FormLotPriority">Priority <span class="req">*</span></label>
                        <div class="field-select-wrap">
                            <select id="FormLotPriority" chosen="PriorityList" class="form-control rd-input" ng-model="FormModel.LotPriority">
                                <option value="">-- Select --</option>
                                <option ng-repeat="item in PriorityList" value="{{item.PriorityName}}">{{item.PriorityName}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="clearfix"></div>
                </div>
                <div class="row">
                    <div class="col-lg-3 col-md-4 col-sm-6 col-xs-12 rd-form-group">
                        <label class="rd-label" for="FormRemarks">Remarks</label>
                        <input type="text" id="FormRemarks" ng-model="FormModel.Remarks" placeholder="Remarks" class="rd-input" />
                    </div>
                    <div class="col-lg-2 col-md-3 col-sm-4 col-xs-6 rd-form-group">
                        <label class="rd-label">Status</label>
                        <div class="active-toggle-wrap">
                            <input type="checkbox" id="FormIsActive" ng-model="FormModel.IsActive" />
                            <label for="FormIsActive" class="status-toggle-label">
                                <span ng-if="FormModel.IsActive" class="text-success"><i class="fa fa-check-circle"></i> Active</span>
                                <span ng-if="!FormModel.IsActive" class="text-danger"><i class="fa fa-times-circle"></i> Inactive</span>
                            </label>
                        </div>
                    </div>
                    <div class="clearfix"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    var appModule;
    try {
        appModule = angular.module('app');
    } catch (e) {
        appModule = angular.module('app', ['ngAnimate', 'ngTouch', 'angularjs-dropdown-multiselect']);
    }

    appModule.directive('chosen', ['$timeout', function ($timeout) {
        return {
            restrict: 'A',
            link: function (scope, element, attrs) {
                var updateChosen = function () {
                    $timeout(function () { element.trigger('chosen:updated'); }, 50);
                };
                var list = attrs['chosen'];
                if (list) { scope.$watchCollection(list, function () { updateChosen(); }); }
                if (attrs['ngModel']) { scope.$watch(attrs['ngModel'], function () { updateChosen(); }); }
                if (attrs['ngDisabled']) {
                    scope.$watch(attrs['ngDisabled'], function (newVal) {
                        $timeout(function () { element.prop('disabled', !!newVal).trigger('chosen:updated'); }, 50);
                    });
                }
                element.chosen({ width: '100%', search_contains: true, allow_single_deselect: true });
            }
        };
    }]);

    appModule.controller("LotEntryCtrl", ['$scope', '$http', '$timeout', '$q', function ($scope, $http, $timeout, $q) {
        $scope.InitLotID = parseInt('@ViewBag.LotID') || 0;

        $scope.BranchList = [];
        $scope.SourceList = [];
        $scope.ReceipeList = [];
        $scope.GradeList = [];
        $scope.DepartmentList = [];
        $scope.NewSplitDepartmentList = [];
        $scope.HeadManagerList = [];
        $scope.PriorityList = [];
        $scope.SelectedInwardDetailID = '';
        $scope.Source = {};
        $scope.StagedSplits = [];
        $scope.AdjustPcs = 0;
        $scope.AdjustWeight = 0;
        $scope.IsSaving = false;
        $scope.IsLoading = false;
        $scope.Selected = {};

        $scope.FormModel = {
            LotID: 0,
            RCode: '',
            LotCode: '',
            FactoryCodeID: null,
            FactoryCode: '',
            ColorType: '',
            SizeCodeID: null,
            SizeCodeType: '',
            BranchID: null,
            Lot_Pcs: null,
            Lot_Carat: null,
            RoughRate: null,
            Receipe: '',
            Height: null,
            NewHeight: null,
            Size: '',
            RejPcs: null,
            RejCarat: null,
            LotPriority: '',
            GrowthRate: '',
            DepartmentID: '',
            HeadManagerID: '',
            Remarks: '',
            IsActive: true
        };

        $scope.NewSplitDefaults = function () {
            return {
                BranchID: '',
                DepartmentID: '',
                HeadManagerID: '',
                GradeID: null,
                Grade: '',
                Lot_Pcs: null,
                Lot_Carat: null,
                RoughRate: null,
                Receipe: '',
                Height: null,
                NewHeight: null,
                Size: '',
                RejPcs: null,
                RejCarat: null,
                LotPriority: '',
                GrowthRate: '',
                Remarks: '',
                IsActive: true
            };
        };
        $scope.NewSplit = $scope.NewSplitDefaults();

        $('.allownumericwithoutdecimal').on('keypress', function (e) {
            if (e.which !== 8 && e.which !== 0 && (e.which < 48 || e.which > 57)) return false;
        });
        $('.allownumericwithdecimal').on('keypress', function (e) {
            if (e.which !== 8 && e.which !== 0 && (e.which !== 46 || $(this).val().indexOf('.') !== -1) && (e.which < 48 || e.which > 57)) return false;
        });

        // Enter-to-advance keyboard navigation is wired up globally for
        // every input.rd-input/select.rd-input field - see
        // ~/Content/js/enter-key-nav.js (included in _MainLayout.cshtml).

        $scope.LoadBranches = function () {
            return $http.post('@Url.Action("GetBranchdata_For_DropDown", "Master")').then(function (res) {
                var bList = [];
                if (res.data && res.data.BranchList && res.data.BranchList.length > 0) {
                    for (var i = 0; i < res.data.BranchList.length; i++) {
                        var bId = res.data.BranchList[i]["ID"];
                        var bVal = res.data.BranchList[i]["Name"];
                        if (bId !== undefined && bId !== null) {
                            bList.push({ id: parseInt(bId), value: bVal });
                        }
                    }
                }
                $scope.BranchList = bList;
                $timeout(function () { $('#NewSplitBranchID').trigger('chosen:updated'); }, 100);
            });
        };

        $scope.LoadSources = function () {
            return $http.get('@Url.Action("Get_TRN_RoughInwardDetailListForLotSplit", "Master")').then(function (res) {
                if (res.data && res.data.success) {
                    $scope.SourceList = res.data.list || [];
                    $timeout(function () { $('#SelectedInwardDetailID').trigger('chosen:updated'); }, 100);
                }
            });
        };

        $scope.LoadRecipes = function () {
            return $http.get('@Url.Action("Get_MST_ReceipeList", "Master")').then(function (res) {
                if (res.data && res.data.success) {
                    $scope.ReceipeList = res.data.list || [];
                    $timeout(function () { $('#FormReceipe, #NewSplitReceipe').trigger('chosen:updated'); }, 100);
                }
            });
        };

        $scope.LoadGrades = function () {
            return $http.get('@Url.Action("Get_MST_GradeList", "Master")').then(function (res) {
                if (res.data && res.data.success) {
                    $scope.GradeList = res.data.list || [];
                    $timeout(function () { $('#FormGradeID, #NewSplitGradeID').trigger('chosen:updated'); }, 100);
                }
            });
        };

        $scope.LoadDepartments = function (branchId) {
            if (!branchId) {
                $scope.DepartmentList = [];
                $timeout(function () { $('#FormDepartmentID').trigger('chosen:updated'); }, 100);
                return $q.when();
            }
            return $http.get('@Url.Action("Get_MST_DepartmentList", "Master")?BranchID=' + branchId).then(function (res) {
                if (res.data && res.data.success) {
                    $scope.DepartmentList = res.data.list || [];
                    $timeout(function () { $('#FormDepartmentID').trigger('chosen:updated'); }, 100);
                }
            });
        };

        $scope.LoadHeadManagers = function () {
            return $http.get('@Url.Action("Get_MST_HeadManagerList", "Master")').then(function (res) {
                if (res.data && res.data.success) {
                    $scope.HeadManagerList = res.data.list || [];
                    $timeout(function () { $('#FormHeadManagerID, #NewSplitHeadManagerID').trigger('chosen:updated'); }, 100);
                }
            });
        };

        $scope.LoadPriorities = function () {
            return $http.get('@Url.Action("Get_MST_PriorityDropdownList", "Master")').then(function (res) {
                if (res.data && res.data.success) {
                    $scope.PriorityList = res.data.list || [];
                    var defaultItem = $scope.PriorityList.find(function (x) { return x.IsDefault; });
                    var defaultName = defaultItem ? defaultItem.PriorityName : ($scope.PriorityList[0] ? $scope.PriorityList[0].PriorityName : '');
                    if (!$scope.FormModel.LotPriority) { $scope.FormModel.LotPriority = defaultName; }
                    if (!$scope.NewSplit.LotPriority) { $scope.NewSplit.LotPriority = defaultName; }
                    $timeout(function () { $('#FormLotPriority, #NewSplitLotPriority').trigger('chosen:updated'); }, 100);
                }
            });
        };

        $scope.GetSourceLabel = function (item) {
            if (!item) return '';
            return (item.LotNo || '-') + ' / Grade ' + (item.Grade || '-') + ' / ' + (item.Receipe || '-') + ' / ' + (item.ColorType || '-') + ' / ' + (item.FactoryCode || '-')
                + ' - Pending ' + (item.PendingPcs || 0) + ' Pcs / ' + (item.PendingWeight || 0) + ' Cts';
        };

        $scope.RecalculateAdjust = function () {
            var usedPcs = 0, usedWt = 0;
            for (var i = 0; i < $scope.StagedSplits.length; i++) {
                usedPcs += parseFloat($scope.StagedSplits[i].Lot_Pcs || 0);
                usedWt += parseFloat($scope.StagedSplits[i].Lot_Carat || 0);
            }
            $scope.AdjustPcs = parseFloat($scope.Source.PendingPcs || 0) - usedPcs;
            $scope.AdjustWeight = parseFloat(($scope.Source.PendingWeight || 0) - usedWt).toFixed(3) * 1;
        };

        $scope.ApplySourceAutoFetch = function () {
            var src = $scope.Source || {};
            $scope.NewSplit.GradeID = src.GradeID || null;
            $scope.NewSplit.Grade = src.Grade || '';
            $scope.NewSplit.Receipe = src.Receipe || '';
            $scope.NewSplit.Height = src.FromHeight;
            $scope.NewSplit.NewHeight = src.ToHeight;
            $scope.NewSplit.GrowthRate = src.GrowthRate || '';
            $scope.NewSplit.Size = src.DimensionName || '';
            $scope.NewSplit.RoughRate = (src.Rate !== undefined && src.Rate !== null) ? src.Rate : null;

            // The chosen-wrapped <select>s don't reliably re-render their
            // displayed text off a pure Angular ng-model change (same reason
            // LoadForEdit's SyncChosenValue has to force #FormGradeID
            // directly) - set the underlying native <select>'s value
            // explicitly, then redraw from it.
            $timeout(function () {
                $('#NewSplitGradeID').val($scope.NewSplit.GradeID != null ? $scope.NewSplit.GradeID.toString() : '').trigger('chosen:updated');
                $('#NewSplitReceipe').val($scope.NewSplit.Receipe || '').trigger('chosen:updated');
            }, 50);
        };

        // Grade/Rough Rate are locked to the source RoughDetails' own values
        // everywhere EXCEPT a 'Mix' Kapan, which has no single real grade -
        // the split clerk has to pick the actual grade (and its rate) per
        // split/per edit in that case. Works for both Create mode (Source =
        // the raw Kapan row) and Edit mode (Selected.SourceGrade, fetched
        // separately since FormModel.Grade is the Lot's own copy and can
        // diverge from the Kapan's once Mix makes it editable).
        $scope.IsSourceGradeMix = function () {
            var grade = ($scope.FormModel.LotID > 0)
                ? ($scope.Selected.SourceGrade || '')
                : (($scope.Source || {}).Grade || '');
            return grade.trim().toUpperCase() === 'MIX';
        };

        $scope.OnSourceChange = function () {
            var match = ($scope.SourceList || []).find(function (x) { return parseInt(x.InwardDetailID) === parseInt($scope.SelectedInwardDetailID); });
            $scope.Source = match || {};
            $scope.StagedSplits = [];
            $scope.NewSplit = $scope.NewSplitDefaults();
            if (match) {
                $scope.ApplySourceAutoFetch();
            }
            $scope.RecalculateAdjust();
            $scope.InitStagedGrid();
            $timeout(function () {
                $('#NewSplitGradeID, #NewSplitReceipe').trigger('chosen:updated');
            }, 100);
        };

        $scope.OnNewSplitBranchChange = function () {
            $scope.NewSplit.DepartmentID = '';
            if (!$scope.NewSplit.BranchID) {
                $scope.NewSplitDepartmentList = [];
                return;
            }
            $http.get('@Url.Action("Get_MST_DepartmentList", "Master")?BranchID=' + $scope.NewSplit.BranchID).then(function (res) {
                $scope.NewSplitDepartmentList = (res.data && res.data.success) ? (res.data.list || []) : [];
                $timeout(function () { $('#NewSplitDepartmentID').trigger('chosen:updated'); }, 100);
            });
        };

        $scope.OnNewSplitGradeChange = function () {
            var match = ($scope.GradeList || []).find(function (x) { return parseInt(x.GradeID) === parseInt($scope.NewSplit.GradeID); });
            $scope.NewSplit.Grade = match ? match.Grade : '';
        };

        $scope.OnGradeChange = function () {
            var match = ($scope.GradeList || []).find(function (x) { return parseInt(x.GradeID) === parseInt($scope.FormModel.GradeID); });
            $scope.FormModel.Grade = match ? match.Grade : '';
        };

        $scope.OnFormBranchChange = function () {
            $scope.FormModel.DepartmentID = '';
            var branchMatch = ($scope.BranchList || []).find(function (x) { return parseInt(x.id) === parseInt($scope.FormModel.BranchID); });
            $scope.Selected.BranchName = branchMatch ? branchMatch.value : '';
            $scope.LoadDepartments($scope.FormModel.BranchID);
        };

        $scope.ResetNewSplitForm = function () {
            var priorityKeep = $scope.NewSplit.LotPriority;
            $scope.NewSplit = $scope.NewSplitDefaults();
            $scope.NewSplit.LotPriority = priorityKeep;
            $scope.NewSplitDepartmentList = [];
            // Re-apply the source's auto-fetched values (Grade, Receipe, etc.) -
            // clearing them to blank on every "Add Split" would force the user
            // to re-pick/re-type them for every single split line.
            $scope.ApplySourceAutoFetch();
            $timeout(function () {
                $('#NewSplitGradeID, #NewSplitReceipe').trigger('chosen:updated');
            }, 100);
        };

        $scope.ValidateNewSplit = function () {
            var pcs = parseInt($scope.NewSplit.Lot_Pcs);
            var carat = parseFloat($scope.NewSplit.Lot_Carat);
            if (isNaN(pcs) || pcs <= 0 || isNaN(carat) || carat <= 0) {
                Noty("error", "Please enter valid Pcs and Carat (greater than zero)!");
                return false;
            }
            if (pcs > $scope.AdjustPcs) {
                Noty("error", "Pcs (" + pcs + ") exceeds the remaining balance (" + $scope.AdjustPcs + ")!");
                return false;
            }
            if (carat > $scope.AdjustWeight + 0.0001) {
                Noty("error", "Carat (" + carat.toFixed(3) + ") exceeds the remaining balance (" + $scope.AdjustWeight.toFixed(3) + ")!");
                return false;
            }
            if (!($scope.NewSplit.Receipe || '').trim()) { Noty("error", "Please select Receipe!"); return false; }
            if (!($scope.NewSplit.LotPriority || '').trim()) { Noty("error", "Please select Priority!"); return false; }
            if (!($scope.NewSplit.GrowthRate || '').trim()) { Noty("error", "Please enter Growth Rate!"); return false; }
            return true;
        };

        $scope.AddSplitRow = function () {
            if (!$scope.ValidateNewSplit()) return;

            var branchMatch = ($scope.BranchList || []).find(function (x) { return parseInt(x.id) === parseInt($scope.NewSplit.BranchID); });
            var deptMatch = ($scope.NewSplitDepartmentList || []).find(function (x) { return x.ID === $scope.NewSplit.DepartmentID; });

            var row = angular.copy($scope.NewSplit);
            row.BranchID = $scope.NewSplit.BranchID ? parseInt($scope.NewSplit.BranchID) : null;
            row.BranchName = branchMatch ? branchMatch.value : '-';
            row.DepartmentName = deptMatch ? deptMatch.ShortName : '-';
            row.FactoryCodeID = $scope.Source.FactoryCodeID;
            row.FactoryCode = $scope.Source.FactoryCode;
            row.ColorType = $scope.Source.ColorType;
            row.SizeCodeID = $scope.Source.SizeCodeID;
            row.SizeCodeType = $scope.Source.SizeCodeType;

            $scope.StagedSplits.push(row);
            $scope.RecalculateAdjust();
            $scope.ResetNewSplitForm();
            $scope.InitStagedGrid();
        };

        $scope.RemoveSplitRow = function (index) {
            $scope.StagedSplits.splice(index, 1);
            $scope.RecalculateAdjust();
            $scope.InitStagedGrid();
        };

        // DevExtreme DataGrid for the staged (not-yet-saved) split lines -
        // mirrors RoughDistributionCtrl's InitGrid pattern: re-create the
        // widget against the current array on every add/remove rather than
        // trying to patch an existing dxDataGrid instance's dataSource.
        $scope.InitStagedGrid = function () {
            if (!$("#stagedSplitsGridContainer").length) return;

            $("#stagedSplitsGridContainer").dxDataGrid({
                dataSource: $scope.StagedSplits,
                height: 'auto',
                columnAutoWidth: true,
                allowColumnResizing: true,
                hoverStateEnabled: true,
                rowAlternationEnabled: true,
                showColumnLines: true,
                showRowLines: true,
                showBorders: true,
                paging: { enabled: false },
                pager: { visible: false },
                columnChooser: { enabled: false },
                columns: [
                    {
                        caption: '#',
                        width: 50,
                        alignment: 'center',
                        allowResizing: false,
                        cellTemplate: function (container, options) {
                            $("<span>").text(options.rowIndex + 1).appendTo(container);
                        }
                    },
                    { caption: 'Pcs', dataField: 'Lot_Pcs', dataType: 'number', minWidth: 90, alignment: 'right', format: '#,##0' },
                    { caption: 'Carat', dataField: 'Lot_Carat', dataType: 'number', minWidth: 110, alignment: 'right', format: '#,##0.000' },
                    { caption: 'Branch', dataField: 'BranchName', minWidth: 110 },
                    { caption: 'Department', dataField: 'DepartmentName', minWidth: 110 },
                    { caption: 'Priority', dataField: 'LotPriority', minWidth: 100 },
                    { caption: 'Grade', dataField: 'Grade', minWidth: 90 },
                    {
                        caption: 'ACTION',
                        width: 70,
                        alignment: 'center',
                        allowResizing: false,
                        fixed: true,
                        fixedPosition: 'right',
                        cellTemplate: function (container, options) {
                            $("<button>")
                                .addClass("grid-action-btn-del")
                                .attr("type", "button")
                                .attr("title", "Remove Staged Split")
                                .html('<i class="fa fa-trash-o"></i>')
                                .on("click", function (e) {
                                    e.stopPropagation();
                                    $scope.$apply(function () {
                                        $scope.RemoveSplitRow(options.rowIndex);
                                    });
                                })
                                .appendTo(container);
                        }
                    }
                ],
                summary: {
                    totalItems: [
                        { column: 'Lot_Pcs', summaryType: 'sum', valueFormat: '#,##0', displayFormat: '{0}', alignByColumn: true },
                        { column: 'Lot_Carat', summaryType: 'sum', valueFormat: '#,##0.000', displayFormat: '{0}', alignByColumn: true }
                    ]
                }
            });
        };

        $scope.LoadForEdit = function (lotId) {
            $scope.IsLoading = true;
            if (typeof show_loader === 'function') show_loader();
            $http.get('@Url.Action("Get_MST_LotByID", "Master")?id=' + lotId).then(function (res) {
                $scope.IsLoading = false;
                if (typeof hide_loader === 'function') hide_loader();
                if (!res.data || !res.data.success || !res.data.item) {
                    Noty("error", "Failed to load lot.");
                    return;
                }
                var m = res.data.item;
                // Rough Rate is locked to the source RoughDetails' own Rate
                // UNLESS that source Grade is 'Mix' (see IsSourceGradeMix) -
                // in the locked case, show the live source Rate rather than
                // whatever (possibly stale/blank) value the Lot itself has.
                var isSourceMix = ((m.SourceGrade || '').trim().toUpperCase() === 'MIX');
                $scope.FormModel = {
                    LotID: parseInt(m.LotID),
                    InwardDetailID: m.InwardDetailID,
                    RCode: m.RCode,
                    LotCode: m.LotCode,
                    FactoryCodeID: m.FactoryCodeID,
                    FactoryCode: m.FactoryCode,
                    ColorType: m.ColorType,
                    SizeCodeID: m.SizeCodeID,
                    SizeCodeType: m.SizeCodeType,
                    BranchID: m.BranchID || null,
                    GradeID: m.GradeID,
                    Grade: m.Grade,
                    Lot_Pcs: m.Lot_Pcs,
                    Lot_Carat: m.Lot_Carat,
                    RoughRate: isSourceMix ? m.RoughRate : ((m.SourceRate !== undefined && m.SourceRate !== null) ? m.SourceRate : m.RoughRate),
                    Receipe: m.Receipe,
                    Height: (m.SourceFromHeight !== undefined && m.SourceFromHeight !== null) ? m.SourceFromHeight : m.Height,
                    NewHeight: (m.SourceToHeight !== undefined && m.SourceToHeight !== null) ? m.SourceToHeight : m.NewHeight,
                    Size: m.SourceDimensionName || m.Size,
                    RejPcs: m.RejPcs,
                    RejCarat: m.RejCarat,
                    LotPriority: m.LotPriority || '',
                    GrowthRate: m.GrowthRate,
                    DepartmentID: m.DepartmentID || '',
                    HeadManagerID: m.HeadManagerID || '',
                    Remarks: m.Remarks,
                    IsActive: m.IsActive === true || m.IsActive === 1 || m.IsActive === '1' || m.IsActive === 'True'
                };
                var branchMatch = ($scope.BranchList || []).find(function (x) { return parseInt(x.id) === parseInt(m.BranchID); });
                $scope.Selected = {
                    BranchName: branchMatch ? branchMatch.value : '',
                    RoughPcs: m.RoughPcs,
                    RoughWeight: m.RoughWeight,
                    PendingPcs: m.AvailablePcs,
                    PendingWeight: m.AvailableWeight,
                    SourceGrade: m.SourceGrade || ''
                };
                $scope.LoadDepartments(m.BranchID).then(function () { SyncChosenValue('#FormDepartmentID', m.DepartmentID); });
                SyncChosenValue('#FormHeadManagerID', m.HeadManagerID);
                SyncChosenValue('#FormLotPriority', m.LotPriority);

                function SyncChosenValue(selector, value) {
                    $timeout(function () {
                        $(selector).val(value != null ? value.toString() : '').trigger('chosen:updated');
                    }, 200);
                }
                SyncChosenValue('#FormGradeID', m.GradeID);
                SyncChosenValue('#FormReceipe', m.Receipe);
                SyncChosenValue('#FormBranchID', m.BranchID);

                $scope.LoadBranchSplitSummary();
            }, function () {
                $scope.IsLoading = false;
                if (typeof hide_loader === 'function') hide_loader();
                Noty("error", "Error loading lot from server.");
            });
        };

        // Breakdown of one Inward row's already-split total (every non-deleted
        // Lot split from it, assigned or not) by Branch. Used by both the
        // normal Edit form (defaults to the current Lot's own InwardDetailID)
        // and Branch Split mode (passes it explicitly).
        $scope.BranchSplitSummary = [];
        $scope.LoadBranchSplitSummary = function (inwardDetailID) {
            inwardDetailID = inwardDetailID || $scope.FormModel.InwardDetailID;
            if (!inwardDetailID) { $scope.BranchSplitSummary = []; return; }
            $http.get('@Url.Action("Get_LotBranchSplitSummary", "Master")?InwardDetailID=' + inwardDetailID).then(function (res) {
                $scope.BranchSplitSummary = (res.data && res.data.success) ? res.data.list : [];
            }, function () {
                $scope.BranchSplitSummary = [];
            });
        };

        $scope.ValidateForm = function () {
            var pcs = parseInt($scope.FormModel.Lot_Pcs);
            var carat = parseFloat($scope.FormModel.Lot_Carat);
            if (isNaN(pcs) || pcs < 0 || isNaN(carat) || carat < 0) {
                Noty("error", "Please enter valid Pcs and Carat!");
                return false;
            }
            if ((pcs === 0 && carat > 0) || (pcs > 0 && carat === 0)) {
                Noty("error", "Pcs and Carat must both be zero or both be greater than zero!");
                return false;
            }
            var availPcs = parseFloat($scope.Selected.PendingPcs || 0);
            var availWt = parseFloat($scope.Selected.PendingWeight || 0);
            if (pcs > availPcs) {
                Noty("error", "Pcs (" + pcs + ") exceeds the available balance (" + availPcs + ")!");
                return false;
            }
            if (carat > availWt + 0.0001) {
                Noty("error", "Carat (" + carat.toFixed(3) + ") exceeds the available balance (" + availWt.toFixed(3) + ")!");
                return false;
            }
            if (!($scope.FormModel.Receipe || '').trim()) { Noty("error", "Please select Receipe!"); return false; }
            if (!($scope.FormModel.LotPriority || '').trim()) { Noty("error", "Please select Priority!"); return false; }
            if (!($scope.FormModel.GrowthRate || '').trim()) { Noty("error", "Please enter Growth Rate!"); return false; }
            return true;
        };

        $scope.GenerateAndShowQR = function (lotIds) {
            if (!lotIds || lotIds.length === 0) return $q.when();
            return $http.post('@Url.Action("GenerateLotQRs", "Master")', { lotIDs: lotIds }).then(function (res) {
                if (res.data && res.data.success) {
                    window.open('@Url.Action("LotQRPrint", "Master")', '_blank');
                } else {
                    Noty("error", (res.data && res.data.message) || "Failed to generate QR code.");
                }
            }, function () {
                Noty("error", "Error connecting to server while generating QR code.");
            });
        };

        $scope.GoBackToList = function () {
            var lotListUrl = '@Url.Action("Lot", "Master")';
            if (window.top && window.top.ChromeTabs && window.top.ChromeTabs.openTab) {
                window.top.ChromeTabs.openTab({ title: 'Lot Master', url: lotListUrl, forceReload: true });
            }
            if (typeof window.closeCurrentTab === 'function') {
                window.closeCurrentTab();
            } else {
                window.location.href = lotListUrl;
            }
        };

        $scope.SaveLot = function () {
            if (!$scope.ValidateForm()) return;

            $scope.IsSaving = true;
            $http.post('@Url.Action("Lot_Save", "Master")', { model: $scope.FormModel, Action: 'UPDATE' }).then(function (res) {
                $scope.IsSaving = false;
                if (res.data && res.data.success) {
                    Noty("success", res.data.message || "Lot saved successfully.");
                    $scope.FormModel.RCode = res.data.RCode || $scope.FormModel.RCode;
                    $scope.FormModel.LotCode = res.data.LotCode || $scope.FormModel.LotCode;
                    $scope.LoadBranchSplitSummary();
                    var savedLotId = res.data.LotID || $scope.FormModel.LotID;
                    $scope.GenerateAndShowQR([savedLotId]).then(function () { $scope.GoBackToList(); });
                } else {
                    Noty("error", (res.data && res.data.message) || "Failed to save lot.");
                }
            }, function () {
                $scope.IsSaving = false;
                Noty("error", "Error saving lot to server.");
            });
        };

        $scope.SaveAllSplits = function () {
            if ($scope.StagedSplits.length === 0) return;

            $scope.IsSaving = true;
            $http.post('@Url.Action("LotSplit_Save", "Master")', {
                splits: $scope.StagedSplits,
                InwardDetailID: $scope.Source.InwardDetailID,
                SizeCodeID: $scope.Source.SizeCodeID
            }).then(function (res) {
                $scope.IsSaving = false;
                if (res.data && res.data.success) {
                    Noty("success", res.data.message || "Lot splits saved successfully.");
                    $scope.GenerateAndShowQR(res.data.newLotIDs).then(function () { $scope.GoBackToList(); });
                } else {
                    Noty("error", (res.data && res.data.message) || "Failed to save lot splits.");
                }
            }, function () {
                $scope.IsSaving = false;
                Noty("error", "Error saving lot splits to server.");
            });
        };

        // Load all dropdown sources first, then load the lot for edit (if any) -
        // guarantees the option lists already exist before FormModel values are
        // set, so the selects/chosen widgets resolve to the right text instead
        // of showing blank.
        $q.all([
            $scope.LoadBranches(),
            $scope.LoadRecipes(),
            $scope.LoadGrades(),
            $scope.LoadHeadManagers(),
            $scope.LoadPriorities(),
            $scope.InitLotID > 0 ? $q.when() : $scope.LoadSources()
        ]).then(function () {
            if ($scope.InitLotID > 0) {
                $scope.LoadForEdit($scope.InitLotID);
            } else {
                $scope.InitStagedGrid();
            }
        });
    }]);
</script>
