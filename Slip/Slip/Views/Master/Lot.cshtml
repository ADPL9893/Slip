@{
    ViewBag.Title = "Lot Master";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* ==========================================================================
       Lot Master - Distinct Mid-Tone Ice Blue Theming & SaaS Styling
       ========================================================================== */
    @@keyframes fadeInUpSmooth {
        from {
            opacity: 0;
            transform: translateY(10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .lot-page {
        padding: 0 0 20px 0;
        margin-top: -10px;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    }

    /* Staggered Card Entrance Animations */
    .lot-header-card { animation: fadeInUpSmooth 0.35s cubic-bezier(0.16, 1, 0.3, 1) 0.05s both; }
    .lot-grid-card { animation: fadeInUpSmooth 0.35s cubic-bezier(0.16, 1, 0.3, 1) 0.15s both; }

    /* Page Header Card (Clean Neutral White Background without Action Buttons) */
    .lot-header-card {
        background: #ffffff !important;
        border-radius: 12px !important;
        padding: 14px 20px !important;
        margin-bottom: 14px !important;
        box-shadow: 0 2px 10px rgba(15, 23, 42, 0.04) !important;
        border: 1.5px solid #cbd5e1 !important;
        border-left: 5px solid #0284c7 !important;
        display: flex !important;
        justify-content: space-between !important;
        align-items: center !important;
        flex-wrap: wrap !important;
        gap: 12px !important;
        transition: all 0.25s ease !important;
    }
    .lot-header-card:hover {
        box-shadow: 0 6px 18px rgba(15, 23, 42, 0.08) !important;
        border-color: #94a3b8 !important;
        border-left-color: #0369a1 !important;
    }

    .lot-header-left {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .lot-header-icon {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        box-shadow: 0 4px 12px rgba(2, 132, 199, 0.28);
        transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
        flex-shrink: 0;
    }
    .lot-header-card:hover .lot-header-icon {
        transform: scale(1.08) rotate(4deg);
    }

    .lot-header-title {
        font-size: 18px !important;
        font-weight: 700 !important;
        color: #0f172a !important;
        margin: 0 !important;
        line-height: 1.2 !important;
        letter-spacing: -0.2px;
    }

    .lot-breadcrumb {
        font-size: 11.5px;
        color: #64748b;
        margin-bottom: 3px;
        font-weight: 500;
    }
    .lot-breadcrumb a {
        color: #0284c7;
        text-decoration: none;
        transition: color 0.15s ease;
        font-weight: 500;
    }
    .lot-breadcrumb a:hover {
        color: #0369a1;
        text-decoration: underline;
    }

    /* Grid Card Container (Matching EmployeeDetail.cshtml) */
    .lot-grid-card {
        background: #ffffff !important;
        border-radius: 12px !important;
        padding: 0 !important;
        box-shadow: 0 2px 10px rgba(15, 23, 42, 0.04) !important;
        border: 1.5px solid #cbd5e1 !important;
        min-height: calc(100vh - 180px);
        overflow: hidden !important;
        position: relative !important;
        transition: all 0.25s ease !important;
    }
    .lot-grid-card:hover {
        box-shadow: 0 6px 18px rgba(15, 23, 42, 0.08) !important;
        border-color: #94a3b8 !important;
    }

    /* Left-Aligned Header Toolbar Above Grid */
    .lot-card-header {
        background: #ffffff !important;
        padding: 12px 18px !important;
        border-bottom: 1.5px solid #e2e8f0 !important;
        display: flex !important;
        align-items: center !important;
        justify-content: flex-start !important;
        flex-wrap: wrap !important;
        gap: 14px !important;
    }

    .lot-toolbar-left {
        display: flex;
        align-items: center;
        gap: 14px;
        flex-wrap: wrap;
        width: 100%;
    }

    .lot-title-badge-wrap {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-shrink: 0;
    }

    .lot-title-icon {
        font-size: 16px;
        color: #0284c7;
    }

    .lot-card-title {
        margin: 0 !important;
        font-size: 15px !important;
        font-weight: 700 !important;
        color: #0f172a !important;
        letter-spacing: -0.1px;
    }

    .lot-actions-toolbar {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    /* Excel Upload Group */
    .lot-upload-group {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        background: #f8fafc;
        border: 1.5px solid #cbd5e1;
        border-radius: 8px;
        padding: 2px 4px 2px 8px;
        transition: all 0.2s ease;
    }
    .lot-upload-group:hover {
        border-color: #94a3b8;
        background: #f1f5f9;
    }

    .btn-lot-choose {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 12px;
        font-weight: 600;
        color: #0369a1;
        cursor: pointer;
        margin: 0;
        padding: 5px 8px;
        border-radius: 6px;
        transition: all 0.2s ease;
        max-width: 180px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .btn-lot-choose:hover {
        color: #0284c7;
        background: #e0f2fe;
    }

    .btn-lot-upload {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%) !important;
        color: #ffffff !important;
        border: none !important;
        border-radius: 6px !important;
        padding: 6px 14px !important;
        font-size: 12px !important;
        font-weight: 700 !important;
        display: inline-flex !important;
        align-items: center !important;
        gap: 5px !important;
        box-shadow: 0 2px 8px rgba(16, 185, 129, 0.28) !important;
        transition: all 0.2s ease !important;
        cursor: pointer !important;
        text-decoration: none !important;
        white-space: nowrap !important;
    }
    .btn-lot-upload:hover {
        background: linear-gradient(135deg, #059669 0%, #047857 100%) !important;
        transform: translateY(-1px) !important;
        box-shadow: 0 4px 12px rgba(16, 185, 129, 0.40) !important;
        color: #ffffff !important;
    }
    .btn-lot-upload:active {
        transform: translateY(0) !important;
    }

    .btn-lot-refresh {
        background: #ffffff !important;
        color: #475569 !important;
        border: 1.5px solid #cbd5e1 !important;
        border-radius: 8px !important;
        padding: 6px 12px !important;
        font-size: 12px !important;
        font-weight: 600 !important;
        display: inline-flex !important;
        align-items: center !important;
        gap: 5px !important;
        transition: all 0.2s ease !important;
        cursor: pointer !important;
        white-space: nowrap !important;
    }
    .btn-lot-refresh:hover {
        background: #f1f5f9 !important;
        color: #1e293b !important;
        border-color: #94a3b8 !important;
        transform: translateY(-1px) !important;
    }

    /* Grid Container */
    .lot-grid-body {
        padding: 0 !important;
    }

    .lot-grid-card .uigrid,
    .lot-grid-card #gridContainer {
        width: 100% !important;
        background: transparent !important;
        border: none !important;
        border-radius: 0 !important;
        padding: 0 !important;
        box-shadow: none !important;
        min-height: calc(100vh - 210px);
    }

    #gridContainer {
        width: 100% !important;
    }

    /* Badges */
    .badge-status-pill {
        display: inline-block;
        padding: 3px 9px;
        border-radius: 12px;
        font-size: 11px;
        font-weight: 700;
        line-height: 1.2;
    }
    .badge-pill-info { background: #e0f2fe; color: #0369a1; border: 1px solid #bae6fd; }

    /* ==========================================================================
       Mobile Responsive Optimizations
       ========================================================================== */
    @@media (max-width: 768px) {
        .lot-page {
            padding: 0 0 10px 0;
            margin-top: -5px;
        }

        .lot-header-card {
            padding: 10px 14px !important;
            margin-bottom: 10px !important;
        }

        .lot-header-icon {
            width: 38px;
            height: 38px;
            font-size: 16px;
        }

        .lot-header-title {
            font-size: 16px !important;
        }

        .lot-card-header {
            padding: 10px 12px !important;
            gap: 10px !important;
        }

        .lot-toolbar-left {
            flex-direction: column !important;
            align-items: stretch !important;
            gap: 10px !important;
        }

        .lot-title-badge-wrap {
            width: 100% !important;
            justify-content: space-between !important;
        }

        .lot-actions-toolbar {
            width: 100% !important;
            display: flex !important;
            flex-direction: row !important;
            gap: 8px !important;
        }

        .lot-upload-group {
            flex: 1 !important;
            display: flex !important;
            min-width: 0 !important;
            justify-content: space-between !important;
        }

        .btn-lot-choose {
            flex: 1 !important;
            min-width: 0 !important;
            max-width: none !important;
        }

        .btn-lot-upload {
            flex-shrink: 0 !important;
        }

        .btn-lot-refresh {
            flex-shrink: 0 !important;
        }

        .lot-grid-card {
            min-height: 480px !important;
        }

        .lot-grid-card .uigrid,
        .lot-grid-card #gridContainer {
            min-height: 440px !important;
            height: calc(100vh - 220px) !important;
        }

        .dx-datagrid-search-panel {
            width: 100% !important;
            max-width: 100% !important;
            margin-bottom: 6px !important;
        }
    }

    @@media (max-width: 480px) {
        .lot-actions-toolbar {
            flex-direction: column !important;
        }

        .lot-upload-group {
            width: 100% !important;
        }

        .btn-lot-refresh {
            width: 100% !important;
            justify-content: center !important;
        }
    }
</style>

<div ng-controller="Diamond" class="lot-page">
    <!-- Header Banner Card (Clean Title & Breadcrumb without Action Buttons) -->
    <div class="lot-header-card">
        <div class="lot-header-left">
            <div class="lot-header-icon">
                <i class="fa fa-cubes"></i>
            </div>
            <div>
                <div class="lot-breadcrumb">
                    <a href="@Url.Action("Index", "Home")"><i class="fa fa-home"></i> Home</a> / 
                    <span>Master</span> / 
                    <span>Lot Master</span>
                </div>
                <h4 class="lot-header-title">Lot Master</h4>
            </div>
        </div>
    </div>

    <!-- DataGrid Container Card with Left-Aligned Actions Toolbar Above Grid -->
    <div class="lot-grid-card">
        <div class="lot-card-header">
            <div class="lot-toolbar-left">
                <!-- Title & Record Count -->
                <div class="lot-title-badge-wrap">
                    <i class="fa fa-table lot-title-icon"></i>
                    <h3 class="lot-card-title">Lot Records</h3>
                    <span class="badge-status-pill badge-pill-info">
                        <i class="fa fa-database"></i> {{List.length || 0}} Total
                    </span>
                </div>

                <!-- Left-Aligned Actions Toolbar -->
                <div class="lot-actions-toolbar">
                    <div class="lot-upload-group">
                        <input id="LotExcel" 
                               type="file" 
                               accept=".xlsx,.csv" 
                               file-model="Diamond.LotExcel" 
                               ng-model="Diamond.LotExcel" 
                               style="display:none;" 
                               onchange="angular.element(this).scope().onFileSelected(this)" />
                        <label for="LotExcel" class="btn-lot-choose" title="Click to choose Excel or CSV file">
                            <i class="fa fa-file-excel-o" style="color: #10b981; font-size: 13px;"></i> 
                            <span>{{selectedFileName || 'Choose File'}}</span>
                        </label>
                        <button type="button" class="btn-lot-upload" ng-click="LotUpload()" title="Upload selected Excel file">
                            <i class="fa fa-cloud-upload"></i> Upload
                        </button>
                    </div>
                    <button type="button" class="btn-lot-refresh" ng-click="FatchData()" title="Reload Lot records">
                        <i class="fa fa-refresh"></i> Refresh
                    </button>
                </div>
            </div>
        </div>
        <div class="lot-grid-body">
            <div class="uigrid">
                <div id="gridContainer" style="width:100%;"></div>
            </div>
        </div>
    </div>
</div>

<script>
    let DataField = [];
    let DataFieldSummary = [];
    let List = [];

    var module;
    try {
        module = angular.module('app');
    } catch (e) {
        module = angular.module('app', ['frapontillo.bootstrap-duallistbox', 'ngTouch', 'angularjs-dropdown-multiselect']);
    }

    module.directive('chosen', function () {
        return {
            restrict: 'A',
            link(scope, element, attrs) {
                scope.$watch(attrs.ngModel, () => element.trigger('chosen:updated'));
                element.chosen();
            }
        };
    });

    module.controller("Diamond", ['$scope', '$http', function ($scope, $http) {
        $scope.Diamond = {};
        $scope.List = [];
        $scope.selectedFileName = "";

        $scope.onFileSelected = function (input) {
            $scope.$apply(function () {
                if (input.files && input.files.length > 0) {
                    $scope.selectedFileName = input.files[0].name;
                } else {
                    $scope.selectedFileName = "";
                }
            });
        };

        $scope.FatchData = function () {
            if (typeof show_loader === 'function') show_loader();
            $http({
                method: "POST",
                url: '@Url.Action("GetData_For_MST_Lot", "Master")',
            }).then(function (response) {
                if (typeof hide_loader === 'function') hide_loader();
                List = response.data.List || [];
                $scope.List = List;
                DataField = response.data.DataField || [];
                DataFieldSummary = response.data.DataFieldSummary || [];

                $scope.BuildGridColumns(DataField);
            }, function () {
                if (typeof hide_loader === 'function') hide_loader();
                if (typeof Noty === 'function') {
                    Noty("error", "Failed to fetch lot data.");
                }
            });
        };

        // Format Grid Columns (Exact same structure as EmployeeDetail.cshtml)
        $scope.BuildGridColumns = function (dataFields) {
            var gridColumns = [];

            // 1. Index / Serial # Column
            gridColumns.push({
                caption: '#',
                width: 55,
                alignment: 'center',
                allowReordering: false,
                fixed: true,
                fixedPosition: 'left',
                cellTemplate: function (container, options) {
                    $("<span>")
                        .text(options.rowIndex + 1)
                        .css({ "font-weight": "600", "color": "#64748b" })
                        .appendTo(container);
                }
            });

            // 2. Dynamic Backend Columns
            if (dataFields && dataFields.length > 0) {
                angular.forEach(dataFields, function (field) {
                    var col = angular.copy(field);
                    var fieldKey = (col.dataField || '').toLowerCase();

                    // Minimum column width for aesthetic readability
                    if (!col.minWidth && !col.width) {
                        col.minWidth = 110;
                    }

                    // Special formatting for Dates
                    if (fieldKey.indexOf('date') !== -1) {
                        col.minWidth = 120;
                        col.dataType = 'date';
                        col.format = 'dd-MMM-yyyy';
                        col.alignment = 'center';
                    }

                    gridColumns.push(col);
                });
            }

            $scope.InitGrid(gridColumns);
        };

        // DevExtreme Grid Initialization (Identical Configuration to EmployeeDetail.cshtml)
        $scope.InitGrid = function (columns) {
            $("#gridContainer").dxDataGrid({
                dataSource: $scope.List,
                keyExpr: 'ID',
                columns: columns,
                height: 'calc(100vh - 210px)',
                columnAutoWidth: true,
                allowColumnResizing: true,
                columnResizingMode: 'widget',
                allowColumnReordering: true,
                columnChooser: {
                    enabled: true,
                    mode: 'select'
                },
                columnFixing: {
                    enabled: true
                },
                showColumnLines: true,
                showRowLines: true,
                showBorders: true,
                rowAlternationEnabled: true,
                wordWrapEnabled: false,
                sorting: { mode: "multiple" },
                scrolling: {
                    mode: 'virtual'
                },
                paging: { 
                    enabled: false 
                },
                pager: { 
                    visible: false 
                },
                searchPanel: { 
                    visible: true, 
                    width: 280, 
                    placeholder: 'Search lot records...' 
                },
                filterRow: { 
                    visible: true, 
                    applyFilter: 'auto' 
                },
                headerFilter: { visible: true },
                selection: {
                    mode: 'single'
                },
                summary: {
                    totalItems: DataFieldSummary
                },
                export: {
                    enabled: true,
                    formats: ['xlxs'],
                    allowExportSelectedData: false
                },
                onExporting: function (e) {
                    if (e.format === 'xlxs') {
                        if (typeof ExcelJS !== 'undefined') {
                            var workbook = new ExcelJS.Workbook();
                            var worksheet = workbook.addWorksheet('Lot Details');

                            DevExpress.excelExporter.exportDataGrid({
                                component: e.component,
                                worksheet: worksheet,
                                autoFilterEnabled: true
                            }).then(function () {
                                workbook.xlsx.writeBuffer().then(function (buffer) {
                                    saveAs(new Blob([buffer], { type: 'application/octet-stream' }), 'Lot.xlsx');
                                });
                            });
                        }
                    }
                }
            });
        };

        $scope.FatchData();

        $scope.LotUpload = function () {
            var fileElem = document.getElementById('LotExcel');
            var file = fileElem ? fileElem.files : [];

            if (file.length > 0) {
                var formData = new FormData();
                for (var i = 0; i < file.length; i++) {
                    formData.append("excelFile", file[i]);
                }
                if (typeof show_loader === 'function') show_loader();

                $http({
                    method: 'POST',
                    asyc: false,
                    url: '@Url.Action("LotCode_Insert_Using_Excel", "Master")',
                    headers: { 'Content-Type': undefined },
                    data: formData,
                    contentType: false,
                    processData: false,
                }).then(function (ret) {
                    if (typeof hide_loader === 'function') hide_loader();
                    if (ret.data && ret.data.Message == "Records inserted successfully") {
                        if (typeof Noty === 'function') {
                            Noty("success", ret.data.Message);
                        } else {
                            alert(ret.data.Message);
                        }
                        $scope.FatchData();
                        if (fileElem) fileElem.value = "";
                        $scope.selectedFileName = "";
                    }
                    else {
                        var msg = (ret.data && ret.data.Message) ? ret.data.Message : "Error inserting records.";
                        if (typeof Noty === 'function') {
                            Noty("error", msg);
                        } else {
                            alert(msg);
                        }
                    }
                }, function () {
                    if (typeof hide_loader === 'function') hide_loader();
                    if (typeof Noty === 'function') {
                        Noty("error", "Error uploading file.");
                    } else {
                        alert("Error uploading file.");
                    }
                });
            } else {
                if (typeof Noty === 'function') {
                    Noty("warning", "Please select an Excel / CSV file to upload.");
                } else {
                    alert("Please select an Excel / CSV file to upload.");
                }
            }
        };
    }]);
</script>
