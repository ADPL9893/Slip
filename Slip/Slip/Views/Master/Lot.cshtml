@{
    ViewBag.Title = "Lot Master";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}


<div ng-controller="Diamond" class="lot-page">
    <!-- Header Banner Card (Clean Title & Breadcrumb without Action Buttons) -->
    <div class="lot-header-card">
        <div class="lot-header-left">
            <div class="lot-header-icon">
                <i class="fa fa-cubes"></i>
            </div>
            <div>
                <div class="lot-breadcrumb">
                    <a href="@Url.Action("Index", "Home")"><i class="fa fa-home"></i> Home</a> / 
                    <span>Master</span> / 
                    <span>Lot Master</span>
                </div>
                <h4 class="lot-header-title">Lot Master</h4>
            </div>
        </div>
    </div>

    <!-- DataGrid Container Card with Left-Aligned Actions Toolbar Above Grid -->
    <div class="lot-grid-card">
        <div class="lot-card-header">
            <div class="lot-toolbar-left">
                <!-- Title & Record Count -->
                <div class="lot-title-badge-wrap">
                    <i class="fa fa-table lot-title-icon"></i>
                    <h3 class="lot-card-title">Lot Records</h3>
                    <span class="badge-status-pill badge-pill-info">
                        <i class="fa fa-database"></i> {{List.length || 0}} Total
                    </span>
                </div>

                <!-- Left-Aligned Actions Toolbar -->
                <div class="lot-actions-toolbar">
                    <div class="lot-upload-group">
                        <input id="LotExcel" 
                               type="file" 
                               accept=".xlsx,.csv" 
                               file-model="Diamond.LotExcel" 
                               ng-model="Diamond.LotExcel" 
                               style="display:none;" 
                               onchange="angular.element(this).scope().onFileSelected(this)" />
                        <label for="LotExcel" class="btn-lot-choose" title="Click to choose Excel or CSV file">
                            <i class="fa fa-file-excel-o" style="color: #10b981; font-size: 13px;"></i> 
                            <span>{{selectedFileName || 'Choose File'}}</span>
                        </label>
                        <button type="button" class="btn-lot-upload" ng-click="LotUpload()" title="Upload selected Excel file">
                            <i class="fa fa-cloud-upload"></i> Upload
                        </button>
                    </div>
                    <button type="button" class="btn-lot-refresh" ng-click="FatchData()" title="Reload Lot records">
                        <i class="fa fa-refresh"></i> Refresh
                    </button>
                </div>
            </div>
        </div>
        <div class="lot-grid-body">
            <div class="uigrid">
                <div id="gridContainer" style="width:100%;"></div>
            </div>
        </div>
    </div>
</div>

<script>
    let DataField = [];
    let DataFieldSummary = [];
    let List = [];

    var module;
    try {
        module = angular.module('app');
    } catch (e) {
        module = angular.module('app', ['frapontillo.bootstrap-duallistbox', 'ngTouch', 'angularjs-dropdown-multiselect']);
    }

    module.directive('chosen', function () {
        return {
            restrict: 'A',
            link(scope, element, attrs) {
                scope.$watch(attrs.ngModel, () => element.trigger('chosen:updated'));
                element.chosen();
            }
        };
    });

    module.controller("Diamond", ['$scope', '$http', function ($scope, $http) {
        $scope.Diamond = {};
        $scope.List = [];
        $scope.selectedFileName = "";

        $scope.onFileSelected = function (input) {
            $scope.$apply(function () {
                if (input.files && input.files.length > 0) {
                    $scope.selectedFileName = input.files[0].name;
                } else {
                    $scope.selectedFileName = "";
                }
            });
        };

        $scope.FatchData = function () {
            if (typeof show_loader === 'function') show_loader();
            $http({
                method: "POST",
                url: '@Url.Action("GetData_For_MST_Lot", "Master")',
            }).then(function (response) {
                if (typeof hide_loader === 'function') hide_loader();
                List = response.data.List || [];
                $scope.List = List;
                DataField = response.data.DataField || [];
                DataFieldSummary = response.data.DataFieldSummary || [];
                DataFieldSummary.forEach(function (s) { s.alignByColumn = true; });

                $scope.BuildGridColumns(DataField);
            }, function () {
                if (typeof hide_loader === 'function') hide_loader();
                if (typeof Noty === 'function') {
                    Noty("error", "Failed to fetch lot data.");
                }
            });
        };

        // Format Grid Columns (Exact same structure as EmployeeDetail.cshtml)
        $scope.BuildGridColumns = function (dataFields) {
            var gridColumns = [];

            // 1. Index / Serial # Column
            gridColumns.push({
                caption: '#',
                width: 55,
                alignment: 'center',
                allowReordering: false,
                fixed: true,
                fixedPosition: 'left',
                cellTemplate: function (container, options) {
                    $("<span>")
                        .text(options.rowIndex + 1)
                        .css({ "font-weight": "600", "color": "#64748b" })
                        .appendTo(container);
                }
            });

            // 2. Dynamic Backend Columns
            if (dataFields && dataFields.length > 0) {
                angular.forEach(dataFields, function (field) {
                    var col = angular.copy(field);
                    var fieldKey = (col.dataField || '').toLowerCase();

                    // Minimum column width for aesthetic readability
                    if (!col.minWidth && !col.width) {
                        col.minWidth = 110;
                    }

                    // Special formatting for Dates
                    if (fieldKey.indexOf('date') !== -1) {
                        col.minWidth = 120;
                        col.dataType = 'date';
                        col.format = 'dd-MMM-yyyy';
                        col.alignment = 'center';
                    }

                    gridColumns.push(col);
                });
            }

            $scope.InitGrid(gridColumns);
        };

        // DevExtreme Grid Initialization (Identical Configuration to EmployeeDetail.cshtml)
        $scope.InitGrid = function (columns) {
            $("#gridContainer").dxDataGrid({
                dataSource: $scope.List,
                keyExpr: 'ID',
                columns: columns,
                onRowPrepared: function (e) {
                    if (e.rowType === "data") {
                        e.rowElement.addClass("ri-row-animate");
                        e.rowElement.css("--ri-row-i", e.rowIndex);
                    }
                },
                height: 'calc(100vh - 210px)',
                columnAutoWidth: true,
                allowColumnResizing: true,
                columnResizingMode: 'widget',
                allowColumnReordering: true,
                columnChooser: {
                    enabled: true,
                    mode: 'select'
                },
                columnFixing: {
                    enabled: true
                },
                showColumnLines: true,
                showRowLines: true,
                showBorders: true,
                rowAlternationEnabled: true,
                wordWrapEnabled: false,
                sorting: { mode: "multiple" },
                scrolling: {
                    mode: 'virtual'
                },
                paging: { 
                    enabled: false 
                },
                pager: { 
                    visible: false 
                },
                searchPanel: { 
                    visible: true, 
                    width: 280, 
                    placeholder: 'Search lot records...' 
                },
                filterRow: { 
                    visible: true, 
                    applyFilter: 'auto' 
                },
                headerFilter: { visible: true },
                selection: {
                    mode: 'single'
                },
                summary: {
                    totalItems: DataFieldSummary
                },
                export: {
                    enabled: true,
                    formats: ['xlxs'],
                    allowExportSelectedData: false
                },
                onExporting: function (e) {
                    if (e.format === 'xlxs') {
                        if (typeof ExcelJS !== 'undefined') {
                            var workbook = new ExcelJS.Workbook();
                            var worksheet = workbook.addWorksheet('Lot Details');

                            DevExpress.excelExporter.exportDataGrid({
                                component: e.component,
                                worksheet: worksheet,
                                autoFilterEnabled: true
                            }).then(function () {
                                workbook.xlsx.writeBuffer().then(function (buffer) {
                                    saveAs(new Blob([buffer], { type: 'application/octet-stream' }), 'Lot.xlsx');
                                });
                            });
                        }
                    }
                }
            });
        };

        $scope.FatchData();

        $scope.LotUpload = function () {
            var fileElem = document.getElementById('LotExcel');
            var file = fileElem ? fileElem.files : [];

            if (file.length > 0) {
                var formData = new FormData();
                for (var i = 0; i < file.length; i++) {
                    formData.append("excelFile", file[i]);
                }
                if (typeof show_loader === 'function') show_loader();

                $http({
                    method: 'POST',
                    asyc: false,
                    url: '@Url.Action("LotCode_Insert_Using_Excel", "Master")',
                    headers: { 'Content-Type': undefined },
                    data: formData,
                    contentType: false,
                    processData: false,
                }).then(function (ret) {
                    if (typeof hide_loader === 'function') hide_loader();
                    if (ret.data && ret.data.Message == "Records inserted successfully") {
                        if (typeof Noty === 'function') {
                            Noty("success", ret.data.Message);
                        } else {
                            alert(ret.data.Message);
                        }
                        $scope.FatchData();
                        if (fileElem) fileElem.value = "";
                        $scope.selectedFileName = "";
                    }
                    else {
                        var msg = (ret.data && ret.data.Message) ? ret.data.Message : "Error inserting records.";
                        if (typeof Noty === 'function') {
                            Noty("error", msg);
                        } else {
                            alert(msg);
                        }
                    }
                }, function () {
                    if (typeof hide_loader === 'function') hide_loader();
                    if (typeof Noty === 'function') {
                        Noty("error", "Error uploading file.");
                    } else {
                        alert("Error uploading file.");
                    }
                });
            } else {
                if (typeof Noty === 'function') {
                    Noty("warning", "Please select an Excel / CSV file to upload.");
                } else {
                    alert("Please select an Excel / CSV file to upload.");
                }
            }
        };
    }]);
</script>
