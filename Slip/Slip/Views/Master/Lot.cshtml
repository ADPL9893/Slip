@{
    ViewBag.Title = "Lot Master";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<div ng-controller="LotMasterCtrl" class="rough-dist-list-page">
    <!-- DataGrid Container Card -->
    <div class="rdl-grid-card">
        <div class="rdl-card-header">
            <div class="rdl-card-title-left">
                <i class="fa fa-table"></i>
                <h3>Lot Master</h3>
                <span class="badge-status-pill badge-pill-info">
                    <i class="fa fa-database"></i> {{List.length}} Total Records
                </span>
            </div>
            <div class="rdl-card-actions">
                <button class="btn-ri-add-main" ng-click="OpenAddNew()" title="Open Lot Entry in new tab">
                    <i class="fa fa-plus"></i>
                </button>
                <button type="button" class="grid-action-btn-edit" title="Column Chooser" ng-click="ShowColumnChooser()">
                    <i class="fa fa-columns"></i>
                </button>
                <button type="button" class="grid-action-btn-edit" title="Export to Excel" ng-click="ExportGrid()">
                    <i class="fa fa-file-excel-o"></i>
                </button>
                <div class="field-select-wrap field-select-wrap--search">
                    <input type="text"
                           ng-model="SearchText"
                           ng-change="OnSearchChange()"
                           placeholder="Search lot records..."
                           class="form-control rd-input search-input-compact" />
                </div>
            </div>
        </div>
        <div class="rdl-grid-body">
            <div class="uigrid">
                <div id="lotGridContainer" style="width: 100%;"></div>
            </div>
        </div>
    </div>

    <!-- Delete Confirmation Modal -->
    <div class="modal fade" id="ConfirmDeleteModal" role="dialog" data-backdrop="static">
        <div class="modal-dialog modal-md">
            <div class="modal-content">
                <div class="modal-header">
                    <div class="modal-header-brand">
                        <i class="fa fa-exclamation-triangle modal-icon-danger"></i>
                        <h4 class="modal-header-title">Confirm Delete Lot</h4>
                    </div>
                    <button type="button" class="close modal-close-btn" data-dismiss="modal">&times;</button>
                </div>
                <div class="modal-body">
                    <div class="delete-dialog-content">
                        <div class="delete-warning-icon">
                            <i class="fa fa-trash-o"></i>
                        </div>
                        <h4 class="delete-dialog-title">Remove Lot?</h4>
                        <p class="delete-dialog-text">
                            Are you sure you want to delete Lot <strong>{{SelectedDeleteItem.LotCode}}</strong>
                            ({{SelectedDeleteItem.Lot_Pcs}} Pcs, {{SelectedDeleteItem.Lot_Carat}} Cts)?
                            <br /><br />
                            <small class="text-muted"><i class="fa fa-info-circle"></i> Its pcs/carat will be returned to the parent distribution's pending balance.</small>
                        </p>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn-modal-action btn-modal-reset" data-dismiss="modal" type="button">
                        <i class="fa fa-times"></i> Cancel
                    </button>
                    <button class="btn-modal-action btn-modal-delete" ng-click="ExecuteDelete()" type="button">
                        <i class="fa fa-trash"></i> Yes, Delete
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Upload Lot Images Modal -->
    <div class="modal fade" id="UploadLotImageModal" role="dialog" data-backdrop="static">
        <div class="modal-dialog modal-md">
            <div class="modal-content img-modal-shell-light">
                <div class="modal-header img-modal-header">
                    <div class="modal-header-brand">
                        <i class="fa fa-cloud-upload modal-icon-info"></i>
                        <h4 class="modal-header-title img-modal-title">Upload Lot Images</h4>
                    </div>
                    <button type="button" class="close modal-close-btn" data-dismiss="modal" aria-label="Close">&times;</button>
                </div>
                <div class="modal-body img-modal-body-light">
                    <div class="img-info-card">
                        <div class="row">
                            <div class="col-xs-12 rdl-modal-form-group" style="margin-bottom: 0;">
                                <label class="rdl-modal-label">Selected Lot Code</label>
                                <input type="text" class="rdl-modal-input img-info-readonly-strong" ng-model="UploadModel.LotCode" readonly />
                            </div>
                        </div>
                    </div>

                    <div class="image-dropzone">
                        <input type="file" id="lotImageFiles" multiple accept="image/*" onchange="angular.element(this).scope().OnFileSelected(this)" />
                        <div class="dropzone-icon">
                            <i class="fa fa-cloud-upload"></i>
                        </div>
                        <div class="dropzone-text">Click or Drag &amp; Drop Images Here</div>
                        <div class="dropzone-hint">Supports multiple JPG, PNG, WEBP files (Max 10MB per image)</div>
                    </div>

                    <div class="selected-files-list" ng-if="UploadModel.Files && UploadModel.Files.length > 0">
                        <div class="selected-file-item" ng-repeat="f in UploadModel.Files">
                            <div class="selected-file-name">
                                <i class="fa fa-file-image-o modal-icon-file"></i>
                                <span>{{f.name}}</span>
                            </div>
                            <span class="selected-file-size">{{f.size}}</span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer img-modal-footer-light">
                    <button class="btn-modal-action btn-modal-reset" data-dismiss="modal" type="button" ng-disabled="IsUploading">
                        <i class="fa fa-times"></i> Cancel
                    </button>
                    <button class="btn-modal-action btn-rdl-add btn-upload-compact" ng-click="SubmitUploadImages()" type="button" ng-disabled="IsUploading || !UploadModel.Files || UploadModel.Files.length === 0">
                        <span ng-if="!IsUploading"><i class="fa fa-upload"></i> UPLOAD</span>
                        <span ng-if="IsUploading"><i class="fa fa-spinner fa-spin"></i> Uploading...</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- View Lot Images Modal -->
    <div class="modal fade" id="ViewLotImageModal" role="dialog">
        <div class="modal-dialog modal-lg">
            <div class="modal-content img-modal-shell-dark">
                <div class="modal-header img-modal-header">
                    <div class="modal-header-brand">
                        <i class="fa fa-picture-o modal-icon-info"></i>
                        <h4 class="modal-header-title img-modal-title">Lot Images - {{ActiveLotCode}}</h4>
                    </div>
                    <button type="button" class="close modal-close-btn" data-dismiss="modal" aria-label="Close">&times;</button>
                </div>
                <div class="modal-body img-modal-body-dark">
                    <div ng-if="IsLoadingImages" class="img-loading-state">
                        <i class="fa fa-spinner fa-spin modal-loading-icon"></i>
                        <div>Loading Lot Images...</div>
                    </div>

                    <div ng-if="!IsLoadingImages && (!ImageList || ImageList.length === 0)" class="img-empty-state">
                        <div class="img-empty-icon">
                            <i class="fa fa-picture-o"></i>
                        </div>
                        <h4 class="img-empty-title">No Images Found</h4>
                        <p class="img-empty-text">There are no uploaded images for Lot {{ActiveLotCode}} yet.</p>
                        <button class="btn btn-rdl-add btn-img-empty-upload" ng-click="OpenUploadModal(ActiveViewRow)" data-dismiss="modal">
                            <i class="fa fa-cloud-upload"></i> Upload Images Now
                        </button>
                    </div>

                    <div ng-if="!IsLoadingImages && ImageList && ImageList.length > 0">
                        <div class="image-viewer-container">
                            <button class="viewer-nav-btn viewer-prev-btn" ng-click="PrevImage()" ng-if="ImageList.length > 1" title="Previous Image (Left Arrow)">
                                <i class="fa fa-chevron-left"></i>
                            </button>

                            <div class="viewer-main-img-wrap">
                                <img ng-src="{{ImageList[ActiveImageIndex].ImagePath}}"
                                     alt="Lot Image"
                                     class="viewer-main-img"
                                     onerror="this.src='/Content/images/Symbol1.png';" />
                            </div>

                            <button class="viewer-nav-btn viewer-next-btn" ng-click="NextImage()" ng-if="ImageList.length > 1" title="Next Image (Right Arrow)">
                                <i class="fa fa-chevron-right"></i>
                            </button>

                            <div class="preview-counter-pill" ng-if="ImageList.length > 0">
                                {{ActiveImageIndex + 1}} / {{ImageList.length}}
                            </div>
                        </div>

                        <div class="img-meta-bar">
                            <div>
                                <i class="fa fa-clock-o"></i> Uploaded: <strong class="img-meta-date">{{ImageList[ActiveImageIndex].Created || '-'}}</strong>
                            </div>
                            <div class="img-action-group">
                                <a ng-href="{{ImageList[ActiveImageIndex].ImagePath}}" target="_blank" class="btn btn-xs btn-img-view" title="Open original in new tab">
                                    <i class="fa fa-external-link"></i> Full View
                                </a>
                                <a ng-href="{{ImageList[ActiveImageIndex].ImagePath}}" download class="btn btn-xs btn-img-download" title="Download image">
                                    <i class="fa fa-download"></i> Download
                                </a>
                                <button type="button"
                                        class="btn btn-xs btn-img-delete"
                                        ng-click="DeleteCurrentImage()"
                                        title="Delete this image">
                                    <i class="fa fa-trash-o"></i> Delete
                                </button>
                            </div>
                        </div>

                        <div class="viewer-thumb-strip" ng-if="ImageList.length > 1">
                            <div class="viewer-thumb-item"
                                 ng-repeat="img in ImageList"
                                 ng-class="{'active': $index === ActiveImageIndex}"
                                 ng-click="SelectImage($index)">
                                <img ng-src="{{img.ImagePath}}" class="viewer-thumb-img" onerror="this.src='/Content/images/Symbol1.png';" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer img-modal-footer-dark">
                    <button class="btn-modal-action btn-modal-reset btn-img-modal-close-dark" data-dismiss="modal" type="button">
                        <i class="fa fa-times"></i> Close
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    var appModule;
    try {
        appModule = angular.module('app');
    } catch (e) {
        appModule = angular.module('app', ['ngAnimate', 'ngTouch', 'angularjs-dropdown-multiselect']);
    }

    appModule.controller("LotMasterCtrl", ['$scope', '$http', function ($scope, $http) {
        $scope.List = [];
        $scope.IsLoading = false;
        $scope.SelectedDeleteItem = null;

        // Image Upload & Viewer State
        $scope.UploadModel = { LotID: null, LotCode: '', Files: [] };
        $scope.IsUploading = false;
        $scope.ActiveLotCode = '';
        $scope.ActiveViewRow = null;
        $scope.ImageList = [];
        $scope.ActiveImageIndex = 0;
        $scope.IsLoadingImages = false;

        $scope.OpenAddNew = function () {
            var url = '@Url.Action("LotEntry", "Master")';
            if (window.top && window.top.ChromeTabs && window.top.ChromeTabs.openTab) {
                window.top.ChromeTabs.openTab({ title: 'Lot Entry', url: url, forceReload: true });
            } else {
                window.open(url, '_blank');
            }
        };

        $scope.OpenEdit = function (row) {
            var id = row ? (row.LotID || 0) : 0;
            var url = '@Url.Action("LotEntry", "Master")';
            if (id && parseInt(id) > 0) {
                url += '?id=' + parseInt(id);
            }
            if (window.top && window.top.ChromeTabs && window.top.ChromeTabs.openTab) {
                window.top.ChromeTabs.openTab({ title: 'Lot Entry', url: url, forceReload: true });
            } else {
                window.open(url, '_blank');
            }
        };

        $scope.FetchData = function () {
            $scope.IsLoading = true;
            if (typeof show_loader === 'function') show_loader();

            $http.get('@Url.Action("GetData_For_MST_Lot", "Master")').then(function (response) {
                $scope.IsLoading = false;
                if (typeof hide_loader === 'function') hide_loader();
                $scope.List = (response.data && response.data.List) ? response.data.List : [];
                $scope.InitGrid();
            }, function () {
                $scope.IsLoading = false;
                if (typeof hide_loader === 'function') hide_loader();
                Noty("error", "Error loading lot list from server.");
            });
        };

        $scope.SearchText = '';
        $scope.OnSearchChange = function () {
            var gridInstance = $("#lotGridContainer").dxDataGrid("instance");
            if (gridInstance) gridInstance.searchByText($scope.SearchText || '');
        };

        $scope.ShowColumnChooser = function () {
            var gridInstance = $("#lotGridContainer").dxDataGrid("instance");
            if (gridInstance) gridInstance.showColumnChooser();
        };

        $scope.ExportGrid = function () {
            var gridInstance = $("#lotGridContainer").dxDataGrid("instance");
            if (!gridInstance || typeof ExcelJS === 'undefined') return;
            var workbook = new ExcelJS.Workbook();
            var worksheet = workbook.addWorksheet('Lot');
            DevExpress.excelExporter.exportDataGrid({
                component: gridInstance,
                worksheet: worksheet,
                autoFilterEnabled: true
            }).then(function () {
                workbook.xlsx.writeBuffer().then(function (buffer) {
                    saveAs(new Blob([buffer], { type: 'application/octet-stream' }), 'Lot.xlsx');
                });
            });
        };

        $scope.OpenUploadModal = function (row) {
            $scope.UploadModel = {
                LotID: row ? row.LotID : null,
                LotCode: row ? (row.LotCode || '') : '',
                Files: []
            };
            $('#lotImageFiles').val('');
            $('#UploadLotImageModal').modal('show');
        };

        $scope.OnFileSelected = function (element) {
            $scope.$apply(function () {
                $scope.UploadModel.Files = [];
                if (element.files && element.files.length > 0) {
                    for (var i = 0; i < element.files.length; i++) {
                        $scope.UploadModel.Files.push({
                            name: element.files[i].name,
                            size: (element.files[i].size / 1024).toFixed(1) + ' KB'
                        });
                    }
                }
            });
        };

        $scope.SubmitUploadImages = function () {
            var fileInput = document.getElementById('lotImageFiles');
            if (!fileInput || !fileInput.files || fileInput.files.length === 0) {
                Noty("error", "Please select at least one image to upload.");
                return;
            }

            var formData = new FormData();
            formData.append("LotID", $scope.UploadModel.LotID);
            for (var i = 0; i < fileInput.files.length; i++) {
                formData.append("file_" + i, fileInput.files[i]);
            }

            $scope.IsUploading = true;
            $http.post('@Url.Action("Upload_Lot_Images", "Master")', formData, {
                transformRequest: angular.identity,
                headers: { 'Content-Type': undefined }
            }).then(function (res) {
                $scope.IsUploading = false;
                if (res.data && res.data.success) {
                    Noty("success", res.data.message || "Images uploaded successfully!");
                    $('#UploadLotImageModal').modal('hide');
                    $('#lotImageFiles').val('');
                    $scope.UploadModel.Files = [];
                    $scope.FetchData();
                } else {
                    Noty("error", (res.data && res.data.message) || "Upload failed.");
                }
            }, function () {
                $scope.IsUploading = false;
                Noty("error", "Error uploading images to server.");
            });
        };

        $scope.OpenViewModal = function (row) {
            $scope.ActiveViewRow = row;
            $scope.ActiveLotCode = row ? (row.LotCode || '') : '';
            $scope.ImageList = [];
            $scope.ActiveImageIndex = 0;
            $scope.IsLoadingImages = true;

            $('#ViewLotImageModal').modal('show');

            $http.get('@Url.Action("Get_Lot_Images", "Master")?LotID=' + (row ? row.LotID : 0)).then(function (res) {
                $scope.IsLoadingImages = false;
                if (res.data && res.data.list) {
                    $scope.ImageList = res.data.list;
                    $scope.ActiveImageIndex = 0;
                }
            }, function () {
                $scope.IsLoadingImages = false;
                Noty("error", "Failed to load images from server.");
            });
        };

        $scope.PrevImage = function () {
            if ($scope.ImageList && $scope.ImageList.length > 1) {
                $scope.ActiveImageIndex = ($scope.ActiveImageIndex - 1 + $scope.ImageList.length) % $scope.ImageList.length;
            }
        };

        $scope.NextImage = function () {
            if ($scope.ImageList && $scope.ImageList.length > 1) {
                $scope.ActiveImageIndex = ($scope.ActiveImageIndex + 1) % $scope.ImageList.length;
            }
        };

        $scope.SelectImage = function (index) {
            if (index >= 0 && index < $scope.ImageList.length) {
                $scope.ActiveImageIndex = index;
            }
        };

        $scope.DeleteCurrentImage = function () {
            var currentImg = $scope.ImageList[$scope.ActiveImageIndex];
            if (!currentImg || !currentImg.ID) return;
            if (!confirm("Are you sure you want to permanently delete this image?")) return;

            $http.post('@Url.Action("Delete_Lot_Image", "Master")', { imageId: currentImg.ID }).then(function (res) {
                if (res.data && res.data.success) {
                    Noty("success", "Image deleted successfully!");
                    $scope.ImageList.splice($scope.ActiveImageIndex, 1);
                    if ($scope.ImageList.length > 0) {
                        if ($scope.ActiveImageIndex >= $scope.ImageList.length) {
                            $scope.ActiveImageIndex = $scope.ImageList.length - 1;
                        }
                    } else {
                        $('#ViewLotImageModal').modal('hide');
                        $scope.FetchData();
                    }
                } else {
                    Noty("error", (res.data && res.data.message) || "Failed to delete image.");
                }
            }, function () {
                Noty("error", "Error connecting to server.");
            });
        };

        $scope.ShowQRCode = function (item) {
            if (!item || !item.LotID) return;
            if (typeof show_loader === 'function') show_loader();
            $http.post('@Url.Action("GenerateLotQRs", "Master")', { lotIDs: [item.LotID] }).then(function (res) {
                if (typeof hide_loader === 'function') hide_loader();
                if (res.data && res.data.success) {
                    window.open('@Url.Action("LotQRPrint", "Master")', '_blank');
                } else {
                    Noty("error", (res.data && res.data.message) || "Failed to generate QR code.");
                }
            }, function () {
                if (typeof hide_loader === 'function') hide_loader();
                Noty("error", "Error connecting to server.");
            });
        };

        $scope.PromptDelete = function (item) {
            $scope.SelectedDeleteItem = item;
            $("#ConfirmDeleteModal").modal("show");
        };

        $scope.ExecuteDelete = function () {
            if (!$scope.SelectedDeleteItem || !$scope.SelectedDeleteItem.LotID) {
                $("#ConfirmDeleteModal").modal("hide");
                return;
            }

            $scope.IsLoading = true;
            $http.post('@Url.Action("Lot_Delete", "Master")', { LotID: $scope.SelectedDeleteItem.LotID }).then(function (res) {
                $scope.IsLoading = false;
                $("#ConfirmDeleteModal").modal("hide");
                if (res.data && res.data.success) {
                    Noty("success", res.data.message || "Lot deleted successfully.");
                    $scope.FetchData();
                } else {
                    Noty("error", (res.data && res.data.message) || "Failed to delete lot.");
                }
            }, function () {
                $scope.IsLoading = false;
                $("#ConfirmDeleteModal").modal("hide");
                Noty("error", "Error connecting to server.");
            });
        };

        function ApplyPriorityStyle($el, color) {
            if (!color) return;
            $el.css({ "color": color, "background": color + "22", "border": "1px solid " + color, "font-weight": 700, "padding": "2px 8px", "border-radius": "4px", "display": "inline-block" });
        }

        $scope.InitGrid = function () {
            $("#lotGridContainer").dxDataGrid({
                dataSource: $scope.List,
                keyExpr: 'LotID',
                onRowPrepared: function (e) {
                    if (e.rowType === "data") {
                        e.rowElement.addClass("ri-row-animate");
                        e.rowElement.css("--ri-row-i", e.rowIndex);
                        e.rowElement.find("> td").css({ "border-bottom": "1px solid #e2e8f0", "border-right": "1px solid #e2e8f0" });
                    }
                },
                height: '100%',
                columnAutoWidth: true,
                allowColumnResizing: true,
                columnResizingMode: 'widget',
                allowColumnReordering: true,
                columnChooser: { enabled: true, mode: 'select' },
                columnFixing: { enabled: true },
                showColumnLines: true,
                showRowLines: true,
                showBorders: true,
                rowAlternationEnabled: true,
                wordWrapEnabled: false,
                sorting: { mode: "single" },
                scrolling: { mode: 'virtual' },
                paging: { enabled: false },
                pager: { visible: false },
                searchPanel: { visible: false },
                filterRow: { visible: true, applyFilter: 'auto' },
                headerFilter: { visible: true },
                export: { enabled: false },
                onToolbarPreparing: function (e) {
                    // Column chooser / export / search are rendered in the card
                    // header above the grid instead of the grid's own toolbar row.
                    e.toolbarOptions.items = [];
                },
                columns: [
                    {
                        caption: '#',
                        width: 55,
                        alignment: 'center',
                        allowReordering: false,
                        fixed: true,
                        fixedPosition: 'left',
                        cellTemplate: function (container, options) {
                            $("<span>").text(options.rowIndex + 1).css({ "font-weight": "600", "color": "#64748b" }).appendTo(container);
                        }
                    },
                    {
                        caption: 'R.Code',
                        dataField: 'RCode',
                        minWidth: 110,
                        alignment: 'center',
                        cellTemplate: function (container, options) {
                            var $span = $("<span>").text(options.data.RCode || '-');
                            if (options.data.PriorityColor) {
                                ApplyPriorityStyle($span, options.data.PriorityColor);
                            } else {
                                var priority = (options.data.LotPriority || 'REGULAR').toUpperCase();
                                var cls = 'rcode-regular';
                                if (priority === 'SAMPLE') {
                                    cls = 'rcode-sample';
                                } else if (priority === 'ARGENT' || priority === 'URGENT') {
                                    cls = 'rcode-argent';
                                }
                                $span.addClass(cls);
                            }
                            $span.appendTo(container);
                        }
                    },
                    {
                        caption: 'Branch',
                        dataField: 'BranchName',
                        minWidth: 110,
                        cellTemplate: function (container, options) {
                            $("<strong>")
                                .text(options.data.BranchName || '-')
                                .appendTo(container);
                        }
                    },
                    { caption: 'Department', dataField: 'DepartmentShortName', minWidth: 100 },
                    { caption: 'Head Manager', dataField: 'HeadManagerName', minWidth: 120 },
                    { caption: 'Lot Code', dataField: 'LotCode', minWidth: 120 },
                    {
                        caption: 'LotNo',
                        dataField: 'LotNo',
                        minWidth: 140,
                        alignment: 'center',
                        calculateCellValue: function (data) {
                            if (data.DepartmentShortName == null)
                                return data.LotCode;
                            else
                                return (data.LotCode || '') + '-' + (data.DepartmentShortName || '');
                        },
                        cellTemplate: function (container, options) {
                            var data = options.data;
                            var text = (data.DepartmentShortName == null)
                                ? data.LotCode
                                : (data.LotCode || '') + '-' + (data.DepartmentShortName || '');
                            $("<span>")
                                .addClass("badge-status-pill badge-pill-info")
                                .text(text || '-')
                                .appendTo(container);
                        }
                    },
                    { caption: 'Pcs', dataField: 'Lot_Pcs', dataType: 'number', minWidth: 80, alignment: 'center' },
                    { caption: 'Carat', dataField: 'Lot_Carat', dataType: 'number', format: '#0.000', minWidth: 90, alignment: 'center' },
                    {
                        caption: 'Priority', dataField: 'LotPriority', minWidth: 90, alignment: 'center',
                        cellTemplate: function (container, options) {
                            var $span = $("<span>").text(options.data.LotPriority || '-');
                            if (options.data.PriorityColor) {
                                ApplyPriorityStyle($span, options.data.PriorityColor);
                            }
                            $span.appendTo(container);
                        }
                    },
                    { caption: 'Created Date', dataField: 'CreatedDate', minWidth: 110, alignment: 'center' },
                    { caption: 'Factory Code', dataField: 'FactoryCode', minWidth: 100 },
                    { caption: 'Color Type', dataField: 'ColorType', minWidth: 100 },
                    { caption: 'Size Code', dataField: 'SizeCodeType', minWidth: 100 },
                    { caption: 'Rough Rate', dataField: 'RoughRate', dataType: 'number', minWidth: 90, alignment: 'center' },
                    { caption: 'Remarks', dataField: 'Remarks', minWidth: 140 },
                    {
                        caption: 'Action',
                        width: 200,
                        alignment: 'center',
                        fixed: true,
                        fixedPosition: 'right',
                        allowReordering: false,
                        cellTemplate: function (container, options) {
                            var group = $("<div>").addClass("grid-btn-group");

                            $("<button>")
                                .addClass("grid-action-btn-edit")
                                .attr("title", "Open in Lot Entry")
                                .html('<i class="fa fa-external-link"></i>')
                                .on("click", function () {
                                    $scope.$apply(function () { $scope.OpenEdit(options.data); });
                                })
                                .appendTo(group);

                            $("<button>")
                                .addClass("grid-action-btn-edit")
                                .attr("title", "Show QR Code")
                                .html('<i class="fa fa-qrcode"></i>')
                                .on("click", function (e) {
                                    e.stopPropagation();
                                    $scope.$apply(function () { $scope.ShowQRCode(options.data); });
                                })
                                .appendTo(group);

                            $("<button>")
                                .addClass("grid-action-btn-edit")
                                .attr("title", "Upload Images")
                                .html('<i class="fa fa-cloud-upload"></i>')
                                .on("click", function (e) {
                                    e.stopPropagation();
                                    $scope.$apply(function () { $scope.OpenUploadModal(options.data); });
                                })
                                .appendTo(group);

                            $("<button>")
                                .addClass("grid-action-btn-edit")
                                .attr("title", "View Images")
                                .html('<i class="fa fa-picture-o"></i>')
                                .on("click", function (e) {
                                    e.stopPropagation();
                                    $scope.$apply(function () { $scope.OpenViewModal(options.data); });
                                })
                                .appendTo(group);

                            $("<button>")
                                .addClass("grid-action-btn-del")
                                .attr("title", "Delete Lot")
                                .html('<i class="fa fa-trash"></i>')
                                .on("click", function () {
                                    $scope.$apply(function () { $scope.PromptDelete(options.data); });
                                })
                                .appendTo(group);

                            group.appendTo(container);
                        }
                    }
                ]
            });
        };

        $scope.FetchData();
    }]);
</script>
