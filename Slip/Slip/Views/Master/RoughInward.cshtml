                    if (isSuccess) {
                        Noty("success", (data && data.message) ? data.message : "Lot line deleted successfully!");
                        $scope.SelectedDeleteItem = null;
                        $scope.LoadInwardList();
                    } else {
                        var errMsg = (data && data.message) ? data.message : "Failed to delete lot line.";
