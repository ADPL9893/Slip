        $scope.IsDeleting = false;
        $scope.SelectedDeleteItem = null;

        $scope.NewEmptyLine = function () {
            return {
                InwardDetailID: 0,
                LotNo: '',
                GrowthRate: '',
                AvgGrowthRate: null,
                MachineNo: '',
                Size: '',
                FromHeight: null,
                ToHeight: null,
                Hours: null,
                BoxNo: '',
                RecipeID: null,
                GradeID: null,
                Pcs: 0,
                Carat: 0,
                Rate: 0,
                Amount: 0,
                SizeCode: $scope.FormModel ? ($scope.FormModel.SizeCode || '') : '',
                ColorType: $scope.FormModel ? ($scope.FormModel.ColorType || '') : '',
                Remarks: '',
                IsDelete: false
            };
        };

        $scope.FormModel = {
            InwardID: 0,
            ChallanNo: '',
            ChallanDate: new Date(),
            ChallanDateStr: '',
            FactoryCodeID: null,
            SourceType: 'BRANCH',
            FromBranchID: null,
            FromPartyID: null,
            ToBranchID: null,
            PurposeID: null,
            SizeCode: '',
            ColorType: '',
            Remarks: '',
            IsReadOnly: false,
            Details: [$scope.NewEmptyLine()]
        };

        $scope.OnHeaderSizeCodeChange = function () {
            angular.forEach($scope.FormModel.Details, function (line) {
                line.SizeCode = $scope.FormModel.SizeCode || '';
            });
        };

        $scope.OnHeaderColorTypeChange = function () {
            angular.forEach($scope.FormModel.Details, function (line) {
                line.ColorType = $scope.FormModel.ColorType || '';
            });
        };

        $scope.UpdateBranchFilters = function () {
            $scope.FromBranchList = $scope.BranchList.filter(function (b) {
                return !$scope.FormModel.ToBranchID || b.BranchID !== $scope.FormModel.ToBranchID;
            });
            $scope.ToBranchList = $scope.BranchList.filter(function (b) {
                return $scope.FormModel.SourceType !== 'BRANCH' || !$scope.FormModel.FromBranchID || b.BranchID !== $scope.FormModel.FromBranchID;
            });
            $timeout(function () {
                $('#ModalFromBranchID').trigger('chosen:updated');
                $('#ModalToBranchID').trigger('chosen:updated');
            }, 50);
        };

        $scope.SetSourceType = function (type) {
            $scope.FormModel.SourceType = type;
            if (type === 'BRANCH') {
                $scope.FormModel.FromPartyID = null;
            } else {
                $scope.FormModel.FromBranchID = null;
            }
            $scope.UpdateBranchFilters();
        };

        $scope.AddLine = function () {
            $scope.FormModel.Details.push($scope.NewEmptyLine());
