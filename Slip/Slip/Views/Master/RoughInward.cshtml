        $scope.ExecuteDelete = function () {
            if (!$scope.SelectedDeleteItem || $scope.IsDeleting) return;

            // Extract InwardDetailID properly from the selected row object
            var detailId = $scope.SelectedDeleteItem.InwardDetailID ||
                           $scope.SelectedDeleteItem.inwardDetailID ||
                           $scope.SelectedDeleteItem.InwardID ||
                           (typeof $scope.SelectedDeleteItem === 'number' ? $scope.SelectedDeleteItem : 0);

            if (!detailId) {
                $("#InwardConfirmDeleteModal").modal("hide");
                Noty("error", "No Inward Detail ID found for deletion.");
                return;
            }

            $scope.IsDeleting = true;
            // Explicitly sending InwardDetailID in post data
            $http.post('@Url.Action("RoughInwardDetail_Delete", "Master")', { InwardDetailID: detailId })
                .then(function (res) {
                    $scope.IsDeleting = false;
                    $("#InwardConfirmDeleteModal").modal("hide");

