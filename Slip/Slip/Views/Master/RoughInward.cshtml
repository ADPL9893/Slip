@{
    ViewBag.Title = "Rough Inward";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}


@if (ViewBag.CanView != null && (bool)ViewBag.CanView)
{
<div ng-controller="RoughInwardCtrl" class="ri-page">
    <div class="ri-header-card">
        <div class="ri-header-left">
            <div class="ri-header-icon"><i class="fa fa-truck"></i></div>
            <div>
                <div class="ri-breadcrumb">
                    <a href="@Url.Action("Index", "Home")"><i class="fa fa-home"></i> Home</a> /
                    <span>Rough Inward</span>
                </div>
                <h4 class="ri-header-title">Rough Inward (Jangad)</h4>
            </div>
        </div>
        <div>
            <button class="btn-ri-add-main" type="button" ng-show="CanAdd" ng-click="OpenAddModal()">
                <i class="fa fa-plus"></i> NEW INWARD
            </button>
        </div>
    </div>

    <div class="ri-grid-card">
        <div class="ri-card-header">
            <div class="ri-card-title-left">
                <i class="fa fa-table"></i>
                <h3>Inward Records</h3>
                <span class="badge-status-pill badge-pill-info" style="margin-left: 6px;">
                    <i class="fa fa-database"></i> {{InwardList.length || 0}} Records
                </span>
            </div>
        </div>
        <div class="ri-grid-body">
            <div id="inwardGridContainer" style="width: 100%;"></div>
        </div>
    </div>

    <!-- Add / Edit Modal -->
    <div class="modal fade" id="InwardModal" role="dialog" data-backdrop="static">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <div class="modal-header-flex">
                        <div class="modal-header-title-left">
                            <i class="fa fa-truck modal-title-icon"></i>
                            <h4 class="modal-title">{{FormModel.InwardID > 0 ? 'Edit Rough Inward' : 'New Rough Inward'}}</h4>
                        </div>
                        <button type="button" class="btn-close-header" data-dismiss="modal">&times;</button>
                    </div>
                </div>

                <div class="modal-body">
                    <div class="row ri-from-to-row">
                        <div class="col-md-5 col-sm-12">
                            <fieldset class="ri-fieldset">
                                <legend class="ri-legend">From</legend>
                                <div class="row">
                                    <div class="col-md-5 col-sm-5 col-xs-12 ri-form-group">
                                        <label class="ri-label">SOURCE TYPE <span class="req">*</span></label>
                                        <div class="ri-radio-group">
                                            <label class="ri-radio-option">
                                                <input type="radio" name="riSourceType" value="BRANCH" ng-model="FormModel.SourceType" ng-change="SetSourceType('BRANCH')" />
                                                <span><i class="fa fa-building"></i> Branch</span>
                                            </label>
                                            <label class="ri-radio-option">
                                                <input type="radio" name="riSourceType" value="PARTY" ng-model="FormModel.SourceType" ng-change="SetSourceType('PARTY')" />
                                                <span><i class="fa fa-handshake-o"></i> Party</span>
                                            </label>
                                        </div>
                                    </div>
                                    <div class="col-md-7 col-sm-7 col-xs-12 ri-form-group" ng-if="FormModel.SourceType === 'BRANCH'">
                                        <label class="ri-label" for="ModalFromBranchID">BRANCH <span class="req">*</span></label>
                                        <select id="ModalFromBranchID" chosen="FromBranchList" class="form-control ri-input" ng-model="FormModel.FromBranchID" ng-change="UpdateBranchFilters()" ng-options="item.BranchID as item.BranchName for item in FromBranchList">
                                            <option value="">Select Branch</option>
                                        </select>
                                    </div>
                                    <div class="col-md-7 col-sm-7 col-xs-12 ri-form-group" ng-if="FormModel.SourceType === 'PARTY'">
                                        <label class="ri-label" for="ModalFromPartyID">PARTY <span class="req">*</span></label>
                                        <select id="ModalFromPartyID" chosen="PartyList" class="form-control ri-input" ng-model="FormModel.FromPartyID" ng-options="item.PartyId as item.PartyName for item in PartyList">
                                            <option value="">Select Party</option>
                                        </select>
                                    </div>
                                </div>
                            </fieldset>
                        </div>
                        <div class="col-md-3 col-sm-12">
                            <fieldset class="ri-fieldset">
                                <legend class="ri-legend">To</legend>
                                <div class="row">
                                    <div class="col-md-12 ri-form-group">
                                        <label class="ri-label" for="ModalToBranchID">COMPANY BRANCH <span class="req">*</span></label>
                                        <select id="ModalToBranchID" chosen="ToBranchList" class="form-control ri-input" ng-model="FormModel.ToBranchID" ng-change="UpdateBranchFilters()" ng-options="item.BranchID as item.BranchName for item in ToBranchList">
                                            <option value="">Select Branch</option>
                                        </select>
                                    </div>
                                </div>
                            </fieldset>
                        </div>
                        <div class="col-md-4 col-sm-12">
                            <fieldset class="ri-fieldset">
                                <legend class="ri-legend">Challan</legend>
                                <div class="row">
                                    <div class="col-md-5 col-sm-5 col-xs-6 ri-form-group">
                                        <label class="ri-label" for="ModalChallanNo">CHALLAN NO <span class="req">*</span></label>
                                        <input type="text" id="ModalChallanNo" ng-model="FormModel.ChallanNo" placeholder="Enter Challan No" class="ri-input" />
                                    </div>
                                    <div class="col-md-7 col-sm-7 col-xs-6 ri-form-group">
                                        <label class="ri-label" for="ModalChallanDate">CHALLAN DATE <span class="req">*</span></label>
                                        <input type="date" id="ModalChallanDate" ng-model="FormModel.ChallanDate" class="ri-input" />
                                    </div>
                                </div>
                            </fieldset>
                        </div>
                    </div>

                    <div class="ri-modal-section" style="margin-bottom: 5px;">
                        <div class="ri-modal-section-title"><i class="fa fa-list text-primary"></i> JANGAD / LOT LINES</div>
                        <div class="row">
                            <div class="col-md-4 col-sm-4 col-xs-12 ri-form-group">
                                <label class="ri-label" for="ModalFactoryCodeID">FACTORY CODE</label>
                                <select id="ModalFactoryCodeID" chosen="FactoryCodeList" class="form-control ri-input" ng-model="FormModel.FactoryCodeID" ng-options="item.FactoryCodeID as item.FactoryCode for item in FactoryCodeList">
                                    <option value="">Select Factory Code</option>
                                </select>
                            </div>
                            <div class="col-md-4 col-sm-4 col-xs-12 ri-form-group">
                                <label class="ri-label" for="ModalPurposeID">PURPOSE <span class="req">*</span></label>
                                <select id="ModalPurposeID" chosen="PurposeList" class="form-control ri-input" ng-model="FormModel.PurposeID" ng-options="item.PurposeID as item.PurposeName for item in PurposeList">
                                    <option value="">Select Purpose</option>
                                </select>
                            </div>
                            <div class="col-md-4 col-sm-4 col-xs-12 ri-form-group">
                                <label class="ri-label" for="ModalRemarks">REMARKS</label>
                                <input type="text" id="ModalRemarks" ng-model="FormModel.Remarks" placeholder="Enter Remarks" class="ri-input" />
                            </div>
                        </div>
                        <div class="ri-lines-table-wrap">
                        <table class="ri-lines-table">
                            <thead>
                                <tr>
                                    <th style="width: 36px;">#</th>
                                    <th style="min-width: 130px;">Lot No</th>
                                    <th style="width: 100px;">Growth Rate</th>
                                    <th style="width: 100px;">Avg Growth Rate</th>
                                    <th style="width: 120px;">Recipe</th>
                                    <th style="width: 100px;">Grade</th>
                                    <th style="width: 70px;">Pcs</th>
                                    <th style="width: 90px;">Carat</th>
                                    <th style="width: 100px;">Rate</th>
                                    <th style="width: 110px;">Amount</th>
                                    <th style="width: 40px;"></th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="line in FormModel.Details track by $index">
                                    <td>{{$index + 1}}</td>
                                    <td><input type="text" class="ri-lot-input" ng-model="line.LotNo" placeholder="Lot No" /></td>
                                    <td><input type="text" ng-model="line.GrowthRate" placeholder="Growth Rate" /></td>
                                    <td><input type="number" ng-model="line.AvgGrowthRate" min="0" step="0.01" placeholder="Avg Growth Rate" /></td>
                                    <td>
                                        <select ng-model="line.RecipeID" ng-options="item.ReceipeID as item.Receipe for item in RecipeList">
                                            <option value="">Select</option>
                                        </select>
                                    </td>
                                    <td>
                                        <select ng-model="line.GradeID" ng-options="item.GradeID as item.Grade for item in GradeList">
                                            <option value="">Select</option>
                                        </select>
                                    </td>
                                    <td><input type="number" ng-model="line.Pcs" min="0" /></td>
                                    <td><input type="number" ng-model="line.Carat" min="0" step="0.01" ng-change="RecalcLine(line)" /></td>
                                    <td><input type="number" ng-model="line.Rate" min="0" step="0.01" ng-change="RecalcLine(line)" /></td>
                                    <td class="ri-amount-cell">{{(line.Amount || 0) | number:2}}</td>
                                    <td>
                                        <button type="button" class="btn-ri-del-row" ng-click="RemoveLine($index)" title="Remove row">
                                            <i class="fa fa-times"></i>
                                        </button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        </div>
                        <button type="button" class="btn-ri-add-row" ng-click="AddLine()">
                            <i class="fa fa-plus"></i> Add Row
                        </button>

                        <div class="ri-totals-bar">
                            <div><span class="lbl">Total Pcs:</span> {{GetTotalPcs()}}</div>
                            <div><span class="lbl">Total Carat:</span> {{GetTotalCarat() | number:3}}</div>
                            <div><span class="lbl">Total Amount:</span> {{GetTotalAmount() | number:2}}</div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button class="btn-ri-reset" type="button" ng-click="ResetForm()">
                        <i class="fa fa-refresh"></i> Reset
                    </button>
                    <button class="btn-ri-save" type="button" ng-click="SaveInward()" ng-disabled="IsSaving">
                        <i class="fa fa-check" ng-class="{'fa-spin fa-spinner': IsSaving}"></i>
                        {{FormModel.InwardID > 0 ? 'UPDATE' : 'SAVE'}}
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Delete Confirmation Modal -->
    <div class="modal fade" id="InwardConfirmDeleteModal" role="dialog" data-backdrop="static">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header" style="background: #111827 !important; padding: 12px 18px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
                        <h4 class="modal-title" style="font-size: 14px; font-weight: 700; color: #ffffff; margin: 0;">Confirm Delete</h4>
                        <button type="button" class="btn-close-header" data-dismiss="modal">&times;</button>
                    </div>
                </div>
                <div class="modal-body text-center" style="padding: 20px; background: #ffffff;">
                    <i class="fa fa-trash-o text-danger" style="font-size: 38px; margin-bottom: 12px; display: block;"></i>
                    <p style="font-size: 13px; color: #334155; margin: 0;">
                        Are you sure you want to delete Rough Inward <strong>{{SelectedDeleteItem.ChallanNo}}</strong>?
                    </p>
                </div>
                <div class="modal-footer" style="padding: 10px 18px; background: #f8fafc;">
                    <button class="btn btn-default btn-sm" data-dismiss="modal" type="button" style="font-weight: 600;">Cancel</button>
                    <button class="btn btn-danger btn-sm" ng-click="ExecuteDelete()" type="button" style="font-weight: 600;">Delete</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    var module;
    try {
        module = angular.module('app');
    } catch (e) {
        module = angular.module('app', ['ngAnimate', 'ngTouch']);
    }

    try {
        module.directive('chosen', ['$timeout', function ($timeout) {
            return {
                restrict: 'A',
                link: function (scope, element, attrs) {
                    var list = attrs['chosen'];
                    if (list) {
                        scope.$watchCollection(list, function () {
                            $timeout(function () { element.trigger('chosen:updated'); }, 50);
                        });
                    }
                    if (attrs['ngModel']) {
                        scope.$watch(attrs['ngModel'], function () {
                            $timeout(function () { element.trigger('chosen:updated'); }, 50);
                        });
                    }
                    element.chosen({ width: '100%', search_contains: true, allow_single_deselect: true });
                }
            };
        }]);
    } catch (e) { /* chosen directive already registered on this module */ }

    module.controller("RoughInwardCtrl", ['$scope', '$http', '$timeout', function ($scope, $http, $timeout) {
        $scope.CanAdd = ('@ViewBag.CanAdd' === 'True' || '@ViewBag.IsAdmin' === 'True');
        $scope.CanEdit = ('@ViewBag.CanEdit' === 'True' || '@ViewBag.IsAdmin' === 'True');
        $scope.CanDelete = ('@ViewBag.CanDelete' === 'True' || '@ViewBag.IsAdmin' === 'True');
        $scope.IsAdmin = ('@ViewBag.IsAdmin' === 'True');

        $scope.InwardList = [];
        $scope.PurposeList = [];
        $scope.BranchList = [];
        $scope.PartyList = [];
        $scope.FromBranchList = [];
        $scope.ToBranchList = [];
        $scope.RecipeList = [];
        $scope.GradeList = [];
        $scope.FactoryCodeList = [];
        $scope.IsLoading = false;
        $scope.IsSaving = false;
        $scope.SelectedDeleteItem = null;

        $scope.NewEmptyLine = function () {
            return {
                LotNo: '', GrowthRate: '', AvgGrowthRate: null, RecipeID: null, GradeID: null,
                Pcs: 0, Carat: 0, Rate: 0, Amount: 0, Remarks: ''
            };
        };

        $scope.FormModel = {
            InwardID: 0,
            ChallanNo: '',
            ChallanDate: '',
            FactoryCodeID: null,
            SourceType: 'BRANCH',
            FromBranchID: null,
            FromPartyID: null,
            ToBranchID: null,
            PurposeID: null,
            Remarks: '',
            Details: [$scope.NewEmptyLine()]
        };

        $scope.UpdateBranchFilters = function () {
            $scope.FromBranchList = $scope.BranchList.filter(function (b) {
                return !$scope.FormModel.ToBranchID || b.BranchID !== $scope.FormModel.ToBranchID;
            });
            $scope.ToBranchList = $scope.BranchList.filter(function (b) {
                return $scope.FormModel.SourceType !== 'BRANCH' || !$scope.FormModel.FromBranchID || b.BranchID !== $scope.FormModel.FromBranchID;
            });
            $timeout(function () {
                $('#ModalFromBranchID').trigger('chosen:updated');
                $('#ModalToBranchID').trigger('chosen:updated');
            }, 50);
        };

        $scope.SetSourceType = function (type) {
            $scope.FormModel.SourceType = type;
            if (type === 'BRANCH') {
                $scope.FormModel.FromPartyID = null;
            } else {
                $scope.FormModel.FromBranchID = null;
            }
            $scope.UpdateBranchFilters();
        };

        $scope.AddLine = function () {
            $scope.FormModel.Details.push($scope.NewEmptyLine());
        };

        $scope.RemoveLine = function (index) {
            if ($scope.FormModel.Details.length <= 1) {
                $scope.FormModel.Details[0] = $scope.NewEmptyLine();
                return;
            }
            $scope.FormModel.Details.splice(index, 1);
        };

        $scope.RecalcLine = function (line) {
            var carat = parseFloat(line.Carat) || 0;
            var rate = parseFloat(line.Rate) || 0;
            line.Amount = Math.round(carat * rate * 100) / 100;
        };

        $scope.GetTotalPcs = function () {
            var total = 0;
            angular.forEach($scope.FormModel.Details, function (l) { total += parseInt(l.Pcs) || 0; });
            return total;
        };
        $scope.GetTotalCarat = function () {
            var total = 0;
            angular.forEach($scope.FormModel.Details, function (l) { total += parseFloat(l.Carat) || 0; });
            return total;
        };
        $scope.GetTotalAmount = function () {
            var total = 0;
            angular.forEach($scope.FormModel.Details, function (l) { total += parseFloat(l.Amount) || 0; });
            return total;
        };

        $scope.OpenAddModal = function () {
            $scope.ResetForm();
            $("#InwardModal").modal("show");
            $timeout(function () {
                $('#ModalPurposeID').trigger('chosen:updated');
                $('#ModalFromBranchID').trigger('chosen:updated');
                $('#ModalFromPartyID').trigger('chosen:updated');
                $('#ModalFactoryCodeID').trigger('chosen:updated');
                $('#ModalToBranchID').trigger('chosen:updated');
            }, 60);
        };

        $scope.ResetForm = function () {
            $scope.FormModel = {
                InwardID: 0,
                ChallanNo: '',
                ChallanDate: new Date().toISOString().substring(0, 10),
                FactoryCodeID: null,
                SourceType: 'BRANCH',
                FromBranchID: null,
                FromPartyID: null,
                ToBranchID: null,
                PurposeID: null,
                Remarks: '',
                Details: [$scope.NewEmptyLine()]
            };
            $scope.UpdateBranchFilters();
            $timeout(function () {
                $('#ModalPurposeID').trigger('chosen:updated');
                $('#ModalFromBranchID').trigger('chosen:updated');
                $('#ModalFromPartyID').trigger('chosen:updated');
                $('#ModalFactoryCodeID').trigger('chosen:updated');
                $('#ModalToBranchID').trigger('chosen:updated');
            }, 40);
        };

        $scope.EditItem = function (item) {
            if (!item || !item.InwardID) return;
            $http.get('@Url.Action("Get_TRN_RoughInwardById", "Master")', { params: { InwardID: item.InwardID } })
                .then(function (res) {
                    if (res.data && res.data.success && res.data.item) {
                        var data = res.data.item;
                        $scope.FormModel = {
                            InwardID: data.InwardID,
                            ChallanNo: data.ChallanNo || '',
                            ChallanDate: data.ChallanDate ? data.ChallanDate.substring(0, 10) : '',
                            FactoryCodeID: data.FactoryCodeID,
                            SourceType: data.SourceType || 'BRANCH',
                            FromBranchID: data.FromBranchID,
                            FromPartyID: data.FromPartyID,
                            ToBranchID: data.ToBranchID,
                            PurposeID: data.PurposeID,
                            Remarks: data.Remarks || '',
                            Details: (data.Details && data.Details.length > 0) ? data.Details : [$scope.NewEmptyLine()]
                        };
                        $scope.UpdateBranchFilters();
                        $("#InwardModal").modal("show");
                        $timeout(function () {
                            $('#ModalPurposeID').trigger('chosen:updated');
                            $('#ModalFromBranchID').trigger('chosen:updated');
                            $('#ModalFromPartyID').trigger('chosen:updated');
                            $('#ModalFactoryCodeID').trigger('chosen:updated');
                            $('#ModalToBranchID').trigger('chosen:updated');
                        }, 80);
                    } else {
                        Noty("error", (res.data && res.data.message) || "Failed to load Rough Inward details.");
                    }
                }, function () {
                    Noty("error", "Error connecting to server.");
                });
        };

        $scope.PromptDelete = function (item) {
            if (!item || !item.InwardID) return;
            $scope.SelectedDeleteItem = item;
            $("#InwardConfirmDeleteModal").modal("show");
        };

        $scope.ExecuteDelete = function () {
            if (!$scope.SelectedDeleteItem) return;
            $http.post('@Url.Action("RoughInward_Delete", "Master")', { InwardID: $scope.SelectedDeleteItem.InwardID })
                .then(function (res) {
                    $("#InwardConfirmDeleteModal").modal("hide");
                    if (res.data && res.data.success) {
                        Noty("success", res.data.message || "Rough Inward deleted successfully!");
                        $scope.LoadInwardList();
                    } else {
                        Noty("error", (res.data && res.data.message) || "Failed to delete Rough Inward.");
                    }
                }, function () {
                    $("#InwardConfirmDeleteModal").modal("hide");
                    Noty("error", "Error connecting to server.");
                });
        };

        $scope.LoadPurposes = function () {
            $http.get('@Url.Action("Get_MST_PurposeList", "Master")').then(function (res) {
                if (res.data && res.data.success) {
                    $scope.PurposeList = res.data.list || [];
                    $timeout(function () { $('#ModalPurposeID').trigger('chosen:updated'); }, 100);
                }
            });
        };

        $scope.LoadBranches = function () {
            $http.get('@Url.Action("Get_MST_BranchList", "Master")').then(function (res) {
                if (res.data && res.data.success) {
                    $scope.BranchList = res.data.list || [];
                    $scope.UpdateBranchFilters();
                }
            });
        };

        $scope.LoadParties = function () {
            $http.get('@Url.Action("Get_MST_PartyMasterList", "Master")').then(function (res) {
                if (res.data && res.data.success) {
                    $scope.PartyList = res.data.list || [];
                    $timeout(function () { $('#ModalFromPartyID').trigger('chosen:updated'); }, 100);
                }
            });
        };

        $scope.LoadRecipes = function () {
            $http.get('@Url.Action("Get_MST_ReceipeList", "Master")').then(function (res) {
                if (res.data && res.data.success) {
                    $scope.RecipeList = res.data.list || [];
                }
            });
        };

        $scope.LoadGrades = function () {
            $http.get('@Url.Action("Get_MST_GradeList", "Master")').then(function (res) {
                if (res.data && res.data.success) {
                    $scope.GradeList = res.data.list || [];
                }
            });
        };

        $scope.LoadFactoryCodes = function () {
            $http.get('@Url.Action("Get_MST_FactoryCodeList", "Master")').then(function (res) {
                if (res.data && res.data.success) {
                    $scope.FactoryCodeList = res.data.list || [];
                    $timeout(function () { $('#ModalFactoryCodeID').trigger('chosen:updated'); }, 100);
                }
            });
        };

        $scope.GetGridInstance = function () {
            var $el = $("#inwardGridContainer");
            if (!$el.data("dxDataGrid")) {
                return null;
            }
            return $el.dxDataGrid("instance");
        };

        $scope.LoadInwardList = function (searchText) {
            $scope.IsLoading = true;
            $http.get('@Url.Action("Get_TRN_RoughInwardList", "Master")', { params: { SearchText: searchText || '' } })
                .then(function (res) {
                    $scope.IsLoading = false;
                    if (res.data && res.data.success) {
                        $scope.InwardList = res.data.list || [];
                        $scope.InitGrid();
                    } else {
                        Noty("error", (res.data && res.data.message) || "Failed to load Rough Inward records.");
                    }
                }, function () {
                    $scope.IsLoading = false;
                    Noty("error", "Error connecting to server.");
                });
        };

        $scope.SaveInward = function () {
            if (!$scope.FormModel.ChallanNo) {
                Noty("error", "Please enter Challan No!");
                $('#ModalChallanNo').focus();
                return;
            }
            if (!$scope.FormModel.ChallanDate) {
                Noty("error", "Please select Challan Date!");
                $('#ModalChallanDate').focus();
                return;
            }
            if (!$scope.FormModel.PurposeID) {
                Noty("error", "Please select Purpose!");
                $('#ModalPurposeID').trigger('chosen:open');
                return;
            }
            if ($scope.FormModel.SourceType === 'BRANCH' && !$scope.FormModel.FromBranchID) {
                Noty("error", "Please select From Branch!");
                $('#ModalFromBranchID').trigger('chosen:open');
                return;
            }
            if ($scope.FormModel.SourceType === 'PARTY' && !$scope.FormModel.FromPartyID) {
                Noty("error", "Please select From Party!");
                $('#ModalFromPartyID').trigger('chosen:open');
                return;
            }
            if (!$scope.FormModel.ToBranchID) {
                Noty("error", "Please select To (Company Branch)!");
                $('#ModalToBranchID').trigger('chosen:open');
                return;
            }
            if ($scope.FormModel.SourceType === 'BRANCH' && $scope.FormModel.FromBranchID === $scope.FormModel.ToBranchID) {
                Noty("error", "From Branch and To Branch cannot be the same!");
                return;
            }
            var validLines = $scope.FormModel.Details.filter(function (l) { return l.LotNo && l.LotNo.trim() !== ''; });
            if (validLines.length === 0) {
                Noty("error", "Please add at least one Lot line with Lot No!");
                return;
            }

            var action = ($scope.FormModel.InwardID > 0) ? 'UPDATE' : 'INSERT';
            $scope.IsSaving = true;

            $http.post('@Url.Action("RoughInward_Save", "Master")', { model: $scope.FormModel, Action: action })
                .then(function (res) {
                    $scope.IsSaving = false;
                    if (res.data && res.data.success) {
                        $("#InwardModal").modal("hide");
                        Noty("success", res.data.message || (action === 'UPDATE' ? "Rough Inward updated successfully!" : "Rough Inward saved successfully!"));
                        $scope.ResetForm();
                        $scope.LoadInwardList();
                    } else {
                        Noty("error", (res.data && res.data.message) || "Failed to save Rough Inward.");
                    }
                }, function () {
                    $scope.IsSaving = false;
                    Noty("error", "Error saving Rough Inward to server.");
                });
        };

        $scope.InitGrid = function () {
            var gridInstance = $scope.GetGridInstance();
            if (gridInstance) {
                gridInstance.option("dataSource", $scope.InwardList);
                return;
            }
            $("#inwardGridContainer").dxDataGrid({
                dataSource: $scope.InwardList,
                keyExpr: 'InwardID',
                height: 'calc(100vh - 210px)',
                columnAutoWidth: true,
                allowColumnResizing: true,
                columnResizingMode: 'widget',
                showColumnLines: true,
                showRowLines: true,
                showBorders: true,
                sorting: { mode: "multiple" },
                scrolling: { mode: 'standard', rowRenderingMode: 'standard' },
                paging: { enabled: false },
                pager: { visible: false },
                searchPanel: { visible: true, width: 250, placeholder: 'Search inward...' },
                filterRow: { visible: true },
                headerFilter: { visible: true },
                columns: [
                    {
                        caption: '#', width: 45, alignment: 'center',
                        cellTemplate: function (container, options) {
                            $("<span>").text(options.rowIndex + 1).css({ "font-weight": "600", "color": "#64748b" }).appendTo(container);
                        }
                    },
                    {
                        caption: 'Challan No', dataField: 'ChallanNo', minWidth: 120,
                        cellTemplate: function (container, options) {
                            $("<strong>").text(options.data.ChallanNo).css({ "color": "#1e293b" }).appendTo(container);
                        }
                    },
                    {
                        caption: 'Date', dataField: 'ChallanDate', width: 110, dataType: 'date', format: 'dd-MMM-yyyy'
                    },
                    {
                        caption: 'Factory Code', dataField: 'FactoryCodeName', width: 110
                    },
                    {
                        caption: 'Source', dataField: 'SourceType', width: 100, alignment: 'center',
                        cellTemplate: function (container, options) {
                            if (options.data.SourceType === 'BRANCH') {
                                $("<span>").addClass("badge-status-pill badge-pill-info").text("Branch").appendTo(container);
                            } else {
                                $("<span>").addClass("badge-status-pill badge-pill-warning").text("Party").appendTo(container);
                            }
                        }
                    },
                    {
                        caption: 'From', minWidth: 150,
                        calculateCellValue: function (data) { return data.SourceType === 'BRANCH' ? data.FromBranchName : data.PartyName; }
                    },
                    { caption: 'To Branch', dataField: 'ToBranchName', minWidth: 130 },
                    { caption: 'Purpose', dataField: 'PurposeName', width: 110 },
                    { caption: 'Total Pcs', dataField: 'TotalPcs', width: 90, alignment: 'right' },
                    { caption: 'Total Carat', dataField: 'TotalCarat', width: 100, alignment: 'right', format: { type: 'fixedPoint', precision: 3 } },
                    { caption: 'Total Amount', dataField: 'TotalAmount', width: 120, alignment: 'right', format: { type: 'fixedPoint', precision: 2 } },
                    {
                        caption: 'Action', width: 100, alignment: 'center', fixed: true, fixedPosition: 'right',
                        visible: ($scope.CanEdit || $scope.CanDelete),
                        cellTemplate: function (container, options) {
                            var div = $("<div>").addClass("grid-btn-group");

                            if ($scope.CanEdit) {
                                $("<button>").addClass("grid-btn-edit").attr("title", "Edit Inward").html('<i class="fa fa-pencil"></i>')
                                    .on("click", function () { $scope.$apply(function () { $scope.EditItem(options.data); }); })
                                    .appendTo(div);
                            }

                            if ($scope.CanDelete) {
                                $("<button>").addClass("grid-btn-del").attr("title", "Delete Inward").html('<i class="fa fa-trash-o"></i>')
                                    .on("click", function () { $scope.$apply(function () { $scope.PromptDelete(options.data); }); })
                                    .appendTo(div);
                            }

                            div.appendTo(container);
                        }
                    }
                ]
            });
        };

        $scope.LoadPurposes();
        $scope.LoadBranches();
        $scope.LoadParties();
        $scope.LoadRecipes();
        $scope.LoadGrades();
        $scope.LoadFactoryCodes();
        $scope.LoadInwardList();
        $scope.ResetForm();
    }]);
</script>
}
else
{
    <div class="container-fluid" style="margin-top: 25px;">
        <div class="alert alert-danger text-center" style="border-radius: 8px; font-size: 14px; padding: 20px; box-shadow: 0 4px 12px rgba(239, 68, 68, 0.12);">
            <h4 style="margin-top: 0; font-weight: 700;"><i class="fa fa-ban"></i> Access Denied</h4>
            <p style="margin-bottom: 0;">You do not have permission to view the <strong>Rough Inward</strong> module. Please contact your administrator to request access.</p>
        </div>
    </div>
}
