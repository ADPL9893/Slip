        $scope.SaveInward = function () {
            if (!$scope.FormModel.ChallanNo) {
                Noty("error", "Please enter Challan No!");
                $('#ModalChallanNo').focus();
                return;
            }
            var dateObj = $scope.FormModel.ChallanDate;
            var finalDateStr = '';
            if (dateObj instanceof Date && !isNaN(dateObj.getTime())) {
                finalDateStr = $scope.FormatDateYMD(dateObj);
            } else if ($('#ModalChallanDate').val()) {
                finalDateStr = $('#ModalChallanDate').val();
            } else if (typeof $scope.FormModel.ChallanDate === 'string' && $scope.FormModel.ChallanDate) {
                finalDateStr = $scope.FormModel.ChallanDate;
            }

            if (!finalDateStr) {
                Noty("error", "Please select Challan Date!");
                $('#ModalChallanDate').focus();
                return;
            }
            if (!$scope.FormModel.PurposeID) {
                Noty("error", "Please select Purpose!");
                $('#ModalPurposeID').trigger('chosen:open');
                return;
            }
            if (!$scope.FormModel.FactoryCodeID) {
                Noty("error", "Please select Factory Code!");
                $('#ModalFactoryCodeID').trigger('chosen:open');
                return;
            }
            if (!$scope.FormModel.SizeCode) {
                Noty("error", "Please select Size Code!");
                $('#ModalSizeCode').trigger('chosen:open');
                return;
            }
            if (!$scope.FormModel.ColorType) {
                Noty("error", "Please select Color Type!");
                $('#ModalColorType').trigger('chosen:open');
                return;
            }
            if ($scope.FormModel.SourceType === 'BRANCH' && !$scope.FormModel.FromBranchID) {
                Noty("error", "Please select From Branch!");
                $('#ModalFromBranchID').trigger('chosen:open');
                return;
            }
            if ($scope.FormModel.SourceType === 'PARTY' && !$scope.FormModel.FromPartyID) {
                Noty("error", "Please select From Party!");
                $('#ModalFromPartyID').trigger('chosen:open');
                return;
            }
            if (!$scope.FormModel.ToBranchID) {
                Noty("error", "Please select To (Company Branch)!");
                $('#ModalToBranchID').trigger('chosen:open');
                return;
            }
            if ($scope.FormModel.SourceType === 'BRANCH' && $scope.FormModel.FromBranchID === $scope.FormModel.ToBranchID) {
                Noty("error", "From Branch and To Branch cannot be the same!");
                return;
            }

            if (!$scope.FormModel.Details || $scope.FormModel.Details.length === 0) {
                Noty("error", "Please add at least one Lot line!");
                return;
            }

            for (var i = 0; i < $scope.FormModel.Details.length; i++) {
                var line = $scope.FormModel.Details[i];
                if (line.IsDelete) continue;
                var rowNum = i + 1;
                if (!line.LotNo || line.LotNo.trim() === '') {
                    Noty("error", "Please enter Lot No in row #" + rowNum + "!");
                    return;
                }
                if (!line.Size || line.Size.trim() === '') {
                    Noty("error", "Please enter Size in row #" + rowNum + "!");
                    return;
                }
                if (line.FromHeight === null || line.FromHeight === undefined || line.FromHeight === '') {
                    Noty("error", "Please enter From Height in row #" + rowNum + "!");
                    return;
                }
                if (line.ToHeight === null || line.ToHeight === undefined || line.ToHeight === '') {
                    Noty("error", "Please enter To Height in row #" + rowNum + "!");
                    return;
                }
                if (!line.BoxNo || line.BoxNo.trim() === '') {
                    Noty("error", "Please enter Box No in row #" + rowNum + "!");
                    return;
                }
                if (!line.RecipeID) {
                    Noty("error", "Please select Recipe in row #" + rowNum + "!");
                    return;
                }
                if (!line.GradeID) {
                    Noty("error", "Please select Grade in row #" + rowNum + "!");
                    return;
                }
            }

            angular.forEach($scope.FormModel.Details, function (line) {
                line.MachineNo = line.MachineNo ? line.MachineNo.trim() : '';
                line.Size = line.Size ? line.Size.trim() : '';
                line.BoxNo = line.BoxNo ? line.BoxNo.trim() : '';
                line.SizeCode = line.SizeCode ? line.SizeCode.trim() : '';
                line.ColorType = line.ColorType ? line.ColorType.trim() : '';
                line.Remarks = line.Remarks ? line.Remarks.trim() : '';
                line.FromHeight = (line.FromHeight !== null && line.FromHeight !== undefined && line.FromHeight !== '') ? parseFloat(line.FromHeight) : null;
                line.ToHeight = (line.ToHeight !== null && line.ToHeight !== undefined && line.ToHeight !== '') ? parseFloat(line.ToHeight) : null;
                line.Hours = (line.Hours !== null && line.Hours !== undefined && line.Hours !== '') ? parseFloat(line.Hours) : null;
                line.AvgGrowthRate = (line.AvgGrowthRate !== null && line.AvgGrowthRate !== undefined && line.AvgGrowthRate !== '') ? parseFloat(line.AvgGrowthRate) : null;
            });

            var action = ($scope.FormModel.InwardID > 0) ? 'UPDATE' : 'INSERT';
            $scope.IsSaving = true;

            var postModel = angular.copy($scope.FormModel);
            postModel.ChallanDate = finalDateStr;
            postModel.ChallanDateStr = finalDateStr;

            $http.post('@Url.Action("RoughInward_Save", "Master")', { model: postModel, Action: action })
                .then(function (res) {
                    $scope.IsSaving = false;
                    if (res.data && res.data.success) {
                        $("#InwardModal").modal("hide");
                        Noty("success", res.data.message || (action === 'UPDATE' ? "Rough Inward updated successfully!" : "Rough Inward saved successfully!"));
                        $scope.ResetForm();
                        $scope.LoadInwardList();
                    } else {
                        Noty("error", (res.data && res.data.message) || "Failed to save Rough Inward.");
                    }
                }, function () {
                    $scope.IsSaving = false;
                    Noty("error", "Error saving Rough Inward to server.");
                });
        };

