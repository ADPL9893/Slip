        $scope.FormatDateYMD = function (d) {
            if (!d) return '';
            if (!(d instanceof Date)) {
                d = $scope.ParseDateObj(d);
            }
            if (!d || isNaN(d.getTime())) return '';
            var yyyy = d.getFullYear();
            var mm = ('0' + (d.getMonth() + 1)).slice(-2);
            var dd = ('0' + d.getDate()).slice(-2);
            return yyyy + '-' + mm + '-' + dd;
        };

        $scope.ParseDateObj = function (val) {
            if (!val) return new Date();
            if (val instanceof Date) return val;
            if (typeof val === 'string' && val.indexOf('/Date(') !== -1) {
                var num = parseInt(val.replace(/\/Date\((\d+).*/, '$1'), 10);
                return !isNaN(num) ? new Date(num) : new Date();
            }
            if (typeof val === 'string') {
                var parts = val.substring(0, 10).split('-');
                if (parts.length === 3) {
                    var y = parseInt(parts[0], 10);
                    var m = parseInt(parts[1], 10) - 1;
                    var d = parseInt(parts[2], 10);
                    return new Date(y, m, d);
                }
            }
            var dt = new Date(val);
            return isNaN(dt.getTime()) ? new Date() : dt;
        };

