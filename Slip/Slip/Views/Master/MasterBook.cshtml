                            <tr class="clv-total-row"><td>TOTAL</td><td>{{fmt(ClvSum(ClvChartData.list14,'PolishWeight'),2)}}</td><td>100</td></tr>
                        </table>

                        <!-- CT UP ROUND / CT UP FANCY (GradType breakdown) -->
                        <div class="clv-section-row">
                            <table class="clv-plain-table clv-data-table">
                                <tr><th class="clv-table-title" colspan="5">CT UP ROUND</th></tr>
                                <tr><th>GradType</th><th>Pcs</th><th>PrdPWT</th><th>PolishWeight</th><th>%</th></tr>
                                <tr ng-repeat="r in ClvChartData.list23"><td>{{gv(r,'GradType')}}</td><td>{{gv(r,'Pcs')}}</td><td>{{fmt(gv(r,'PrdPWT'),2)}}</td><td>{{fmt(gv(r,'PolishWeight'),2)}}</td><td>{{fmt(gv(r,'Per'),2)}}</td></tr>
