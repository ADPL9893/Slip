                                <tr><th class="clv-table-title" colspan="5">Shape Category (28)</th></tr>
                                <tr><th>Shape</th><th>Category</th><th>Pcs</th><th>Weight</th><th>$</th></tr>
                                <tr ng-repeat="r in ClvChartData.list28"><td>{{gv(r,'Shape')}}</td><td>{{gv(r,'Category')}}</td><td>{{gv(r,'Pcs')}}</td><td>{{fmt(gv(r,'PolishWeight'),2)}}</td><td>{{fmt(gv(r,'PrcAmt'),2)}}</td></tr>
