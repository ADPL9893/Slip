@{
    ViewBag.Title = "Master Book";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}

<!-- Inline, not in common.css: guarantees this always loads fresh with the
     page (no stylesheet caching/bundling to go stale), and !important wins
     against Bootstrap's .modal-dialog/table resets without relying on
     common.css's own load order relative to Bootstrap. -->
<style>
    /* Plain white grid background - overrides the Material theme's default
       shading on the header/rowsview panels and on alternating rows
       (rowAlternationEnabled is on, which otherwise tints every other row
       light gray). */
    #masterBookGridContainer.dx-datagrid,
    #masterBookGridContainer .dx-datagrid,
    #masterBookGridContainer .dx-datagrid-headers,
    #masterBookGridContainer .dx-datagrid-rowsview,
    #masterBookGridContainer .dx-row,
    #masterBookGridContainer .dx-row-alt {
        background-color: #ffffff !important;
    }

    /* common.css paints the alternating-row tint directly on the <td>
       children (.dx-row-alt > td / .dx-data-row:nth-child(even)), which
       sits visually above the <tr> background set to white above - so
       the td-level background needs its own override here too. */
    #masterBookGridContainer .dx-datagrid-rowsview .dx-row > td,
    #masterBookGridContainer .dx-datagrid-rowsview .dx-row-alt > td,
    #masterBookGridContainer .dx-datagrid-rowsview .dx-data-row:nth-child(even) > td {
        background-color: #ffffff !important;
    }

    /* Compact grid: short row height, tight cell padding/font so the extra
       Date/Label/Days columns fit without the grid feeling cramped. */
    #masterBookGridContainer .dx-datagrid-headers .dx-row > td,
    #masterBookGridContainer .dx-datagrid-rowsview .dx-row > td {
        padding: 0px 6px !important;
        font-size: 10.5px !important;
        line-height: 10px !important;
    }

    /* Darker, unconditional grid lines - applied per-cell via CSS (not the
       onRowPrepared JS, which only fires on initial row render and can miss
       rows that virtual scrolling recycles later, leaving them without a
       bottom border) so every row/column line is guaranteed to show.
       Selectors include the .rdl-grid-card ancestor class to out-specify
       common.css's own "#masterBookGridContainer ... > td { border-bottom:
       1px solid #e2e8f0 }" rule (same !important, but that rule carries an
       extra .rdl-grid-card class so it otherwise wins specificity and was
       silently overriding just the horizontal line, leaving it faint while
       the uncontested border-right stayed dark). */
    #masterBookGridContainer .dx-datagrid-headers .dx-row > td,
    #masterBookGridContainer .dx-datagrid-rowsview .dx-row > td,
    .rdl-grid-card #masterBookGridContainer .dx-datagrid-headers .dx-row > td,
    .rdl-grid-card #masterBookGridContainer .dx-datagrid-rowsview .dx-row > td,
    .rdl-grid-card #masterBookGridContainer .dx-datagrid-rowsview .dx-row:not(.dx-freespace-row) > td {
        border-bottom: 1px solid #94a3b8 !important;
        border-right: 1px solid #94a3b8 !important;
    }

    #masterBookGridContainer .dx-datagrid-headers .dx-row > td {
        font-weight: 500 !important;
        font-size: 9.5px !important;
        padding-top: 2px !important;
        padding-bottom: 2px !important;
        white-space: normal !important;
    }

    /* Header theme CSS truncates with an ellipsis by default (nowrap +
       overflow hidden on the inner text span) - allow it to wrap onto a
       second line instead of cutting off long column names. word-break:
       normal (not break-word) so it only wraps BETWEEN words ("Growth" /
       "Rate") - break-word was splitting short single-word captions like
       "Days" one letter per line in narrow columns. */
    #masterBookGridContainer .dx-datagrid-headers .dx-datagrid-text-content {
        white-space: normal !important;
        overflow: visible !important;
        text-overflow: unset !important;
        word-break: normal !important;
        line-height: 12px !important;
    }

    /* Sort arrow - was rendered at the theme's default ~11px, oversized next
       to our 9.5px header text and, combined with word-wrap, pushed narrow
       captions like "Days" down enough to wrap letter-by-letter. */
    #masterBookGridContainer .dx-datagrid-headers .dx-sort {
        font-size: 8px !important;
    }

    /* Multi-column sort order number badge - sorting.mode is "single" so it
       should never render, but force it hidden regardless since it was
       still showing (reading as a second arrow next to the direction one). */
    #masterBookGridContainer .dx-datagrid-headers .dx-sort-index-icon {
        display: none !important;
    }

    /* Header filter funnel icon - kept out of sight (not display:none, so
       it keeps a real position/size for dxclick + popup anchoring) and
       opened only via double-click on the header, see onCellDblClick. */
    #masterBookGridContainer .dx-datagrid-headers .dx-header-filter {
        opacity: 0 !important;
        width: 0 !important;
        min-width: 0 !important;
        margin: 0 !important;
        padding: 0 !important;
        overflow: hidden !important;
        pointer-events: none !important;
    }

    /* Column indicator slot collapses to nothing when it has no visible
       sort/filter icon to show, instead of reserving blank space. */
    #masterBookGridContainer .dx-column-indicators.dx-visibility-hidden {
        display: none;
    }

    /* All header captions left-aligned, regardless of the column's own
       data alignment (center/right for numeric columns etc). */
    #masterBookGridContainer .dx-datagrid-headers .dx-row > td {
        text-align: left !important;
    }

    #masterBookGridContainer .dx-datagrid-headers .dx-datagrid-text-content {
        text-align: left !important;
        justify-content: flex-start !important;
    }

    /* Table No / L Code / W(Ct) data values called out in bold - header
       weight is intentionally left at its reduced 500 (not re-bolded). */
    #masterBookGridContainer .dx-datagrid-rowsview .mb-col-bold {
        font-weight: 700 !important;
    }

    #masterBookGridContainer .badge-status-pill {
        padding: 0px 6px !important;
        font-size: 9.5px !important;
        line-height: 9px !important;
    }

    /* Stage filter buttons - color-coded instead of icon-shape-coded
       (common.css's gradients replaced with flat colors here so this page
       always loads the current version instead of common.css's own
       cache/bundle). */
    .btn-onhand {
        background: #a16207 !important;
    }

    .btn-clv-running,
    .btn-clv-complete {
        background: #15803d !important;
    }

    .btn-distribution {
        background: #0369a1 !important;
    }

    .btn-mfg-running,
    .btn-mfg-complete {
        background: #4a0404 !important;
    }

    .btn-transfer {
        background: #475569 !important;
    }

    /* Per-row stage indicator (L Code's neighboring column) - reuses the
       same btn-onhand/btn-clv-running/etc. background colors as the filter
       buttons above, just sized down to fit the grid's compact row height
       instead of the buttons' fixed 28x28. */
    #masterBookGridContainer .mb-row-stage-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 21px;
        height: 21px;
        border-radius: 4px;
        color: #ffffff;
    }

    #masterBookGridContainer .mb-row-stage-btn i {
        font-size: 8px;
    }

    /* Action button popover - stage-dated rows (ClvPlan/ClvCom/MFGComplete/
       Mumbai Issue) shown above the Reports & Charts list, each with a
       small dot in that stage's own color (reusing the same green/maroon/
       gray used by the filter buttons). Only rendered when the row
       actually has that date. */
    .mb-popover-dates {
        padding: 6px 14px;
        border-bottom: 1px solid #e2e8f0;
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .mb-popover-dates .mb-date-row {
        display: flex;
        align-items: center;
        gap: 7px;
        font-size: 11.5px;
    }

    .mb-popover-dates .mb-date-dot {
        display: inline-block;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .mb-popover-dates .mb-dot-green {
        background: #15803d;
    }

    .mb-popover-dates .mb-dot-maroon {
        background: #4a0404;
    }

    .mb-popover-dates .mb-dot-gray {
        background: #475569;
    }

    .mb-popover-dates .mb-date-text {
        font-weight: 600;
        color: #334155;
    }

    /* "All" button - concentric rings mixing every stage's color into one
       bullseye icon instead of a generic list glyph, innermost-to-outermost
       matching the stage order: Onhand(yellow) -> Cleaving(green) ->
       Distribution(blue) -> Mfg(maroon) -> Transfer(gray). Each ring is a
       same-centered circle fully covering the one behind it except for its
       own outer rim, so only each ring's edge color shows through. */
    .mb-all-rings {
        position: relative;
        display: inline-block;
        width: 18px;
        height: 18px;
    }

    .mb-all-rings .mb-ring {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        border-radius: 50%;
    }

        .mb-all-rings .mb-ring-gray {
            width: 28px;
            height: 28px;
            background: #94a3b8;
        }

    .mb-all-rings .mb-ring-maroon {
        width: 24px;
        height: 24px;
        background: #800000;
    }

        .mb-all-rings .mb-ring-blue {
            width: 16px;
            height: 16px;
            background: #164789;
        }

        .mb-all-rings .mb-ring-green {
            width: 11px;
            height: 11px;
            background: #3c8f1d;
        }

        .mb-all-rings .mb-ring-yellow {
            width: 7px;
            height: 7px;
            background: #eab308;
        }

    /* LotCode/RoughWeight/KapanNo cells: value left, search icon pinned to
       the cell's right edge regardless of text length. */
    #masterBookGridContainer .mb-cell-search-wrap {
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        gap: 6px;
    }

    #masterBookGridContainer .mb-cell-search-text {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    #masterBookGridContainer .mb-cell-search-icon {
        color: #2c62ad;
        cursor: pointer;
        flex-shrink: 0;
    }

    #masterBookGridContainer .mb-cell-search-icon:hover {
        color: #2563eb;
    }

    #ClvChartModal .modal-dialog {
        width: 96vw !important;
        max-width: 1500px !important;
        margin: 20px auto !important;
    }

    #ClvChartModal .modal-body.clv-chart-body {
        max-height: 80vh !important;
        overflow-y: auto !important;
        background: #f8fafc !important;
        padding: 14px !important;
    }

    .clv-chart-report {
        font-family: Consolas, "Courier New", monospace;
        font-size: 11px !important;
        color: #1e293b !important;
    }

    .clv-chart-report .clv-kv-grid .clv-report-title {
        text-align: center !important;
        font-weight: 700 !important;
        font-size: 14px !important;
        padding: 2px 6px !important;
        color: #0f172a !important;
        background: #ffffff !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
    }

    .clv-chart-report .clv-kv-grid .clv-pct-highlight {
        background: #bbf7d0 !important;
        font-weight: 700 !important;
    }

    .clv-chart-report .clv-header-row,
    .clv-chart-report .clv-section-row {
        display: flex !important;
        flex-direction: row !important;
        flex-wrap: nowrap !important;
        align-items: flex-start !important;
        gap: 8px !important;
        margin: 0 0 8px 0 !important;
        width: 100% !important;
    }

    /* Header row specifically: kv-grid (left) and grad-box (right) sit
       flush against each other at matching height, grad-box kept at its
       natural width instead of wrapping/shrinking. */
    .clv-chart-report .clv-header-row {
        align-items: stretch !important;
    }

    /* Tables keep their natural content width (nowrap cells mean they
       can't meaningfully shrink without truncating data) - if a row's
       tables together are wider than the modal, the ROW scrolls
       horizontally instead of wrapping the trailing tables onto a new
       line or letting a shrunk table visually overlap its siblings. */
    .clv-chart-report .clv-section-row {
        overflow-x: auto !important;
    }

    .clv-chart-report .clv-section-row > table {
        flex-shrink: 0 !important;
    }

    /* Vertical stack of 2 tables acting as ONE column within a
       .clv-section-row (e.g. "CLV P WT %" with the PRD/CLV value
       comparison table directly underneath it). */
    .clv-chart-report .clv-section-row > .clv-stack-col {
        display: flex !important;
        flex-direction: column !important;
        gap: 8px !important;
        flex-shrink: 0 !important;
    }

    .clv-chart-report .clv-header-row > table.clv-grad-box {
        flex: 0 0 auto !important;
        align-self: stretch !important;
    }

    .clv-chart-report .clv-header-row > table.clv-grad-box tbody,
    .clv-chart-report .clv-header-row > table.clv-grad-box {
        height: 100% !important;
    }

    .clv-chart-report table.clv-plain-table {
        border-collapse: collapse !important;
        background: #ffffff !important;
        table-layout: auto !important;
        margin: 0 !important;
    }

    /* Table title - a real <th colspan> row inside the table (not a
       <caption>, which rendered outside/disconnected from the bordered
       grid) so it's part of the same bordered box as the header/data rows. */
    .clv-chart-report table.clv-plain-table th.clv-table-title {
        text-align: left !important;
        font-weight: 700 !important;
        font-size: 11px !important;
        padding: 3px 6px !important;
        background: #334155 !important;
        color: #ffffff !important;
        border: 1px solid #334155 !important;
    }

    /* Only center the title when it's actually spanning/merged across a
       wide multi-column header (PRD, FINAL, WEIGHT, LABOUR, etc.) - the
       narrow 2-5 column mini tables keep a left-aligned title. */
    .clv-chart-report table.clv-data-table th.clv-table-title,
    .clv-chart-report table.clv-grow th.clv-table-title {
        text-align: center !important;
    }

    /* Wrapper that shrink-wraps to the combined width of the sibling
       tables it contains (instead of stretching full-width like a normal
       .clv-section-row), so the shared title bar above them lines up
       exactly with their actual width - not wider, not narrower. */
    .clv-chart-report .clv-table-group {
        display: inline-block !important;
        margin: 0 0 8px 0 !important;
    }

    .clv-chart-report .clv-table-group > .clv-section-row {
        width: auto !important;
        margin: 0 !important;
    }

    /* The 2 tables inside a group sit flush against each other (shared
       border, no visible gap) like one combined table - drop the right-hand
       table's left border so the shared seam is a single line, not a
       doubled-up 2px line from both tables' borders stacking. */
    .clv-chart-report .clv-section-row.clv-no-gap {
        gap: 0 !important;
    }

    .clv-chart-report .clv-section-row.clv-no-gap > table + table {
        border-left: none !important;
    }

    .clv-chart-report .clv-section-row.clv-no-gap > table + table th:first-child,
    .clv-chart-report .clv-section-row.clv-no-gap > table + table td:first-child {
        border-left: none !important;
    }

    /* Plain heading above a group of sibling tables that share ONE title
       between them (e.g. "ROUND" above the GR/NGR size tables) - a real
       <th colspan> can't span across separate <table> elements. */
    .clv-chart-report .clv-table-group-title {
        text-align: center !important;
        font-weight: 700 !important;
        font-size: 11px !important;
        padding: 3px 6px !important;
        background: #334155 !important;
        color: #ffffff !important;
        border: 1px solid #334155 !important;
        margin: 0 0 -1px 0 !important;
    }

    .clv-chart-report table.clv-plain-table th,
    .clv-chart-report table.clv-plain-table td {
        border: 1px solid #94a3b8 !important;
        padding: 2px 6px !important;
        white-space: nowrap !important;
        text-align: right !important;
        line-height: 1.5 !important;
    }

    .clv-chart-report table.clv-plain-table th {
        background: #e2e8f0 !important;
        font-weight: 700 !important;
        text-align: center !important;
    }

    .clv-chart-report table.clv-plain-table td:first-child {
        text-align: left !important;
        font-weight: 600 !important;
    }

    .clv-chart-report table.clv-data-table {
        min-width: 230px !important;
    }

    .clv-chart-report table.clv-grow {
        flex: 1 1 auto !important;
    }

    .clv-chart-report table.clv-mini td {
        text-align: right !important;
    }

    .clv-chart-report tr.clv-total-row td {
        font-weight: 700 !important;
        background: #f1f5f9 !important;
    }

    .clv-chart-report tr.clv-total-row td.clv-hl-orange {
        background: #fb923c !important;
        color: #ffffff !important;
    }

    .clv-chart-report tr.clv-total-row td.clv-hl-cyan {
        background: #22d3ee !important;
        color: #0f172a !important;
    }

    .clv-chart-report .clv-kv-grid {
        flex: 1 1 auto !important;
        display: grid !important;
        grid-template-columns: repeat(14, auto) !important;
        border: 1px solid #94a3b8 !important;
        border-right: none !important;
        border-bottom: none !important;
        background: #ffffff !important;
    }

    .clv-chart-report .clv-kv-grid > div {
        border-right: 1px solid #94a3b8 !important;
        border-bottom: 1px solid #94a3b8 !important;
        padding: 2px 6px !important;
        white-space: nowrap !important;
    }

    .clv-chart-report .clv-kv-grid .clv-lbl {
        font-weight: 700 !important;
        background: #e2e8f0 !important;
    }

    .clv-chart-report .clv-kv-grid .clv-diff-cell {
        color: #b91c1c !important;
        font-weight: 700 !important;
        text-align: center !important;
    }

    .clv-chart-report table.clv-grad-box {
        min-width: 230px !important;
    }

    .clv-chart-report table.clv-value-compare {
        margin-bottom: 8px !important;
    }
</style>

<div ng-controller="MasterBookCtrl" class="rough-dist-list-page">
    <div class="rdl-grid-card">
        <div class="rdl-card-header">
            <div class="rdl-card-title-left">
                <i class="fa fa-book"></i>
                <h3>Master Book</h3>
                <span class="badge-status-pill badge-pill-info" ng-show="!IsLoading">{{List.length}} Records</span>
                <span class="badge-status-pill" ng-class="GetStageBadgeClass(ActiveFilter)" ng-show="ActiveFilter">{{ActiveFilter}}</span>

                <div class="field-select-wrap" style="width: 220px;">
                    <input type="text"
                           ng-model="SearchText"
                           ng-change="OnSearchChange()"
                           placeholder="Search Master Book..."
                           class="form-control rd-input"
                           style="height: 32px; padding: 4px 10px;" />
                </div>
                <button type="button" class="grid-action-btn-edit" title="Reset All Filters" ng-click="ResetAllFilters()">
                    <i class="fa fa-eraser"></i>
                </button>
            </div>
            <div class="rdl-card-actions">
                <!-- 8 Stage Filter Buttons - icon-only, tooltip carries the label -->
                <div class="mb-btn-group-row">
                    <button type="button" class="mb-stage-square-btn btn-all-data" ng-class="{'active': ActiveFilter === 'All'}" ng-click="SelectFilter('All')" title="All Lots">
                        <span class="mb-all-rings">
                            <span class="mb-ring mb-ring-gray"></span>
                            <span class="mb-ring mb-ring-maroon"></span>
                            <span class="mb-ring mb-ring-blue"></span>
                            <span class="mb-ring mb-ring-green"></span>
                            <span class="mb-ring mb-ring-yellow"></span>
                        </span>
                    </button>
                    <button type="button" class="mb-stage-square-btn btn-onhand" ng-class="{'active': ActiveFilter === 'Onhand'}" ng-click="SelectFilter('Onhand')" title="Onhand (Not yet given to a Branch)">
                        <i class="fa fa-pause"></i>
                    </button>
                    <button type="button" class="mb-stage-square-btn btn-clv-running" ng-class="{'active': ActiveFilter === 'Cleaving Running'}" ng-click="SelectFilter('Cleaving Running')" title="Cleaving Running">
                        <i class="fa fa-play"></i>
                    </button>
                    <button type="button" class="mb-stage-square-btn btn-clv-complete" ng-class="{'active': ActiveFilter === 'Cleaving Completed'}" ng-click="SelectFilter('Cleaving Completed')" title="Cleaving Completed">
                        <i class="fa fa-stop"></i>
                    </button>
                    <!-- Hidden for now (same condition as Cleaving Completed) - markup/logic
                         left in place so it's a one-line revert to bring back. -->
                    <button type="button" class="mb-stage-square-btn btn-distribution" ng-class="{'active': ActiveFilter === 'Distribution'}" ng-click="SelectFilter('Distribution')" title="Distribution (CLV Complete, MFG not yet running)" ng-show="false">
                        <i class="fa fa-stop"></i>
                    </button>
                    <button type="button" class="mb-stage-square-btn btn-mfg-running" ng-class="{'active': ActiveFilter === 'Mfg Running'}" ng-click="SelectFilter('Mfg Running')" title="Mfg Running">
                        <i class="fa fa-play"></i>
                    </button>
                    <button type="button" class="mb-stage-square-btn btn-mfg-complete" ng-class="{'active': ActiveFilter === 'Mfg Complete'}" ng-click="SelectFilter('Mfg Complete')" title="Mfg Complete">
                        <i class="fa fa-stop"></i>
                    </button>
                    <button type="button" class="mb-stage-square-btn btn-transfer" ng-class="{'active': ActiveFilter === 'Transfer'}" ng-click="SelectFilter('Transfer')" title="Transfer (Mumbai Submitted)">
                    </button>
                </div>

                <button type="button" class="grid-action-btn-edit" title="Column Chooser" ng-click="ShowColumnChooser()">
                    <i class="fa fa-columns"></i>
                </button>
                <button type="button" class="grid-action-btn-edit" title="Export to Excel" ng-click="ExportGrid()">
                    <i class="fa fa-file-excel-o"></i>
                </button>
            </div>
        </div>

        <div class="rdl-grid-body">
            <div id="masterBookGridContainer" style="width: 100%; height: 100%;"></div>
        </div>
    </div>

    <!-- Floating Context Menu for Reports & Charts -->
    <div id="mbReportContextMenu" class="mb-report-popover" ng-show="ShowReportMenu" ng-style="ReportMenuStyle" ng-click="$event.stopPropagation()">
        <div class="mb-popover-header">
            <span>Reports &amp; Charts</span>
            <button type="button" class="popover-close" ng-click="CloseReportMenu()">&times;</button>
        </div>
        @*<div class="mb-popover-dates" >
           
            
           
          
        </div>*@
        <ul class="mb-popover-list" ng-if="SelectedRowItem">
            <li ng-click="OpenReport('Pre Rough')">
                <div class="mb-date-row" ng-if="SelectedRowItem.CLVRunningDate">
                    <span class="mb-date-dot mb-dot-green"></span>
                    <span class="mb-date-text">ClvPlan-{{fmtPopupDate(SelectedRowItem.CLVRunningDate)}}</span>
                </div>
            </li>
            <li ng-click="OpenReport('CLV Chart')">
                <div class="mb-date-row" ng-if="SelectedRowItem.CLVCompleteDate">
                    <span class="mb-date-dot mb-dot-green"></span>
                    <span class="mb-date-text">ClvCom-{{fmtPopupDate(SelectedRowItem.CLVCompleteDate)}}</span>
                </div>
            </li>
            <li ng-click="OpenReport('MFG Chart')">
                <div class="mb-date-row" ng-if="SelectedRowItem.MFGCompleteDate">
                    <span class="mb-date-dot mb-dot-maroon"></span>
                    <span class="mb-date-text">MFGCom-{{fmtPopupDate(SelectedRowItem.MFGCompleteDate)}}</span>
                </div> 
            </li>
            <li ng-click="OpenReport('IGI complet')">
                <div class="mb-date-row" ng-if="SelectedRowItem.MumbaiSubmitDate">
                    <span class="mb-date-dot mb-dot-gray"></span>
                    <span class="mb-date-text">Mumbai-{{fmtPopupDate(SelectedRowItem.MumbaiSubmitDate)}} </span>
                </div>
            </li>
        </ul>
    </div>

    <!-- CLV Chart Modal - replicates the "Cleaving Chart" print report.
         Field-to-panel mapping below is a best-effort reconstruction from
         ReportRepository.cs's shape (29 lists, List0..List28) cross-checked
         against a sample PDF - a handful of lower-confidence spots are
         flagged inline with "BEST GUESS". If a panel shows the wrong data
         once tested against live data, the fix is just re-pointing that
         panel's list/column config in the script below, not restructuring
         the HTML. -->
    <div class="modal fade" id="ClvChartModal" role="dialog">
        <div class="modal-dialog clv-chart-modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <div class="modal-header-brand">
                        <i class="fa fa-cogs modal-icon-info"></i>
                        <h4 class="modal-header-title">Cleaving Chart - {{ClvLotCode}}</h4>
                    </div>
                    <button type="button" class="close modal-close-btn" data-dismiss="modal">&times;</button>
                </div>
                <div class="modal-body clv-chart-body">
                    <div ng-if="IsLoadingClvChart" class="img-loading-state">
                        <i class="fa fa-spinner fa-spin modal-loading-icon"></i>
                        <div>Loading CLV Chart...</div>
                    </div>

                    <div ng-if="!IsLoadingClvChart && !ClvMain" class="img-empty-state">
                        <div class="img-empty-icon"><i class="fa fa-cogs"></i></div>
                        <h4 class="img-empty-title">No CLV Chart Data</h4>
                        <p class="img-empty-text">No cleaving chart data was found for this Kapan.</p>
                    </div>

                    <div ng-if="!IsLoadingClvChart && ClvMain" class="clv-chart-report" id="clvChartPrintArea">
                        <!-- Header strip: left info grid | PRD/CLV box | Grad box -->
                        <div class="clv-header-row">
                            <div class="clv-kv-grid">
                                <div class="clv-lbl">Issue By</div><div>{{gv(ClvMain,'PrdUser')}}</div>
                                <div class="clv-report-title" style="grid-column: span 10;">Cleaving Chart ({{gv(ClvMain,'PrdDate')}})</div>
                                <div class="clv-lbl">Rough Rate</div><div>{{fmt(gv(ClvGradTotalRow,'Rate'),2)}}</div>

                                <div class="clv-lbl">Issue Dt.</div><div>{{gv(ClvMain,'PrdDate')}}</div>
                                <div class="clv-lbl">R Name</div><div>{{fmt(gv(ClvMain,'RWT'),2)}} / {{ClvLotCode}}</div>
                                <div class="clv-lbl">Receipe</div><div>{{gv(ClvMain,'MainReceipe')}}</div>
                                <div class="clv-lbl">PRD/CT $ (-L)</div><div>{{fmt(gv(ClvMain,'PrdPerCTValue'),2)}}</div>
                                <div class="clv-lbl">PRD/CT</div><div>{{fmt(gv(ClvMain,'PrdPerCarat'),2)}}</div>
                                <div class="clv-lbl">PRD %</div><div class="clv-pct-highlight">{{fmt(gv(ClvMain,'PrdPer'),2)}}</div>
                                <div class="clv-lbl">Pcs</div><div>{{gv(ClvMain,'RoughPcs')}}</div>

                                <div class="clv-lbl">Return Dt.</div><div>{{gv(ClvMain,'TrnDate')}}</div>
                                <div class="clv-lbl">Challan</div><div>{{gv(ClvMain,'RCode')}}</div>
                                <div class="clv-lbl">C Grad</div><div>{{gv(ClvMain,'GradNo')}}</div>
                                <div class="clv-lbl">CLV/CT $ (-L)</div><div>{{fmt(gv(ClvMain,'ClvPerCTValue'),2)}}</div>
                                <div class="clv-lbl">CLV/CT</div><div>{{fmt(gv(ClvMain,'ClvPerCarat'),2)}}</div>
                                <div class="clv-lbl">CLV %</div><div class="clv-pct-highlight">{{fmt(gv(ClvMain,'ClvPer'),2)}}</div>
                                <div class="clv-lbl">Size</div><div>{{fmt(gv(ClvMain,'Size'),2)}}</div>

                                <div class="clv-lbl">Days</div><div>{{gv(ClvMain,'ClvDays')}}</div>
                                <div class="clv-lbl">Carat</div><div>{{fmt(gv(ClvMain,'RWT'),2)}}</div>
                                <div class="clv-lbl">K Grad</div><div>{{gv(ClvMain,'MainGradNo')}}</div>
                                <div class="clv-diff-cell" style="grid-column: span 2;">{{fmt(gv(ClvMain,'PrdPerCTValue') - gv(ClvMain,'ClvPerCTValue'),2)}}</div>
                                <div class="clv-diff-cell" style="grid-column: span 2;">{{fmt(gv(ClvMain,'PrdPerCarat') - gv(ClvMain,'ClvPerCarat'),2)}}</div>
                                <div class="clv-diff-cell" style="grid-column: span 2;">{{fmt(gv(ClvMain,'PrdPer') - gv(ClvMain,'ClvPer'),2)}}</div>
                                <div class="clv-lbl">Table No</div><div>{{gv(ClvMain,'TableNo')}}</div>
                            </div>

                            <table class="clv-plain-table clv-grad-box" ng-if="ClvGradTotalRow">
                                <tr><th>Grad</th><th>Rate</th><th>Pcs</th><th>Carat</th><th>%</th></tr>
                                <tr ng-repeat="r in ClvGradRows"><td>{{gv(r,'GradNo')}}</td><td>{{fmt(gv(r,'Rate'),2)}}</td><td>{{gv(r,'Pcs')}}</td><td>{{fmt(gv(r,'Carat'),2)}}</td><td>{{fmt(gv(r,'Per'),2)}}</td></tr>
                                <tr class="clv-total-row"><td>Total</td><td>{{fmt(gv(ClvGradTotalRow,'Rate'),2)}}</td><td>{{gv(ClvGradTotalRow,'Pcs')}}</td><td>{{fmt(gv(ClvGradTotalRow,'Carat'),2)}}</td><td>{{fmt(gv(ClvGradTotalRow,'Per'),2)}}</td></tr>
                            </table>
                        </div>

                        <!-- PRD shape table + its 2 side mini-panels.
                             Data source is list20, NOT list1 - verified
                             against live data: list1's actual values match
                             the PDF's FINAL section, and list20's actual
                             values match the PDF's PRD section (the API's
                             real table order doesn't match
                             ReportRepository.cs's naming intuition). There's
                             no separate "total row" list either - TOTAL/
                             GRAND TOTAL are computed client-side (ClvGroupTotal)
                             from the GR+NGR rows. -->
                        <div class="clv-section-row">
                            <table class="clv-plain-table clv-data-table clv-grow">
                                <tr><th class="clv-table-title" colspan="9">PRD</th></tr>
                                <tr><th>Shape</th><th>Type</th><th>Pcs</th><th>R WT</th><th>P WT</th><th>Yeild %</th><th>$</th><th>Size</th><th>Result %</th></tr>
                                <tr ng-repeat="r in ClvChartData.list20">
                                    <td>{{gv(r,'Shape')}}</td><td>{{gv(r,'Status')}}</td><td>{{gv(r,'Pcs')}}</td>
                                    <td>{{fmt(gv(r,'RPartWeight'),2)}}</td><td>{{fmt(gv(r,'PolishWeight'),2)}}</td>
                                    <td>{{fmt(gv(r,'Yeild'),2)}}</td><td>{{fmt(gv(r,'PrcAmt'),2)}}</td>
                                    <td>{{fmt(gv(r,'Size'),2)}}</td><td>{{fmt(gv(r,'Per'),2)}}</td>
                                </tr>
                                <tr class="clv-total-row" ng-if="ClvChartData.list20.length">
                                    <td colspan="2">GRAND TOTAL</td><td>{{ClvGroupTotal(ClvChartData.list20).Pcs}}</td>
                                    <td>{{fmt(ClvGroupTotal(ClvChartData.list20).RPartWeight,2)}}</td><td class="clv-hl-orange">{{fmt(ClvGroupTotal(ClvChartData.list20).PolishWeight,2)}}</td>
                                    <td>{{fmt(ClvGroupTotal(ClvChartData.list20).Yeild,2)}}</td><td>{{fmt(ClvGroupTotal(ClvChartData.list20).PrcAmt,2)}}</td>
                                    <td></td><td class="clv-hl-cyan">{{fmt(ClvGroupTotal(ClvChartData.list20).Per,2)}}</td>
                                </tr>
                            </table>
                            <table class="clv-plain-table clv-mini">
                                <tr><th>PRD</th><th>P WT</th><th>%</th></tr>
                                <tr ng-repeat="r in ClvChartData.list20"><td>{{gv(r,'Status')}}</td><td>{{fmt(gv(r,'PolishWeight'),2)}}</td><td>{{fmt(ClvPct(gv(r,'PolishWeight'), ClvSum(ClvChartData.list20,'PolishWeight')),2)}}</td></tr>
                                <tr class="clv-total-row"><td>TOTAL</td><td>{{fmt(ClvSum(ClvChartData.list20,'PolishWeight'),2)}}</td><td>100</td></tr>
                            </table>
                            <table class="clv-plain-table clv-mini">
                                <tr><th>Grad</th><th>PRD/CT$(-L)</th><th>CLV/CT$(-L)</th></tr>
                                <tr ng-repeat="r in ClvGradRows"><td>{{gv(r,'GradNo')}}</td><td>{{fmt(gv(r,'PrdPerCTValue'),2)}}</td><td>{{fmt(gv(r,'ClvPerCTValue'),2)}}</td></tr>
                                <tr class="clv-total-row" ng-if="ClvGradTotalRow"><td>Total</td><td>{{fmt(gv(ClvGradTotalRow,'PrdPerCTValue'),2)}}</td><td>{{fmt(gv(ClvGradTotalRow,'ClvPerCTValue'),2)}}</td></tr>
                            </table>
                        </div>

                        <!-- FINAL (CLV) shape table + its 2 side mini-panels.
                             Data source is list1 (see note above PRD). -->
                        <div class="clv-section-row">
                            <table class="clv-plain-table clv-data-table clv-grow">
                                <tr><th class="clv-table-title" colspan="9">FINAL</th></tr>
                                <tr><th>Shape</th><th>Type</th><th>Pcs</th><th>R WT</th><th>P WT</th><th>Yeild %</th><th>$</th><th>Size</th><th>Result %</th></tr>
                                <tr ng-repeat="r in ClvChartData.list1">
                                    <td>{{gv(r,'Shape')}}</td><td>{{gv(r,'Status')}}</td><td>{{gv(r,'Pcs')}}</td>
                                    <td>{{fmt(gv(r,'RPartWeight'),2)}}</td><td>{{fmt(gv(r,'PolishWeight'),2)}}</td>
                                    <td>{{fmt(gv(r,'Yeild'),2)}}</td><td>{{fmt(gv(r,'PrcAmt'),2)}}</td>
                                    <td>{{fmt(gv(r,'Size'),2)}}</td><td>{{fmt(gv(r,'Per'),2)}}</td>
                                </tr>
                                <tr class="clv-total-row" ng-if="ClvChartData.list1.length">
                                    <td colspan="2">TOTAL</td><td>{{ClvGroupTotal(ClvChartData.list1).Pcs}}</td>
                                    <td>{{fmt(ClvGroupTotal(ClvChartData.list1).RPartWeight,2)}}</td><td>{{fmt(ClvGroupTotal(ClvChartData.list1).PolishWeight,2)}}</td>
                                    <td>{{fmt(ClvGroupTotal(ClvChartData.list1).Yeild,2)}}</td><td>{{fmt(ClvGroupTotal(ClvChartData.list1).PrcAmt,2)}}</td>
                                    <td></td><td>{{fmt(ClvGroupTotal(ClvChartData.list1).Per,2)}}</td>
                                </tr>
                            </table>
                            <!-- CLV P WT % stacked above the PRD vs CLV value
                                 comparison table - one flex column within the
                                 FINAL row, instead of the comparison table
                                 sitting full-width below everything. -->
                            <div class="clv-stack-col">
                                <table class="clv-plain-table clv-mini">
                                    <tr><th>CLV</th><th>P WT</th><th>%</th></tr>
                                    <tr ng-repeat="r in ClvChartData.list1"><td>{{gv(r,'Status')}}</td><td>{{fmt(gv(r,'PolishWeight'),2)}}</td><td>{{fmt(ClvPct(gv(r,'PolishWeight'), ClvSum(ClvChartData.list1,'PolishWeight')),2)}}</td></tr>
                                    <tr class="clv-total-row"><td>TOTAL</td><td>{{fmt(ClvSum(ClvChartData.list1,'PolishWeight'),2)}}</td><td>100</td></tr>
                                </table>
                                <table class="clv-plain-table clv-mini clv-value-compare">
                                    <tr><th></th><th>PRD</th><th>CLV</th></tr>
                                    <tr><td>VALUE $</td><td>{{fmt(gv(ClvMain,'PrdPrcAmt'),2)}}</td><td>{{fmt(gv(ClvMain,'ClvPrcAmt'),2)}}</td></tr>
                                    <tr><td>LBR $</td><td>{{fmt(gv(ClvMain,'PrdLabour'),2)}}</td><td>{{fmt(gv(ClvMain,'ClvLabour'),2)}}</td></tr>
                                    <tr><td>Val/CT $</td><td>{{fmt(gv(ClvMain,'PrdPerCTValue'),2)}}</td><td>{{fmt(gv(ClvMain,'ClvPerCTValue'),2)}}</td></tr>
                                    <tr><td>Lab/CT $</td><td>{{fmt(gv(ClvMain,'PrdLabourPerCarat'),2)}}</td><td>{{fmt(gv(ClvMain,'ClvLabourPerCarat'),2)}}</td></tr>
                                    <tr><td>F/CT $</td><td>{{fmt(gv(ClvMain,'PrdFinalPerCarat'),2)}}</td><td>{{fmt(gv(ClvMain,'ClvFinalPerCarat'),2)}}</td></tr>
                                    <tr><td>VDiff $</td><td colspan="2">{{fmt(gv(ClvMain,'ClvDiff'),2)}}</td></tr>
                                </table>
                            </div>
                            <table class="clv-plain-table clv-mini">
                                <tr><th>Grad</th><th>PRD%</th><th>CLV%</th><th>Diff%</th></tr>
                                <tr ng-repeat="r in ClvGradRows"><td>{{gv(r,'GradNo')}}</td><td>{{fmt(gv(r,'PrdPer'),2)}}</td><td>{{fmt(gv(r,'ClvPer'),2)}}</td><td>{{fmt(gv(r,'ClvPer') - gv(r,'PrdPer'),2)}}</td></tr>
                                <tr class="clv-total-row" ng-if="ClvGradTotalRow"><td>Total</td><td>{{fmt(gv(ClvGradTotalRow,'PrdPer'),2)}}</td><td>{{fmt(gv(ClvGradTotalRow,'ClvPer'),2)}}</td><td>{{fmt(gv(ClvGradTotalRow,'ClvPer') - gv(ClvGradTotalRow,'PrdPer'),2)}}</td></tr>
                            </table>
                        </div>

                        <!-- WEIGHT/RATE/VALUE (scrap) + LABOUR -->
                        <div class="clv-section-row">
                            <table class="clv-plain-table clv-data-table">
                                <tr><th></th><th>Weight</th><th>%</th><th>Rate</th><th>Value</th></tr>
                                <tr ng-repeat="r in ClvChartData.list3">
                                    <td>{{gv(r,'ScrapType')}}</td><td>{{fmt(gv(r,'Weight'),2)}}</td><td>{{fmt(gv(r,'Per'),2)}}</td><td>{{fmt(gv(r,'Rate'),2)}}</td><td>{{fmt(gv(r,'Value'),2)}}</td>
                                </tr>
                            </table>
                            <table class="clv-plain-table clv-data-table">
                                <tr><th class="clv-table-title" colspan="5">LABOUR</th></tr>
                                <tr><th></th><th>Pcs</th><th>Weight</th><th>Rate</th><th>Labour$</th></tr>
                                <tr ng-repeat="r in ClvChartData.list4">
                                    <td>{{gv(r,'Status')}}</td><td>{{gv(r,'Pcs')}}</td><td>{{fmt(gv(r,'Weight'),2)}}</td><td>{{fmt(gv(r,'Rate'),2)}}</td><td>{{fmt(gv(r,'Amount'),2)}}</td>
                                </tr>
                                <tr class="clv-total-row"><td colspan="4">TOTAL</td><td>{{fmt(ClvSum(ClvChartData.list4,'Amount'),2)}}</td></tr>
                            </table>
                        </div>
                        <!-- SIZE breakdown, Round shape (GR / NGR side by side) -
                             "ROUND" is ONE shared title spanning both tables in
                             the reference, not two separate "ROUND - GR"/
                             "ROUND - NGR" titles, so it's a plain heading above
                             the row instead of baked into either table. The
                             whole group (title + GR + NGR) is wrapped so it
                             shrink-wraps to the combined table width (not the
                             full modal width) and the 2 tables sit flush
                             against each other with no gap, like one table. -->
                        <div class="clv-table-group">
                            <div class="clv-table-group-title">ROUND</div>
                            <div class="clv-section-row clv-no-gap">
                                <table class="clv-plain-table clv-data-table">
                                    <tr><th class="clv-table-title" colspan="4">GR</th></tr>
                                <tr><th>Size</th><th>Pcs</th><th>Weight</th><th>$</th></tr>
                                <tr ng-repeat="r in ClvChartData.list6"><td>{{gv(r,'Category')}}</td><td>{{gv(r,'Pcs')}}</td><td>{{fmt(gv(r,'PolishWeight'),2)}}</td><td>{{fmt(gv(r,'PrcAmt'),2)}}</td></tr>
                                <tr class="clv-total-row"><td>TOTAL</td><td>{{ClvSum(ClvChartData.list6,'Pcs')}}</td><td>{{fmt(ClvSum(ClvChartData.list6,'PolishWeight'),2)}}</td><td>{{fmt(ClvSum(ClvChartData.list6,'PrcAmt'),2)}}</td></tr>
                            </table>
                            <table class="clv-plain-table clv-data-table">
                                <tr><th class="clv-table-title" colspan="4">NGR</th></tr>
                                <tr><th>Size</th><th>Pcs</th><th>Weight</th><th>$</th></tr>
                                <tr ng-repeat="r in ClvChartData.list7"><td>{{gv(r,'Category')}}</td><td>{{gv(r,'Pcs')}}</td><td>{{fmt(gv(r,'PolishWeight'),2)}}</td><td>{{fmt(gv(r,'PrcAmt'),2)}}</td></tr>
                                <tr class="clv-total-row"><td>TOTAL</td><td>{{ClvSum(ClvChartData.list7,'Pcs')}}</td><td>{{fmt(ClvSum(ClvChartData.list7,'PolishWeight'),2)}}</td><td>{{fmt(ClvSum(ClvChartData.list7,'PrcAmt'),2)}}</td></tr>
                                </table>
                            </div>
                        </div>
                        <!-- 2nd shape's SIZE breakdown (BEST GUESS - e.g. Fancy; shown only if present) -->
                        <div class="clv-section-row" ng-if="ClvChartData.list8.length || ClvChartData.list9.length">
                            <table class="clv-plain-table clv-data-table">
                                <tr><th class="clv-table-title" colspan="4">FANCY - GR</th></tr>
                                <tr><th>Size</th><th>Pcs</th><th>Weight</th><th>$</th></tr>
                                <tr ng-repeat="r in ClvChartData.list8"><td>{{gv(r,'Category')}}</td><td>{{gv(r,'Pcs')}}</td><td>{{fmt(gv(r,'PolishWeight'),2)}}</td><td>{{fmt(gv(r,'PrcAmt'),2)}}</td></tr>
                            </table>
                            <table class="clv-plain-table clv-data-table">
                                <tr><th class="clv-table-title" colspan="4">FANCY - NGR</th></tr>
                                <tr><th>Size</th><th>Pcs</th><th>Weight</th><th>$</th></tr>
                                <tr ng-repeat="r in ClvChartData.list9"><td>{{gv(r,'Category')}}</td><td>{{gv(r,'Pcs')}}</td><td>{{fmt(gv(r,'PolishWeight'),2)}}</td><td>{{fmt(gv(r,'PrcAmt'),2)}}</td></tr>
                            </table>
                        </div>

                        <!-- PREDICTION + PROCESS WISE LOSS -->
                        <div class="clv-section-row">
                            <table class="clv-plain-table clv-data-table">
                                <tr><th class="clv-table-title" colspan="4">PREDICTION</th></tr>
                                <tr><th>Status</th><th>P WT</th><th>Pcs</th><th>%</th></tr>
                                <tr ng-repeat="r in ClvChartData.list13"><td>{{gv(r,'Status')}}</td><td>{{fmt(gv(r,'PolishWeight'),2)}}</td><td>{{gv(r,'Pcs')}}</td><td>{{fmt(gv(r,'Per'),2)}}</td></tr>
                                <tr class="clv-total-row"><td>TOTAL</td><td>{{fmt(ClvSum(ClvChartData.list13,'PolishWeight'),2)}}</td><td>{{ClvSum(ClvChartData.list13,'Pcs')}}</td><td>100</td></tr>
                            </table>
                            <table class="clv-plain-table clv-data-table">
                                <tr><th class="clv-table-title" colspan="4">PROCESS WISE LOSS</th></tr>
                                <tr><th>Process</th><th>P WT</th><th>Value</th><th>%</th></tr>
                                <tr ng-repeat="r in ClvChartData.list18"><td>{{gv(r,'Process')}}</td><td>{{fmt(gv(r,'DiffPWt'),2)}}</td><td>{{fmt(gv(r,'DiffPrcAmt'),2)}}</td><td>{{fmt(gv(r,'Per'),2)}}</td></tr>
                                <tr class="clv-total-row"><td>TOTAL</td><td>{{fmt(ClvSum(ClvChartData.list18,'DiffPWt'),2)}}</td><td>{{fmt(ClvSum(ClvChartData.list18,'DiffPrcAmt'),2)}}</td><td>{{fmt(ClvSum(ClvChartData.list18,'Per'),2)}}</td></tr>
