                        <!-- Shape/Category breakdown (BEST GUESS placement - shown only if present) -->
                        <div class="clv-section-row" ng-if="ClvChartData.list27.length || ClvChartData.list28.length">
                            <table class="clv-plain-table clv-data-table">
                                <tr><th class="clv-table-title" colspan="5">Shape Category (27)</th></tr>
                                <tr><th>Shape</th><th>Category</th><th>Pcs</th><th>Weight</th><th>$</th></tr>
                                <tr ng-repeat="r in ClvChartData.list27"><td>{{gv(r,'Shape')}}</td><td>{{gv(r,'Category')}}</td><td>{{gv(r,'Pcs')}}</td><td>{{fmt(gv(r,'PolishWeight'),2)}}</td><td>{{fmt(gv(r,'PrcAmt'),2)}}</td></tr>
                            </table>
                            <table class="clv-plain-table clv-data-table">
                                <tr><th class="clv-table-title" colspan="5">Shape Category (28)</th></tr>
                                <tr><th>Shape</th><th>Category</th><th>Pcs</th><th>Weight</th><th>$</th></tr>
                                <tr ng-repeat="r in ClvChartData.list28"><td>{{gv(r,'Shape')}}</td><td>{{gv(r,'Category')}}</td><td>{{gv(r,'Pcs')}}</td><td>{{fmt(gv(r,'PolishWeight'),2)}}</td><td>{{fmt(gv(r,'PrcAmt'),2)}}</td></tr>
                            </table>
                        </div>

                        <!-- List16 (Loss) - shown only if present, columns unconfirmed -->
                        <div class="clv-section-row" ng-if="ClvChartData.list16.length">
                            <table class="clv-plain-table clv-data-table">
                                <tr><th class="clv-table-title" colspan="5">PROCESS WISE LOSS</th></tr>
                                <tr><th>Status</th><th>Loss P WT</th><th>%</th><th>Loss $</th><th>$ %</th></tr>
                                <tr ng-repeat="r in ClvChartData.list16"><td>{{gv(r,'Status')}}</td><td>{{fmt(gv(r,'LossPW'),2)}}</td><td>{{fmt(gv(r,'Per'),2)}}</td><td>{{fmt(gv(r,'LossPrc'),2)}}</td><td>{{fmt(gv(r,'PrcPer'),2)}}</td></tr>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn-modal-action btn-modal-reset" data-dismiss="modal" type="button">
                        <i class="fa fa-times"></i> Close
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    var module;
    try {
        module = angular.module('app');
    } catch (e) {
        module = angular.module('app', ['ngAnimate', 'ngTouch', 'ui.grid']);
    }

    module.controller("MasterBookCtrl", ['$scope', '$http', function ($scope, $http) {
        // Default page load pre-selection: 'All' (no stage/date narrowing)
        $scope.ActiveFilter = 'All';
        $scope.List = [];
        $scope.DynamicColumns = [];
        $scope.DynamicSummary = [];
        $scope.IsLoading = false;
        $scope.SelectedRowItem = null;
        $scope.ShowReportMenu = false;
        $scope.ReportMenuStyle = {};
        $scope.SearchText = '';

        $scope.OnSearchChange = function () {
            var gridInstance = $("#masterBookGridContainer").dxDataGrid("instance");
            if (gridInstance) gridInstance.searchByText($scope.SearchText || '');
        };

        // Clears the search box AND every column filter (the per-cell
        // search-icon clicks set column filterValue via columnOption, and
        // headerFilter dropdowns can set their own) - clearFilter() with no
        // argument wipes all of DevExtreme's filter types in one call.
        $scope.ResetAllFilters = function () {
            $scope.SearchText = '';
            var gridInstance = $("#masterBookGridContainer").dxDataGrid("instance");
            if (gridInstance) {
                gridInstance.clearFilter();
                gridInstance.searchByText('');
            }
        };

        $scope.ShowColumnChooser = function () {
            var gridInstance = $("#masterBookGridContainer").dxDataGrid("instance");
            if (gridInstance) gridInstance.showColumnChooser();
        };

        $scope.ExportGrid = function () {
            var gridInstance = $("#masterBookGridContainer").dxDataGrid("instance");
            if (!gridInstance || typeof ExcelJS === 'undefined') return;
            var workbook = new ExcelJS.Workbook();
            var worksheet = workbook.addWorksheet('MasterBook');
            DevExpress.excelExporter.exportDataGrid({
                component: gridInstance,
                worksheet: worksheet,
                autoFilterEnabled: true
            }).then(function () {
                workbook.xlsx.writeBuffer().then(function (buffer) {
                    var cleanFilter = ($scope.ActiveFilter || 'All').replace(/\s+/g, '_');
                    saveAs(new Blob([buffer], { type: 'application/octet-stream' }), 'MasterBook_' + cleanFilter + '.xlsx');
                });
            });
        };

        // Dynamic Header Badge Class based on Active Stage
        $scope.GetStageBadgeClass = function (stage) {
            if (!stage) return 'badge-pill-info';
            if (stage === 'All') return 'badge-pill-slate';
            if (stage === 'Onhand') return 'badge-stage-onhand';
            if (stage === 'Cleaving Running' || stage === 'Cleaving Completed') return 'badge-stage-clv';
            if (stage === 'Distribution') return 'badge-stage-distribution';
            if (stage === 'Mfg Running' || stage === 'Mfg Complete') return 'badge-stage-mfg';
            if (stage === 'Transfer') return 'badge-stage-transfer';
            return 'badge-pill-info';
        };

        // Stage Button Click
        $scope.SelectFilter = function (filterName) {
            $scope.ActiveFilter = filterName;
            $scope.FetchData(filterName);
        };

        // Fetch Grid Data from Server
        $scope.FetchData = function (filterType) {
            $scope.IsLoading = true;
            if (typeof show_loader === 'function') show_loader();

            var postData = {
                FilterType: filterType || $scope.ActiveFilter || 'All',
                FromDate: '',
                ToDate: ''
            };

            $http.post('@Url.Action("Get_MasterBook_DataList", "Master")', postData)
            .then(function (res) {
                $scope.IsLoading = false;
                if (typeof hide_loader === 'function') hide_loader();

                if (res.data && res.data.success) {
                    $scope.List = res.data.List || [];
                    $scope.DynamicColumns = res.data.DataField || [];
                    $scope.DynamicSummary = res.data.DataFieldSummary || [];
                    $scope.InitGrid();
                } else {
                    if (typeof Noty === 'function') {
                        Noty("error", res.data.message || "Failed to load master book data.");
                    }
                }
            }, function () {
                $scope.IsLoading = false;
                if (typeof hide_loader === 'function') hide_loader();
                if (typeof Noty === 'function') {
                    Noty("error", "Error connecting to server.");
                }
            });
        };

        // Trigger initial default load (All, no date restriction - the
        // date-range filter UI was removed, so FetchData no longer takes
        // date params at all).
        $scope.FetchData('All');

        // Initialize Dynamic DevExtreme DataGrid
        $scope.InitGrid = function () {
            var gridCols = [];

            // Shared cellTemplate: cell value on the left, a search icon
            // pinned to the cell's right edge - clicking it sets that
            // column's filter-row value to this cell's raw value, so the
            // grid narrows to every row sharing it (column-wise filter,
            // not the main search box).
            // Generic version: renderValue(container, $wrap, options) is
            // responsible for appending whatever the cell normally shows
            // (plain text, a badge, colored text, etc.) into $wrap - the
            // search icon is then appended after it, pinned to the right
            // edge. Lets any existing custom cellTemplate gain the shared
            // "click to filter by this value" icon without duplicating the
            // icon-wiring logic.
            function withCustomSearchIcon(dataField, renderValue) {
                return function (container, options) {
                    var $wrap = $("<div>").addClass("mb-cell-search-wrap");
                    renderValue($wrap, options);
                    $("<i>").addClass("fa fa-search mb-cell-search-icon")
                        .attr("title", "Filter grid by this value")
                        .on("click", function (e) {
                            e.stopPropagation();
                            var gridInstance = $("#masterBookGridContainer").dxDataGrid("instance");
                            if (gridInstance) gridInstance.columnOption(dataField, "filterValue", options.value);
                        })
                        .appendTo($wrap);
                    $wrap.appendTo(container);
                };
            }

            function withSearchIcon(dataField) {
                return withCustomSearchIcon(dataField, function ($wrap, options) {
                    var displayVal = (options.text !== undefined && options.text !== null && options.text !== '') ? options.text : '-';
                    $("<span>").addClass("mb-cell-search-text").text(displayVal).appendTo($wrap);
                });
            }

            // Same color/icon mapping as the stage filter buttons above the
            // grid (btn-onhand/btn-clv-running/etc.) - keyed off StageStatus,
            // which holds the exact same stage strings used by SelectFilter.
            function stageButtonInfo(stage) {
                switch ((stage || '').trim()) {
                    case 'Onhand': return { cls: 'btn-onhand', icon: 'fa-pause' };
                    // Synthetic rows for a Kapan balance not yet split into
                    // any Lot (pending assign/pending Lot creation) - not a
                    // real Lot stage, but visually it's still "not yet
                    // actioned" like Onhand, so it gets the same icon/color.
                    case 'Pending Split': return { cls: 'btn-onhand', icon: 'fa-pause' };
                    case 'Cleaving Running': return { cls: 'btn-clv-running', icon: 'fa-play' };
                    case 'Cleaving Completed': return { cls: 'btn-clv-complete', icon: 'fa-stop' };
                    case 'Distribution': return { cls: 'btn-distribution', icon: 'fa-stop' };
                    case 'Mfg Running': return { cls: 'btn-mfg-running', icon: 'fa-play' };
                    case 'Mfg Complete': return { cls: 'btn-mfg-complete', icon: 'fa-stop' };
                    case 'Transfer': return { cls: 'btn-transfer', icon: null };
                    default: return { cls: 'btn-transfer', icon: null };
                }
            }

            // Add index column (#)
            gridCols.push({
                caption: '#',
                width: 45,
                alignment: 'center',
                fixed: true,
                fixedPosition: 'left',
                cellTemplate: function (container, options) {
                    $("<span>").text(options.rowIndex + 1).css({ "font-weight": "600", "color": "#64748b" }).appendTo(container);
                }
            });

            // Dynamically construct columns from SP Table 1 metadata
            angular.forEach($scope.DynamicColumns, function (col) {
                var df = col.dataField || '';
                var dfLower = df.toLowerCase();

                var c = {
                    dataField: col.dataField,
                    caption: col.caption || col.dataField,
                    dataType: col.dataType || 'string',
                    alignment: col.alignment || 'left',
                    visible: col.visible !== false
                };

                if (col.format) {
                    c.format = col.format;
                }

                // Custom badge renderers based on dataField (independent of caption string)
                if (dfLower === 'kapanno') {
                    // TRN_RoughInwardDetail's own LotNo (the original Kapan
                    // before any Lot split) - lets Lots split from the same
                    // Kapan be compared against each other. Wider than the
                    // compact default since values are long composite codes
                    // (e.g. "D-S514-TRIAL03-2309-MIX-2809"). Plain text (no
                    // badge) with the shared search icon.
                    c.width = 200;
                    c.alignment = 'left';
                    c.cellTemplate = withSearchIcon('KapanNo');
                } else if (dfLower === 'lotcode') {
                    c.width = 80;
                    c.alignment = 'left';
                    c.cssClass = 'mb-col-bold';
                } else if (dfLower === 'mainlotcarat' || dfLower === 'roughcarat') {
                    c.width = 85;
                    c.alignment = 'left';
                    c.cellTemplate = withSearchIcon(col.dataField);
                } else if (dfLower === 'isactive') {
                    c.width = 65;
                    c.alignment = 'center';
                    c.cellTemplate = function (container, options) {
                        if (options.data.IsActive) {
                            $("<span>").addClass("badge-status-pill badge-pill-success").text("Active").appendTo(container);
                        } else {
                            $("<span>").addClass("badge-status-pill badge-pill-danger").text("Inactive").appendTo(container);
                        }
                    };
                } else if (dfLower === 'stagestatus') {
                    c.width = 100;
                    c.alignment = 'center';
                    c.cellTemplate = function (container, options) {
                        var stage = options.data.StageStatus || '';
                        var pillClass = "badge-pill-info";
                        if (stage.indexOf('Complete') > -1 || stage === 'Transfer') {
                            pillClass = "badge-pill-success";
                        } else if (stage.indexOf('Running') > -1) {
                            pillClass = "badge-pill-warning";
                        } else if (stage === 'Distribution') {
                            pillClass = "badge-pill-purple";
                        }
                        $("<span>").addClass("badge-status-pill " + pillClass).text(stage).appendTo(container);
                    };
                } else if (dfLower === 'label') {
                    c.width = 80;
                    c.alignment = 'center';
                    c.cellTemplate = function (container, options) {
                        var label = options.data.Label || '';
                        var pillClass = "badge-pill-slate";
                        if (label.indexOf('complete') > -1 || label === 'MumbaiSubmit') {
                            pillClass = "badge-pill-success";
                        } else if (label.indexOf('Running') > -1 || label === 'Clv Running' || label === 'MFG - Issue') {
                            pillClass = "badge-pill-warning";
                        } else if (label === 'Planning') {
                            pillClass = "badge-pill-purple";
                        }
                        $("<span>").addClass("badge-status-pill " + pillClass).text(label).appendTo(container);
                    };
                } else if (dfLower === 'days') {
                    c.width = 60;
                    c.alignment = 'center';
                    c.cssClass = 'mb-col-bold';
                    c.cellTemplate = function (container, options) {
                        var days = options.data.Days;
                        var color = options.data.DaysColor;
                        var $wrap = $("<span>").css({ display: "inline-flex", alignItems: "center", justifyContent: "center", gap: "5px" });
                        if (color) {
                            $("<span>").css({
                                display: "inline-block",
                                width: "13px",
                                height: "13px",
                                borderRadius: "50%",
                                backgroundColor: color,
                                flexShrink: 0
                            }).appendTo($wrap);
                        }
                        $("<span>").text(days === null || days === undefined ? '-' : days).appendTo($wrap);
                        $wrap.appendTo(container);
                    };
                } else if (dfLower === 'priority') {
                    c.width = 90;
                    c.alignment = 'center';
                    c.cellTemplate = function (container, options) {
                        var priority = (options.data[col.dataField] || options.data.Priority || options.data.priority || 'REGULAR').toUpperCase().trim();
                        if (!priority) priority = 'REGULAR';

                        var badgeClass = "badge-status-pill badge-pill-info";
                        if (priority === 'SAMPLE') {
                            badgeClass = "badge-status-pill badge-pill-warning";
                        } else if (priority === 'ARGENT' || priority === 'URGENT') {
                            badgeClass = "badge-status-pill badge-pill-danger";
                        }

                        $("<span>")
                            .addClass(badgeClass)
                            .text(priority)
                            .appendTo(container);
                    };
                } else if (dfLower === 'rcode' || dfLower === 'r_code' || dfLower === 'r.code') {
                    c.width = 85;
                    c.alignment = 'center';
                    c.cellTemplate = withCustomSearchIcon(col.dataField, function ($wrap, options) {
                        var val = options.data[col.dataField] || options.data.RCode || options.data.R_Code || '-';
                        var priority = (options.data.Priority || options.data.priority || 'REGULAR').toUpperCase().trim();
                        if (!priority) priority = 'REGULAR';

                        var cls = 'rcode-regular';
                        if (priority === 'SAMPLE') {
                            cls = 'rcode-sample';
                        } else if (priority === 'ARGENT' || priority === 'URGENT') {
                            cls = 'rcode-argent';
                        }

                        $("<span>")
                            .addClass(cls)
                            .text(val)
                            .appendTo($wrap);
                    });
                } else if (dfLower === 'jangadno' || dfLower === 'jangad' || dfLower === 'challanno') {
                    // Plain text (no badge-pill "label" look), with the
                    // shared search icon.
                    c.width = 90;
                    c.alignment = 'center';
                    c.cellTemplate = withCustomSearchIcon(col.dataField, function ($wrap, options) {
                        var val = options.data[col.dataField] || options.data.ChallanNo || options.data.JangadNo || '-';
                        $("<span>").addClass("mb-cell-search-text").text(val).appendTo($wrap);
                    });
                } else if (dfLower === 'branchname' || dfLower === 'br' || dfLower === 'branchshortname') {
                    c.width = 65;
                    c.alignment = 'center';
                    c.cellTemplate = withCustomSearchIcon(col.dataField, function ($wrap, options) {
                        var rawVal = options.data.BranchShortName || options.data.ShortName || options.data[col.dataField] || options.data.BranchName || '';
                        var displayVal = rawVal;

                        // Normalize "Branch 1" / "Branch #1" / "Branch-1" to "BR-1"
                        if (typeof displayVal === 'string' && displayVal.toLowerCase().indexOf('branch') > -1) {
                            displayVal = displayVal.replace(/branch\s*#?\s*/i, 'BR-').trim();
                        }

                        if (displayVal === 'Not Assigned' || !displayVal) {
                            $("<span>").text(displayVal || '-').css({ "color": "#94a3b8" }).appendTo($wrap);
                        } else {
                            $("<strong>").text(displayVal).css({ "color": "#0f172a", "font-weight": "700" }).appendTo($wrap);
                        }
                    });
                } else if (dfLower === 'maingrad' || dfLower === 'grade') {
                    c.width = 55;
                    c.alignment = 'center';
                    c.cellTemplate = function (container, options) {
                        var val = options.data[col.dataField];
                        if (val) {
                            var isMix = (val + '').toUpperCase() === 'MIX';
                            $("<span>").addClass("badge-status-pill " + (isMix ? "badge-pill-warning" : "badge-pill-info")).text(val).appendTo(container);
                        } else {
                            $("<span>").text('-').appendTo(container);
                        }
                    };
                } else if (dfLower === 'date') {
                    c.width = 95;
                } else if (dfLower === 'process') {
                    c.width = 70;
                } else if (dfLower === 'tableno') {
                    c.width = 75;
                    c.alignment = 'center';
                    c.cellTemplate = withSearchIcon(col.dataField);
                    c.cssClass = 'mb-col-bold';
                } else if (dfLower === 'roughweight') {
                    c.caption = 'L.Carat';
                    c.width = 85;
                    c.cssClass = 'mb-col-bold';
                } else if (dfLower === 'growthrate') {
                    c.width = 80;
                } else if (dfLower === 'roughpcs' || dfLower === 'pcs') {
                    c.width = 50;
                } else if (dfLower === 'roughsize' || dfLower === 'size') {
                    c.width = 55;
                } else if (dfLower === 'factorycode' || dfLower === 'colortype' || dfLower === 'sizecodetype' || dfLower === 'boxno' || dfLower === 'machineno') {
                    c.width = 55;
                } else if (dfLower === 'height') {
                    c.width = 75;
                } else if (dfLower === 'rate') {
                    c.width = 75;
                }

                // Compact default for every column not given a specific
                // width above (e.g. CLVRunningDate/MFGCompleteDate/Remarks)
                // so the grid stays narrow instead of auto-sizing to content.
                // if (!c.width && !c.minWidth) {
                //     c.width = 85;
                // }

                gridCols.push(c);
            });

            // Move L Code (LotCode) to sit right before Table No - the SP's
            // Table 1 metadata orders it much later (after R. Code), but
            // the grid should show it earlier in the front columns.
            var lotCodeIdx = -1, tableNoIdx = -1;
            for (var gi = 0; gi < gridCols.length; gi++) {
                if ((gridCols[gi].dataField || '').toLowerCase() === 'lotcode') lotCodeIdx = gi;
                if ((gridCols[gi].dataField || '').toLowerCase() === 'tableno') tableNoIdx = gi;
            }
            if (lotCodeIdx > -1 && tableNoIdx > -1 && lotCodeIdx !== tableNoIdx) {
                var lotCodeCol = gridCols.splice(lotCodeIdx, 1)[0];
                if (lotCodeIdx < tableNoIdx) tableNoIdx--;
                gridCols.splice(tableNoIdx, 0, lotCodeCol);
            }

            // Move Jangad No (ChallanNo) to be the very first data column,
            // ahead of Date (it sits right after the fixed "#" index column).
            var jangadIdx = -1, dateIdx = -1;
            for (var gj = 0; gj < gridCols.length; gj++) {
                if ((gridCols[gj].dataField || '').toLowerCase() === 'challanno') jangadIdx = gj;
                if ((gridCols[gj].dataField || '').toLowerCase() === 'date') dateIdx = gj;
            }
            if (jangadIdx > -1 && dateIdx > -1 && jangadIdx !== dateIdx) {
                var jangadCol = gridCols.splice(jangadIdx, 1)[0];
                if (jangadIdx < dateIdx) dateIdx--;
                gridCols.splice(dateIdx, 0, jangadCol);
            }

            // Stage indicator column - a mini version of the stage filter
            // buttons above the grid, right after L Code, so each row shows
            // its own stage at a glance using the same color/icon as the
            // button you'd click to filter down to that stage.
            var lCodeIdx = -1;
            for (var gk = 0; gk < gridCols.length; gk++) {
                if ((gridCols[gk].dataField || '').toLowerCase() === 'lotcode') lCodeIdx = gk;
            }
            if (lCodeIdx > -1) {
                gridCols.splice(lCodeIdx + 1, 0, {
                    dataField: 'StageStatus',
                    name: 'StageIndicator',
                    caption: 'Stage',
                    width: 40,
                    alignment: 'center',
                    allowSorting: false,
                    allowFiltering: false,
                    allowHeaderFiltering: false,
                    cellTemplate: function (container, options) {
                        var stage = options.data.StageStatus || '';
                        var info = stageButtonInfo(stage);
                        var $btn = $("<span>").addClass("mb-row-stage-btn " + info.cls).attr("title", stage || '-');
                        if (info.icon) {
                            $("<i>").addClass("fa " + info.icon).appendTo($btn);
                        }
                        $btn.appendTo(container);
                    }
                });
            }

            // Add Action Column (Hamburger Menu for Reports & Charts) at the very end
            gridCols.push({
                caption: 'Action',
                width: 50,
                alignment: 'center',
                fixed: true,
                fixedPosition: 'right',
                allowResizing: false,
                allowReordering: false,
                allowExporting: false,
                cellTemplate: function (container, options) {
                    var $btn = $("<i>")
                        .addClass("fa fa-bars btn-grid-row-menu")
                        .attr("title", "View Reports")
                        .on("click", function (e) {
                            e.preventDefault();
                            e.stopPropagation();
                            if (e.originalEvent) {
                                e.originalEvent.stopPropagation();
                                e.originalEvent.preventDefault();
                            }
                            var btnEl = this;
                            $scope.$apply(function () {
                                $scope.OpenReportMenu(options.data, e, btnEl);
                            });
                        });
                    $btn.appendTo(container);
                }
            });

            // Format dynamic summaries from SP Table 2 metadata + Total record count
            var summaryItems = [];

            // Add Total Record Count Summary under the first data column (e.g., JangadNo)
            var countCol = ($scope.DynamicColumns && $scope.DynamicColumns.length > 0) ? $scope.DynamicColumns[0].dataField : 'JangadNo';
            summaryItems.push({
                column: countCol,
                summaryType: 'count',
                valueFormat: '#,##0',
                displayFormat: '{0}',
                alignByColumn: true
            });

            angular.forEach($scope.DynamicSummary, function (s) {
                var sumCol = s.column || s.dataField;
                if (sumCol && sumCol !== countCol) {
                    var item = {
                        column: sumCol,
                        summaryType: s.summaryType || 'sum',
                        valueFormat: s.valueFormat || '#,##0.000',
                        displayFormat: '{0}',
                        alignByColumn: true
                    };
                    // L.Carat (RoughWeight) is too narrow (85px) for its own
                    // total to display without truncating ("871,1...") -
                    // show it in the wider Table No footer cell instead.
                    if (sumCol === 'RoughWeight') {
                        item.showInColumn = 'TableNo';
                    }
                    summaryItems.push(item);
                }
            });

            // Destroy previous grid instance if exists
            var gridElement = $("#masterBookGridContainer");
            if (gridElement.data("dxDataGrid")) {
                gridElement.dxDataGrid("dispose");
            }

            gridElement.dxDataGrid({
                dataSource: $scope.List,
                columns: gridCols,
                keyExpr: 'RowKey',
                // No ri-row-animate stagger-fade here (unlike the app's other
                // grids): it keys its animation-delay off e.rowIndex, which
                // under virtual scrolling is the row's GLOBAL index into the
                // ~1200-row dataset, not its on-screen position - a row deep
                // in the list (e.g. index 900) would get a ~40s delay and
                // sit at opacity:0 (invisible, borders included) every time
                // virtual scroll recycles it into view.
                height: '100%',
                columnAutoWidth: true,
                allowColumnResizing: true,
                columnResizingMode: 'widget',
                allowColumnReordering: true,
                columnChooser: {
                    enabled: true,
                    mode: 'select'
                },
                columnFixing: {
                    enabled: true
                },
                showColumnLines: true,
                showRowLines: true,
                showBorders: true,
                rowAlternationEnabled: true,
                wordWrapEnabled: false,
                // "single" - "multiple" rendered a sort-order number badge
                // next to the direction arrow even with only one column
                // sorted, showing as two stacked arrow-like glyphs in
                // narrow headers (e.g. Days).
                sorting: { mode: "single" },
                scrolling: {
                    mode: 'virtual'
                },
                paging: { enabled: false },
                pager: { visible: false },
                // The column-wise filter row, the filter-expression panel
                // bar, and the per-column header filter dropdown are all
                // hidden - filtering now happens via the per-cell search
                // icons (columnOption filterValue) and the main search box,
                // with the "Reset All Filters" button clearing all of it
                // at once.
                filterRow: {
                    visible: false,
                    applyFilter: 'auto'
                },
                filterPanel: { visible: false },
                // The funnel icon itself stays hidden (see the
                // .dx-header-filter CSS rule above) - visible:true just
                // keeps it in the DOM so onCellDblClick below can trigger it
                // programmatically on a header double-click instead of
                // showing it as a permanent icon on every column.
                headerFilter: { visible: true ,allowSearch : true},
                searchPanel: { visible: false },
                export: { enabled: false },
                onCellDblClick: function (e) {
                    if (e.rowType === 'header') {
                        var $filterIcon = $(e.cellElement).find('.dx-header-filter');
                        if ($filterIcon.length) $filterIcon.trigger('dxclick');
                    }
                },
                onToolbarPreparing: function (e) {
                    // Column chooser / export / search are rendered in the
                    // card header above instead of the grid's own toolbar row.
                    e.toolbarOptions.items = [];
                },
                summary: {
                    totalItems: summaryItems
                }
            });
        };

        // Open Floating Report Context Menu
        $scope.OpenReportMenu = function (rowItem, event, btnElement) {
            // If already open for this exact row, toggle close
            if ($scope.ShowReportMenu && $scope.SelectedRowItem && $scope.SelectedRowItem === rowItem) {
                $scope.CloseReportMenu();
                return;
            }

            $scope.SelectedRowItem = rowItem;
            $scope.ShowReportMenu = true;

            var targetEl = btnElement;
            if (!targetEl && event) {
                targetEl = event.currentTarget || event.target;
            }
            if (targetEl && !$(targetEl).hasClass('btn-grid-row-menu')) {
                targetEl = $(targetEl).closest('.btn-grid-row-menu')[0] || targetEl;
            }

            var menuWidth = 195;
            var menuHeight = 180;
            var winWidth = $(window).width();
            var winHeight = $(window).height();
            var posX = 0;
            var posY = 0;

            if (targetEl && typeof targetEl.getBoundingClientRect === 'function') {
                var rect = targetEl.getBoundingClientRect();
                posX = rect.right - menuWidth;
                posY = rect.bottom + 4;

                if (posX + menuWidth > winWidth - 10) {
                    posX = winWidth - menuWidth - 10;
                }
                if (posX < 10) {
                    posX = rect.left > 10 ? rect.left : 10;
                }
                if (posY + menuHeight > winHeight - 10) {
                    posY = Math.max(10, rect.top - menuHeight - 4);
                }
            } else {
                var clickX = (event && (event.clientX || (event.originalEvent && event.originalEvent.clientX))) || (winWidth - menuWidth - 20);
                var clickY = (event && (event.clientY || (event.originalEvent && event.originalEvent.clientY))) || 100;

                posX = clickX - menuWidth + 20;
                posY = clickY + 10;

                if (posX + menuWidth > winWidth - 10) {
                    posX = winWidth - menuWidth - 10;
                }
                if (posX < 10) {
                    posX = 10;
                }
                if (posY + menuHeight > winHeight - 10) {
                    posY = clickY - menuHeight - 5;
                }
            }

            $scope.ReportMenuStyle = {
                top: Math.round(posY) + 'px',
                left: Math.round(posX) + 'px'
            };
        };

        // Close Floating Report Context Menu
        $scope.CloseReportMenu = function () {
            $scope.ShowReportMenu = false;
            $scope.SelectedRowItem = null;
        };

        var onScrollOrResize = function (e) {
            if ($scope.ShowReportMenu) {
                if (e && e.target && $(e.target).closest("#mbReportContextMenu").length > 0) {
                    return;
                }
                $scope.$apply(function () {
                    $scope.CloseReportMenu();
                });
            }
        };

        // Close menu immediately on any scroll (grid scroll, page scroll, mobile scroll) or window resize
        window.addEventListener('scroll', onScrollOrResize, true);
        window.addEventListener('resize', onScrollOrResize);

        // Global Document Click to close menu when clicking outside
        $(document).off("click.mbReportMenu").on("click.mbReportMenu", function (e) {
            if ($(e.target).closest("#mbReportContextMenu, .btn-grid-row-menu").length === 0) {
                if ($scope.ShowReportMenu) {
                    $scope.$apply(function () {
                        $scope.CloseReportMenu();
                    });
                }
            }
        });

        $scope.$on("$destroy", function () {
            $(document).off("click.mbReportMenu");
            window.removeEventListener('scroll', onScrollOrResize, true);
            window.removeEventListener('resize', onScrollOrResize);
        });

        // Action Click Handler for Reports & Charts
        $scope.ClvChartData = null;
        $scope.ClvMain = null;
        $scope.ClvGradRows = [];
        $scope.ClvGradTotalRow = null;
        $scope.IsLoadingClvChart = false;

        $scope.OpenReport = function (reportType) {
            var rowItem = $scope.SelectedRowItem;
            $scope.CloseReportMenu();

            if (reportType === 'CLV Chart') {
                $scope.OpenClvChart(rowItem);
                return;
            }
            // Pre Rough / MFG Chart / IGI complet: not wired up yet.
        };

        // Fetches Report/GetAssortmentChart (Type=CLV) from the Branch 1 API,
        // keyed by this row's LotCode (the Kapan key - RCode isn't unique per
        // Kapan since multiple Lot splits can share one RCode).
        $scope.ClvLotCode = '';

        $scope.OpenClvChart = function (rowItem) {
            var lotCode = rowItem ? rowItem.LotCode : null;
            if (!lotCode) {
                Noty("error", "This row has no Lot Code to look up a CLV Chart for.");
                return;
            }

            // Captured into its own scope var, not read from SelectedRowItem
            // in the modal template - OpenReport() already clears
            // SelectedRowItem via CloseReportMenu() before this runs, so the
            // modal would otherwise render with a blank Lot Code.
            $scope.ClvLotCode = lotCode;

            $scope.IsLoadingClvChart = true;
            $scope.ClvChartData = null;
            $scope.ClvMain = null;
            $scope.ClvGradRows = [];
            $scope.ClvGradTotalRow = null;
            if (typeof show_loader === 'function') show_loader();

            $http.get('@Url.Action("Get_ClvChartData", "Master")', { params: { LotCode: lotCode } }).then(function (res) {
                $scope.IsLoadingClvChart = false;
                if (typeof hide_loader === 'function') hide_loader();
                if (res.data && res.data.success) {
                    $scope.ClvChartData = res.data.data || {};
                     
                     console.log(res.data.data)
                    // List (singular, "list" in camelCase JSON) is the one
                    // header row; List15 ("list15") is the Grad-wise
                    // breakdown (B/C/...) with a trailing "Total" row - both
                    // get pulled out into their own scope vars since the
                    // header/grad-box markup above references them directly
                    // instead of indexing into the arrays inline.
                    var mainList = $scope.ClvChartData.list || [];
                    $scope.ClvMain = mainList.length ? mainList[0] : null;

                    var gradList = $scope.ClvChartData.list15 || [];
                    $scope.ClvGradTotalRow = null;
                    $scope.ClvGradRows = [];
                    angular.forEach(gradList, function (r) {
                        var gradNo = ($scope.gv(r, 'GradNo') || '').toString().toUpperCase();
                        if (gradNo === 'TOTAL') {
                            $scope.ClvGradTotalRow = r;
                        } else {
                            $scope.ClvGradRows.push(r);
                        }
                    });

                    // API didn't send an explicit "Total" row for the Grad
                    // breakdown - compute one so the Grad box/mini-panels
                    // don't just show a blank Total row. Pcs/Carat are plain
                    // sums; Rate/PRD/CLV-per-carat values are Carat-weighted
                    // averages (verified against the PDF reference: e.g.
                    // Rate 16.60 = sum(Rate*Carat)/sum(Carat) across B/C,
                    // not a plain average).
                    if (!$scope.ClvGradTotalRow && $scope.ClvGradRows.length) {
                        $scope.ClvGradTotalRow = $scope.ClvComputeGradTotal($scope.ClvGradRows);
                    }

                    $('#ClvChartModal').modal('show');
                } else {
                    Noty("error", (res.data && res.data.message) || "Failed to load CLV Chart.");
                }
            }, function () {
                $scope.IsLoadingClvChart = false;
                if (typeof hide_loader === 'function') hide_loader();
                Noty("error", "Error connecting to server.");
            });
        };

        // Case-insensitive field lookup - the CLV Chart API response is
        // camelCase JSON (ASP.NET Core default), but the report config
        // above is written against the external project's PascalCase C#
        // model names (ReportRepository.cs) for readability/traceability.
        // Tries the exact name, then first-letter-lowered, then a full
        // case-insensitive scan (covers short-acronym fields like "RWT"
        // which camelCase to "rwt", not "rWT").
        $scope.gv = function (row, pascalName) {
            if (!row || !pascalName) return null;
            if (row[pascalName] !== undefined) return row[pascalName];
            var camel = pascalName.charAt(0).toLowerCase() + pascalName.slice(1);
            if (row[camel] !== undefined) return row[camel];
            var lower = pascalName.toLowerCase();
            for (var k in row) {
                if (row.hasOwnProperty(k) && k.toLowerCase() === lower) return row[k];
            }
            return null;
        };

        $scope.fmt = function (val, decimals) {
            if (val === null || val === undefined || val === '' || isNaN(val)) return '';
            return Number(val).toFixed(decimals || 0);
        };

        // Dates arrive from the server pre-formatted as "31 Oct 2026"
        // (SQL CONVERT style 106) - reformat to "31 Oct'26" for display in
        // the Action popover's date rows.
        $scope.fmtPopupDate = function (val) {
            if (!val) return '';
            var parts = (val + '').trim().split(/\s+/);
            if (parts.length !== 3) return val;
            return parts[0] + ' ' + parts[1] + '\'' + parts[2].slice(-2);
        };

        $scope.ClvSum = function (rows, pascalName) {
            if (!rows || !rows.length) return 0;
            var total = 0;
            angular.forEach(rows, function (r) {
                var v = parseFloat($scope.gv(r, pascalName));
                if (!isNaN(v)) total += v;
            });
            return total;
        };

        $scope.ClvPct = function (part, whole) {
            part = parseFloat(part) || 0;
            whole = parseFloat(whole) || 0;
            return whole ? (part / whole * 100) : 0;
        };

        // PRD/FINAL shape tables have no separate "total row" in the API
        // response - just GR/NGR data rows - so TOTAL/GRAND TOTAL is summed
        // here instead. Yeild %/Result % are both recomputed as
        // PolishWeight/RPartWeight*100 (verified against the PDF reference:
        // summed GR+NGR gives exactly the printed total). Size has no known
        // summation formula (not a simple sum/average of the row values),
        // so it's left blank on the computed total row rather than guessed.
        $scope.ClvGroupTotal = function (rows) {
            var t = { Pcs: 0, RPartWeight: 0, PolishWeight: 0, PrcAmt: 0, Yeild: 0, Per: 0 };
            if (!rows || !rows.length) return t;
            angular.forEach(rows, function (r) {
                t.Pcs += parseFloat($scope.gv(r, 'Pcs')) || 0;
                t.RPartWeight += parseFloat($scope.gv(r, 'RPartWeight')) || 0;
                t.PolishWeight += parseFloat($scope.gv(r, 'PolishWeight')) || 0;
                t.PrcAmt += parseFloat($scope.gv(r, 'PrcAmt')) || 0;
            });
            var pct = t.RPartWeight ? (t.PolishWeight / t.RPartWeight * 100) : 0;
            t.Yeild = pct;
            t.Per = pct;
            return t;
        };

        // Fallback "Total" row for the Grad box (and its 2 sibling mini-
        // panels, which reuse the same ClvGradTotalRow object) when the API
        // doesn't send one. Pcs/Carat/Per are plain sums; Rate and the
        // PRD/CLV per-carat & per-percent values are Carat-weighted
        // averages, not plain averages - verified against the PDF
        // reference (e.g. Rate 16.60 = sum(Rate*Carat)/sum(Carat) across
        // Grad B/C, not (17.16+13.39)/2).
        $scope.ClvComputeGradTotal = function (rows) {
            var t = {
                GradNo: 'TOTAL', Pcs: 0, Carat: 0, Per: 0,
                Rate: 0, PrdPerCTValue: 0, ClvPerCTValue: 0, PrdPer: 0, ClvPer: 0
            };
            if (!rows || !rows.length) return t;

            var totalCarat = 0;
            var wRate = 0, wPrdCT = 0, wClvCT = 0, wPrdPer = 0, wClvPer = 0;

            angular.forEach(rows, function (r) {
                var pcs = parseFloat($scope.gv(r, 'Pcs')) || 0;
                var carat = parseFloat($scope.gv(r, 'Carat')) || 0;
                var per = parseFloat($scope.gv(r, 'Per')) || 0;

                t.Pcs += pcs;
                t.Carat += carat;
                t.Per += per;
                totalCarat += carat;

                wRate += (parseFloat($scope.gv(r, 'Rate')) || 0) * carat;
                wPrdCT += (parseFloat($scope.gv(r, 'PrdPerCTValue')) || 0) * carat;
                wClvCT += (parseFloat($scope.gv(r, 'ClvPerCTValue')) || 0) * carat;
                wPrdPer += (parseFloat($scope.gv(r, 'PrdPer')) || 0) * carat;
                wClvPer += (parseFloat($scope.gv(r, 'ClvPer')) || 0) * carat;
            });

            if (totalCarat) {
                t.Rate = wRate / totalCarat;
                t.PrdPerCTValue = wPrdCT / totalCarat;
                t.ClvPerCTValue = wClvCT / totalCarat;
                t.PrdPer = wPrdPer / totalCarat;
                t.ClvPer = wClvPer / totalCarat;
            }

            return t;
        };
    }]);
</script>
