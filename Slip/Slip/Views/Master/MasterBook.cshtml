                                <tr ng-repeat="r in ClvChartData.list16"><td>{{gv(r,'Status')}}</td><td>{{fmt(gv(r,'LossPW'),2)}}</td><td>{{fmt(gv(r,'Per'),2)}}</td><td>{{fmt(gv(r,'LossPrc'),2)}}</td><td>{{fmt(gv(r,'PrcPer'),2)}}</td></tr>
