                                <tr ng-repeat="r in ClvChartData.list24"><td>{{gv(r,'GradType')}}</td><td>{{gv(r,'Pcs')}}</td><td>{{fmt(gv(r,'PolishWeight'),2)}}</td><td>{{fmt(gv(r,'Per'),2)}}</td></tr>
