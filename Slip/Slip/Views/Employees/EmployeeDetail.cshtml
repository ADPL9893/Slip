@{
    ViewBag.Title = "Employee List";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}


<div ng-controller="EmployeeDetailCtrl" class="rough-dist-list-page">

    <!-- DataGrid Container Card (UserMaster Style) -->
    <div class="rdl-grid-card">
        <div class="rdl-card-header">
            <div class="rdl-card-title-left">
                <i class="fa fa-users"></i>
                <h3>Employee List</h3>
                <span class="badge-status-pill badge-pill-info">
                    <i class="fa fa-database"></i> {{List.length || 0}} Total Records
                </span>
            </div>
            <div class="rdl-card-actions">
                <button class="btn-ri-add-main" type="button" ng-click="OpenAddNew()" title="Add New Employee">
                    <i class="fa fa-plus"></i>
                </button>
                <button type="button" class="grid-action-btn-edit" title="Column Chooser" ng-click="ShowColumnChooser()">
                    <i class="fa fa-columns"></i>
                </button>
                <button type="button" class="grid-action-btn-edit" title="Export to Excel" ng-click="ExportGrid()">
                    <i class="fa fa-file-excel-o"></i>
                </button>
                <div class="field-select-wrap field-select-wrap--search">
                    <input type="text"
                           ng-model="SearchText"
                           ng-change="OnSearchChange()"
                           placeholder="Search all employees..."
                           class="form-control ri-input" />
                </div>
            </div>
        </div>
        <div class="rdl-grid-body">
            <div class="uigrid">
                <div id="gridContainer" style="width: 100%;"></div>
            </div>
        </div>
    </div>

    <!-- Delete Confirmation Modal -->
    <div class="modal fade" id="ConfirmDeleteModal" role="dialog" data-backdrop="static">
        <div class="modal-dialog modal-md">
            <div class="modal-content">
                <div class="modal-header">
                    <div class="modal-header-brand">
                        <i class="fa fa-exclamation-triangle" style="color: #ef4444; font-size: 18px;"></i>
                        <h4 class="modal-header-title">Confirm Delete Employee</h4>
                    </div>
                    <button type="button" class="close modal-close-btn" data-dismiss="modal">&times;</button>
                </div>
                <div class="modal-body" style="background: #ffffff;">
                    <div class="delete-dialog-content">
                        <div class="delete-warning-icon">
                            <i class="fa fa-trash-o"></i>
                        </div>
                        <h4 class="delete-dialog-title">Delete Employee Record?</h4>
                        <p class="delete-dialog-text">
                            Are you sure you want to delete employee <strong>{{SelectedDeleteItem.EmployeeName || SelectedDeleteItem.EmpName || 'this record'}}</strong> 
                            <span ng-if="SelectedDeleteItem.EmpCode || SelectedDeleteItem.EmployeeCode">({{SelectedDeleteItem.EmpCode || SelectedDeleteItem.EmployeeCode}})</span>?
                        </p>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn-modal-action btn-modal-reset" data-dismiss="modal" type="button">
                        <i class="fa fa-times"></i> Cancel
                    </button>
                    <button class="btn-modal-action btn-modal-delete" ng-click="ExecuteDelete()" type="button">
                        <i class="fa fa-trash"></i> Confirm Delete
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    var module;
    try {
        module = angular.module('app');
    } catch (e) {
        module = angular.module('app', ['ngAnimate', 'ngTouch', 'ui.grid']);
    }

    module.controller("EmployeeDetailCtrl", ['$scope', '$http', '$timeout', function ($scope, $http, $timeout) {
        $scope.List = [];
        $scope.DataField = [];
        $scope.IsLoading = false;
        $scope.SelectedDeleteItem = null;

        // Open Add New in new browser tab
        $scope.OpenAddNew = function () {
            window.open('@Url.Action("Index", "Employees")?id=0', '_blank');
        };

        // Open Edit in new browser tab
        $scope.EditRow = function (id) {
            window.open('@Url.Action("Index", "Employees")?id=' + (id || 0), '_blank');
        };

        // Fetch Data from Server
        $scope.FetchData = function () {
            $scope.IsLoading = true;
            if (typeof show_loader === 'function') show_loader();

            $http.get('@Url.Action("EMP_Employee_Getdata", "Employees")')
            .then(function (response) {
                $scope.IsLoading = false;
                if (typeof hide_loader === 'function') hide_loader();

                var rawList = (response.data && response.data.EMPEmployeeList) ? response.data.EMPEmployeeList : [];
                // Ensure unique ID for DevExtreme keyExpr
                angular.forEach(rawList, function (item) {
                    item.ID = item.EmployeeID || item.ID;
                });
                $scope.List = rawList;

                $scope.BuildGridColumns();
            }, function () {
                $scope.IsLoading = false;
                if (typeof hide_loader === 'function') hide_loader();
                if (typeof Noty === 'function') {
                    Noty("error", "Error loading employee list from server.");
                }
            });
        };

        // Format Grid Columns (Only requested columns: Branch, Department, Code, Employee Name, Designation, Gender, Status, Is Head)
        $scope.BuildGridColumns = function () {
            var gridColumns = [];

            // 1. Index / Serial # Column
            gridColumns.push({
                caption: '#',
                width: 45,
                alignment: 'center',
                allowReordering: false,
                fixed: true,
                fixedPosition: 'left',
                cellTemplate: function (container, options) {
                    $("<span>")
                        .text(options.rowIndex + 1)
                        .css({ "font-weight": "600", "color": "#64748b" })
                        .appendTo(container);
                }
            });

            // 2. Branch
            gridColumns.push({
                caption: 'Branch',
                dataField: 'BranchName',
                minWidth: 120,
                calculateCellValue: function (data) {
                    return data.BranchName || '-';
                },
                cellTemplate: function (container, options) {
                    $("<span>")
                        .css({ "font-weight": "600", "color": "#0f172a" })
                        .text(options.value || '-')
                        .appendTo(container);
                }
            });

            // 3. Department
            gridColumns.push({
                caption: 'Department',
                dataField: 'DepartmentName',
                minWidth: 120,
                calculateCellValue: function (data) {
                    return data.DepartmentName || '-';
                },
                cellTemplate: function (container, options) {
                    $("<span>")
                        .css({ "color": "#334155", "font-weight": "500" })
                        .text(options.value || '-')
                        .appendTo(container);
                }
            });

            // 4. Code (Emp Code)
            gridColumns.push({
                caption: 'Code',
                dataField: 'EmpCode',
                width: 85,
                alignment: 'center',
                calculateCellValue: function (data) {
                    return data.EmpCode || data.EmployeeCode || data.Code || '-';
                },
                cellTemplate: function (container, options) {
                    $("<span>")
                        .text(options.value || '-')
                        .css({ "font-weight": "700", "color": "#0284c7" })
                        .appendTo(container);
                }
            });

            // 5. Employee Name
            gridColumns.push({
                caption: 'Employee Name',
                dataField: 'EmployeeName',
                minWidth: 160,
                calculateCellValue: function (data) {
                    return data.EmployeeName || data.EmpName || data.Name || '-';
                },
                cellTemplate: function (container, options) {
                    $("<strong>")
                        .text(options.value || '-')
                        .css({ "color": "#0f172a", "font-weight": "600" })
                        .appendTo(container);
                }
            });

            // 6. Designation
            gridColumns.push({
                caption: 'Designation',
                dataField: 'Designation',
                minWidth: 110,
                alignment: 'center',
                cellTemplate: function (container, options) {
                    var val = options.value || '-';
                    var isMgr = (val.toString().toUpperCase() === 'MANAGER');
                    if (isMgr) {
                        $("<span>").addClass("badge-status-pill badge-pill-info").text(val).appendTo(container);
                    } else {
                        $("<span>").css({ "font-weight": "600", "color": "#475569" }).text(val).appendTo(container);
                    }
                }
            });

            // 7. Gender (Normal plain text, no badge)
            gridColumns.push({
                caption: 'Gender',
                dataField: 'Gender',
                width: 85,
                alignment: 'center',
                cellTemplate: function (container, options) {
                    $("<span>")
                        .css({ "color": "#475569", "font-weight": "500" })
                        .text(options.value || '-')
                        .appendTo(container);
                }
            });

            // 8. Active/Inactive
            gridColumns.push({
                caption: 'Active / Inactive',
                dataField: 'IsActive',
                width: 115,
                alignment: 'center',
                calculateCellValue: function (data) {
                    var val = data.IsActive !== undefined ? data.IsActive : data.Status;
                    return (val === true || val === 'True' || val === 'true' || val === 1 || val === '1');
                },
                cellTemplate: function (container, options) {
                    if (options.value) {
                        $("<span>").addClass("badge-status-pill badge-pill-success").text("Active").appendTo(container);
                    } else {
                        $("<span>").addClass("badge-status-pill badge-pill-danger").text("Inactive").appendTo(container);
                    }
                }
            });

            // 9. Is Head
            gridColumns.push({
                caption: 'Is Head',
                dataField: 'IsHead',
                width: 90,
                alignment: 'center',
                calculateCellValue: function (data) {
                    var val = data.IsHead;
                    return (val === true || val === 'True' || val === 'true' || val === 1 || val === '1');
                },
                cellTemplate: function (container, options) {
                    if (options.value) {
                        $("<span>")
                            .addClass("badge-status-pill badge-pill-info")
                            .html('<i class="fa fa-check-circle"></i> Yes')
                            .appendTo(container);
                    } else {
                        $("<span>")
                            .css({ "color": "#94a3b8", "font-weight": "500", "font-size": "11.5px" })
                            .text("No")
                            .appendTo(container);
                    }
                }
            });

            // 10. Action Column (Edit & Delete)
            gridColumns.push({
                caption: 'Action',
                width: 95,
                alignment: 'center',
                fixed: true,
                fixedPosition: 'right',
                allowReordering: false,
                cellTemplate: function (container, options) {
                    var group = $("<div>").addClass("grid-btn-group");

                    // Edit Button
                    $("<button>")
                        .addClass("grid-action-btn-edit")
                        .attr("title", "Edit Employee")
                        .html('<i class="fa fa-pencil"></i>')
                        .on("click", function (e) {
                            e.preventDefault();
                            $scope.$apply(function () {
                                $scope.EditRow(options.data.ID || options.data.EmployeeID);
                            });
                        })
                        .appendTo(group);

                    // Delete Button
                    $("<button>")
                        .addClass("grid-action-btn-del")
                        .attr("title", "Delete Employee")
                        .html('<i class="fa fa-trash-o"></i>')
                        .on("click", function (e) {
                            e.preventDefault();
                            $scope.$apply(function () {
                                $scope.PromptDelete(options.data);
                            });
                        })
                        .appendTo(group);

                    group.appendTo(container);
                }
            });

            $scope.InitGrid(gridColumns);
        };

        // Delete handlers
        $scope.PromptDelete = function (item) {
            $scope.SelectedDeleteItem = item;
            $("#ConfirmDeleteModal").modal("show");
        };

        $scope.ExecuteDelete = function () {
            if (!$scope.SelectedDeleteItem) {
                $("#ConfirmDeleteModal").modal("hide");
                return;
            }
            var empId = $scope.SelectedDeleteItem.ID || $scope.SelectedDeleteItem.EmployeeID;
            if (!empId) {
                $("#ConfirmDeleteModal").modal("hide");
                return;
            }

            $scope.IsLoading = true;
            if (typeof show_loader === 'function') show_loader();

            var JsonPassData = { "EmployeeID": empId };
            var Action = "DELETE";

            $http({
                method: "post",
                url: '@Url.Action("InsertUpdateEmployee", "Employees")',
                data: { model: JsonPassData, Action: Action },
                dataType: "json"
            }).then(function (ret) {
                $scope.IsLoading = false;
                if (typeof hide_loader === 'function') hide_loader();
                $("#ConfirmDeleteModal").modal("hide");

                var respMsg = (ret.data && typeof ret.data === 'string') ? ret.data : (ret.data && ret.data.message ? ret.data.message : '');
                if (respMsg === "Recored Is Deleted" || respMsg.toLowerCase().indexOf("deleted") !== -1) {
                    if (typeof Noty === 'function') Noty("success", "Record Deleted Successfully");
                    $scope.FetchData();
                } else {
                    if (typeof Noty === 'function') Noty("error", respMsg || "Record Not Deleted");
                }
            }, function () {
                $scope.IsLoading = false;
                if (typeof hide_loader === 'function') hide_loader();
                $("#ConfirmDeleteModal").modal("hide");
                if (typeof Noty === 'function') Noty("error", "Error connecting to server.");
            });
        };

        // Toolbar actions matching UserMaster
        $scope.SearchText = '';
        $scope.OnSearchChange = function () {
            var gridInstance = $("#gridContainer").dxDataGrid("instance");
            if (gridInstance) {
                gridInstance.searchByText($scope.SearchText || '');
            }
        };

        $scope.ShowColumnChooser = function () {
            var gridInstance = $("#gridContainer").dxDataGrid("instance");
            if (gridInstance) {
                gridInstance.showColumnChooser();
            }
        };

        $scope.ExportGrid = function () {
            var gridInstance = $("#gridContainer").dxDataGrid("instance");
            if (!gridInstance) {
                if (typeof Noty === 'function') Noty("warning", "Grid is not ready for export.");
                return;
            }
            if (typeof ExcelJS !== 'undefined') {
                var workbook = new ExcelJS.Workbook();
                var worksheet = workbook.addWorksheet('Employees');
                DevExpress.excelExporter.exportDataGrid({
                    component: gridInstance,
                    worksheet: worksheet,
                    autoFilterEnabled: true
                }).then(function () {
                    workbook.xlsx.writeBuffer().then(function (buffer) {
                        saveAs(new Blob([buffer], { type: 'application/octet-stream' }), 'EmployeeList.xlsx');
                    });
                });
            }
        };

        // DevExtreme DataGrid Initialization
        $scope.InitGrid = function (columns) {
            $("#gridContainer").dxDataGrid({
                dataSource: $scope.List,
                keyExpr: 'ID',
                columns: columns,
                height: 'calc(100vh - 110px)',
                columnAutoWidth: true,
                allowColumnResizing: true,
                columnResizingMode: 'widget',
                allowColumnReordering: true,
                columnChooser: {
                    enabled: true,
                    mode: 'select'
                },
                columnFixing: {
                    enabled: true
                },
                showColumnLines: true,
                showRowLines: true,
                showBorders: true,
                rowAlternationEnabled: true,
                wordWrapEnabled: false,
                sorting: { mode: "multiple" },
                scrolling: {
                    mode: 'virtual'
                },
                paging: { 
                    enabled: false 
                },
                pager: { 
                    visible: false 
                },
                searchPanel: {
                    visible: false
                },
                filterRow: { 
                    visible: true,
                    applyFilter: 'auto'
                },
                headerFilter: { visible: true },
                selection: {
                    mode: 'single'
                },
                export: {
                    enabled: false
                },
                summary: {
                    totalItems: [
                        {
                            column: 'EmployeeName',
                            summaryType: 'count',
                            displayFormat: 'Total: {0}'
                        }
                    ]
                }
            });
        };

        // Fetch data on load
        $scope.FetchData();
    }]);
</script>