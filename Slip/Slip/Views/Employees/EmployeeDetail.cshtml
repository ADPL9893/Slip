@{
    ViewBag.Title = "Employee List";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}


<div ng-controller="EmployeeDetailCtrl" class="emp-list-page">
    <!-- Header Banner Card -->
    <div class="emp-header-card">
        <div class="emp-header-left">
            <div class="emp-header-icon">
                <i class="fa fa-users"></i>
            </div>
            <div>
                <div class="emp-breadcrumb">
                    <a href="@Url.Action("Index", "Home")"><i class="fa fa-home"></i> Home</a> / 
                    <span>Employee List</span>
                </div>
                <h4 class="emp-header-title">Employee List</h4>
            </div>
        </div>
        <div class="emp-header-actions">
            <button class="btn-emp-add" ng-click="OpenAddNew()" title="Open Employee Registration in new tab">
                <i class="fa fa-plus-circle"></i> Add New
            </button>
        </div>
    </div>

    <!-- DataGrid Container Card -->
    <div class="emp-grid-card">
        <div class="emp-card-header">
            <div class="emp-card-title-left">
                <i class="fa fa-table"></i>
                <h3>Employee Records ({{List.length || 0}} Records)</h3>
            </div>
            <div class="emp-card-actions">
                <span class="badge-status-pill badge-pill-info">
                    <i class="fa fa-database"></i> {{List.length || 0}} Total Records
                </span>
            </div>
        </div>
        <div class="emp-grid-body">
            <div class="uigrid">
                <div id="gridContainer" style="width: 100%;"></div>
            </div>
        </div>
    </div>

    <!-- Delete Confirmation Modal -->
    <div class="modal fade" id="ConfirmDeleteModal" role="dialog" data-backdrop="static">
        <div class="modal-dialog modal-md">
            <div class="modal-content">
                <div class="modal-header">
                    <div class="modal-header-brand">
                        <i class="fa fa-exclamation-triangle" style="color: #ef4444; font-size: 18px;"></i>
                        <h4 class="modal-header-title">Confirm Delete Employee</h4>
                    </div>
                    <button type="button" class="close modal-close-btn" data-dismiss="modal">&times;</button>
                </div>
                <div class="modal-body" style="background: #ffffff;">
                    <div class="delete-dialog-content">
                        <div class="delete-warning-icon">
                            <i class="fa fa-trash-o"></i>
                        </div>
                        <h4 class="delete-dialog-title">Delete Employee Record?</h4>
                        <p class="delete-dialog-text">
                            Are you sure you want to delete employee <strong>{{SelectedDeleteItem.EmployeeName || SelectedDeleteItem.EmpName || 'this record'}}</strong> 
                            <span ng-if="SelectedDeleteItem.EmpCode || SelectedDeleteItem.EmployeeCode">({{SelectedDeleteItem.EmpCode || SelectedDeleteItem.EmployeeCode}})</span>?
                        </p>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn-modal-action btn-modal-reset" data-dismiss="modal" type="button">
                        <i class="fa fa-times"></i> Cancel
                    </button>
                    <button class="btn-modal-action btn-modal-delete" ng-click="ExecuteDelete()" type="button">
                        <i class="fa fa-trash"></i> Confirm Delete
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    var module;
    try {
        module = angular.module('app');
    } catch (e) {
        module = angular.module('app', ['ngAnimate', 'ngTouch', 'ui.grid']);
    }

    module.controller("EmployeeDetailCtrl", ['$scope', '$http', '$timeout', function ($scope, $http, $timeout) {
        $scope.List = [];
        $scope.DataField = [];
        $scope.IsLoading = false;
        $scope.SelectedDeleteItem = null;

        // Open Add New in new browser tab
        $scope.OpenAddNew = function () {
            window.open('@Url.Action("Index", "Employees")?id=0', '_blank');
        };

        // Open Edit in new browser tab
        $scope.EditRow = function (id) {
            window.open('@Url.Action("Index", "Employees")?id=' + (id || 0), '_blank');
        };

        // Fetch Data from Server
        $scope.FetchData = function () {
            $scope.IsLoading = true;
            if (typeof show_loader === 'function') show_loader();

            $http.get('@Url.Action("EMP_Employee_Getdata", "Employees")')
            .then(function (response) {
                $scope.IsLoading = false;
                if (typeof hide_loader === 'function') hide_loader();

                var rawList = (response.data && response.data.EMPEmployeeList) ? response.data.EMPEmployeeList : [];
                $scope.List = rawList;

                var rawFields = (response.data && response.data.DataField) ? response.data.DataField : [];
                $scope.BuildGridColumns(rawFields);
            }, function () {
                $scope.IsLoading = false;
                if (typeof hide_loader === 'function') hide_loader();
                if (typeof Noty === 'function') {
                    Noty("error", "Error loading employee list from server.");
                }
            });
        };

        // Format Grid Columns (Compact High-Density Display)
        $scope.BuildGridColumns = function (dataFields) {
            var gridColumns = [];

            // 1. Index / Serial # Column
            gridColumns.push({
                caption: '#',
                width: 40,
                alignment: 'center',
                allowReordering: false,
                fixed: true,
                fixedPosition: 'left',
                cellTemplate: function (container, options) {
                    $("<span>")
                        .text(options.rowIndex + 1)
                        .css({ "font-weight": "600", "color": "#64748b" })
                        .appendTo(container);
                }
            });

            // 2. Process backend dynamic DataFields
            if (dataFields && dataFields.length > 0) {
                angular.forEach(dataFields, function (field) {
                    var col = angular.copy(field);
                    var fieldKey = (col.dataField || '').toLowerCase();

                    // Ensure clean, human-readable caption
                    if (!col.caption || col.caption === null || col.caption === '') {
                        if (fieldKey === 'empcode' || fieldKey === 'employeecode' || fieldKey === 'code') {
                            col.caption = 'Code';
                        } else if (fieldKey === 'employeename' || fieldKey === 'empname' || fieldKey === 'name') {
                            col.caption = 'Employee Name';
                        } else if (fieldKey === 'gender') {
                            col.caption = 'Gender';
                        } else if (fieldKey === 'age') {
                            col.caption = 'Age';
                        } else if (fieldKey === 'mobileno' || fieldKey === 'mobile' || fieldKey === 'phoneno' || fieldKey === 'phone') {
                            col.caption = 'Mobile No';
                        } else if (fieldKey === 'balance') {
                            col.caption = 'Balance';
                        } else if (fieldKey === 'designation') {
                            col.caption = 'Designation';
                        } else if (fieldKey === 'employeetype' || fieldKey === 'emptype') {
                            col.caption = 'Employee Type';
                        } else if (fieldKey === 'username' || fieldKey === 'user_name') {
                            col.caption = 'User Name';
                        } else if (fieldKey === 'company' || fieldKey === 'companyname') {
                            col.caption = 'Company';
                        } else if (fieldKey === 'isactive' || fieldKey === 'status') {
                            col.caption = 'Status';
                        } else if (fieldKey === 'createdbyuser' || fieldKey === 'createdby' || fieldKey === 'createduser') {
                            col.caption = 'Created By';
                        } else if (col.dataField) {
                            col.caption = col.dataField
                                .replace(/([a-z])([A-Z])/g, '$1 $2')
                                .replace(/_/g, ' ')
                                .trim();
                        }
                    }

                    // Special styling for Employee Name
                    if (fieldKey === 'employeename' || fieldKey === 'empname' || fieldKey === 'name') {
                        col.minWidth = 120;
                        col.cellTemplate = function (container, options) {
                            $("<strong>")
                                .text(options.value || '-')
                                .css({ "color": "#1e293b", "font-weight": "600" })
                                .appendTo(container);
                        };
                    }
                    // Special styling for Employee Code
                    else if (fieldKey === 'empcode' || fieldKey === 'employeecode' || fieldKey === 'code') {
                        col.minWidth = 70;
                        col.alignment = 'center';
                        col.cellTemplate = function (container, options) {
                            $("<span>")
                                .text(options.value || '-')
                                .css({ "font-weight": "600", "color": "#2563eb" })
                                .appendTo(container);
                        };
                    }
                    // Special styling for Status
                    else if (fieldKey === 'isactive' || fieldKey === 'status') {
                        col.minWidth = 65;
                        col.alignment = 'center';
                        col.cellTemplate = function (container, options) {
                            var val = options.value;
                            var isActive = (val === true || val === 'True' || val === 'true' || val === 1 || val === '1');
                            if (isActive) {
                                $("<span>").addClass("badge-status-pill badge-pill-success").text("Active").appendTo(container);
                            } else {
                                $("<span>").addClass("badge-status-pill badge-pill-danger").text("Inactive").appendTo(container);
                            }
                        };
                    }
                    // Special styling for Gender
                    else if (fieldKey === 'gender') {
                        col.minWidth = 65;
                        col.alignment = 'center';
                        col.cellTemplate = function (container, options) {
                            if (options.value) {
                                var g = options.value.toString().toUpperCase();
                                var isMale = (g === 'MALE' || g === 'M');
                                $("<span>")
                                    .addClass("badge-status-pill " + (isMale ? "badge-pill-info" : "badge-pill-warning"))
                                    .text(options.value)
                                    .appendTo(container);
                            } else {
                                $("<span>").text("-").appendTo(container);
                            }
                        };
                    }
                    // Special styling for Designation / Employee Type
                    else if (fieldKey === 'designation' || fieldKey === 'employeetype') {
                        col.minWidth = 80;
                    }
                    // Special formatting for Dates
                    else if (fieldKey.indexOf('date') !== -1 || fieldKey === 'dob') {
                        col.minWidth = 85;
                        col.dataType = 'date';
                        col.format = 'dd-MMM-yyyy';
                        col.alignment = 'center';
                    }

                    gridColumns.push(col);
                });
            }

            // 3. Action Column (Edit & Delete)
            gridColumns.push({
                caption: 'Action',
                width: 75,
                alignment: 'center',
                fixed: true,
                fixedPosition: 'right',
                allowReordering: false,
                cellTemplate: function (container, options) {
                    var group = $("<div>").addClass("grid-btn-group");

                    // Edit Button
                    $("<button>")
                        .addClass("grid-action-btn-edit")
                        .attr("title", "Edit Employee")
                        .html('<i class="fa fa-pencil"></i>')
                        .on("click", function () {
                            $scope.$apply(function () {
                                $scope.EditRow(options.data.ID || options.data.EmployeeID);
                            });
                        })
                        .appendTo(group);

                    // Delete Button
                    $("<button>")
                        .addClass("grid-action-btn-del")
                        .attr("title", "Delete Employee")
                        .html('<i class="fa fa-trash-o"></i>')
                        .on("click", function () {
                            $scope.$apply(function () {
                                $scope.PromptDelete(options.data);
                            });
                        })
                        .appendTo(group);

                    group.appendTo(container);
                }
            });

            $scope.InitGrid(gridColumns);
        };

        // Delete handlers
        $scope.PromptDelete = function (item) {
            $scope.SelectedDeleteItem = item;
            $("#ConfirmDeleteModal").modal("show");
        };

        $scope.ExecuteDelete = function () {
            if (!$scope.SelectedDeleteItem) {
                $("#ConfirmDeleteModal").modal("hide");
                return;
            }
            var empId = $scope.SelectedDeleteItem.ID || $scope.SelectedDeleteItem.EmployeeID;
            if (!empId) {
                $("#ConfirmDeleteModal").modal("hide");
                return;
            }

            $scope.IsLoading = true;
            if (typeof show_loader === 'function') show_loader();

            var JsonPassData = { "EmployeeID": empId };
            var Action = "DELETE";

            $http({
                method: "post",
                url: '@Url.Action("InsertUpdateEmployee", "Employees")',
                data: { model: JsonPassData, Action: Action },
                dataType: "json"
            }).then(function (ret) {
                $scope.IsLoading = false;
                if (typeof hide_loader === 'function') hide_loader();
                $("#ConfirmDeleteModal").modal("hide");

                var respMsg = (ret.data && typeof ret.data === 'string') ? ret.data : (ret.data && ret.data.message ? ret.data.message : '');
                if (respMsg === "Recored Is Deleted" || respMsg.toLowerCase().indexOf("deleted") !== -1) {
                    if (typeof Noty === 'function') Noty("success", "Record Deleted Successfully");
                    $scope.FetchData();
                } else {
                    if (typeof Noty === 'function') Noty("error", respMsg || "Record Not Deleted");
                }
            }, function () {
                $scope.IsLoading = false;
                if (typeof hide_loader === 'function') hide_loader();
                $("#ConfirmDeleteModal").modal("hide");
                if (typeof Noty === 'function') Noty("error", "Error connecting to server.");
            });
        };

        // DevExtreme DataGrid Initialization
        $scope.InitGrid = function (columns) {
            $("#gridContainer").dxDataGrid({
                dataSource: $scope.List,
                keyExpr: 'ID',
                columns: columns,
                height: 'calc(100vh - 210px)',
                columnAutoWidth: true,
                allowColumnResizing: true,
                columnResizingMode: 'widget',
                allowColumnReordering: true,
                columnChooser: {
                    enabled: true,
                    mode: 'select'
                },
                columnFixing: {
                    enabled: true
                },
                showColumnLines: true,
                showRowLines: true,
                showBorders: true,
                rowAlternationEnabled: true,
                wordWrapEnabled: false,
                sorting: { mode: "multiple" },
                scrolling: {
                    mode: 'virtual'
                },
                paging: { 
                    enabled: false 
                },
                pager: { 
                    visible: false 
                },
                searchPanel: {
                    visible: true,
                    width: 280,
                    placeholder: 'Search all employees...'
                },
                filterRow: { 
                    visible: true,
                    applyFilter: 'auto'
                },
                headerFilter: { visible: true },
                selection: {
                    mode: 'single'
                },
                export: {
                    enabled: true,
                    formats: ['xlxs'],
                    allowExportSelectedData: false
                },
                onExporting: function (e) {
                    if (e.format === 'xlxs') {
                        if (typeof ExcelJS !== 'undefined') {
                            var workbook = new ExcelJS.Workbook();
                            var worksheet = workbook.addWorksheet('Employees');
                            DevExpress.excelExporter.exportDataGrid({
                                component: e.component,
                                worksheet: worksheet,
                                autoFilterEnabled: true
                            }).then(function () {
                                workbook.xlsx.writeBuffer().then(function (buffer) {
                                    saveAs(new Blob([buffer], { type: 'application/octet-stream' }), 'EmployeeList.xlsx');
                                });
                            });
                        }
                    }
                },
                summary: {
                    totalItems: [
                        {
                            column: 'EmployeeName',
                            summaryType: 'count',
                            displayFormat: 'Total: {0}'
                        }
                    ]
                }
            });
        };

        // Fetch data on load
        $scope.FetchData();
    }]);
</script>