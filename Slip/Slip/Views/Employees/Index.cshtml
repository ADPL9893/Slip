                    </div>
                </div>
                <!-- Gender -->
                <div class="emp-form-col col-lg-2 col-md-6 col-sm-6 col-xs-12">
                    <div class="emp-form-group">
                        <label class="emp-label">Gender</label>
                        <select ng-model="EmployeeMaster.Gender" class="emp-form-control">
                            <option value="">Please Select</option>
                            <option value="MALE">Male</option>
