@{
    ViewBag.Title = "Employee Registration";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}


<div ng-controller="EmployeeMaster" class="emp-entry-page">
    <input type="hidden" ng-model="EmployeeMaster.EmployeeID" />

    <!-- Top Header Banner Card (Actions Only Here) -->
    <div class="emp-header-card">
        <div class="emp-header-left">
            <div class="emp-header-icon">
                <i class="fa fa-user-plus" ng-if="BtnName != 'UPDATE'"></i>
                <i class="fa fa-user" ng-if="BtnName == 'UPDATE'"></i>
            </div>
            <div>
                <div class="emp-breadcrumb">
                    <a href="@Url.Action("Index", "Home")"><i class="fa fa-home"></i> Home</a> / 
                    <a href="@Url.Action("EmployeeDetail", "Employees")">Employee List</a> / 
                    <span>{{BtnName == 'UPDATE' ? 'Edit Employee' : 'Registration'}}</span>
                </div>
                <h4 class="emp-header-title">{{BtnName == 'UPDATE' ? 'Edit Employee: ' + (EmployeeMaster.EmployeeName || 'ID #' + EmployeeMaster.EmployeeID) : 'New Employee Registration'}}</h4>
            </div>
        </div>
        <div class="emp-header-actions">
            <a href="@Url.Action("EmployeeDetail", "Employees")" class="btn-emp-secondary" title="Return to Employee List">
                <i class="fa fa-arrow-left"></i> Back to List
            </a>
            <button class="btn-emp-reset" ng-click="Clear()" type="button" title="Reset Form Values">
                <i class="fa fa-refresh"></i> Clear Form
            </button>
            <button class="btn-emp-save" ng-click="Save()" type="button" title="Save Employee Record">
                <i class="fa fa-check-circle"></i> {{BtnName}}
            </button>
        </div>
    </div>

    <!-- Section 1: Personal Information Card (Soft Ice Blue) -->
    <div class="emp-card emp-card-personal">
        <div class="emp-card-header">
            <h3 class="emp-card-title">
                <i class="fa fa-user"></i> Personal Information
            </h3>
        </div>
        <div class="emp-card-body">
            <div class="emp-form-row">
                <!-- Employee Name -->
                <div class="emp-form-col col-lg-4 col-md-6 col-sm-12 col-xs-12">
                    <div class="emp-form-group">
                        <label class="emp-label">Full Name <span class="req">*</span></label>
                        <input type="text" ng-model="EmployeeMaster.EmployeeName" class="emp-form-control" placeholder="Enter Full Name" />
                    </div>
                </div>
                <!-- DOB -->
                <div class="emp-form-col col-lg-2 col-md-3 col-sm-6 col-xs-12">
                    <div class="emp-form-group">
                        <label class="emp-label">Date of Birth</label>
                        <input type="text" id="FromDATE" class="emp-form-control" ng-model="EmployeeMaster.DOB" ng-change="GetDueDays()" placeholder="dd/mm/yyyy" />
                    </div>
                </div>
                <!-- Age -->
                <div class="emp-form-col col-lg-2 col-md-3 col-sm-6 col-xs-12">
                    <div class="emp-form-group">
                        <label class="emp-label">Age</label>
                        <input type="number" ng-model="EmployeeMaster.Age" ng-blur="agemanage(EmployeeMaster.Age);" class="emp-form-control" placeholder="Age" min="1" />
                    </div>
                </div>
                <!-- Gender -->
                <div class="emp-form-col col-lg-2 col-md-6 col-sm-6 col-xs-12">
                    <div class="emp-form-group">
                        <label class="emp-label">Gender</label>
                        <select ng-model="EmployeeMaster.Gender" class="emp-form-control">
                            <option value="">Please Select</option>
                            <option value="MALE">Male</option>
                            <option value="FEMALE">Female</option>
                        </select>
                    </div>
                </div>
                <!-- Mobile No -->
                <div class="emp-form-col col-lg-2 col-md-6 col-sm-6 col-xs-12">
                    <div class="emp-form-group">
                        <label class="emp-label">Mobile Number <span class="req">*</span></label>
                        <input type="text" ng-model="EmployeeMaster.MobileNo" class="emp-form-control allownumericwithoutdecimal" placeholder="Mobile Number" maxlength="15" />
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Section 2: Employment & System Details Card (Soft Periwinkle / Royal Indigo) -->
    <div class="emp-card emp-card-employment">
        <div class="emp-card-header">
            <h3 class="emp-card-title">
                <i class="fa fa-briefcase"></i> Employment & System Details
            </h3>
        </div>
        <div class="emp-card-body">
            <div class="emp-form-row">
                <!-- Employee Type -->
                <div class="emp-form-col col-lg-3 col-md-6 col-sm-6 col-xs-12">
                    <div class="emp-form-group">
                        <label class="emp-label">Employee Type <span class="req">*</span></label>
                        <select ng-model="EmployeeMaster.EmployeeType" class="emp-form-control" ng-change="ShowGST(EmployeeMaster.EmployeeType)">
                            <option value="">Please Select</option>
                            <option value="EMPLOYEE">Employee</option>
                            <option value="PARTY">Party</option>
                        </select>
                    </div>
                </div>
                <!-- Designation -->
                <div class="emp-form-col col-lg-3 col-md-6 col-sm-6 col-xs-12">
                    <div class="emp-form-group">
                        <label class="emp-label">Designation <span class="req">*</span></label>
                        <select ng-model="EmployeeMaster.Designation" class="emp-form-control">
                            <option value="">Please Select</option>
                            <option value="MANAGER">Manager</option>
                            <option value="EMPLOYEE">Employee</option>
                        </select>
                    </div>
                </div>
                <!-- Emp Code -->
                <div class="emp-form-col col-lg-3 col-md-6 col-sm-6 col-xs-12">
                    <div class="emp-form-group">
                        <label class="emp-label">Emp. Code</label>
                        <input type="text" ng-model="EmployeeMaster.EmpCode" class="emp-form-control" placeholder="Employee Code" />
                    </div>
                </div>
                <!-- Table Selection -->
                <div class="emp-form-col col-lg-3 col-md-6 col-sm-6 col-xs-12">
                    <div class="emp-form-group">
                        <label class="emp-label">Table <span class="req">*</span></label>
                        <select id="TableNo" tabindex="1" chosen="GetTableList" class="emp-form-control" ng-options="item.id as item.value for item in GetTableList" ng-model="EmployeeMaster.TableNo">
                            <option value="">Table Select</option>
                        </select>
                    </div>
                </div>
                <!-- JobWork -->
                <div class="emp-form-col col-lg-3 col-md-6 col-sm-6 col-xs-12">
                    <div class="emp-form-group">
                        <label class="emp-label">JobWork <span class="req">*</span></label>
                        <select id="JobWork" tabindex="1" chosen="JobWork" class="emp-form-control" ng-model="EmployeeMaster.JobWork">
                            <option value="">Please Select</option>
                            <option value="INSIDE">INSIDE</option>
                            <option value="OUTSIDE">OUTSIDE</option>
                        </select>
                    </div>
                </div>
                <!-- Role -->
                <div class="emp-form-col col-lg-3 col-md-6 col-sm-6 col-xs-12">
                    <div class="emp-form-group">
                        <label class="emp-label">Role</label>
                        <select id="RoleID" tabindex="1" chosen="GetRoleList" class="emp-form-control" ng-options="item.id as item.value for item in GetRoleList" ng-model="EmployeeMaster.RoleID">
                            <option value="">Role Select</option>
                        </select>
                    </div>
                </div>
                <!-- Reference Name -->
                <div class="emp-form-col col-lg-6 col-md-12 col-sm-12 col-xs-12">
                    <div class="emp-form-group">
                        <label class="emp-label">Reference Name <span class="req">*</span></label>
                        <input type="text" ng-model="EmployeeMaster.ReferenceName" class="emp-form-control" placeholder="Reference Person Name" />
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Section 3: Account Credentials Card (Soft Ice Blue - Same as Personal Information) -->
    <div class="emp-card emp-card-account">
        <div class="emp-card-header">
            <h3 class="emp-card-title">
                <i class="fa fa-lock"></i> Account Credentials
            </h3>
        </div>
        <div class="emp-card-body">
            <div class="emp-form-row">
                <!-- Username -->
                <div class="emp-form-col col-lg-6 col-md-6 col-sm-12 col-xs-12">
                    <div class="emp-form-group">
                        <label class="emp-label">Username <span class="req">*</span></label>
                        <input type="text" ng-model="EmployeeMaster.UserName" class="emp-form-control" placeholder="Enter Login Username" autocomplete="off" />
                    </div>
                </div>
                <!-- Password -->
                <div class="emp-form-col col-lg-6 col-md-6 col-sm-12 col-xs-12">
                    <div class="emp-form-group">
                        <label class="emp-label">Password <span class="req">*</span></label>
                        <input type="text" ng-model="EmployeeMaster.Password" class="emp-form-control" placeholder="Enter Password" autocomplete="new-password" />
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Section 4: Identity & Address Information Card (Soft Periwinkle / Royal Indigo - Same as Employment Details) -->
    <div class="emp-card emp-card-identity">
        <div class="emp-card-header">
            <h3 class="emp-card-title">
                <i class="fa fa-id-card-o"></i> Identity & Address Information
            </h3>
        </div>
        <div class="emp-card-body">
            <div class="emp-form-row">
                <!-- ID Proof Doc Name -->
                <div class="emp-form-col col-lg-3 col-md-6 col-sm-6 col-xs-12">
                    <div class="emp-form-group">
                        <label class="emp-label">ID Proof Doc Name</label>
                        <input type="text" class="emp-form-control" ng-model="EmployeeMaster.IDProofDocName" placeholder="e.g. Aadhaar, PAN, Voter ID" />
                    </div>
                </div>
                <!-- ID Proof Number -->
                <div class="emp-form-col col-lg-3 col-md-6 col-sm-6 col-xs-12">
                    <div class="emp-form-group">
                        <label class="emp-label">ID Proof Number</label>
                        <input type="text" class="emp-form-control" ng-model="EmployeeMaster.IDProofNumber" placeholder="Document ID Number" />
                    </div>
                </div>
                <!-- Address -->
                <div class="emp-form-col col-lg-6 col-md-12 col-sm-12 col-xs-12">
                    <div class="emp-form-group">
                        <label class="emp-label">Address</label>
                        <input type="text" class="emp-form-control" ng-model="EmployeeMaster.Address" placeholder="Enter Address Details" />
                    </div>
                </div>

                <!-- Conditional GST / PAN (For Party) -->
                <div class="emp-form-col col-lg-6 col-md-6 col-sm-12 col-xs-12" ng-show="GSTShow">
                    <div class="emp-form-group">
                        <label class="emp-label">GST No</label>
                        <input type="text" ng-model="EmployeeMaster.GSTNo" class="emp-form-control" placeholder="GST Number" />
                    </div>
                </div>
                <div class="emp-form-col col-lg-6 col-md-6 col-sm-12 col-xs-12" ng-show="GSTShow">
                    <div class="emp-form-group">
                        <label class="emp-label">PAN No</label>
                        <input type="text" ng-model="EmployeeMaster.PanNo" class="emp-form-control" placeholder="PAN Card Number" />
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Section 5: Documents & Photos Upload Card (Soft Ice Blue - Same as Personal Information) -->
    <div class="emp-card emp-card-documents">
        <div class="emp-card-header">
            <h3 class="emp-card-title">
                <i class="fa fa-cloud-upload"></i> Documents & Photos
            </h3>
        </div>
        <div class="emp-card-body">
            <div class="emp-form-row">
                <!-- Card 1: Profile Photo -->
                <div class="emp-form-col col-lg-4 col-md-4 col-sm-12 col-xs-12">
                    <div class="upload-box-card">
                        <div class="upload-preview-wrapper">
                            <img id="image_source" ng-src="{{image_source}}" class="upload-preview-img" ng-show="image_source" />
                            <div class="upload-preview-placeholder" ng-hide="image_source">
                                <i class="fa fa-user-circle-o"></i>
                                <span>Profile Photo Preview</span>
                            </div>
                        </div>
                        <label for="firlogo" class="btn-emp-upload" tabindex="32">
                            <i class="fa fa-camera"></i> Choose Profile Photo
                        </label>
                        <input id="firlogo" ng-model="EmployeeMaster.PhotoPath" file-model="EmployeeMaster.PhotoPath" type="file" style="display: none;" accept=".jpeg,.jpg,.png" onchange="angular.element(this).scope().uploadedFile(this)">
                        <span id="filename" class="upload-filename-tag">Select File !</span>
                    </div>
                </div>

                <!-- Card 2: ID Proof Document -->
                <div class="emp-form-col col-lg-4 col-md-4 col-sm-12 col-xs-12">
                    <div class="upload-box-card">
                        <div class="upload-preview-wrapper">
                            <img id="Proofimage_source" ng-src="{{Proofimage_source}}" class="upload-preview-img" ng-show="Proofimage_source" />
                            <div class="upload-preview-placeholder" ng-hide="Proofimage_source">
                                <i class="fa fa-file-image-o"></i>
                                <span>ID Proof Preview</span>
                            </div>
                        </div>
                        <label for="Prooffirlogo" class="btn-emp-upload" tabindex="33">
                            <i class="fa fa-id-card"></i> Choose ID Proof Doc
                        </label>
                        <input id="Prooffirlogo" ng-model="EmployeeMaster.IDProofPhotoPath" file-model="EmployeeMaster.IDProofPhotoPath" type="file" style="display: none;" accept=".jpeg,.jpg,.png" onchange="angular.element(this).scope().proofuploadedFile(this)">
                        <span id="Prooffilename" class="upload-filename-tag">Select File !</span>
                    </div>
                </div>

                <!-- Card 3: Additional Photo (Optional) -->
                <div class="emp-form-col col-lg-4 col-md-4 col-sm-12 col-xs-12">
                    <div class="upload-box-card">
                        <div class="upload-preview-wrapper">
                            <img id="Path2image_source2" ng-src="{{Path2image_source2}}" class="upload-preview-img" ng-show="Path2image_source2" />
                            <div class="upload-preview-placeholder" ng-hide="Path2image_source2">
                                <i class="fa fa-picture-o"></i>
                                <span>Optional Photo Preview</span>
                            </div>
                        </div>
                        <label for="Path2logo" class="btn-emp-upload" tabindex="34">
                            <i class="fa fa-image"></i> Choose Photo 2 (Optional)
                        </label>
                        <input id="Path2logo" ng-model="EmployeeMaster.PhotoPath2" file-model="EmployeeMaster.PhotoPath2" type="file" style="display: none;" accept=".jpeg,.jpg,.png" onchange="angular.element(this).scope().path2uploadedFile(this)">
                        <span id="Path2" class="upload-filename-tag">Select File !</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    var Paramdata = [{}];
    var Action = "INSERT";
    var EmployeeID = 0;
    if ('@ViewBag.EmployeeID' != 0) {
        EmployeeID = '@ViewBag.EmployeeID';
    }

    var module;
    try {
        module = angular.module('app');
    } catch (e) {
        module = angular.module('app', ['frapontillo.bootstrap-duallistbox', 'ngTouch', 'angularjs-dropdown-multiselect']);
    }

    module.directive('chosen', ['$timeout', function ($timeout) {
        return {
            restrict: 'A',
            link: function (scope, element, attrs) {
                var updateChosen = function () {
                    $timeout(function () {
                        element.trigger('chosen:updated');
                    }, 50);
                };

                var list = attrs['chosen'];
                if (list) {
                    scope.$watchCollection(list, function () {
                        updateChosen();
                    });
                }

                if (attrs['ngModel']) {
                    scope.$watch(attrs['ngModel'], function () {
                        updateChosen();
                    });
                }

                if (attrs['ngDisabled']) {
                    scope.$watch(attrs['ngDisabled'], function (newVal) {
                        $timeout(function () {
                            element.prop('disabled', !!newVal).trigger('chosen:updated');
                        }, 50);
                    });
                }

                $timeout(function () {
                    element.chosen({
                        width: '100%',
                        search_contains: true,
                        allow_single_deselect: true
                    });
                    updateChosen();
                }, 0);
            }
        };
    }]);

    module.controller("EmployeeMaster", ['$scope', '$filter', '$http', '$q', '$interval', '$timeout', function ($scope, $filter, $http, $q, $interval, $timeout) {
        $scope.EmployeeMaster = {};
        $scope.BtnName = "SAVE";
        $scope.DaytermsDetails = [];
        $scope.Tablemodel = [];
        $scope.GSTShow = false;
        $scope.EmployeeMaster.JoiningDate = typeof Cur_Date !== 'undefined' ? Cur_Date : '';
        $scope.EmployeeMaster.EndingDate = typeof Cur_Date !== 'undefined' ? Cur_Date : '';
        $scope.dateformte = "dd/mm/yyyy";
        $scope.MonthName = [
            { No: 1, Name: "Jan" },
            { No: 2, Name: "Feb" },
            { No: 3, Name: "Mar" },
            { No: 4, Name: "Apr" },
            { No: 5, Name: "May" },
            { No: 6, Name: "Jun" },
            { No: 7, Name: "Jul" },
            { No: 8, Name: "Aug" },
            { No: 9, Name: "Sep" },
            { No: 10, Name: "Oct" },
            { No: 11, Name: "Nov" },
            { No: 12, Name: "Dec" }
        ];

        $(function () {
            $("#FromDATE").keyup(function (e) {
                var currentValue = $(e.target).val();
                var newValue = autocompleteMMDDYYYYDateFormat(currentValue);
                if (newValue != currentValue) {
                    $(e.target).val(newValue);
                }
            });
        });

        var autocompleteMMDDYYYYDateFormat = function (str) {
            str = str.trim();
            var matches, year,
                looksLike_MM_slash_DD = /^(\d\d\/)?\d\d$/,
                looksLike_MM_slash_D_slash = /^(\d\d\/)?(\d\/)$/,
                looksLike_MM_slash_DD_slash_DD = /^(\d\d\/\d\d\/)(\d\d)$/;
            if (looksLike_MM_slash_DD.test(str)) {
                str += "/";
            } else if (looksLike_MM_slash_D_slash.test(str)) {
                str = str.replace(looksLike_MM_slash_D_slash, "$10$2");
            } else if (looksLike_MM_slash_DD_slash_DD.test(str)) {
                matches = str.match(looksLike_MM_slash_DD_slash_DD);
                year = "";
                str = String(matches[1]) + year + String(matches[2]);
            }
            return str;
        };

        $scope.agemanage = function (Age) {
            if (parseInt(Age) < 0) {
                $scope.EmployeeMaster.Age = 0;
                if (typeof Noty === 'function') Noty("error", "Please Enter valid age");
            }
        };

        $scope.ShowGST = function (EmployeeType) {
            if (EmployeeType == "PARTY") {
                $scope.GSTShow = true;
            } else {
                $scope.GSTShow = false;
            }
        };

        $scope.Clear = function () {
            $scope.EmployeeMaster = {};
            $scope.BtnName = "SAVE";
            $scope.EmployeeMaster.JoiningDate = typeof Cur_Date !== 'undefined' ? Cur_Date : '';
            $scope.EmployeeMaster.EndingDate = typeof Cur_Date !== 'undefined' ? Cur_Date : '';
            $scope.dateformte = "dd/mm/yyyy";
            $scope.image_source = null;
            $scope.Proofimage_source = null;
            $scope.Path2image_source2 = null;

            $("#filename").text("Select File !");
            $('#image_source').prop('src', '');

            $("#Prooffilename").text("Select File !");
            $('#Proofimage_source').prop('src', '');

            $("#Path2").text("Select File !");
            $('#Path2image_source2').prop('src', '');
        };

        // GetData Dropdowns with robust key resolution and role fallback
        var loopPromises = [];
        var promise = $http.get('@Url.Action("Get_DataList_For_Using_Common", "Employees")').then(function (response) {
            var data = (typeof response.data === 'string') ? JSON.parse(response.data) : (response.data || {});

            var TableList = [];
            if (data.TableList && data.TableList.length > 0) {
                for (var i = 0; i < data.TableList.length; i++) {
                    var item = data.TableList[i];
                    var tVal = item["TableName"] || item["TableNo"] || item["TableID"] || item["TABLE_NAME"] || item["name"] || item["value"] || item["Table"] || Object.values(item)[0];
                    var tId = item["TableNo"] || item["TableName"] || item["TableID"] || item["id"] || tVal;
                    TableList.push({ id: tId, value: tVal });
                }
            }
            $scope.GetTableList = TableList;

            var RoleList = [];
            if (data.RoleList && data.RoleList.length > 0) {
                for (var j = 0; j < data.RoleList.length; j++) {
                    var rItem = data.RoleList[j];
                    var rId = rItem["RoleID"] || rItem["RoleId"] || rItem["roleid"] || rItem["ID"] || rItem["id"];
                    var rName = rItem["RoleName"] || rItem["Rolename"] || rItem["rolename"] || rItem["Name"] || rItem["value"] || rItem["Role"];
                    RoleList.push({ id: rId, value: rName });
                }
                $scope.GetRoleList = RoleList;
            } else {
                // Fallback to User/Getdata_Role if RoleList not present in common dataset
                $http.get('@Url.Action("Getdata_Role", "User")').then(function (userRoleRes) {
                    var rData = (typeof userRoleRes.data === 'string') ? JSON.parse(userRoleRes.data) : (userRoleRes.data || {});
                    if (rData.RoleList && rData.RoleList.length > 0) {
                        var fallbackRoles = [];
                        for (var k = 0; k < rData.RoleList.length; k++) {
                            var roleItem = rData.RoleList[k];
                            var id = roleItem["RoleID"] || roleItem["RoleId"] || roleItem["roleid"] || roleItem["id"];
                            var name = roleItem["RoleName"] || roleItem["Rolename"] || roleItem["rolename"] || roleItem["name"] || roleItem["value"];
                            fallbackRoles.push({ id: id, value: name });
                        }
                        $scope.GetRoleList = fallbackRoles;
                        $timeout(function () {
                            $('select[chosen]').trigger('chosen:updated');
                        }, 50);
                    }
                });
            }

            $timeout(function () {
                $('select[chosen]').trigger('chosen:updated');
            }, 50);
        });
        loopPromises.push(promise);
        $scope.TableSettings = { enableSearch: true, externalIdProp: '' };

        $scope.SetEditData = function () {
            if (EmployeeID != 0) {
                $scope.BtnName = "UPDATE";
                Action = "UPDATE";
                if (typeof show_loader === 'function') show_loader();

                $http({
                    method: "POST",
                    dataType: "json",
                    data: JSON.stringify({ "EmployeeID": EmployeeID }),
                    url: '@Url.Action("EMP_Employee_GetdataEdit", "Employees")',
                    contentType: "application/json; charset=utf-8"
                }).then(function (ret) {
                    if (typeof hide_loader === 'function') hide_loader();
                    if (ret.data && ret.data.List && ret.data.List.length > 0) {
                        var empData = ret.data.List[0];
                        $scope.EmployeeMaster = empData;
                        $scope.EmployeeMaster.Age = parseInt(empData.Age) || 0;
                        $scope.EmployeeMaster.IsActive = (empData.IsActive == "True" || empData.IsActive === true);
                        $scope.EmployeeMaster.PhotoPath = empData.PhotoPath;
                        $scope.EmployeeMaster.IDProofPhotoPath = empData.IDProofPhotoPath;
                        $scope.EmployeeMaster.PhotoPath2 = empData.PhotoPath2;

                        if (empData.EmployeeType == "PARTY") {
                            $scope.GSTShow = true;
                        } else {
                            $scope.GSTShow = false;
                        }

                        if (empData.PhotoPath) {
                            $("#filename").text(empData.PhotoPath);
                            $scope.image_source = "..\\Images\\PhotoPath\\" + empData.PhotoPath;
                            $("#image_source").attr('src', $scope.image_source);
                        }
                        if (empData.IDProofPhotoPath) {
                            $("#Prooffilename").text(empData.IDProofPhotoPath);
                            $scope.Proofimage_source = "..\\Images\\ProofPhotoPath\\" + empData.IDProofPhotoPath;
                            $("#Proofimage_source").attr('src', $scope.Proofimage_source);
                        }
                        if (empData.PhotoPath2) {
                            $("#Path2").text(empData.PhotoPath2);
                            $scope.Path2image_source2 = "..\\Images\\PhotoPath2\\" + empData.PhotoPath2;
                            $("#Path2image_source2").attr('src', $scope.Path2image_source2);
                        }

                        $timeout(function () {
                            $('select[chosen]').trigger('chosen:updated');
                        }, 100);
                    }
                }, function () {
                    if (typeof hide_loader === 'function') hide_loader();
                });
            }
        }; 
        $scope.SetEditData();

        // Upload Profile Image
        $scope.Save = function () {
            if ($scope.EmployeeMaster.EmployeeName == undefined || $scope.EmployeeMaster.EmployeeName == "") {
                if (typeof Noty === 'function') Noty("error", "Please Enter Employee Name !");
                return;
            }

            if ($scope.EmployeeMaster.MobileNo == undefined || $scope.EmployeeMaster.MobileNo == "") {
                if (typeof Noty === 'function') Noty("error", "Please Enter Mobile Number !");
                return;
            }

            if ($scope.EmployeeMaster.EmployeeType == undefined || $scope.EmployeeMaster.EmployeeType == "") {
                if (typeof Noty === 'function') Noty("error", "Please Select Employee Type !");
                return;
            }

            if ($scope.EmployeeMaster.Designation == undefined || $scope.EmployeeMaster.Designation == "") {
                if (typeof Noty === 'function') Noty("error", "Please Select Designation !");
                return;
            }

            if ($scope.EmployeeMaster.UserName == undefined || $scope.EmployeeMaster.UserName == "") {
                if (typeof Noty === 'function') Noty("error", "Please Enter Username !");
                return;
            }

            if ($scope.EmployeeMaster.Password == undefined || $scope.EmployeeMaster.Password == "") {
                if (typeof Noty === 'function') Noty("error", "Please Enter Password !");
                return;
            }

            if ($scope.EmployeeMaster.TableNo == undefined || $scope.EmployeeMaster.TableNo == "") {
                $scope.EmployeeMaster.TableNo = "0";
            }

            if ($scope.EmployeeMaster.TableNo == undefined || $scope.EmployeeMaster.TableNo == "") {
                if (typeof Noty === 'function') Noty("error", "Please Select Table !");
                return;
            }

            if ($scope.EmployeeMaster.JobWork == undefined || $scope.EmployeeMaster.JobWork == "") {
                if (typeof Noty === 'function') Noty("error", "Please Select JobWork !");
                return;
            }
            if ($scope.EmployeeMaster.ReferenceName == undefined || $scope.EmployeeMaster.ReferenceName == "") {
                if (typeof Noty === 'function') Noty("error", "Please Enter Reference Name !");
                return;
            }

            if (typeof show_loader === 'function') show_loader();

            if ($('#firlogo').val() && $('#firlogo').val().split('.').pop().toLowerCase() != "") {
                var formData = new FormData();
                formData.append("firlogo", document.getElementById('firlogo').files[0]);
                var ext = $('#firlogo').val().split('.').pop().toLowerCase();
                if ($.inArray(ext, ['gif', 'png', 'jpg', 'jpeg']) == -1) {
                    if (typeof hide_loader === 'function') hide_loader();
                    if (typeof Noty === 'function') Noty("error", "Please Select Valid Profile Image !");
                    return;
                }
                formData.append("party_code", $scope.EmployeeMaster.EmployeeID == undefined ? "0" : $scope.EmployeeMaster.EmployeeID);
                $http({
                    method: 'POST',
                    url: '@Url.Action("CustomerImageUpload", "Employees")',
                    headers: { 'Content-Type': undefined },
                    data: formData
                }).then(function (data) {
                    $scope.EmployeeMaster.PhotoPath = data.data;
                    $scope.ProofUploadImage();
                }, function () {
                    $scope.ProofUploadImage();
                });
            } else {
                $scope.ProofUploadImage();
            }
        };

