@{
    ViewBag.Title = "Employee Registration";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* ==========================================================================
       Employee Entry & Registration - Distinct Themed SaaS Card Styling
       ========================================================================== */
    @@keyframes fadeInUpSmooth {
        from {
            opacity: 0;
            transform: translateY(10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .emp-entry-page {
        padding: 0 0 25px 0;
        margin-top: -10px; /* Removes extra spacing below navbar */
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    }

    /* Staggered Card Entrance Animations */
    .emp-header-card { animation: fadeInUpSmooth 0.35s cubic-bezier(0.16, 1, 0.3, 1) 0.05s both; }
    .emp-card { animation: fadeInUpSmooth 0.35s cubic-bezier(0.16, 1, 0.3, 1) 0.12s both; }

    /* Page Header Card (Clean Neutral White Background with Distinct Border) */
    .emp-header-card {
        background: #ffffff !important;
        border-radius: 12px !important;
        padding: 14px 20px !important;
        margin-top: 0 !important;
        margin-bottom: 14px !important;
        box-shadow: 0 2px 10px rgba(15, 23, 42, 0.04) !important;
        border: 1.5px solid #cbd5e1 !important;
        border-left: 5px solid #0284c7 !important;
        display: flex !important;
        justify-content: space-between !important;
        align-items: center !important;
        flex-wrap: wrap !important;
        gap: 12px !important;
        transition: all 0.25s ease !important;
    }
    .emp-header-card:hover {
        box-shadow: 0 6px 18px rgba(15, 23, 42, 0.08) !important;
        border-color: #94a3b8 !important;
        border-left-color: #0369a1 !important;
    }

    .emp-header-left {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .emp-header-icon {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        box-shadow: 0 4px 12px rgba(2, 132, 199, 0.28);
        transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .emp-header-card:hover .emp-header-icon {
        transform: scale(1.08) rotate(4deg);
    }

    .emp-header-title {
        font-size: 18px !important;
        font-weight: 700 !important;
        color: #0f172a !important;
        margin: 0 !important;
        line-height: 1.2 !important;
        letter-spacing: -0.2px;
    }

    .emp-breadcrumb {
        font-size: 11.5px;
        color: #64748b;
        margin-bottom: 3px;
        font-weight: 500;
    }
    .emp-breadcrumb a {
        color: #0284c7;
        text-decoration: none;
        transition: color 0.15s ease;
        font-weight: 500;
    }
    .emp-breadcrumb a:hover {
        color: #0369a1;
        text-decoration: underline;
    }

    .emp-header-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    /* Action Buttons */
    .btn-emp-save {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%) !important;
        color: #ffffff !important;
        border: none !important;
        border-radius: 8px !important;
        padding: 9px 20px !important;
        font-size: 13px !important;
        font-weight: 700 !important;
        display: inline-flex !important;
        align-items: center !important;
        gap: 7px !important;
        box-shadow: 0 4px 14px rgba(16, 185, 129, 0.3) !important;
        transition: all 0.22s cubic-bezier(0.34, 1.56, 0.64, 1) !important;
        cursor: pointer !important;
        text-decoration: none !important;
    }
    .btn-emp-save:hover {
        background: linear-gradient(135deg, #059669 0%, #047857 100%) !important;
        transform: translateY(-2px) !important;
        box-shadow: 0 8px 20px rgba(16, 185, 129, 0.4) !important;
        color: #ffffff !important;
    }
    .btn-emp-save:active {
        transform: translateY(0) !important;
    }

    .btn-emp-secondary {
        background: #f1f5f9 !important;
        color: #475569 !important;
        border: 1.5px solid #cbd5e1 !important;
        border-radius: 8px !important;
        padding: 8px 16px !important;
        font-size: 13px !important;
        font-weight: 600 !important;
        display: inline-flex !important;
        align-items: center !important;
        gap: 6px !important;
        transition: all 0.2s ease !important;
        cursor: pointer !important;
        text-decoration: none !important;
    }
    .btn-emp-secondary:hover {
        background: #e2e8f0 !important;
        color: #1e293b !important;
        border-color: #94a3b8 !important;
        transform: translateY(-1px) !important;
        text-decoration: none !important;
    }

    .btn-emp-reset {
        background: #ffffff !important;
        color: #64748b !important;
        border: 1.5px solid #cbd5e1 !important;
        border-radius: 8px !important;
        padding: 8px 16px !important;
        font-size: 13px !important;
        font-weight: 600 !important;
        display: inline-flex !important;
        align-items: center !important;
        gap: 6px !important;
        transition: all 0.2s ease !important;
        cursor: pointer !important;
    }
    .btn-emp-reset:hover {
        background: #fee2e2 !important;
        color: #b91c1c !important;
        border-color: #fca5a5 !important;
        transform: translateY(-1px) !important;
    }

    /* Base Section Card Container (overflow: visible ensures Chosen dropdowns like JobWork & Role are never clipped) */
    .emp-card {
        border-radius: 12px !important;
        padding: 0 !important;
        margin-bottom: 16px !important;
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04) !important;
        overflow: visible !important;
        position: relative !important;
        transition: all 0.25s ease !important;
    }
    .emp-card:hover,
    .emp-card:focus-within,
    .emp-card:has(.chosen-with-drop) {
        box-shadow: 0 6px 18px rgba(15, 23, 42, 0.08) !important;
        z-index: 50 !important;
    }

    .emp-card-header {
        padding: 12px 18px !important;
        border-top-left-radius: 11px !important;
        border-top-right-radius: 11px !important;
        display: flex !important;
        align-items: center !important;
        justify-content: space-between !important;
        flex-wrap: wrap !important;
        gap: 10px !important;
    }
    .emp-card-title {
        margin: 0 !important;
        font-size: 14.5px !important;
        font-weight: 700 !important;
        letter-spacing: -0.1px;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .emp-card-title i {
        font-size: 15px;
    }

    .emp-card-body {
        padding: 18px 20px 10px !important;
        background: transparent !important;
    }

    /* ==========================================================================
       Distinct Themed Pastel Backgrounds Across Every Entire Card
       ========================================================================== */
    /* 1. Personal Information (Mid-Tone Soft Ice Blue Theme) */
    .emp-card-personal {
        background: #e0f2fe !important;
        border: 1.5px solid #7dd3fc !important;
        z-index: 20 !important;
    }
    .emp-card-personal:hover {
        border-color: #38bdf8 !important;
    }
    .emp-card-personal .emp-card-header {
        background: #bae6fd !important;
        border-bottom: 1.5px solid #7dd3fc !important;
    }
    .emp-card-personal .emp-card-title {
        color: #0369a1 !important;
    }
    .emp-card-personal .emp-card-title i {
        color: #0284c7 !important;
    }
    .emp-card-personal .emp-label {
        color: #0c4a6e !important;
    }
    .emp-card-personal .emp-form-control {
        background: #ffffff !important;
        border: 1.5px solid #7dd3fc !important;
        color: #0f172a !important;
    }
    .emp-card-personal .emp-form-control:focus {
        border-color: #0284c7 !important;
        box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.20) !important;
    }

    /* 2. Employment & System Details (Soft Periwinkle / Royal Indigo Theme - Harmonizes with Card 1 Sky Blue & Card 3 Mint Green) */
    .emp-card-employment {
        background: #e0e7ff !important;
        border: 1.5px solid #a5b4fc !important;
        z-index: 18 !important;
    }
    .emp-card-employment:hover {
        border-color: #818cf8 !important;
    }
    .emp-card-employment .emp-card-header {
        background: #c7d2fe !important;
        border-bottom: 1.5px solid #a5b4fc !important;
    }
    .emp-card-employment .emp-card-title {
        color: #312e81 !important;
    }
    .emp-card-employment .emp-card-title i {
        color: #4f46e5 !important;
    }
    .emp-card-employment .emp-label {
        color: #3730a3 !important;
    }
    .emp-card-employment .emp-form-control {
        background: #ffffff !important;
        border: 1.5px solid #a5b4fc !important;
        color: #0f172a !important;
    }
    .emp-card-employment .emp-form-control:focus {
        border-color: #4f46e5 !important;
        box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.20) !important;
    }
    .emp-card-employment .chosen-container-single .chosen-single {
        background: #ffffff !important;
        border: 1.5px solid #a5b4fc !important;
    }
    .emp-card-employment .chosen-container-active.chosen-with-drop .chosen-single,
    .emp-card-employment .chosen-container-active .chosen-single {
        border-color: #4f46e5 !important;
        box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.20) !important;
    }

    /* 3. Account Credentials (Soft Ice Blue Theme - Same as Personal Information) */
    .emp-card-account {
        background: #e0f2fe !important;
        border: 1.5px solid #7dd3fc !important;
        z-index: 16 !important;
    }
    .emp-card-account:hover {
        border-color: #38bdf8 !important;
    }
    .emp-card-account .emp-card-header {
        background: #bae6fd !important;
        border-bottom: 1.5px solid #7dd3fc !important;
    }
    .emp-card-account .emp-card-title {
        color: #0369a1 !important;
    }
    .emp-card-account .emp-card-title i {
        color: #0284c7 !important;
    }
    .emp-card-account .emp-label {
        color: #0c4a6e !important;
    }
    .emp-card-account .emp-form-control {
        background: #ffffff !important;
        border: 1.5px solid #7dd3fc !important;
        color: #0f172a !important;
    }
    .emp-card-account .emp-form-control:focus {
        border-color: #0284c7 !important;
        box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.20) !important;
    }

    /* 4. Identity & Address (Soft Periwinkle / Royal Indigo Theme - Same as Employment & System Details) */
    .emp-card-identity {
        background: #e0e7ff !important;
        border: 1.5px solid #a5b4fc !important;
        z-index: 14 !important;
    }
    .emp-card-identity:hover {
        border-color: #818cf8 !important;
    }
    .emp-card-identity .emp-card-header {
        background: #c7d2fe !important;
        border-bottom: 1.5px solid #a5b4fc !important;
    }
    .emp-card-identity .emp-card-title {
        color: #312e81 !important;
    }
    .emp-card-identity .emp-card-title i {
        color: #4f46e5 !important;
    }
    .emp-card-identity .emp-label {
        color: #3730a3 !important;
    }
    .emp-card-identity .emp-form-control {
        background: #ffffff !important;
        border: 1.5px solid #a5b4fc !important;
        color: #0f172a !important;
    }
    .emp-card-identity .emp-form-control:focus {
        border-color: #4f46e5 !important;
        box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.20) !important;
    }
    .emp-card-identity .chosen-container-single .chosen-single {
        background: #ffffff !important;
        border: 1.5px solid #a5b4fc !important;
    }
    .emp-card-identity .chosen-container-active.chosen-with-drop .chosen-single,
    .emp-card-identity .chosen-container-active .chosen-single {
        border-color: #4f46e5 !important;
        box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.20) !important;
    }

    /* 5. Documents & Photos Uploads (Soft Ice Blue Theme - Same as Personal Information) */
    .emp-card-documents {
        background: #e0f2fe !important;
        border: 1.5px solid #7dd3fc !important;
        z-index: 12 !important;
    }
    .emp-card-documents:hover {
        border-color: #38bdf8 !important;
    }
    .emp-card-documents .emp-card-header {
        background: #bae6fd !important;
        border-bottom: 1.5px solid #7dd3fc !important;
    }
    .emp-card-documents .emp-card-title {
        color: #0369a1 !important;
    }
    .emp-card-documents .emp-card-title i {
        color: #0284c7 !important;
    }
    .emp-card-documents .upload-box-card {
        background: #ffffff !important;
        border: 1.5px dashed #0284c7 !important;
        box-shadow: 0 2px 6px rgba(2, 132, 199, 0.08) !important;
    }
    .emp-card-documents .upload-box-card:hover {
        background: #f0f9ff !important;
        border-color: #0369a1 !important;
        box-shadow: 0 4px 14px rgba(2, 132, 199, 0.18) !important;
    }
    .emp-card-documents .upload-preview-wrapper {
        background: #f0f9ff !important;
        border: 1px solid #bae6fd !important;
    }
    .emp-card-documents .btn-emp-upload {
        background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%) !important;
        box-shadow: 0 2px 8px rgba(2, 132, 199, 0.35) !important;
    }
    .emp-card-documents .btn-emp-upload:hover {
        background: linear-gradient(135deg, #0369a1 0%, #0284c7 100%) !important;
        box-shadow: 0 4px 12px rgba(2, 132, 199, 0.45) !important;
    }
    .emp-card-documents .upload-filename-tag {
        background: #f0f9ff !important;
        border: 1px solid #bae6fd !important;
        color: #0284c7 !important;
        font-weight: 600 !important;
    }

    /* Form Fields Grid & Controls */
    .emp-form-row {
        display: flex;
        flex-wrap: wrap;
        margin-left: -9px;
        margin-right: -9px;
    }

    .emp-form-col {
        padding-left: 9px;
        padding-right: 9px;
        margin-bottom: 14px;
        position: relative;
    }
    .emp-form-col:has(.chosen-with-drop),
    .emp-form-col:focus-within {
        z-index: 100 !important;
    }

    .emp-form-group {
        display: flex;
        flex-direction: column;
        width: 100%;
        position: relative;
    }

    .emp-label {
        font-size: 12.5px !important;
        font-weight: 600 !important;
        margin-bottom: 5px !important;
        display: flex !important;
        align-items: center !important;
        gap: 4px !important;
    }
    .emp-label .req {
        color: #ef4444;
        font-weight: 700;
    }

    .emp-form-control {
        height: 38px !important;
        border-radius: 8px !important;
        padding: 6px 12px !important;
        font-size: 13px !important;
        font-weight: 500 !important;
        width: 100% !important;
        box-shadow: 0 1px 2px rgba(15, 23, 42, 0.03) !important;
        transition: all 0.2s ease !important;
        outline: none !important;
    }
    .emp-form-control::placeholder {
        color: #94a3b8 !important;
        font-weight: 400 !important;
    }

    textarea.emp-form-control {
        height: auto !important;
        min-height: 70px !important;
        resize: vertical;
    }

    /* Chosen Customization */
    .chosen-container {
        width: 100% !important;
        font-size: 13px !important;
        position: relative !important;
    }
    .chosen-container-active,
    .chosen-container.chosen-with-drop {
        z-index: 1050 !important;
    }
    .chosen-container-single .chosen-single {
        height: 38px !important;
        line-height: 36px !important;
        border-radius: 8px !important;
        box-shadow: 0 1px 2px rgba(15, 23, 42, 0.03) !important;
        padding: 0 12px !important;
        color: #0f172a !important;
        font-weight: 500 !important;
        transition: all 0.2s ease !important;
    }
    .chosen-container-single .chosen-single div b {
        background-position: 0 8px !important;
    }
    .chosen-container .chosen-drop {
        border-radius: 8px !important;
        border: 1.5px solid #0284c7 !important;
        box-shadow: 0 12px 28px rgba(15, 23, 42, 0.18) !important;
        margin-top: 2px !important;
        position: absolute !important;
        z-index: 1060 !important;
        background: #ffffff !important;
    }
    .chosen-container .chosen-search {
        padding: 6px 8px !important;
    }
    .chosen-container .chosen-search input[type="text"] {
        border-radius: 6px !important;
        border: 1.5px solid #cbd5e1 !important;
        padding: 6px 10px 6px 24px !important;
        font-size: 12.5px !important;
        outline: none !important;
        box-shadow: none !important;
    }
    .chosen-container .chosen-results {
        max-height: 200px !important;
        padding: 4px !important;
        margin: 0 !important;
        font-size: 13px !important;
    }
    .chosen-container .chosen-results li {
        padding: 7px 10px !important;
        border-radius: 6px !important;
        line-height: 1.4 !important;
        color: #1e293b !important;
    }
    .chosen-container .chosen-results li.highlighted {
        background: #0284c7 !important;
        background-image: none !important;
        color: #ffffff !important;
    }
    .chosen-container .chosen-results li.no-results {
        background: #f8fafc !important;
        color: #64748b !important;
        font-style: italic !important;
    }

    /* Specific Chosen Theme overrides for Employment & Identity cards */
    .emp-card-employment .chosen-container .chosen-drop,
    .emp-card-identity .chosen-container .chosen-drop {
        border: 1.5px solid #a5b4fc !important;
    }
    .emp-card-employment .chosen-container .chosen-results li.highlighted,
    .emp-card-identity .chosen-container .chosen-results li.highlighted {
        background: #4f46e5 !important;
        color: #ffffff !important;
    }
    .emp-card-employment .chosen-container .chosen-search input[type="text"]:focus,
    .emp-card-identity .chosen-container .chosen-search input[type="text"]:focus {
        border-color: #4f46e5 !important;
    }

    /* Upload Cards Inside Documents & Photos */
    .upload-box-card {
        border-radius: 10px;
        padding: 14px;
        text-align: center;
        transition: all 0.25s ease;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: space-between;
        min-height: 240px;
    }

    .upload-preview-wrapper {
        width: 100%;
        height: 130px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        margin-bottom: 10px;
        position: relative;
    }
    .upload-preview-img {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
    }
    .upload-preview-placeholder {
        color: #0284c7;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
    }
    .upload-preview-placeholder i {
        font-size: 32px;
        color: #38bdf8;
    }
    .upload-preview-placeholder span {
        font-size: 11.5px;
        font-weight: 600;
        color: #0369a1;
    }

    .btn-emp-upload {
        color: #ffffff !important;
        border: none !important;
        border-radius: 7px !important;
        padding: 7px 14px !important;
        font-size: 12px !important;
        font-weight: 600 !important;
        display: inline-flex !important;
        align-items: center !important;
        gap: 6px !important;
        cursor: pointer !important;
        transition: all 0.2s ease !important;
        margin-bottom: 6px !important;
    }
    .btn-emp-upload:hover {
        transform: translateY(-1px) !important;
        color: #ffffff !important;
    }

    .upload-filename-tag {
        font-size: 11px;
        max-width: 100%;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        display: block;
        padding: 3px 8px;
        border-radius: 4px;
    }

    /* Responsive Breakpoints */
    @@media (max-width: 768px) {
        .emp-entry-page {
            padding: 0 0 20px 0;
            margin-top: -6px;
        }

        .emp-header-card {
            flex-direction: column !important;
            align-items: stretch !important;
            padding: 12px 14px !important;
            gap: 12px !important;
        }

        .emp-header-left {
            width: 100%;
        }

        .emp-header-actions {
            width: 100%;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .btn-emp-save,
        .btn-emp-secondary,
        .btn-emp-reset {
            width: 100% !important;
            justify-content: center !important;
            padding: 10px 16px !important;
        }

        .emp-card-body {
            padding: 14px 14px 6px !important;
        }

        .upload-box-card {
            margin-bottom: 12px;
        }
    }

    @@media (max-width: 480px) {
        .emp-header-icon {
            width: 38px;
            height: 38px;
            font-size: 17px;
        }

        .emp-header-title {
            font-size: 16px !important;
        }
    }
</style>

<div ng-controller="EmployeeMaster" class="emp-entry-page">
    <input type="hidden" ng-model="EmployeeMaster.EmployeeID" />

    <!-- Top Header Banner Card (Actions Only Here) -->
    <div class="emp-header-card">
        <div class="emp-header-left">
            <div class="emp-header-icon">
                <i class="fa fa-user-plus" ng-if="BtnName != 'UPDATE'"></i>
                <i class="fa fa-user" ng-if="BtnName == 'UPDATE'"></i>
            </div>
            <div>
                <div class="emp-breadcrumb">
                    <a href="@Url.Action("Index", "Home")"><i class="fa fa-home"></i> Home</a> / 
                    <a href="@Url.Action("EmployeeDetail", "Employees")">Employee List</a> / 
                    <span>{{BtnName == 'UPDATE' ? 'Edit Employee' : 'Registration'}}</span>
                </div>
                <h4 class="emp-header-title">{{BtnName == 'UPDATE' ? 'Edit Employee: ' + (EmployeeMaster.EmployeeName || 'ID #' + EmployeeMaster.EmployeeID) : 'New Employee Registration'}}</h4>
            </div>
        </div>
        <div class="emp-header-actions">
            <a href="@Url.Action("EmployeeDetail", "Employees")" class="btn-emp-secondary" title="Return to Employee List">
                <i class="fa fa-arrow-left"></i> Back to List
            </a>
            <button class="btn-emp-reset" ng-click="Clear()" type="button" title="Reset Form Values">
                <i class="fa fa-refresh"></i> Clear Form
            </button>
            <button class="btn-emp-save" ng-click="Save()" type="button" title="Save Employee Record">
                <i class="fa fa-check-circle"></i> {{BtnName}}
            </button>
        </div>
    </div>

    <!-- Section 1: Personal Information Card (Soft Ice Blue) -->
    <div class="emp-card emp-card-personal">
        <div class="emp-card-header">
            <h3 class="emp-card-title">
