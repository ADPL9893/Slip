@{
    ViewBag.Title = "Login - Anjali Labtech";
    Layout = "~/Views/Shared/_LoginLayout.cshtml";

    string rememberedUsername = Convert.ToString(ViewBag.RememberedUsername);
    string rememberedPassword = Convert.ToString(ViewBag.RememberedPassword);
    bool rememberMeChecked = ViewBag.RememberMe != null && Convert.ToBoolean(ViewBag.RememberMe);
}

<style>
    @@import url("https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap");

    :root {
        --ho-bg: #050b18;
        --ho-ice: #7dd3fc;
        --ho-blue: #3b82f6;
        --ho-violet: #8b5cf6;
        --ho-text: #e6edf7;
        --ho-muted: #8a9bb8;
        --ho-line: rgba(148, 178, 230, .16);
    }

    html, body.adpl-login-page-body, body {
        margin: 0 !important;
        padding: 0 !important;
        height: auto !important;
        min-height: 100vh !important;
    }

    body.adpl-login-page-body, body {
        font-family: 'Plus Jakarta Sans', system-ui, sans-serif !important;
        background: var(--ho-bg) !important;
        color: var(--ho-text) !important;
        overflow-x: hidden !important;
        display: block !important;
        -webkit-font-smoothing: antialiased !important;
    }

    .ho-page * , .ho-page *::before, .ho-page *::after { box-sizing: border-box; }

    /* ---------- Background ---------- */
    .ho-aurora { position: fixed; inset: 0; z-index: 0; overflow: hidden; }
    .ho-aurora span {
        position: absolute; border-radius: 50%; filter: blur(90px); opacity: .55;
        animation: hoDrift 22s ease-in-out infinite alternate;
    }
    .ho-aurora .ho-a1 { width: 620px; height: 620px; background: #1d4ed8; top: -200px; left: -120px; }
    .ho-aurora .ho-a2 { width: 520px; height: 520px; background: #7c3aed; bottom: -220px; right: 10%; animation-delay: -6s; opacity: .35; }
    .ho-aurora .ho-a3 { width: 420px; height: 420px; background: #0ea5e9; top: 30%; left: 35%; animation-delay: -12s; opacity: .25; }
    @@keyframes hoDrift {
        0% { transform: translate(0,0) scale(1); }
        50% { transform: translate(80px,40px) scale(1.12); }
        100% { transform: translate(-40px,90px) scale(.95); }
    }
    .ho-grid {
        position: fixed; inset: 0; z-index: 0;
        background-image:
            linear-gradient(rgba(125,211,252,.05) 1px, transparent 1px),
            linear-gradient(90deg, rgba(125,211,252,.05) 1px, transparent 1px);
        background-size: 60px 60px;
        mask-image: radial-gradient(ellipse 70% 60% at 30% 50%, #000 20%, transparent 80%);
    }
    #hoStage { position: fixed; inset: 0; z-index: 1; }

    /* ---------- Layout ---------- */
    .ho-wrap {
        position: relative; z-index: 2; min-height: 100vh;
        display: grid; grid-template-columns: 1.15fr 1fr; align-items: center;
        max-width: 1320px; margin: 0 auto; padding: 40px 56px; gap: 40px;
    }
    header.ho-top {
        position: absolute; top: 36px; left: 56px; right: 56px;
        display: flex; justify-content: space-between; align-items: center;
    }
    .ho-logo { line-height: 0; display: flex; align-items: center; }
    .ho-logo img { height: 75px; width: auto; display: block; filter: drop-shadow(0 2px 10px rgba(0,0,0,.35)); }
    @@media (max-width: 960px) { .ho-logo img { height: 32px; } }

    .ho-status {
        display: inline-flex; align-items: center; gap: 8px; font-size: 12px; color: var(--ho-muted);
        padding: 7px 14px; border: 1px solid var(--ho-line); border-radius: 999px; background: rgba(10,18,36,.5); backdrop-filter: blur(8px);
    }
    .ho-status i { width: 7px; height: 7px; border-radius: 50%; background: #22c55e; box-shadow: 0 0 0 0 rgba(34,197,94,.6); animation: hoPing 2s infinite; }
    @@keyframes hoPing { 70% { box-shadow: 0 0 0 8px rgba(34,197,94,0); } 100% { box-shadow: 0 0 0 0 rgba(34,197,94,0); } }

    .ho-hero { padding-top: 40px; }
    .ho-hero .ho-tag {
        font-size: 12px; font-weight: 700; letter-spacing: .22em; text-transform: uppercase; color: var(--ho-ice);
        display: flex; align-items: center; gap: 12px; margin-bottom: 22px;
    }
    .ho-hero .ho-tag::before { content: ""; width: 36px; height: 1px; background: var(--ho-ice); }
    .ho-hero h1 {
        font-size: clamp(40px, 5vw, 64px); line-height: 1.04; font-weight: 800; letter-spacing: -.035em; max-width: 560px;
        margin: 0; color: var(--ho-text);
    }
    .ho-hero h1 em {
        font-style: normal;
        background: linear-gradient(100deg, #7dd3fc 0%, #a5b4fc 45%, #c4b5fd 70%, #7dd3fc 100%);
        background-size: 200% auto; -webkit-background-clip: text; background-clip: text; color: transparent;
        animation: hoSheen 6s linear infinite;
    }
    @@keyframes hoSheen { to { background-position: 200% center; } }
    .ho-hero p { margin-top: 22px; margin-bottom: 0; max-width: 460px; font-size: 16px; line-height: 1.7; color: var(--ho-muted); }

    /* ---------- Glass card ---------- */
    .ho-card-shell {
        position: relative; justify-self: end; width: 100%; max-width: 440px;
        border-radius: 24px; padding: 1px;
        background: conic-gradient(from var(--ho-ang, 0deg), rgba(125,211,252,.0), rgba(125,211,252,.7), rgba(139,92,246,.6), rgba(125,211,252,0) 40%);
        animation: hoSpin 6s linear infinite;
        box-shadow: 0 40px 120px -30px rgba(29,78,216,.55);
    }
    @@property --ho-ang { syntax: '<angle>'; inherits: false; initial-value: 0deg; }
    @@keyframes hoSpin { to { --ho-ang: 360deg; } }
    .ho-card {
        border-radius: 23px; padding: 40px 36px 32px;
        background: linear-gradient(180deg, rgba(17,28,54,.82), rgba(8,15,32,.88));
        backdrop-filter: blur(22px) saturate(140%);
    }
    .ho-card .ho-hello { font-size: 13px; color: var(--ho-ice); font-weight: 600; }
    .ho-card h2 { font-size: 28px; font-weight: 800; letter-spacing: -.02em; margin: 6px 0 6px; color: var(--ho-text); }
    .ho-card .ho-lead { font-size: 14px; color: var(--ho-muted); margin-bottom: 30px; }

    /* Floating-label fields */
    .ho-field { position: relative; margin-bottom: 18px; }
    .ho-field input {
        width: 100%; height: 58px; padding: 22px 48px 6px 48px;
        font: inherit; font-size: 15px; color: var(--ho-text);
        background: rgba(5,11,24,.6); border: 1px solid var(--ho-line); border-radius: 14px;
        transition: border-color .2s, box-shadow .2s, background .2s;
    }
    .ho-field label {
        position: absolute; left: 48px; top: 50%; transform: translateY(-50%);
        font-size: 14px; color: var(--ho-muted); pointer-events: none; transition: all .18s ease;
    }
    .ho-field input:focus, .ho-field input:not(:placeholder-shown) { outline: none; }
    .ho-field input:focus { border-color: rgba(125,211,252,.7); background: rgba(5,11,24,.85); box-shadow: 0 0 0 4px rgba(56,189,248,.12), 0 0 24px -6px rgba(56,189,248,.5); }
    .ho-field input:focus + label,
    .ho-field input:not(:placeholder-shown) + label,
    .ho-field input:-webkit-autofill + label,
    .ho-field.ho-has-value label {
        top: 17px; font-size: 11px; letter-spacing: .04em; color: var(--ho-ice);
    }
    .ho-field .ho-ico { position: absolute; left: 16px; top: 50%; transform: translateY(-50%); width: 18px; height: 18px; color: #5f7397; transition: color .2s; }
    .ho-field input:focus ~ .ho-ico { color: var(--ho-ice); }

    /* Chrome/Edge autofill paints its own background and can leave the floating
       label stuck in the middle of the field since :placeholder-shown doesn't
       always flip on autofill - force the label up and re-skin the fill. */
    .ho-field input:-webkit-autofill,
    .ho-field input:-webkit-autofill:hover,
    .ho-field input:-webkit-autofill:focus {
        -webkit-text-fill-color: var(--ho-text);
        -webkit-box-shadow: 0 0 0 1000px rgba(5,11,24,.85) inset;
        box-shadow: 0 0 0 1000px rgba(5,11,24,.85) inset;
        transition: background-color 9999s ease-in-out 0s;
        caret-color: var(--ho-text);
    }
    .ho-eye {
        position: absolute; right: 10px; top: 50%; transform: translateY(-50%);
        width: 36px; height: 36px; border: 0; border-radius: 10px; background: none; color: #5f7397; cursor: pointer;
        display: grid; place-items: center;
    }
    .ho-eye:hover { background: rgba(125,211,252,.08); color: var(--ho-text); }
    .ho-eye svg { width: 18px; height: 18px; }
    .ho-caps { font-size: 12px; color: #fbbf24; margin: -8px 0 14px 4px; }

    .ho-error {
        display: flex; align-items: center; gap: 10px;
        background: rgba(239, 68, 68, .12); border: 1px solid rgba(239, 68, 68, .35); border-left: 4px solid #ef4444;
        border-radius: 9px; padding: 10px 14px; margin-bottom: 18px;
        font-size: 12.5px; font-weight: 600; color: #fecaca;
        animation: hoShake .4s ease-in-out both;
    }
    .ho-error svg { width: 18px; height: 18px; stroke: #ef4444; flex-shrink: 0; }
    @@keyframes hoShake {
        0%, 100% { transform: translateX(0); }
        20%, 60% { transform: translateX(-7px); }
        40%, 80% { transform: translateX(7px); }
    }

    .ho-row { display: flex; justify-content: space-between; align-items: center; font-size: 13px; margin: 6px 0 26px; }
    .ho-switch { display: inline-flex; align-items: center; gap: 10px; cursor: pointer; color: #b6c3da; }
    .ho-switch input { display: none; }
    .ho-switch .ho-t { width: 34px; height: 20px; border-radius: 999px; background: #1e2a44; position: relative; transition: background .2s; }
    .ho-switch .ho-t::after { content: ""; position: absolute; top: 3px; left: 3px; width: 14px; height: 14px; border-radius: 50%; background: #8a9bb8; transition: all .2s; }
    .ho-switch input:checked + .ho-t { background: var(--ho-blue); }
    .ho-switch input:checked + .ho-t::after { left: 17px; background: #fff; }
    .ho-link { color: var(--ho-ice); text-decoration: none; font-weight: 600; }
    .ho-link:hover { text-decoration: underline; }

    .ho-btn {
        position: relative; overflow: hidden; width: 100%; height: 54px; border: 0; border-radius: 14px; cursor: pointer;
        font: inherit; font-size: 15px; font-weight: 700; color: #fff; letter-spacing: .01em;
        background: linear-gradient(100deg, #2563eb, #3b82f6 45%, #7c3aed);
        box-shadow: 0 14px 34px -12px rgba(59,130,246,.8), inset 0 1px 0 rgba(255,255,255,.25);
        display: flex; align-items: center; justify-content: center; gap: 10px;
        transition: transform .15s, box-shadow .2s, filter .2s;
    }
    .ho-btn::after {
        content: ""; position: absolute; top: 0; left: -60%; width: 40%; height: 100%;
        background: linear-gradient(100deg, transparent, rgba(255,255,255,.35), transparent);
        transform: skewX(-20deg); animation: hoShine 3.6s ease-in-out infinite;
    }
    @@keyframes hoShine { 0%, 60% { left: -60%; } 100% { left: 130%; } }
    .ho-btn:hover:not(:disabled) { filter: brightness(1.08); transform: translateY(-1px); }
    .ho-btn svg { width: 18px; height: 18px; transition: transform .2s; }
    .ho-btn:hover svg { transform: translateX(3px); }
    .ho-btn:disabled { opacity: .6; cursor: not-allowed; }
    .ho-btn.loading span, .ho-btn.loading svg { opacity: 0; }
    .ho-spin { display: none; position: absolute; width: 22px; height: 22px; border: 2.5px solid rgba(255,255,255,.35); border-top-color: #fff; border-radius: 50%; animation: hoRot .7s linear infinite; }
    .ho-btn.loading .ho-spin { display: block; }
    @@keyframes hoRot { to { transform: rotate(360deg); } }

    .ho-secure { margin-top: 26px; display: flex; justify-content: center; align-items: center; gap: 8px; font-size: 12px; color: #6b7d9c; }
    .ho-secure svg { width: 14px; height: 14px; color: #22c55e; }

    footer.ho-bottom {
        position: absolute; bottom: 28px; left: 56px; right: 56px;
        display: flex; justify-content: space-between; font-size: 12px; color: #4f6080; z-index: 2;
    }
    footer.ho-bottom a { color: inherit; text-decoration: none; margin-left: 20px; }
    footer.ho-bottom a:hover { color: var(--ho-text); }

    /* Entrance */
    .ho-rise { opacity: 0; transform: translateY(18px); animation: hoRise .8s cubic-bezier(.2,.7,.2,1) forwards; }
    .ho-d1 { animation-delay: .1s; } .ho-d2 { animation-delay: .22s; } .ho-d3 { animation-delay: .34s; } .ho-d4 { animation-delay: .46s; }
    @@keyframes hoRise { to { opacity: 1; transform: none; } }

    @@media (max-width: 960px) {
        .ho-wrap { grid-template-columns: 1fr; padding: 110px 16px 90px; gap: 28px; }
        header.ho-top { left: 16px; right: 16px; top: 24px; }
        footer.ho-bottom { left: 16px; right: 16px; flex-direction: column; gap: 8px; align-items: center; }
        footer.ho-bottom a { margin: 0 10px; }
        .ho-hero { padding-top: 0; text-align: center; }
        .ho-hero .ho-tag { justify-content: center; }
        .ho-hero p { display: none; }
        .ho-hero h1 { margin: 0 auto; font-size: 36px; }
        .ho-card-shell { justify-self: center; }
        .ho-card { padding: 32px 22px 26px; }
        .ho-status { display: none; }
    }
    @@media (prefers-reduced-motion: reduce) {
        .ho-page *, .ho-page *::before, .ho-page *::after { animation: none !important; }
        .ho-rise { opacity: 1; transform: none; }
    }
</style>

<div class="ho-page" ng-controller="Login">
    <div class="ho-aurora"><span class="ho-a1"></span><span class="ho-a2"></span><span class="ho-a3"></span></div>
    <div class="ho-grid"></div>
    <canvas id="hoStage"></canvas>

    <div class="ho-wrap">
        <header class="ho-top ho-rise">
            <div class="ho-logo">
                <img src="@Url.Content("~/Content/images/anjali-logo-white.png")" alt="Anjali Labtech Limited">
            </div>
            <div class="ho-status"><i></i> All systems operational</div>
        </header>

        <section class="ho-hero">
            <div class="ho-tag ho-rise ho-d1">HO Management System</div>
            <h1 class="ho-rise ho-d2">Head Office, <em>in one place.</em></h1>
            <p class="ho-rise ho-d3">Manage branches, staff, approvals, inventory and reports for Anjali Labtech from a single secure console.</p>
        </section>

        <div class="ho-card-shell ho-rise ho-d3">
            <div class="ho-card">
                <div class="ho-hello" id="hoGreet">Good day</div>
                <h2>HO Management Login</h2>
                <p class="ho-lead">Authorised head office personnel only.</p>

                <form name="loginForm" ng-submit="LoginCheck()" novalidate autocomplete="on">
                    <div class="ho-field" ng-class="{'ho-has-value': username}">
                        <input type="text"
                               ng-model="username"
                               name="Username"
                               id="username"
                               placeholder=" "
                               autocomplete="username"
                               autocapitalize="none"
                               required />
                        <label for="username">Username or employee ID</label>
                        <svg class="ho-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                    </div>

                    <div class="ho-field" ng-class="{'ho-has-value': password}">
                        <input type="{{showPassword ? 'text' : 'password'}}"
                               ng-model="password"
                               name="Password"
                               id="password"
                               placeholder=" "
                               autocomplete="current-password"
                               required />
                        <label for="password">Password</label>
                        <svg class="ho-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                        <button type="button" class="ho-eye" id="hoEye" aria-label="Show password" tabindex="-1"></button>
                    </div>
                    <div class="ho-caps" id="hoCaps" style="display:none;">&#9888; Caps Lock is on</div>

                    <div class="ho-error" ng-if="msg">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                        <span>{{msg}}</span>
                    </div>

                    <div class="ho-row">
                        <label class="ho-switch"><input type="checkbox" ng-model="rememberMe"><span class="ho-t"></span> Keep me signed in</label>
                        <a href="#" class="ho-link">Forgot password?</a>
                    </div>

                    <button type="submit" class="ho-btn" ng-class="{loading: IsLoading}" ng-disabled="!(username && password) || IsLoading">
                        <span>Sign in securely</span>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
                        <i class="ho-spin"></i>
                    </button>
                </form>

                <div class="ho-secure">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
                    Protected by ADPL Security
                </div>
            </div>
        </div>

        <footer class="ho-bottom">
            <span>&copy; <span id="hoYr"></span> Anjali Labtech Limited. All rights reserved.</span>
            <span><a href="#">Privacy</a><a href="#">Terms</a><a href="#">IT Support</a></span>
        </footer>
    </div>
</div>

<script>
    /* ---------- Small UI bits ---------- */
    document.getElementById('hoYr').textContent = new Date().getFullYear();
    (function () {
        var h = new Date().getHours();
        document.getElementById('hoGreet').textContent = h < 12 ? 'Good morning' : h < 17 ? 'Good afternoon' : 'Good evening';
    })();

    (function () {
        var EYE = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>';
        var EYE_OFF = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 19c-6.5 0-10-7-10-7a18.5 18.5 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c6.5 0 10 7 10 7a18.5 18.5 0 0 1-2.16 3.19M1 1l22 22"/></svg>';
        var pw = document.getElementById('password'), eye = document.getElementById('hoEye');
        eye.innerHTML = EYE;
        eye.onclick = function () {
            var show = pw.type === 'password';
            pw.type = show ? 'text' : 'password';
            eye.innerHTML = show ? EYE_OFF : EYE;
            eye.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
        };
        pw.addEventListener('keyup', function (e) {
            document.getElementById('hoCaps').style.display = e.getModifierState && e.getModifierState('CapsLock') ? 'block' : 'none';
        });
    })();

    /* ---------- 3D rotating diamond + sparkles ---------- */
    (function () {
        var cv = document.getElementById('hoStage'), ctx = cv.getContext('2d');
        var W, H, DPR;
        function resize() {
            DPR = Math.min(window.devicePixelRatio || 1, 2);
            W = cv.width = innerWidth * DPR; H = cv.height = innerHeight * DPR;
            cv.style.width = innerWidth + 'px'; cv.style.height = innerHeight + 'px';
        }
        addEventListener('resize', resize); resize();

        var N = 8, V = [], E = [];
        var ring = function (r, y, off) { var s = V.length; for (var i = 0; i < N; i++) { var a = (i + off) / N * Math.PI * 2; V.push([Math.cos(a) * r, y, Math.sin(a) * r]); } return s; };
        var T = ring(.52, -.62, 0), C = ring(.82, -.42, .5), G = ring(1, -.22, 0);
        var CU = V.push([0, 1.15, 0]) - 1;
        for (var i = 0; i < N; i++) {
            var n = (i + 1) % N;
            E.push([T + i, T + n], [T + i, C + i], [T + n, C + i], [C + i, G + i], [C + i, G + n], [G + i, G + n], [G + i, CU]);
        }

        var sparks = [];
        for (var k = 0; k < 70; k++) {
            sparks.push({ x: Math.random(), y: Math.random(), r: Math.random() * 1.4 + .3, p: Math.random() * 6.28, s: Math.random() * .015 + .004 });
        }

        var t = 0, mx = 0, my = 0;
        addEventListener('pointermove', function (e) { mx = e.clientX / innerWidth - .5; my = e.clientY / innerHeight - .5; });
        var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

        function frame() {
            t += reduce ? 0 : .006;
            ctx.clearRect(0, 0, W, H);

            for (var si = 0; si < sparks.length; si++) {
                var s = sparks[si];
                s.p += s.s;
                var a = (Math.sin(s.p) + 1) / 2;
                ctx.fillStyle = 'rgba(186,230,253,' + (a * .7) + ')';
                ctx.beginPath(); ctx.arc(s.x * W, s.y * H, s.r * DPR, 0, 7); ctx.fill();
            }

            var mobile = innerWidth < 960;
            var cx = (mobile ? .5 : .62) * W, cy = (mobile ? .2 : .5) * H;
            var S = Math.min(W, H) * (mobile ? .16 : .3);
            var ry = t + mx * .6, rx = -.38 + my * .3;
            var cyR = Math.cos(ry), syR = Math.sin(ry), cxR = Math.cos(rx), sxR = Math.sin(rx);
            var P = V.map(function (v) {
                var x = v[0], y = v[1], z = v[2];
                var X = x * cyR - z * syR, Z = x * syR + z * cyR;
                var Y = y * cxR - Z * sxR; Z = y * sxR + Z * cxR;
                var f = 3.2 / (3.2 + Z);
                return [cx + X * S * f, cy + (Y + .1) * S * f, Z];
            });

            var gl = ctx.createRadialGradient(cx, cy, 0, cx, cy, S * 1.6);
            gl.addColorStop(0, 'rgba(56,189,248,.16)'); gl.addColorStop(1, 'rgba(56,189,248,0)');
            ctx.fillStyle = gl; ctx.beginPath(); ctx.arc(cx, cy, S * 1.6, 0, 7); ctx.fill();

            ctx.lineCap = 'round';
            for (var ei = 0; ei < E.length; ei++) {
                var a1 = E[ei][0], b1 = E[ei][1];
                var pa = P[a1], pb = P[b1], depth = (pa[2] + pb[2]) / 2;
                var alpha = .18 + (1 - (depth + 1) / 2) * .55;
                var g = ctx.createLinearGradient(pa[0], pa[1], pb[0], pb[1]);
                g.addColorStop(0, 'rgba(125,211,252,' + alpha + ')');
                g.addColorStop(1, 'rgba(167,139,250,' + (alpha * .8) + ')');
                ctx.strokeStyle = g; ctx.lineWidth = 1.3 * DPR;
                ctx.beginPath(); ctx.moveTo(pa[0], pa[1]); ctx.lineTo(pb[0], pb[1]); ctx.stroke();
            }
            P.forEach(function (pt, i) {
                var tw = (Math.sin(t * 4 + i * 1.7) + 1) / 2;
                if (pt[2] < 0 && tw > .85) {
                    ctx.fillStyle = 'rgba(255,255,255,' + ((tw - .85) * 6) + ')';
                    ctx.beginPath(); ctx.arc(pt[0], pt[1], 2.2 * DPR, 0, 7); ctx.fill();
                }
            });
            requestAnimationFrame(frame);
        }
        frame();
    })();

    /* ---------- AngularJS Login Controller ---------- */
    var app;
    try {
        app = angular.module('app');
    } catch (e) {
        app = angular.module('app', ['ngTouch']);
    }

    app.controller("Login", function ($scope, $http) {
        $scope.username = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(rememberedUsername));
        $scope.password = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(rememberedPassword));
        $scope.rememberMe = @(rememberMeChecked ? "true" : "false");
        $scope.Invalid = false;
        $scope.IsLoading = false;
        $scope.showPassword = false;
        $scope.msg = "";

        $scope.LoginCheck = function () {
            if ($scope.username && $scope.password && $scope.username.trim() !== "" && $scope.password.trim() !== "") {
                $scope.Invalid = true;
                $scope.msg = "";
            } else {
                $scope.Invalid = false;
                $scope.msg = "Please enter both Username and Password.";
                return;
            }

            if ($scope.Invalid) {
                $scope.IsLoading = true;
                var User = {
                    username: $scope.username.trim(),
                    password: $scope.password.trim(),
                    rememberMe: !!$scope.rememberMe
                };

                $http({
                    url: '@Url.Action("LoginUser", "Login")',
                    method: "GET",
                    params: User
                }).then(function (response) {
                    $scope.IsLoading = false;
                    if (response.data.Status == 1) {
                        if (response.data.UserID == 12) {
                            window.location.href = "@Url.Action("ApprovePricing", "Pricing")";
                        } else {
                            window.location.href = "@Url.Action("Index", "Home")";
                        }
                    } else {
                        $scope.msg = "UserName Or Password Incorrect.!!!";
                    }
                }, function (error) {
                    $scope.IsLoading = false;
                    $scope.msg = "Server communication error. Please try again.";
                });
            }
        };
    });
</script>
